---
// Self-hosted rather than a CDN link, per the plan: no third-party requests.
// Without this the one post with LaTeX renders its formulas as raw $...$ text.
import 'katex/dist/katex.min.css'
import SEO from '../components/SEO.astro'
import { t, type Locale } from '../i18n/ui'

interface Props {
  title: string
  description: string
  lang?: string
  type?: 'website' | 'article'
  publishedAt?: Date
  updatedAt?: Date
  image?: string
  tags?: string[]
  series?: string
  alternates?: { lang: string; href: string }[]
}

const {
  title,
  description,
  lang = 'pt',
  type = 'website',
  publishedAt,
  updatedAt,
  image,
  tags,
  series,
  alternates,
} = Astro.props

const locale = (lang === 'en' ? 'en' : 'pt') satisfies Locale
const canonical = new URL(Astro.url.pathname, Astro.site).href
const home = locale === 'en' ? '/en/' : '/'

// Cloudflare Web Analytics: cookieless, no consent banner needed. Emitted only
// when the token is set, so local builds and previews send nothing.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lucas Santos"
      href={locale === 'en' ? '/en/rss.xml' : '/rss.xml'}
    />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      lang={lang}
      image={image}
      tags={tags}
      series={series}
      alternates={alternates}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t(locale, 'skipToContent')}</a>
    <header>
      <a href={home} class="home">lsantos.dev</a>
      <nav aria-label={t(locale, 'search')}>
        <a href={locale === 'en' ? '/en/busca/' : '/busca/'}>{t(locale, 'search')}</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <p>Lucas Santos</p>
    </footer>
    {
      analyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
    <script>
      // Registers the offline cache. Everything above works without it; this
      // only makes already-read posts available with no connection.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // A failed registration must never break the page.
          })
        })
      }
    </script>
  </body>
</html>

<style is:global>
  /* ponytail: theming is native light-dark() + color-scheme, no toggle and no
     JS yet. A manual toggle needs a stored preference — add it with the real
     design in Phase 1. */
  :root {
    color-scheme: light dark;
    --bg: light-dark(#fffdf9, #14161a);
    --fg: light-dark(#1a1c20, #e6e4e0);
    --muted: light-dark(#5d6169, #9a9ea6);
    --accent: light-dark(#0b5ea8, #7cc0ff);
    --rule: light-dark(#e4e0d8, #2a2d33);
    --measure: 68ch;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    padding: 0 1.5rem;
    background: var(--bg);
    color: var(--fg);
    font-family: ui-serif, Georgia, 'Times New Roman', serif;
    font-size: 1.05rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  header,
  main,
  footer {
    max-width: var(--measure);
    margin-inline: auto;
  }

  header {
    display: flex;
    padding-block: 2rem 3rem;
  }

  .skip-link {
    position: absolute;
    top: -3rem;
    left: 1rem;
    padding: 0.5rem 1rem;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--rule);
    border-radius: 4px;
    z-index: 1;
  }

  .skip-link:focus-visible {
    top: 0.5rem;
  }

  .home {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-decoration: none;
  }

  .home:hover {
    color: var(--accent);
  }

  footer {
    margin-block: 5rem 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.85rem;
  }

  h1,
  h2,
  h3 {
    line-height: 1.25;
    text-wrap: balance;
  }

  a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  pre {
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
</style>
