---
// Self-hosted rather than a CDN link, per the plan: no third-party requests.
// Without this the one post with LaTeX renders its formulas as raw $...$ text.
import 'katex/dist/katex.min.css'
// rehype-callouts emits the markup and the icons but ships its themes as opt-in
// stylesheets, so without this line every > [!note] rendered as plain text with
// a stray title. Obsidian's theme, matching the plugin option in astro.config.mjs
// and the vocabulary the posts are actually written in.
import 'rehype-callouts/theme/obsidian'
// The two faces that are decided, self-hosted. First, so a @font-face exists
// before any rule below asks for the family.
import '../styles/fonts.css'
// Every colour, font stack, size and duration the site uses. Nothing below
// should hardcode one.
import '../styles/theme.css'
// How the body of a post reads: headings, emphasis, lists, tables, links, code.
import '../styles/prose.css'
// Callout cards and the code block frame, which are both dense enough to want
// their own file. Ordered after prose.css so they win where they overlap.
import '../styles/code-and-callouts.css'
// Footnotes rendered beside the text instead of only at the foot of the page.
import '../styles/footnotes.css'
// Every embed centred in the reading column instead of hugging its left edge.
import '../styles/embeds.css'
// Display equations and their copy control.
import '../styles/math.css'
// Quote and epigraph treatments the lab page shows side by side. This file is a
// menu, not a decision: the chosen variant moves into prose.css and the rest go.
import '../styles/variants/quotes.css'
// Tag and category chips, which live outside the prose wrapper.
import '../styles/chips.css'
import BrandHeader from '../components/BrandHeader.astro'
import ConwayField from '../components/ConwayField.astro'
import FootnoteSidenotes from '../components/FootnoteSidenotes.astro'
import Github from '../components/icons/Github.astro'
import LinkedIn from '../components/icons/LinkedIn.astro'
import Twitter from '../components/icons/Twitter.astro'
import Youtube from '../components/icons/Youtube.astro'
import MathCopy from '../components/MathCopy.astro'
import QuoteCopy from '../components/QuoteCopy.astro'
import ReadingProgress from '../components/ReadingProgress.astro'
import SEO from '../components/SEO.astro'
import { t, type Locale } from '../i18n/ui'
import { contentSecurityPolicy } from '../lib/embed-hosts'
// Baked in at build time: the semver the release workflow last tagged, plus a
// count of commits since that tag. See src/lib/version.ts. It counted posts
// once, which left every change that was not a post invisible. REPO is the
// same string the footer's GitHub icon link points at, so both read off one
// constant rather than spelling the host out twice.
import { commitShort, commitUrl, REPO, siteVersion as version } from '../lib/version'

interface Props {
  title: string
  description: string
  lang?: string
  type?: 'website' | 'article'
  publishedAt?: Date
  updatedAt?: Date
  image?: string
  tags?: string[]
  series?: string
  /** Raw `authors` frontmatter, passed through to the article schema. */
  authors?: string[]
  alternates?: { lang: string; href: string }[]
  markdown?: string
  noindex?: boolean
  /** Passed through to the breadcrumb so it reads Home > section > post. */
  section?: { name: string; url: string }
  /** Only a post gets the reading progress bar; an index has nothing to read through. */
  progress?: boolean
}

const {
  title,
  description,
  lang = 'pt',
  type = 'website',
  publishedAt,
  updatedAt,
  image,
  tags,
  series,
  authors,
  alternates,
  section,
  markdown,
  noindex,
  progress = false,
} = Astro.props

const locale = (lang === 'en' ? 'en' : 'pt') satisfies Locale
const canonical = new URL(Astro.url.pathname, Astro.site).href
const home = locale === 'en' ? '/en/' : '/'

// Cloudflare Web Analytics: cookieless, no consent banner needed. Emitted only
// when the token is set, so local builds and previews send nothing.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN

// The footer copyright's closing year. 2019 (the first post's year) is fixed
// in the translated string itself; this is only the end of the range, taken
// at build time so it never needs a manual bump.
const copyrightYear = new Date().getFullYear()

// The footer's other three icon buttons, alongside REPO: Lucas's own
// subdomains rather than the platforms' own hosts, so a renamed or replaced
// service is one DNS record away from staying correct without a code change.
const LINKEDIN_URL = 'https://linkedin.lsantos.dev'
const TWITTER_URL = 'https://twitter.lsantos.dev'
const YOUTUBE_URL = 'https://youtube.lsantos.dev'
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Ahead of every stylesheet on purpose: an explicit light/dark choice has
        to be on <html> before the first paint, or every page flashes the
        system-default ground first. Nothing stored means no attribute, and
        the color-scheme: light dark on :root (theme.css) decides, which is
        exactly today's behaviour with no toggle at all. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('color-scheme')
        if (stored === 'light' || stored === 'dark') document.documentElement.setAttribute('data-theme', stored)
      } catch {
        // Private mode, or storage disabled. color-scheme: light dark still applies.
      }
    </script>
    {/* Same shape, one key over: the reader's chosen code theme has to be on
        <html> before the first paint too, or every page flashes the
        system-default theme first. Nothing stored means no attribute, and the
        prefers-color-scheme media query in expressive-code's own CSS decides,
        which is exactly the behaviour before there was a picker. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('code-theme')
        if (stored !== null && stored !== 'auto') document.documentElement.setAttribute('data-code-theme', stored)
      } catch {
        // Private mode, or storage disabled. The media query still applies.
      }
    </script>
    {/* Same shape again: the reader's motion override and the Conway
        background on/off choice both decide whether anything moves or draws
        at all, so both need to be on <html> before conway.ts's own deferred
        module ever runs. Absent, nothing here changes: the OS query still
        decides reduced motion, and the field still starts on. */}
    <script is:inline>
      try {
        const motion = localStorage.getItem('motion')
        if (motion === 'reduce' || motion === 'allow') document.documentElement.setAttribute('data-motion', motion)
        if (localStorage.getItem('background-life') === '0') document.documentElement.setAttribute('data-bg-life', 'off')
      } catch {
        // Private mode, or storage disabled. The field starts on, motion follows the OS.
      }
    </script>
    {/* Same shape again: the reader's text-size step and body face (theme.css,
        settings-panel.ts) both have to be on <html> before first paint too, or
        every page flashes at the default size and face first. Nothing stored
        means neither attribute, which is the default 100% Literata step. */}
    <script is:inline>
      try {
        const size = localStorage.getItem('font-size')
        if (size === 'xs' || size === 'sm' || size === 'lg' || size === 'xl') document.documentElement.setAttribute('data-font-size', size)
        if (localStorage.getItem('body-face') === 'sans') document.documentElement.setAttribute('data-body-face', 'sans')
      } catch {
        // Private mode, or storage disabled. The default size and face apply.
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- iOS ignores the manifest and looks for this one specifically. -->
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    {/* One manifest per locale, so an install prompt describes the site in the
        language the reader is actually on. */}
    <link rel="manifest" href={locale === 'en' ? '/en/manifest.webmanifest' : '/manifest.webmanifest'} />
    <!-- Both are --bg from theme.css. They cannot read the token, so they are the
         one place a palette change has to be made twice. -->
    <meta name="theme-color" content="#f4efe0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {/* GitHub Pages cannot set headers, so this is the only way to cap what an
        injected script could reach. The old Ghost site had nothing like it, and
        one injected tag was enough to run whatever the attacker wanted. Built
        from src/lib/embed-hosts.ts, which the output guard reads too. */}
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy()} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lucas Santos"
      href={locale === 'en' ? '/en/rss.xml' : '/rss.xml'}
    />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      lang={lang}
      image={image}
      tags={tags}
      series={series}
      authors={authors}
      alternates={alternates}
      section={section}
      markdown={markdown}
      noindex={noindex}
    />
  </head>
  <body>
    {/* Decorative, aria-hidden, and behind everything (z-index: -1 in its own
        scoped style): placed first so it never affects tab order, which
        starts at the skip link below regardless of where in the DOM this
        renders. */}
    <ConwayField />
    {progress && <ReadingProgress locale={locale} />}
    <a href="#main-content" class="skip-link">{t(locale, 'skipToContent')}</a>
    {/* The plain-link "Buscar" nav that used to live here is gone: the
        command palette BrandHeader renders replaced it as the actual way
        readers search with JS on. The old link's own /search/ page still
        exists and still works with JS off (which the palette never will).
        It no longer lives in this footer, but it is not orphaned: the 404
        page and the home page's own no-JS notice both link to it directly,
        and robots.txt/the sitemap filter still know it by name. */}
    <BrandHeader locale={locale} home={home} alternates={alternates} />
    <main id="main-content">
      <slot />
    </main>
    <footer>
      {/* Drawn the same way BrandHeader.astro's .chrome draws its own top
          edge: box-drawing corners plus a run of dashes filling whatever
          room is left, same --muted, same font-display, same 0.4em
          letter-spacing on the dashes. Corners point down (└─ / ─┘) rather
          than repeating the header's up-pointing ┌─/─┐: the header opens
          the frame at the top of the page, this closes it at the bottom,
          so the two read as one box rather than two unrelated bars. */}
      <div class="rule" aria-hidden="true">
        <span class="rule-edge">└─</span><span class="rule-fill">────────────────────────────────────────────────────────────────────────────────────────────────────────────────────</span><span class="rule-edge">─┘</span>
      </div>
      <div class="row">
        <p class="copyright">{t(locale, 'copyright', copyrightYear)}</p>
        <p class="links">
          {/*
            Required, not decorative: PxPlus IBM VGA is CC BY-SA 4.0, which asks for
            attribution reachable from the site. This link is that attribution now;
            /oss/ names the font, its author and the licence, with a link to the
            licence text. See docs/theming.md.
          */}
          {/*
            Four icon-only links, each needing a name in words: aria-label
            carries that, and every icon component's own aria-hidden keeps
            the glyph out of the accessibility tree, so the label is the only
            thing a screen reader announces on any of them.

            The header's own icon-button chrome now, not the quieter
            treatment this GitHub link had last pass: the owner asked for it
            explicitly, reversing that earlier call. `.icon-link` (below)
            matches ThemeToggle.astro's `.tt-open`/`.tt-open::before` pair
            (--icon-btn-hit hit target, --icon-btn-chip drawn chip,
            --icon-btn-glyph size, --accent-day border) on an <a> rather than
            a <button>, since these link straight to a destination instead of
            opening anything.

            All four are excluded by name from the site-wide link treatment
            (src/styles/prose/links.css's own `footer .icon-link` entry,
            generalised from the single `footer .gh-link` case it used to be
            a single-purpose exception for): a dashed underline has no
            baseline to sit under on an icon, and the external-link arrow
            that rule appends is redundant beside a glyph that already reads
            as its own service.
          */}
          <a href={REPO} rel="noopener" class="icon-link" aria-label={t(locale, 'githubRepo')}>
            <Github />
          </a>
          <a href={LINKEDIN_URL} rel="noopener" class="icon-link" aria-label={t(locale, 'linkedinProfile')}>
            <LinkedIn />
          </a>
          {/*
            "Twitter", not "X": lsantos.dev's own short link keeps the old
            name (twitter.lsantos.dev), and the accessible label matches it.
            Pixelarticons has no separate twitter glyph any more (see
            Twitter.astro's own comment); the icon is the pack's current X
            logo either way, so the mismatch is only in the label, not a
            drawn stand-in for a mark the pack does not ship.
          */}
          <a href={TWITTER_URL} rel="noopener" class="icon-link" aria-label={t(locale, 'twitterProfile')}>
            <Twitter />
          </a>
          <a href={YOUTUBE_URL} rel="noopener" class="icon-link" aria-label={t(locale, 'youtubeChannel')}>
            <Youtube />
          </a>
        </p>
      </div>
      {/*
        Still a real link to the commit it was built from, deliberately not
        styled as one: the owner asked for both, so this is a link a reader can
        follow while reading as plain dim text in the line.

        `.version a` therefore has to opt out of the site-wide link treatment
        (the dashed rest underline and the inverted hover block). It keeps a
        visible focus ring and a hover cue of its own rather than dropping
        every affordance: an unstyled link that also gives no feedback on
        hover or focus is undiscoverable and unreachable by keyboard, which is
        a different problem from the one being solved here.
      */}
      <p class="version">
        {t(locale, 'version')}: <a href={commitUrl}>{version}</a>
      </p>
      {/*
        The OSS credits, moved out of the right-hand link row and given their
        own centred line under the version, smaller than it.

        Required, not decorative: PxPlus IBM VGA8 is CC BY-SA 4.0, which asks
        for attribution reachable from the site, and /oss/ is where the font,
        its author and its licence are named. So this line is a licence
        obligation wearing the quietest treatment that still satisfies it,
        which is why it can be the smallest thing in the footer but cannot be
        dropped.
      */}
      <p class="credits">
        <a href={locale === 'en' ? '/en/oss/' : '/oss/'}>{t(locale, 'credits')}</a>
      </p>
    </footer>
    <MathCopy locale={locale} />
    <FootnoteSidenotes />
    <QuoteCopy />
    {
      analyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
    <script is:inline define:vars={{ copiedLabel: t(locale, 'linkCopied') }}>
      // Clicking a heading's # both jumps to the section and puts the full URL on
      // the clipboard. One delegated listener rather than one per heading, and
      // the jump is left to the browser: preventDefault would break opening the
      // anchor in a new tab and lose the history entry.
      document.addEventListener('click', async (event) => {
        const anchor = event.target.closest('a[data-copy-link]')
        if (anchor === null) return

        try {
          await navigator.clipboard.writeText(anchor.href)
        } catch {
          // No clipboard permission, or an insecure origin. The jump still works,
          // which is the part that matters, so say nothing.
          return
        }

        document.querySelector('.toast')?.remove()
        const toast = document.createElement('div')
        toast.className = 'toast'
        toast.setAttribute('role', 'status')
        toast.textContent = copiedLabel
        document.body.append(toast)
        setTimeout(() => toast.remove(), 2000)
      })
    </script>
    <script is:inline define:vars={{ commitShort }}>
      // Registers the offline cache. Everything above works without it; this
      // only makes already-read posts available with no connection.
      //
      // The commit in the URL is what triggers an update: browsers install a
      // new worker only when the script URL or its bytes change, and sw.js
      // reads it back to name its caches. Keyed on the commit rather than the
      // release, so every deploy retires the previous deploy's caches instead
      // of only those from before the last version bump.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js?v=' + commitShort).catch(() => {
            // A failed registration must never break the page.
          })
        })
      }
    </script>
  </body>
</html>

<style is:global>
  /* Tokens live in src/styles/theme.css, imported above. Theming is native
     light-dark() + color-scheme; ThemeToggle.astro narrows color-scheme to
     one keyword on an explicit choice, and every light-dark() token here
     follows without being rewritten. */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /*
   * The page ground lives on <html>, not on <body>, and that is load-bearing
   * rather than a style choice. ConwayField.astro draws a fixed canvas at
   * z-index: -1 so the header, main and footer paint above it as ordinary
   * in-flow boxes. But CSS paints a stacking context in a fixed order, and
   * step 2 is negative-z-index children while step 3 is the backgrounds of
   * non-positioned block descendants. <body> is one of those descendants, so
   * an opaque background on it paints over the canvas: the field was running
   * the whole time and simply invisible. On <html> the background propagates
   * to the canvas surface and is painted before step 2, so the field shows and
   * the ground still covers the viewport past the document's own height.
   */
  html {
    background: var(--bg);
  }

  /*
   * The site's actual font default lives here, on <body>, since every other
   * element without its own font-family declaration inherits from it. It
   * used to read --font-body: correct for a post's running text, but that
   * made --font-body the silent default for everything else too (the
   * footer's copyright line, 404, offline and search's own copy, the OSS
   * intro paragraph, the machine-translation banner), none of which ever
   * picked a body serif/sans on purpose. Departure Mono (--font-display) is
   * the actual, deliberate default for anything on the site that has not
   * picked a face: theme.css's own top comment already calls the coming
   * design "ASCII/ANSI, 8-bit, pixelated", prose is the one still-open
   * exception (docs/design.md), and a page's un-styled chrome text was never
   * meant to read as part of that exception too.
   *
   * .prose (prose.css) now declares --font-body of its own accord, for
   * exactly that reason: a post's own body copy has to keep reading
   * whatever it reads today regardless of what <body> defaults to, so that
   * choice moved from relying on inheritance to being written down on
   * purpose. Everything else inside .prose already carried its own explicit
   * font-family before this change (headings, code, tables, links) and
   * still does: adding this one declaration is the whole fix .prose needed.
   */
  body {
    margin: 0;
    padding: 0 var(--gutter);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--text-base);
    line-height: var(--leading);
    /* Both spacings come from the chosen face's own block in theme.css, so
       switching to the sans changes the spacing with it. Left reading the
       body tokens even though the default face above is no longer one: a
       reader who never enters .prose never sees text at --text-base/
       --leading/--tracking-body/--word-spacing-body zoomed in close enough
       for a monospace face's own metrics to want different values, and
       giving Departure Mono its own set here, sitewide, on a guess was not
       part of what was asked this round. */
    letter-spacing: var(--tracking-body);
    word-spacing: var(--word-spacing-body);
    -webkit-font-smoothing: var(--font-smoothing);
    text-wrap: pretty;
  }

  header,
  main,
  footer {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .skip-link {
    position: absolute;
    top: -3rem;
    left: 1rem;
    padding: 0.5rem 1rem;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--rule);
    border-radius: 4px;
    z-index: 1;
  }

  .skip-link:focus-visible {
    top: 0.5rem;
  }

  footer {
    /*
     * The top value was 5rem. A page that ends in Pagination.astro already
     * closes with its own rule and top spacing (2.5rem margin, 1.5rem
     * padding, then a border), so the two stacked read as an oversized
     * empty run before the footer's own rule below. Halved rather than
     * removed: a page with no pagination (a single post) still wants real
     * separation from the footer, just not doubled up.
     */
    margin-block: 2.5rem 3rem;
    padding-block-start: 1rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /*
   * Same width as the header past the same breakpoint: BrandHeader.astro's
   * .chrome caps itself at 80vw past 70rem (the "there is room to spare"
   * breakpoint footnotes.css already uses) rather than the reading column,
   * since chrome across the top of the page is not prose. The footer is
   * chrome too, so it matches the exact property, value and breakpoint here
   * rather than only lining up at one width. Below 70rem both still share
   * the plain var(--measure) from the "header, main, footer" rule above, so
   * nothing here changes below the breakpoint.
   */
  @media (min-width: 70rem) {
    footer {
      max-inline-size: 80vw;
    }
  }

  /*
   * The footer's own rule, drawn the same way BrandHeader.astro's .chrome
   * draws its own top edge: box-drawing corners plus a run of dashes filling
   * whatever room is left between them, the same --muted, the same
   * font-display, the same 0.4em letter-spacing on the dash run, flex: 1 and
   * overflow: hidden on the fill so it crops to whatever width the footer
   * actually has rather than reflowing. Corners point down (└─ / ─┘) instead
   * of repeating the header's up-pointing ┌─/─┐: the header opens the frame
   * at the top of the page, this closes it at the bottom, so the two read as
   * one box rather than two unrelated bars. Duplicated by hand rather than
   * shared with BrandHeader.astro, which is held by another agent this pass;
   * if this pairing is meant to stay in lockstep going forward, the corner
   * treatment belongs in one shared place (styles/theme.css, or a small
   * chrome-rule partial) rather than two copies of the same characters.
   */
  footer .rule {
    display: flex;
    align-items: center;
    /* 10px, the owner's own number, not 1rem: a rem here would move with the
       reader's text-size setting, and the distance between a drawn rule and
       the line under it is a fixed optical relationship rather than something
       that should scale with the type. */
    margin-block-end: 10px;
  }

  footer .rule-edge {
    color: var(--muted);
    font-family: var(--font-display);
    letter-spacing: 0.06em;
  }

  footer .rule-fill {
    flex: 1;
    overflow: hidden;
    color: var(--muted);
    font-family: var(--font-display);
    letter-spacing: 0.4em;
    white-space: nowrap;
  }

  /*
   * Copyright left, the credits/licence/repo-icon group right, on one line
   * at desktop width. Below that there is not enough room for both without
   * crowding or truncating, so flex-wrap lets the whole `.links` group drop
   * to its own line under the copyright rather than overlapping or
   * shrinking either one. Spacing is margin rather than a shorthand
   * row/column property, so it survives both the wrapped and unwrapped
   * case with the same two declarations.
   */
  footer .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
  }

  /* Both children of `.row` are `<p>`, and the UA sheet's own top margin on
     each was adding a full line between the rule above and this line, on top
     of the rule's own 10px. Zeroed here so the rule's margin is the only thing
     setting that distance. */
  footer .copyright,
  footer .links {
    margin-block-start: 0;
  }

  footer .copyright {
    margin-inline-end: 1rem;
    margin-block-end: 0.35rem;
  }

  footer .version {
    margin-block-start: 0.75rem;
    /* Zero, so the only space between this line and the credits under it is
       the one the credits set. Both are `<p>`, and the UA sheet's own bottom
       margin was adding a full line of its own on top of that. */
    margin-block-end: 0;
    text-align: center;
  }

  /*
   * Centred right under the version, 2pt smaller, and reading as the same dim
   * text rather than as a link: the quietest line in the footer, which is what
   * a licence attribution can be once it is reachable at all.
   *
   * `pt` is an absolute CSS length (1pt = 1/72in), so subtracting it from the
   * version's own size gives the owner's "2pt smaller" literally rather than a
   * rem guess standing in for it. The same technique the nav links use for
   * their own 2pt.
   */
  footer .credits {
    margin-block: 2px 0;
    font-size: calc(0.75rem - 2pt);
    text-align: center;
  }

  /* Same opt-out as `.version a` above, for the same reason and with the same
     hover and focus cues kept: no underline, no accent, inheriting the dim
     colour of its own line, but still discoverable by pointer and reachable by
     keyboard. Both are named exceptions in prose/links.css's own list. */
  footer .credits a {
    color: inherit;
    text-decoration: none;
    background: none;
  }

  footer .credits a:hover {
    text-decoration: underline dotted;
  }

  footer .credits a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Reads as the dim text around it, not as a link: no underline, no accent,
     inheriting the colour of its own line. Hover and focus still say it is
