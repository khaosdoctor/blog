---
// Import order is load-bearing here: each stylesheet depends on values or
// rules defined by the ones before it.
import 'katex/dist/katex.min.css'
import 'rehype-callouts/theme/obsidian'
import '../styles/fonts.css'
import '../styles/tweaks.css'
import '../styles/theme.css'
import '../styles/prose.css'
import '../styles/section-header.css'
import '../styles/callouts.css'
import '../styles/code-blocks.css'
import '../styles/footnotes.css'
import '../styles/embeds.css'
import '../styles/math.css'
import '../styles/variants/quotes.css'
import '../styles/variants/emphasis.css'
import '../styles/chips.css'
import '../styles/listing.css'
import '../styles/lab-demo.css'
import '../styles/core.css'
import BrandHeader from '../components/BrandHeader.astro'
import ConwayField from '../components/ConwayField.astro'
import Footnotes from '../components/Footnotes.astro'
import HoverPreviews from '../components/HoverPreviews.astro'
import Github from '../components/icons/Github.astro'
import LinkedIn from '../components/icons/LinkedIn.astro'
import Twitter from '../components/icons/Twitter.astro'
import Youtube from '../components/icons/Youtube.astro'
import MathCopy from '../components/MathCopy.astro'
import QuoteCopy from '../components/QuoteCopy.astro'
import ReadingProgress from '../components/ReadingProgress.astro'
import SEO from '../components/SEO.astro'
import { type Locale, localePath, t } from '../i18n/ui'
import { contentSecurityPolicy } from '../lib/embed-hosts'
import { DARK_GROUND, LIGHT_GROUND } from '../lib/grounds.mjs'
import { commitShort, commitUrl, REPO, siteVersion as version } from '../lib/version'

interface Props {
  title: string
  description: string
  lang: Locale
  type?: 'website' | 'article'
  publishedAt?: Date
  updatedAt?: Date
  image?: string
  tags?: string[]
  series?: string
  authors?: string[]
  alternates?: { lang: string; href: string }[]
  markdown?: string
  noindex?: boolean
  section?: { name: string; url: string }
  progress?: boolean
  postAccent?: string
}

const {
  title,
  description,
  lang: locale,
  type = 'website',
  publishedAt,
  updatedAt,
  image,
  tags,
  series,
  authors,
  alternates,
  section,
  markdown,
  noindex,
  progress = false,
  postAccent,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
const home = localePath(locale, '/')

const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN

const copyrightYear = new Date().getFullYear()

const LINKEDIN_URL = 'https://linkedin.lsantos.dev'
const TWITTER_URL = 'https://twitter.lsantos.dev'
const YOUTUBE_URL = 'https://youtube.lsantos.dev'
---

<!doctype html>
<html
  lang={locale}
  data-copied-label={t(locale, 'linkCopied')}
  data-quote-copied-label={t(locale, 'quoteCopied')}
  data-formula-copied-label={t(locale, 'formulaCopied')}
  data-source-copied-label={t(locale, 'sourceCopied')}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* These four snippets must stay ahead of every stylesheet: each puts a
        stored choice on <html> before the first paint. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('color-scheme')
        if (stored === 'light' || stored === 'dark') document.documentElement.setAttribute('data-theme', stored)
      } catch {}
    </script>
    <script is:inline>
      try {
        const mode = localStorage.getItem('code-theme') === 'high-contrast' ? 'high-contrast' : 'normal'
        const scheme = localStorage.getItem('color-scheme')
        if (mode === 'high-contrast') {
          const dark = scheme === 'dark' || (scheme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.setAttribute(
            'data-code-theme',
            dark ? 'github-dark-high-contrast' : 'github-light-high-contrast',
          )
        } else if (scheme === 'light' || scheme === 'dark') {
          document.documentElement.setAttribute('data-code-theme', scheme === 'dark' ? 'ayu-dark' : 'ayu-light')
        }
      } catch {}
    </script>
    {/* Before conway.ts's deferred module runs. */}
    <script is:inline>
      try {
        const motion = localStorage.getItem('motion')
        if (motion === 'reduce' || motion === 'allow') document.documentElement.setAttribute('data-motion', motion)
        if (localStorage.getItem('background-life') === '0') document.documentElement.setAttribute('data-bg-life', 'off')
      } catch {}
    </script>
    {/* Mirrors settings-panel.ts's clampFontSize since this inline snippet can't
        import it; keep both in sync or the page flashes on load. */}
    <script is:inline>
      try {
        const raw = localStorage.getItem('font-size')
        const size = raw === null ? Number.NaN : Number(raw)
        if (Number.isFinite(size)) {
          const clamped = Math.min(160, Math.max(50, size))
          const snapped = 50 + Math.round((clamped - 50) / 10) * 10
          if (snapped !== 100) document.documentElement.style.setProperty('--font-scale', String(snapped / 100))
        }
        if (localStorage.getItem('body-face') === 'sans') document.documentElement.setAttribute('data-body-face', 'sans')
      } catch {}
    </script>
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PxPlusIBMVGA8-9x16.woff" as="font" type="font/woff" crossorigin />
    {progress && <link rel="preload" href="/fonts/Literata-400-700.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href={localePath(locale, '/manifest.webmanifest')} />
    {/* A meta tag cannot read a custom property, so these read the constant. */}
    <meta name="theme-color" content={LIGHT_GROUND} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={DARK_GROUND} media="(prefers-color-scheme: dark)" />
    {/* GitHub Pages cannot set headers, so the policy has to be a meta tag. */}
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy()} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lucas Santos"
      href={localePath(locale, '/rss.xml')}
    />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      lang={locale}
      image={image}
      tags={tags}
      series={series}
      authors={authors}
      alternates={alternates}
      section={section}
      markdown={markdown}
      noindex={noindex}
    />
  </head>
  <!-- <body> is the nearest element containing both the header (whose dashes
       draw the reading progress) and the article, so --post-accent goes here. -->
  <body style={postAccent === undefined ? undefined : `--post-accent: ${postAccent}`}>
    <ConwayField />
    {progress && <ReadingProgress />}
    <a href="#main-content" class="skip-link">{t(locale, 'skipToContent')}</a>
    <BrandHeader locale={locale} home={home} alternates={alternates} />
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <div class="rule" aria-hidden="true">
        <span class="rule-edge">└─</span><span class="rule-fill">────────────────────────────────────────────────────────────────────────────────────────────────────────────────────</span><span class="rule-edge">─┘</span>
      </div>
      <div class="row">
        <p class="copyright">
          {t(locale, 'copyright', copyrightYear)} <span class="rights">{t(locale, 'rightsReserved')}</span>
        </p>
        <p class="links">
          <a href={REPO} rel="noopener" class="icon-link" aria-label={t(locale, 'githubRepo')}>
            <Github />
          </a>
          <a href={LINKEDIN_URL} rel="noopener" class="icon-link" aria-label={t(locale, 'linkedinProfile')}>
            <LinkedIn />
          </a>
          <a href={TWITTER_URL} rel="noopener" class="icon-link" aria-label={t(locale, 'twitterProfile')}>
            <Twitter />
          </a>
          <a href={YOUTUBE_URL} rel="noopener" class="icon-link" aria-label={t(locale, 'youtubeChannel')}>
            <Youtube />
          </a>
        </p>
      </div>
      <p class="version">
        {t(locale, 'version')}: <a href={commitUrl}>{version}</a>
      </p>
      {/* A licence obligation: PxPlus IBM VGA8 is CC BY-SA 4.0 and asks for
        attribution reachable from the site. Do not drop it. */}
      <p class="credits">
        <a href={localePath(locale, '/oss/')}>{t(locale, 'credits')}</a>
      </p>
    </footer>
    <MathCopy />
    <Footnotes />
    <QuoteCopy />
    <HoverPreviews locale={locale} />
    {
      analyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
    <script>
      import { copyWithToast } from '../scripts/copy-toast'

      document.addEventListener('click', (event) => {
        const anchor = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-copy-link]')
        if (anchor === null) return
        void copyWithToast(anchor.href)
      })
    </script>
    <script is:inline define:vars={{ commitShort }}>
      const isLocal = ['localhost', '127.0.0.1', '[::1]', '::1'].includes(location.hostname)
      if ('serviceWorker' in navigator && isLocal) {
        navigator.serviceWorker
          .getRegistrations()
          .then((registrations) => {
            for (const registration of registrations) registration.unregister()
          })
          .catch(() => {})
      }
      if ('serviceWorker' in navigator && !isLocal) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js?v=' + commitShort).catch(() => {})
        })
      }
    </script>
  </body>
</html>

