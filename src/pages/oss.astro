---
import BaseLayout from '../layouts/BaseLayout.astro'
import CreditList from '../components/CreditList.astro'
import { t } from '../i18n/ui'
---

<BaseLayout
  title={`${t('pt', 'ossTitle')} | Lucas Santos`}
  description={t('pt', 'ossDescription')}
  alternates={[
    { lang: 'pt-BR', href: new URL('/oss/', Astro.site).href },
    { lang: 'en', href: new URL('/en/oss/', Astro.site).href },
  ]}
>
  <h1>{t('pt', 'ossTitle')}</h1>
  <p class="intro">{t('pt', 'ossIntro')}</p>
  <CreditList locale="pt" />
</BaseLayout>

<style>
  .intro {
    margin-block-end: 2.5rem;
    color: var(--muted);
  }
</style>
