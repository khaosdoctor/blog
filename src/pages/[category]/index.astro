---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'
import { getPublishedPosts } from '../../lib/posts'
import { categoryDescription } from '../../lib/categories'
import { getCategories } from '../../lib/taxonomy'
import { HREFLANG, localePath, LOCALES, t } from '../../i18n/ui'

// Section index pages live at /{category}/, the same shape as a post URL.
// Astro gives this dynamic route priority over the [...slug] rest route, so the
// only real hazard is a category named exactly like a post: fail the build
// instead of silently shadowing an article.
export const getStaticPaths = (async () => {
  const [categories, posts] = await Promise.all([getCategories(), getPublishedPosts()])
  const slugs = new Set(posts.map((post) => post.id))
  for (const category of categories.keys()) {
    if (slugs.has(category)) {
      throw new Error(
        `Category "${category}" collides with a post of the same slug. Rename the category or the post.`,
      )
    }
  }
  // Which languages have a section index for each category. A section page only
  // exists in a language that has a post in it, so the alternates (and with
  // them the language switcher) are built from that rather than assumed.
  const languages = await Promise.all(
    LOCALES.map(async (locale) => [locale, await getPublishedPosts(locale)] as const),
  )
  const sectionsByLocale = languages.map(
    ([locale, localePosts]) => [locale, new Set(localePosts.map((post) => post.data.category))] as const,
  )
  return [...categories.entries()].map(([category, categoryPosts]) => ({
    params: { category },
    props: {
      category,
      posts: categoryPosts,
      languages: sectionsByLocale.filter(([, sections]) => sections.has(category)).map(([locale]) => locale),
    },
  }))
}) satisfies GetStaticPaths

const { category, posts, languages } = Astro.props
const alternates = languages.map((locale) => ({
  lang: HREFLANG[locale],
  href: new URL(localePath(locale, `/${category}/`), Astro.site).href,
}))
// A written description when there is one, otherwise the generated sentence.
const described = categoryDescription(category)
const description = described ?? t('pt', 'sectionDescription', category)
---

<BaseLayout
  title={`${category} | Lucas Santos`}
  description={description}
  alternates={alternates}
  section={{ name: category, url: `/${category}/` }}
>
  <h1>{category}</h1>
  {described !== null && <p class="about">{described}</p>}
  <p class="count">
    {posts.length} {t('pt', posts.length === 1 ? 'article' : 'articles')}
  </p>
  <PostList posts={posts} />
</BaseLayout>

<style>
  /* The decided subtitle face, at a whole 16px: see --font-subtitle. */
  .about {
    margin-block: 0.5rem 1rem;
    color: var(--muted);
    max-inline-size: var(--measure);
    font-family: var(--font-subtitle);
    font-size: 16px;
    line-height: 1.5;
  }

  .count {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
  }
</style>
