---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostList from '../components/PostList.astro'
import Pagination from '../components/Pagination.astro'
import { getPublishedPosts, LIST_PAGE_SIZE } from '../lib/posts'
import { t } from '../i18n/ui'

// [...page] rather than [page]: paginate() only maps the first page to an
// undefined param for a rest param, so page 1 stays the bare "/" and a plain
// [page] segment would have put it at /1/ instead.
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts()
  return paginate(posts, { pageSize: LIST_PAGE_SIZE })
}) satisfies GetStaticPaths

const { page } = Astro.props
const title = page.currentPage > 1 ? `Lucas Santos | página ${page.currentPage}` : 'Lucas Santos'
---

<BaseLayout
  title={title}
  description={t('pt', 'homeDescription')}
  alternates={[
    { lang: 'pt-BR', href: new URL('/', Astro.site).href },
    { lang: 'en', href: new URL('/en/', Astro.site).href },
  ]}
>
  <h1 class="listing-heading">
    {t('pt', 'navPosts')} <span class="page-count">[{page.total}]</span>
  </h1>
  <PostList posts={page.data} />
  <Pagination page={page} basePath="/" locale="pt" />
</BaseLayout>

