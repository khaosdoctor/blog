---
// The English half of the series index (see src/pages/series/index.astro for
// the Portuguese one).
//
// This page builds its own list rather than borrowing the Portuguese one:
// getSeries('en') groups the English posts by the `series` each translation
// carries in its own frontmatter, so the count beside a title is how many parts
// exist in English and every link goes to /en/series/<name>/, which
// src/pages/en/series/[name].astro builds. Nothing here sends an English reader
// into the Portuguese tree.
import BaseLayout from '../../../layouts/BaseLayout.astro'
import SeriesList from '../../../components/SeriesList.astro'
import { getSeries, seriesTitle } from '../../../lib/taxonomy'
import { HREFLANG, t } from '../../../i18n/ui'

const series = [...(await getSeries('en')).entries()]
  .filter(([, posts]) => posts.length > 1)
  .map(([slug, posts]) => ({ slug, title: seriesTitle(slug, posts), posts }))

const alternates = [
  { lang: HREFLANG.pt, href: new URL('/series/', Astro.site).href },
  { lang: HREFLANG.en, href: new URL('/en/series/', Astro.site).href },
]
---

<BaseLayout
  title={`${t('en', 'allSeries')} | Lucas Santos`}
  description={t('en', 'seriesIntro')}
  lang="en"
  alternates={alternates}
>
  <h1 class="listing-heading">
    {t('en', 'allSeries')} <span class="page-count">[{series.length}]</span>
  </h1>
  <SeriesList entries={series} locale="en" />
</BaseLayout>

