---
// The English per-series page (src/pages/series/[name].astro is the
// Portuguese one), built from getSeries('en'): English parts, English URLs.
// A series with fewer than two English parts gets no page here, the same
// rule the Portuguese route has always applied to itself.
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostList from '../../../components/PostList.astro'
import { getSeries, seriesTitle } from '../../../lib/taxonomy'
import { HREFLANG, t } from '../../../i18n/ui'

export const getStaticPaths = (async () => {
  // The Portuguese map only says whether the Portuguese counterpart exists,
  // which decides whether the switcher has one to offer. A series written in
  // English first would have none.
  const [series, portuguese] = await Promise.all([getSeries('en'), getSeries()])
  return [...series.entries()]
    .filter(([, posts]) => posts.length > 1)
    .map(([slug, posts]) => ({
      params: { name: slug },
      props: {
        slug,
        name: seriesTitle(slug, posts),
        posts,
        hasPortuguese: (portuguese.get(slug)?.length ?? 0) > 1,
      },
    }))
}) satisfies GetStaticPaths

const { slug, name, posts, hasPortuguese } = Astro.props

const alternates = [
  ...(hasPortuguese ? [{ lang: HREFLANG.pt, href: new URL(`/series/${slug}/`, Astro.site).href }] : []),
  { lang: HREFLANG.en, href: new URL(`/en/series/${slug}/`, Astro.site).href },
]
---

<BaseLayout
  title={`LS: ${name}`}
  description={t('en', 'seriesDescription', name)}
  lang="en"
  alternates={alternates}
>
  <p class="kicker listing-heading">{t('en', 'series')}</p>
  <h1 class="listing-heading">
    {name} <span class="page-count">[{posts.length}]</span>
  </h1>
  <PostList posts={posts} />
</BaseLayout>
