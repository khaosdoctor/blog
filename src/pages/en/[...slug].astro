---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import { Vimeo, YouTube } from 'astro-embed'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Authors from '../../components/Authors.astro'
import Bookmark from '../../components/Bookmark.astro'
import CoverHero from '../../components/CoverHero.astro'
import HoverPreviews from '../../components/HoverPreviews.astro'
import HtmlLab from '../../components/HtmlLab.astro'
import LabDemo from '../../components/LabDemo.astro'
import LangBanner from '../../components/LangBanner.astro'
import MarginNote from '../../components/MarginNote.astro'
import MissingImage from '../../components/MissingImage.astro'
import PostToc from '../../components/PostToc.astro'
import RawEmbed from '../../components/RawEmbed.astro'
import ReadingTime from '../../components/ReadingTime.astro'
import SeriesToc from '../../components/SeriesToc.astro'
import Sidenote from '../../components/Sidenote.astro'
import SpeakerDeck from '../../components/SpeakerDeck.astro'
import Spotify from '../../components/Spotify.astro'
import Tweet from '../../components/Tweet.astro'
import Video from '../../components/Video.astro'
import { parseAuthors } from '../../lib/authors'
import { coverTone } from '../../lib/cover'
import { buildSeriesMap, chipColor, getSeriesNavigation } from '../../lib/taxonomy'
import { HREFLANG, t } from '../../i18n/ui'
import { folderOf, formatDate, getPublishedByFolder, getPublishedPosts, slugOf, SOURCE_LANG, urlOf } from '../../lib/posts'

const mdxComponents = {
  Bookmark,
  HtmlLab,
  LabDemo,
  MarginNote,
  MissingImage,
  RawEmbed,
  Sidenote,
  SpeakerDeck,
  Spotify,
  Tweet,
  Video,
  Vimeo,
  YouTube,
}

// English lives under /en/, Portuguese stays unprefixed at the root so every
// URL Ghost ever published keeps working. The slug is this file's own, so an
// English article reads as English in the address bar.
export const getStaticPaths = (async () => {
  const [posts, byFolder] = await Promise.all([getPublishedPosts('en'), getPublishedByFolder()])
  // Built from the English posts alone, so previous/next inside a series can
  // only ever reach another English part, and "part N of M" counts what exists
  // in English rather than what exists in Portuguese.
  const seriesMap = buildSeriesMap(posts)
  return posts.map((post) => {
    // Every language of this article is a file in the same folder.
    const siblings = byFolder.get(folderOf(post)) ?? [post]
    const source = siblings.find((entry) => entry.data.lang === SOURCE_LANG)
    return {
      params: { slug: slugOf(post) },
      props: {
        post,
        series: getSeriesNavigation(post, seriesMap),
        // The original to link back to. A translation of a post that is still a
        // draft has nowhere to point, so the banner has to cope with null.
        sourcePath: source === undefined ? null : urlOf(source),
        alternates: siblings.map((entry) => ({
          lang: HREFLANG[entry.data.lang],
          path: urlOf(entry),
        })),
      },
    }
  })
}) satisfies GetStaticPaths

const { post, series, sourcePath, alternates: folderAlternates } = Astro.props
// Same render() the Portuguese page makes, read for the same two things: the
// content, and the exact reading time remark-reading-time.mjs computed for it.
// This page went without one until the cover's meta line started carrying the
// reading time, at which point an English post would have drawn a chip and
// nothing beside it.
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const readingTime = remarkPluginFrontmatter.readingTime as number | undefined
const alternates = folderAlternates.map(({ lang, path }) => ({
  lang,
  href: new URL(path, Astro.site).href,
}))
const authorName = parseAuthors(post.data.authors)[0]?.name ?? 'Lucas Santos'

/**
 * The post's own colour: whatever brand its cover drew, read straight off the
 * cover's own derivation (coverTone, lib/cover.ts) so bold and italic inside
 * the article cannot come out a different colour from the card at the top of
 * the page. Links do NOT read this, they follow the day colour
 * (prose/links.css). The English translation has its own slug and so its own
 * cover colour, same as it has its own cover.
 *
 * Handed to the layout rather than written onto <article> here, which is where
 * it used to sit: the header now draws the reading progress in this same
 * colour (ReadingProgress.astro), and the header is not inside the article, so
 * the property has to be written on an element that contains both. BaseLayout
 * puts it on <body>; the article inherits it exactly as before.
 */
const postAccent = coverTone(slugOf(post)).token
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  lang="en"
  type="article"
  publishedAt={post.data.pubDate}
  updatedAt={post.data.updatedDate}
  tags={post.data.tags}
  series={post.data.series}
  authors={post.data.authors}
  section={{ name: post.data.category, url: `/en/${post.data.category}/` }}
  alternates={alternates}
  markdown={new URL(`${Astro.url.pathname}index.md`, Astro.site).href}
  noindex={post.data.noindex}
  progress
  postAccent={postAccent}
>
  {/* The outline, which this page never rendered: a reader of a translated
      post got no way to see its shape or jump inside it, purely because this
      file was written without the component rather than by any decision. The
      headings it reads are the translated ones, from this post's own render(),
      so the outline is in English like the text it points at. */}
  <PostToc headings={headings} locale="en" />
  <article>
    <CoverHero
      slug={slugOf(post)}
      title={post.data.title}
      category={post.data.category}
      pubDate={post.data.pubDate}
      lang="en"
      authorName={authorName}
    />
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'en')}</time>
      <span aria-hidden="true">·</span>
      <a
        href={`/en/${post.data.category}/`}
        class="chip"
        style={`--chip-color: ${chipColor(post.data.category)}`}
      >
        {post.data.category}
      </a>
      {
        readingTime !== undefined && (
          <>
            <span aria-hidden="true">·</span>
            <ReadingTime minutes={readingTime} locale="en" />
          </>
        )
      }
    </p>
    <Authors authors={post.data.authors} locale={'en'} />
    {
      post.data.machineTranslated && sourcePath !== null && (
        <LangBanner lang="en" originalHref={sourcePath} />
      )
    }
    {/* The series box and the line under it, both of which this page used to
        leave out: a reader of a translated part was told nothing about the
        series it belongs to. Every link either draws comes from the English
        map, so it points inside /en/. */}
    {post.data.series && <SeriesToc series={post.data.series} current={post.id} locale="en" />}
    {
      series !== null && (
        <p class="series">
          {t('en', 'partOfSeriesNamed', series.index, series.total)}{' '}
          <a href={`/en/series/${series.name}/`}>{series.title}</a>
        </p>
      )
    }
    <div class="prose">
      <Content components={mdxComponents} />
    </div>
    {/* The tag row under the article, which this page never drew: a translation
        carries the same `tags:` line as its original, but there was nowhere in
        English to send a reader who clicked one, so the chips were left out
        rather than pointed at Portuguese listings. Now that /en/tags/<tag>/
        exists (src/pages/en/tags/[tag]/[...page].astro) every chip stays inside
        /en/. The tag string is the same one in both languages, so slugify()
        gives the same segment on both sides. */}
    {
      post.data.tags.length > 0 && (
        <ul class="chips">
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/en/tags/${slugify(tag)}/`} class="chip" style={`--chip-color: ${chipColor(tag)}`}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      series !== null && (
        <nav class="series-nav" aria-label={t('en', 'seriesNav')}>
          {series.previous !== null && (
            <a href={urlOf(series.previous)} rel="prev">
              ← {series.previous.data.title}
            </a>
          )}
          {series.next !== null && (
            <a href={urlOf(series.next)} rel="next" class="next">
              {series.next.data.title} →
            </a>
          )}
        </nav>
      )
    }
  </article>
  <HoverPreviews locale="en" />
</BaseLayout>

<style>
  .meta {
    display: flex;
    /* Without this the chip is a stretched flex item and its text rides at the
       top of a box as tall as the row. */
    align-items: center;
    gap: 0.5rem;
    margin-block: -0.5rem 2rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
  }
</style>
