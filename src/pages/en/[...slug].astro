---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import { Vimeo, YouTube } from 'astro-embed'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Authors from '../../components/Authors.astro'
import Bookmark from '../../components/Bookmark.astro'
import CoverHero from '../../components/CoverHero.astro'
import HoverPreviews from '../../components/HoverPreviews.astro'
import HtmlLab from '../../components/HtmlLab.astro'
import LabDemo from '../../components/LabDemo.astro'
import LangBanner from '../../components/LangBanner.astro'
import MarginNote from '../../components/MarginNote.astro'
import MissingImage from '../../components/MissingImage.astro'
import RawEmbed from '../../components/RawEmbed.astro'
import ReadingTime from '../../components/ReadingTime.astro'
import Sidenote from '../../components/Sidenote.astro'
import SpeakerDeck from '../../components/SpeakerDeck.astro'
import Spotify from '../../components/Spotify.astro'
import Tweet from '../../components/Tweet.astro'
import Video from '../../components/Video.astro'
import { parseAuthors } from '../../lib/authors'
import { coverTone } from '../../lib/cover'
import { chipColor } from '../../lib/taxonomy'
import { HREFLANG } from '../../i18n/ui'
import { folderOf, formatDate, getPublishedByFolder, getPublishedPosts, slugOf, SOURCE_LANG, urlOf } from '../../lib/posts'

const mdxComponents = {
  Bookmark,
  HtmlLab,
  LabDemo,
  MarginNote,
  MissingImage,
  RawEmbed,
  Sidenote,
  SpeakerDeck,
  Spotify,
  Tweet,
  Video,
  Vimeo,
  YouTube,
}

// English lives under /en/, Portuguese stays unprefixed at the root so every
// URL Ghost ever published keeps working. The slug is this file's own, so an
// English article reads as English in the address bar.
export const getStaticPaths = (async () => {
  const [posts, byFolder] = await Promise.all([getPublishedPosts('en'), getPublishedByFolder()])
  return posts.map((post) => {
    // Every language of this article is a file in the same folder.
    const siblings = byFolder.get(folderOf(post)) ?? [post]
    const source = siblings.find((entry) => entry.data.lang === SOURCE_LANG)
    return {
      params: { slug: slugOf(post) },
      props: {
        post,
        // The original to link back to. A translation of a post that is still a
        // draft has nowhere to point, so the banner has to cope with null.
        sourcePath: source === undefined ? null : urlOf(source),
        alternates: siblings.map((entry) => ({
          lang: HREFLANG[entry.data.lang],
          path: urlOf(entry),
        })),
      },
    }
  })
}) satisfies GetStaticPaths

const { post, sourcePath, alternates: folderAlternates } = Astro.props
// Same render() the Portuguese page makes, read for the same two things: the
// content, and the exact reading time remark-reading-time.mjs computed for it.
// This page went without one until the cover's meta line started carrying the
// reading time, at which point an English post would have drawn a chip and
// nothing beside it.
const { Content, remarkPluginFrontmatter } = await render(post)
const readingTime = remarkPluginFrontmatter.readingTime as number | undefined
const alternates = folderAlternates.map(({ lang, path }) => ({
  lang,
  href: new URL(path, Astro.site).href,
}))
const authorName = parseAuthors(post.data.authors)[0]?.name ?? 'Lucas Santos'
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  lang="en"
  type="article"
  publishedAt={post.data.pubDate}
  updatedAt={post.data.updatedDate}
  tags={post.data.tags}
  series={post.data.series}
  authors={post.data.authors}
  section={{ name: post.data.category, url: `/en/${post.data.category}/` }}
  alternates={alternates}
  markdown={new URL(`${Astro.url.pathname}index.md`, Astro.site).href}
  noindex={post.data.noindex}
  progress
>
  {/* The post's own colour: whatever brand its cover drew, read straight
      off the cover's own derivation (coverTone, lib/cover.ts) so bold and
      italic inside the article cannot come out a different colour from the
      card at the top of the page. Links do NOT read this, they follow the
      day colour (prose/links.css). The English translation has its own slug
      and so its own cover colour, same as it has its own cover. */}
  <article style={`--post-accent: ${coverTone(slugOf(post)).token}`}>
    <CoverHero
      slug={slugOf(post)}
      title={post.data.title}
      category={post.data.category}
      pubDate={post.data.pubDate}
      lang="en"
      authorName={authorName}
    />
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'en')}</time>
      <span aria-hidden="true">·</span>
      <a
        href={`/en/${post.data.category}/`}
        class="chip"
        style={`--chip-color: ${chipColor(post.data.category)}`}
      >
        {post.data.category}
      </a>
      {
        readingTime !== undefined && (
          <>
            <span aria-hidden="true">·</span>
            <ReadingTime minutes={readingTime} locale="en" />
          </>
        )
      }
    </p>
    <Authors authors={post.data.authors} locale={'en'} />
    {
      post.data.machineTranslated && sourcePath !== null && (
        <LangBanner lang="en" originalHref={sourcePath} />
      )
    }
    <div class="prose">
      <Content components={mdxComponents} />
    </div>
  </article>
  <HoverPreviews locale="en" />
</BaseLayout>

<style>
  .meta {
    display: flex;
    /* Without this the chip is a stretched flex item and its text rides at the
       top of a box as tall as the row. */
    align-items: center;
    gap: 0.5rem;
    margin-block: -0.5rem 2rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
  }
</style>
