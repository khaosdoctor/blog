---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CreditList from '../../components/CreditList.astro'
import { t } from '../../i18n/ui'
---

<BaseLayout
  title={`${t('en', 'ossTitle')} | Lucas Santos`}
  description={t('en', 'ossDescription')}
  lang="en"
  alternates={[
    { lang: 'pt-BR', href: new URL('/oss/', Astro.site).href },
    { lang: 'en', href: new URL('/en/oss/', Astro.site).href },
  ]}
>
  <h1>{t('en', 'ossTitle')}</h1>
  <p class="intro">{t('en', 'ossIntro')}</p>
  <CreditList locale="en" />
</BaseLayout>

<style>
  .intro {
    margin-block-end: 2.5rem;
    color: var(--muted);
  }
</style>
