---
// The English half of the tag index (see src/pages/tags/index.astro for the
// Portuguese one).
//
// This page builds its own list rather than borrowing the Portuguese one:
// getTags('en') groups the English posts by the tags each translation repeats
// in its own frontmatter, so the count beside a chip is how many English
// articles carry it and every link goes to /en/tags/<tag>/, which
// src/pages/en/tags/[tag]/[...page].astro builds. Nothing here sends an English
// reader into the Portuguese tree, which is what the "these exist in Portuguese
// only" notice this page used to carry apologised for; that string was the last
// use of it, so it is gone from src/i18n/ui.ts too. A tag with no English post
// is simply absent rather than linked at a page in the wrong language.
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { chipColor, getTags, slugify } from '../../../lib/taxonomy'
import { HREFLANG, t } from '../../../i18n/ui'

const tags = [...(await getTags('en')).entries()].sort(([a], [b]) => a.localeCompare(b, 'en'))

const alternates = [
  { lang: HREFLANG.pt, href: new URL('/tags/', Astro.site).href },
  { lang: HREFLANG.en, href: new URL('/en/tags/', Astro.site).href },
]
---

<BaseLayout
  title={`${t('en', 'tags')} | Lucas Santos`}
  description={t('en', 'tagsIntro')}
  lang="en"
  alternates={alternates}
>
  <h1>{t('en', 'tags')}</h1>
  <p class="intro">{t('en', 'tagsIntro')}</p>
  <ul class="chips">
    {
      tags.map(([tag, posts]) => (
        <li>
          <a href={`/en/tags/${slugify(tag)}/`} class="chip" style={`--chip-color: ${chipColor(tag)}`}>
            {tag} ({posts.length})
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .intro {
    max-inline-size: var(--measure);
    color: var(--muted);
  }

  .chips {
    margin-block-start: 1.5rem;
  }
</style>
