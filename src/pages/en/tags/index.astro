---
// The English tag index (src/pages/tags/index.astro is the Portuguese one).
// Built from getTags('en') so counts reflect English articles, every link
// stays inside /en/, and a tag with no English post is simply absent rather
// than linked at a page in the wrong language.
import BaseLayout from '../../../layouts/BaseLayout.astro'
import TagCloud from '../../../components/TagCloud.astro'
import { getTags } from '../../../lib/taxonomy'
import { HREFLANG, t } from '../../../i18n/ui'

const tags = [...(await getTags('en')).entries()]
  .sort(([a], [b]) => a.localeCompare(b, 'en'))
  .map(([name, posts]) => ({ name, count: posts.length }))

const alternates = [
  { lang: HREFLANG.pt, href: new URL('/tags/', Astro.site).href },
  { lang: HREFLANG.en, href: new URL('/en/tags/', Astro.site).href },
]
---

<BaseLayout
  title={`${t('en', 'tags')} | Lucas Santos`}
  description={t('en', 'tagsIntro')}
  lang="en"
  alternates={alternates}
>
  <TagCloud locale="en" tags={tags} />
</BaseLayout>
