---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate, getPublishedPosts, urlOf } from '../../lib/posts'
import { t } from '../../i18n/ui'

const posts = await getPublishedPosts('en')
---

<BaseLayout
  title="Lucas Santos"
  description={t('en', 'homeDescription')}
  lang="en"
  alternates={[
    { lang: 'pt-BR', href: new URL('/', Astro.site).href },
    { lang: 'en', href: new URL('/en/', Astro.site).href },
  ]}
>
  <h1 class="visually-hidden">Lucas Santos</h1>
  <p class="note">
    {t('en', 'translatedIndexNotice')} <a href="/">{t('en', 'readOriginals')}</a>.
  </p>
  <ul class="posts">
    {
      posts.slice(0, 30).map((post) => (
        <li>
          <a href={urlOf(post)}>{post.data.title}</a>
          <p class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'en')}</time>
          </p>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
  {posts.length === 0 && <p>{t('en', 'noTranslatedPosts')}</p>}
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .note {
    margin-block-end: 2.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .posts {
    padding: 0;
    list-style: none;
  }

  .posts li + li {
    margin-block-start: 2.5rem;
  }

  .posts > li > a {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .meta {
    margin-block: 0.2rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
  }
</style>
