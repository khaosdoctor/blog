---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostList from '../../../components/PostList.astro'
import Pagination from '../../../components/Pagination.astro'
import { LIST_PAGE_SIZE } from '../../../lib/posts'
import { categoryDescription } from '../../../lib/categories'
import { categoryLocales, getCategories } from '../../../lib/taxonomy'
import { HREFLANG, localePath, LOCALES, t } from '../../../i18n/ui'

// The English half of the section pages. Built from the English posts alone,
// so a section with no translated post yet simply has no English page rather
// than an empty one, and a post's category chip never drops the reader into
// the other language.
export const getStaticPaths = (async ({ paginate }) => {
  const [byCategory, sectionsByLocale] = await Promise.all([getCategories('en'), categoryLocales()])
  return [...byCategory.entries()].flatMap(([category, categoryPosts]) =>
    paginate(categoryPosts, {
      pageSize: LIST_PAGE_SIZE,
      params: { category },
      props: {
        category,
        languages: sectionsByLocale.filter(([, sections]) => sections.has(category)).map(([locale]) => locale),
      },
    }),
  )
}) satisfies GetStaticPaths

const { category, languages, page } = Astro.props
const alternates = languages.map((locale: (typeof LOCALES)[number]) => ({
  lang: HREFLANG[locale],
  href: new URL(localePath(locale, `/${category}/`), Astro.site).href,
}))
const described = categoryDescription(category, 'en')
const description = described ?? t('en', 'sectionDescription', category)
const title = page.currentPage > 1 ? `LS: ${category} | page ${page.currentPage}` : `LS: ${category}`
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  alternates={alternates}
  section={{ name: category, url: `/en/${category}/` }}
>
  <h1 class="listing-heading">
    {category} <span class="page-count">[{page.total}]</span>
  </h1>
  {described !== null && <p class="about listing-heading">{described}</p>}
  <PostList posts={page.data} />
  <Pagination page={page} basePath={`/en/${category}/`} locale="en" />
</BaseLayout>
