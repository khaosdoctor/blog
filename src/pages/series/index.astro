---
// The series index: every series on the site, linking to its own
// /series/<name>/ page (src/pages/series/[name].astro). That page only
// generates a route for a series with more than one post (a "series" of one
// is not one yet), so this index applies the same filter, or it would link to
// a page that does not exist.
//
// getSeries() with no argument is the Portuguese map, which is the right one
// for this tree: src/pages/en/series/index.astro is the English half and builds
// its own list out of getSeries('en'), so neither index lists a series the
// reader's own language cannot show.
import BaseLayout from '../../layouts/BaseLayout.astro'
import SeriesList from '../../components/SeriesList.astro'
import { getSeries, seriesTitle } from '../../lib/taxonomy'
import { HREFLANG, t } from '../../i18n/ui'

const series = [...(await getSeries()).entries()]
  .filter(([, posts]) => posts.length > 1)
  .map(([slug, posts]) => ({ slug, title: seriesTitle(slug, posts), posts }))

const alternates = [
  { lang: HREFLANG.pt, href: new URL('/series/', Astro.site).href },
  { lang: HREFLANG.en, href: new URL('/en/series/', Astro.site).href },
]
---

<BaseLayout title={`${t('pt', 'allSeries')} | Lucas Santos`} description={t('pt', 'seriesIntro')} alternates={alternates}>
  <h1>{t('pt', 'allSeries')}</h1>
  <p class="intro">{t('pt', 'seriesIntro')}</p>
  <SeriesList entries={series} locale="pt" />
</BaseLayout>

<style>
  .intro {
    max-inline-size: var(--measure);
    color: var(--muted);
  }
</style>
