---
// The Portuguese per-series page; src/pages/en/series/[name].astro is the
// English twin. `series:` in the frontmatter is the same word in every
// language, so switching language is a prefix change: /series/grpc/ and
// /en/series/grpc/. Only the display title and the parts themselves differ.
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'
import { getSeries, seriesTitle } from '../../lib/taxonomy'
import { HREFLANG, t } from '../../i18n/ui'

export const getStaticPaths = (async () => {
  // The English map only says whether the English page for this series is
  // built at all: the switcher must not offer a URL that route never emits,
  // which is any series with fewer than two translated parts.
  const [series, english] = await Promise.all([getSeries(), getSeries('en')])
  return [...series.entries()]
    .filter(([, posts]) => posts.length > 1)
    .map(([slug, posts]) => ({
      params: { name: slug },
      props: {
        slug,
        name: seriesTitle(slug, posts),
        posts,
        hasEnglish: (english.get(slug)?.length ?? 0) > 1,
      },
    }))
}) satisfies GetStaticPaths

const { slug, name, posts, hasEnglish } = Astro.props

const alternates = [
  { lang: HREFLANG.pt, href: new URL(`/series/${slug}/`, Astro.site).href },
  ...(hasEnglish ? [{ lang: HREFLANG.en, href: new URL(`/en/series/${slug}/`, Astro.site).href }] : []),
]
---

<BaseLayout
  title={`LS: ${name}`}
  description={t('pt', 'seriesDescription', name)}
  alternates={alternates}
>
  <p class="kicker listing-heading">{t('pt', 'series')}</p>
  <h1 class="listing-heading">
    {name} <span class="page-count">[{posts.length}]</span>
  </h1>
  <PostList posts={posts} />
</BaseLayout>
