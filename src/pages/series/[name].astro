---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostList from '../../components/PostList.astro'
import { getSeries, seriesTitle } from '../../lib/taxonomy'
import { t } from '../../i18n/ui'

export const getStaticPaths = (async () => {
  const series = await getSeries()
  return [...series.entries()]
    .filter(([, posts]) => posts.length > 1)
    .map(([slug, posts]) => ({ params: { name: slug }, props: { name: seriesTitle(slug, posts), posts } }))
}) satisfies GetStaticPaths

const { name, posts } = Astro.props
---

<BaseLayout title={`${name} | Lucas Santos`} description={t('pt', 'seriesDescription', name)}>
  <p class="kicker">{t('pt', 'series')}</p>
  <h1>{name}</h1>
  <PostList posts={posts} />
</BaseLayout>

<style>
  .kicker {
    margin-block-end: 0;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin-block-start: 0.2rem;
  }
</style>
