---
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import { Vimeo, YouTube } from 'astro-embed'
import BaseLayout from '../layouts/BaseLayout.astro'
import Bookmark from '../components/Bookmark.astro'
import Epigraph from '../components/Epigraph.astro'
import Figure from '../components/Figure.astro'
import HoverPreviews from '../components/HoverPreviews.astro'
import MarginNote from '../components/MarginNote.astro'
import MissingImage from '../components/MissingImage.astro'
import RawEmbed from '../components/RawEmbed.astro'
import SeriesToc from '../components/SeriesToc.astro'
import Sidenote from '../components/Sidenote.astro'
import Tweet from '../components/Tweet.astro'
import Video from '../components/Video.astro'
import { formatDate, getPublishedPosts } from '../lib/posts'
import { buildSeriesMap, getSeriesNavigation, slugify } from '../lib/taxonomy'
import { t } from '../i18n/ui'

/**
 * Injected into every post so migrated MDX can use these tags with no import
 * lines. 246 files stay clean markdown, and the component set can be renamed
 * here in one place instead of across the content.
 */
const mdxComponents = {
  Bookmark,
  Epigraph,
  Figure,
  MarginNote,
  MissingImage,
  RawEmbed,
  Sidenote,
  Tweet,
  Video,
  Vimeo,
  YouTube,
}

// Flat URLs: /{slug}/ exactly as Ghost had them, so moving a post between
// sections only ever changes its `category`, never its URL.
//
// Series navigation and hreflang translations both used to be looked up once
// per post page (an O(N) collection fetch each, N times over). Build the
// shared indices here instead, once, and hand each post its own slice.
export const getStaticPaths = (async () => {
  const [posts, allTranslations] = await Promise.all([
    getPublishedPosts(),
    getCollection('translated'),
  ])
  const seriesMap = buildSeriesMap(posts)
  const translationsByPost = new Map<string, typeof allTranslations>()
  for (const entry of allTranslations) {
    const current = translationsByPost.get(entry.data.translationOf) ?? []
    current.push(entry)
    translationsByPost.set(entry.data.translationOf, current)
  }
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      series: getSeriesNavigation(post, seriesMap),
      translations: translationsByPost.get(post.id) ?? [],
    },
  }))
}) satisfies GetStaticPaths

const { post, series, translations } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)
const readingTime = remarkPluginFrontmatter.readingTime as number | undefined

const self = new URL(Astro.url.pathname, Astro.site).href
const alternates = [
  { lang: 'pt-BR', href: self },
  ...translations.map((entry) => ({
    lang: entry.data.lang,
    href: new URL(`/${entry.data.lang}/${post.id}/`, Astro.site).href,
  })),
]
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  lang={post.data.lang}
  type="article"
  publishedAt={post.data.pubDate}
  updatedAt={post.data.updatedDate}
  tags={post.data.tags}
  series={post.data.series}
  image={post.data.heroImage?.src}
  alternates={alternates}
  section={{ name: post.data.category, url: `/${post.data.category}/` }}
  markdown={new URL(`${Astro.url.pathname}index.md`, Astro.site).href}
  noindex={post.data.noindex}
>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate, post.data.lang)}
      </time>
      <span aria-hidden="true">·</span>
      <a href={`/${post.data.category}/`}>{post.data.category}</a>
      {
        readingTime !== undefined && (
          <>
            <span aria-hidden="true">·</span>
            <span>{readingTime} min</span>
          </>
        )
      }
    </p>
    {
      post.data.series && <SeriesToc series={post.data.series} current={post.id} locale={post.data.lang} />
    }
    {
      series !== null && (
        <p class="series">
          {t('pt', 'partOfSeriesNamed', series.index, series.total)}{' '}
          <a href={`/series/${series.name}/`}>{series.title}</a>
        </p>
      )
    }
    {
      post.data.epigraph && (
        <blockquote class="epigraph">
          <p>{post.data.epigraph}</p>
          {post.data.epigraphCite && <cite>{post.data.epigraphCite}</cite>}
        </blockquote>
      )
    }
    <Content components={mdxComponents} />
    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/tags/${slugify(tag)}/`}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
    {
      series !== null && (
        <nav class="series-nav" aria-label={t('pt', 'seriesNav')}>
          {series.previous !== null && (
            <a href={`/${series.previous.id}/`} rel="prev">
              ← {series.previous.data.title}
            </a>
          )}
          {series.next !== null && (
            <a href={`/${series.next.id}/`} rel="next" class="next">
              {series.next.data.title} →
            </a>
          )}
        </nav>
      )
    }
  </article>
  <HoverPreviews locale="pt" />
</BaseLayout>

<style>
  .meta {
    display: flex;
    gap: 0.5rem;
    margin-block: -0.5rem 2.5rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
  }

  .epigraph {
    margin-inline: 0;
    padding-inline-start: 1.2rem;
    border-inline-start: 2px solid var(--rule);
    color: var(--muted);
    font-style: italic;
  }

  .epigraph cite {
    display: block;
    font-size: 0.85rem;
    font-style: normal;
  }

  .series {
    padding: 0.6rem 0.9rem;
    border-inline-start: 3px solid var(--accent);
    background: color-mix(in oklab, var(--accent) 8%, transparent);
    font-size: 0.9rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 3rem;
    padding: 0;
    list-style: none;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
  }

  .tags a {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }

  .tags a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .series-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
    font-size: 0.9rem;
  }

  .series-nav .next {
    margin-inline-start: auto;
    text-align: end;
  }
</style>
