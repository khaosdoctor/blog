---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import { Vimeo, YouTube } from 'astro-embed'
import BaseLayout from '../layouts/BaseLayout.astro'
import Authors from '../components/Authors.astro'
import Bookmark from '../components/Bookmark.astro'
import DateCopy from '../components/DateCopy.astro'
import HoverPreviews from '../components/HoverPreviews.astro'
import HtmlLab from '../components/HtmlLab.astro'
import LabDemo from '../components/LabDemo.astro'
import MarginNote from '../components/MarginNote.astro'
import MissingImage from '../components/MissingImage.astro'
import PostToc from '../components/PostToc.astro'
import RawEmbed from '../components/RawEmbed.astro'
import SeriesToc from '../components/SeriesToc.astro'
import Sidenote from '../components/Sidenote.astro'
import SpeakerDeck from '../components/SpeakerDeck.astro'
import Spotify from '../components/Spotify.astro'
import Tweet from '../components/Tweet.astro'
import Video from '../components/Video.astro'
import { folderOf, getPublishedByFolder, getPublishedPosts, slugOf, urlOf } from '../lib/posts'
import { buildSeriesMap, chipColor, getSeriesNavigation, slugify } from '../lib/taxonomy'
import { HREFLANG, t } from '../i18n/ui'

/**
 * Injected into every post so migrated MDX can use these tags with no import
 * lines. 246 files stay clean markdown, and the component set can be renamed
 * here in one place instead of across the content.
 */
const mdxComponents = {
  Bookmark,
  HtmlLab,
  LabDemo,
  MarginNote,
  MissingImage,
  RawEmbed,
  Sidenote,
  SpeakerDeck,
  Spotify,
  Tweet,
  Video,
  Vimeo,
  YouTube,
}

// Flat URLs: /{slug}/ exactly as Ghost had them, so moving a post between
// sections only ever changes its `category`, never its URL.
//
// Series navigation and hreflang alternates both used to be looked up once per
// post page (an O(N) collection fetch each, N times over). Build the shared
// indices here instead, once, and hand each post its own slice.
export const getStaticPaths = (async () => {
  const [posts, byFolder] = await Promise.all([getPublishedPosts(), getPublishedByFolder()])
  const seriesMap = buildSeriesMap(posts)
  return posts.map((post) => ({
    params: { slug: slugOf(post) },
    // Alternates come from the post's own folder: every language of the same
    // article is a file in there, so a post with no translation yields a list
    // of one, itself.
    props: {
      post,
      series: getSeriesNavigation(post, seriesMap),
      alternates: (byFolder.get(folderOf(post)) ?? [post]).map((entry) => ({
        lang: HREFLANG[entry.data.lang],
        path: urlOf(entry),
      })),
    },
  }))
}) satisfies GetStaticPaths

const { post, series, alternates: folderAlternates } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const readingTime = remarkPluginFrontmatter.readingTime as number | undefined

const alternates = folderAlternates.map(({ lang, path }) => ({
  lang,
  href: new URL(path, Astro.site).href,
}))
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  lang={post.data.lang}
  type="article"
  publishedAt={post.data.pubDate}
  updatedAt={post.data.updatedDate}
  tags={post.data.tags}
  series={post.data.series}
  authors={post.data.authors}
  image={post.data.heroImage?.src}
  alternates={alternates}
  section={{ name: post.data.category, url: `/${post.data.category}/` }}
  markdown={new URL(`${Astro.url.pathname}index.md`, Astro.site).href}
  noindex={post.data.noindex}
  progress
>
  <PostToc headings={headings} locale={post.data.lang} />
  {/* The hover-invert colour every link inside gets (prose/links.css),
      hashed from the slug the same way chipColor already colours tag
      chips: the same post is always the same colour, nothing to keep
      in step with the content. */}
  <article style={`--post-accent: ${chipColor(slugOf(post))}`}>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <DateCopy date={post.data.pubDate} lang={post.data.lang} />
      <span aria-hidden="true">·</span>
      <a
        href={`/${post.data.category}/`}
        class="chip"
        style={`--chip-color: ${chipColor(post.data.category)}`}
      >
        {post.data.category}
      </a>
      {
        readingTime !== undefined && (
          <>
            <span aria-hidden="true">·</span>
            <span>{readingTime} min</span>
          </>
        )
      }
    </p>
    <Authors authors={post.data.authors} locale={post.data.lang} />
    {
      post.data.series && <SeriesToc series={post.data.series} current={post.id} locale={post.data.lang} />
    }
    {
      series !== null && (
        <p class="series">
          {t(post.data.lang, 'partOfSeriesNamed', series.index, series.total)}{' '}
          <a href={`/series/${series.name}/`}>{series.title}</a>
        </p>
      )
    }
    <div class="prose">
      <Content components={mdxComponents} />
    </div>
    {
      post.data.tags.length > 0 && (
        <ul class="chips">
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/tags/${slugify(tag)}/`} class="chip" style={`--chip-color: ${chipColor(tag)}`}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      series !== null && (
        <nav class="series-nav" aria-label={t(post.data.lang, 'seriesNav')}>
          {series.previous !== null && (
            <a href={urlOf(series.previous)} rel="prev">
              ← {series.previous.data.title}
            </a>
          )}
          {series.next !== null && (
            <a href={urlOf(series.next)} rel="next" class="next">
              {series.next.data.title} →
            </a>
          )}
        </nav>
      )
    }
  </article>
  <HoverPreviews locale={post.data.lang} />
</BaseLayout>

<style>
  .meta {
    display: flex;
    /* Without this the chip is a stretched flex item and its text rides at the
       top of a box as tall as the row. */
    align-items: center;
    gap: 0.5rem;
    margin-block: -0.5rem 2.5rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
  }

  .series {
    padding: 0.6rem 0.9rem;
    border-inline-start: 3px solid var(--accent);
    background: color-mix(in oklab, var(--accent) 8%, transparent);
    font-size: 0.9rem;
  }

  .series-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
    font-size: 0.9rem;
  }

  .series-nav .next {
    margin-inline-start: auto;
    text-align: end;
  }
</style>
