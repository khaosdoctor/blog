---
import PostList from '../components/PostList.astro'
import { LOCALES, localePath, SOURCE_LOCALE, t } from '../i18n/ui'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getListedPosts } from '../lib/posts'

const recent = (await getListedPosts()).slice(0, 5)
---

{/* One 404 answers for the whole host, every language prefix included, so all
    of them have to be rendered here and the script below keeps one. */}
<BaseLayout
  title={`LS: ${t(SOURCE_LOCALE, 'notFoundTitle')}`}
  description={t(SOURCE_LOCALE, 'notFoundBody')}
  lang={SOURCE_LOCALE}
>
  <h1 class="listing-heading">404</h1>
  <div class="listing-heading">
    {LOCALES.map((locale) => (
      <div data-lang={locale} lang={locale}>
        <p>{t(locale, 'notFoundBody')}</p>
        <p><a href={localePath(locale, '/search/')}>{t(locale, 'searchLabel')}</a></p>
        <p class="recent">{t(locale, 'notFoundRecent')}</p>
      </div>
    ))}
  </div>
  <PostList posts={recent} />
</BaseLayout>

<script>
  import { asLocale } from '../i18n/ui'
  import { readStorage } from '../lib/storage'

  const stored = readStorage('lang')
  const top = (stored ?? navigator.languages?.[0] ?? navigator.language ?? '').toLowerCase().split('-')[0]
  const wanted = asLocale(top)
  for (const block of document.querySelectorAll<HTMLElement>('[data-lang]')) {
    if (block.dataset.lang !== wanted) block.remove()
  }
</script>
