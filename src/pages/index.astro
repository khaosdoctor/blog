---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostList from '../components/PostList.astro'
import { getPublishedPosts } from '../lib/posts'
import { getCategories } from '../lib/taxonomy'
import { t } from '../i18n/ui'

const [posts, categories] = await Promise.all([getPublishedPosts(), getCategories()])
const sections = [...categories.entries()].sort((a, b) => b[1].length - a[1].length)
const latest = posts.slice(0, 30)
---

<BaseLayout
  title="Lucas Santos"
  description={t('pt', 'homeDescription')}
  alternates={[
    { lang: 'pt-BR', href: new URL('/', Astro.site).href },
    { lang: 'en', href: new URL('/en/', Astro.site).href },
  ]}
>
  <h1 class="visually-hidden">Lucas Santos</h1>
  <nav class="sections" aria-label={t('pt', 'sections')}>
    {
      sections.map(([category, categoryPosts]) => (
        <a href={`/${category}/`}>
          {category} <span class="count">{categoryPosts.length}</span>
        </a>
      ))
    }
  </nav>
  <PostList posts={latest} />
  <p class="more">
    {t('pt', 'showingLatest', latest.length, posts.length)}
    {' '}
    <a href="/search/">{t('pt', 'searchLabel')}</a>.
  </p>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 3rem;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.85rem;
  }

  .sections a {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
  }

  .sections a:hover {
    border-color: var(--accent);
  }

  .count {
    color: var(--muted);
  }

  .more {
    margin-block-start: 3rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
