---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostList from '../components/PostList.astro'
import { getPublishedPosts } from '../lib/posts'
import { t } from '../i18n/ui'

const posts = await getPublishedPosts()
const latest = posts.slice(0, 30)
---

<BaseLayout
  title="Lucas Santos"
  description={t('pt', 'homeDescription')}
  alternates={[
    { lang: 'pt-BR', href: new URL('/', Astro.site).href },
    { lang: 'en', href: new URL('/en/', Astro.site).href },
  ]}
>
  <h1 class="visually-hidden">Lucas Santos</h1>
  <PostList posts={latest} />
  <p class="more">
    {t('pt', 'showingLatest', latest.length, posts.length)}
    {' '}
    <a href="/search/">{t('pt', 'searchLabel')}</a>.
  </p>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .more {
    margin-block-start: 3rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
