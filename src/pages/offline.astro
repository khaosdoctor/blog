---
import BaseLayout from '../layouts/BaseLayout.astro'
import { localePath, LOCALES, SOURCE_LOCALE, t } from '../i18n/ui'
---

{/* The service worker serves this one page for any uncached URL, in every
    language, so all of them have to be here. */}
<BaseLayout
  title={`LS: ${t(SOURCE_LOCALE, 'offlineTitle')}`}
  description={t(SOURCE_LOCALE, 'offlineDescription')}
  lang={SOURCE_LOCALE}
>
  <h1 class="listing-heading">{t(SOURCE_LOCALE, 'offlineTitle')}</h1>
  <div class="listing-heading">
    {LOCALES.map((locale) => <p lang={locale}>{t(locale, 'offlineBody')}</p>)}
    <p>
      {LOCALES.map((locale, index) => (
        <Fragment>
          {index > 0 && ' / '}
          <a href={localePath(locale, '/')} hreflang={locale}>{t(locale, 'backHome')}</a>
        </Fragment>
      ))}
    </p>
  </div>
</BaseLayout>
