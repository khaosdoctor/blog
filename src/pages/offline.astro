---
import BaseLayout from '../layouts/BaseLayout.astro'
import { t } from '../i18n/ui'
---

{/* The service worker serves this one page for any uncached URL, in either
    language, so both have to be here. */}
<BaseLayout title={`LS: ${t('pt', 'offlineTitle')}`} description={t('pt', 'offlineDescription')}>
  <h1 class="listing-heading">{t('pt', 'offlineTitle')}</h1>
  <div class="listing-heading">
    <p>{t('pt', 'offlineBody')}</p>
    <p lang="en">{t('en', 'offlineBody')}</p>
    <p>
      <a href="/">{t('pt', 'backHome')}</a>
      {' / '}
      <a href="/en/" hreflang="en">{t('en', 'backHome')}</a>
    </p>
  </div>
</BaseLayout>
