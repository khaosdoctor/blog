---
// The Portuguese tag index. getTags() with no argument is the Portuguese map;
// src/pages/en/tags/index.astro builds its own from getTags('en'), so neither
// index links a tag the reader's own language has no page for.
import BaseLayout from '../../layouts/BaseLayout.astro'
import TagCloud from '../../components/TagCloud.astro'
import { getTags } from '../../lib/taxonomy'
import { HREFLANG, t } from '../../i18n/ui'

const tags = [...(await getTags()).entries()]
  .sort(([a], [b]) => a.localeCompare(b, 'pt-BR'))
  .map(([name, posts]) => ({ name, count: posts.length }))

const alternates = [
  { lang: HREFLANG.pt, href: new URL('/tags/', Astro.site).href },
  { lang: HREFLANG.en, href: new URL('/en/tags/', Astro.site).href },
]
---

<BaseLayout title={`${t('pt', 'tags')} | Lucas Santos`} description={t('pt', 'tagsIntro')} alternates={alternates}>
  <TagCloud locale="pt" tags={tags} />
</BaseLayout>
