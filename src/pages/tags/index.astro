---
// The tag index: every tag in this language, as a chip, linking to its own
// /tags/<tag>/ listing (src/pages/tags/[tag]/[...page].astro).
//
// getTags() with no argument is the Portuguese map, which is the right one for
// this tree: src/pages/en/tags/index.astro is the English half and builds its
// own list out of getTags('en'), so neither index links a tag the reader's own
// language has no page for.
import BaseLayout from '../../layouts/BaseLayout.astro'
import { chipColor, getTags, slugify, tagCloudLift, tagCloudScale } from '../../lib/taxonomy'
import { HREFLANG, t } from '../../i18n/ui'

const tags = [...(await getTags()).entries()].sort(([a], [b]) => a.localeCompare(b, 'pt-BR'))

// The range the cloud is scaled across, from the counts actually present.
const counts = tags.map(([, posts]) => posts.length)
const fewest = Math.min(...counts)
const most = Math.max(...counts)

const alternates = [
  { lang: HREFLANG.pt, href: new URL('/tags/', Astro.site).href },
  { lang: HREFLANG.en, href: new URL('/en/tags/', Astro.site).href },
]
---

<BaseLayout title={`${t('pt', 'tags')} | Lucas Santos`} description={t('pt', 'tagsIntro')} alternates={alternates}>
  <h1 class="cloud-heading">
    {t('pt', 'tags')} <span class="page-count">[{tags.length}]</span>
  </h1>
  <ul class="chips">
    {
      tags.map(([tag, posts]) => (
        <li>
          <a
            href={`/tags/${slugify(tag)}/`}
            class="chip"
            style={`--chip-color: ${chipColor(tag)}; --chip-scale: ${tagCloudScale(posts.length, fewest, most)}; --chip-lift: ${tagCloudLift(tag)}em`}
          >
            {tag} ({posts.length})
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .chips {
    margin-block-start: 1.5rem;
    /* Pulls the run in from both edges of its own box, so the cloud reads a
       little more centred without any chip changing shape. */
    padding-inline: 5px;
    /*
     * Rows centre on themselves, and the run centres in the page. On a baseline
     * every chip hung off one line, which is what made the cloud read as ruled
     * text; centred, a row is a band of mixed sizes instead. The last row is
     * short by however many chips it is missing, and left-aligned that made the
     * whole block look unfinished.
     */
    align-items: center;
    justify-content: center;
  }

  /*
   * The cloud breaks out of the reading column: 85 chips at up to three times
   * the base size need the room, and a paragraph's measure is the wrong
   * constraint for something nobody reads line by line.
   *
   * Same technique listing.css uses for the post list. `main` is this box's
   * containing block, and a margin percentage resolves against that block's
   * width, so `margin-inline-start: 50%` puts the start edge at main's own
   * centre; main and body are both centred, so that is the viewport's centre,
   * and translating back by half this box's width puts its centre there.
   */
  /* The title shares the cloud's left edge, so it breaks out the same way. */
  @media (min-width: 70rem) {
    .cloud-heading {
      inline-size: var(--content-width);
      margin-inline-start: 50%;
      transform: translateX(calc(var(--content-width) / -2));
    }
  }

  @media (min-width: 70rem) {
    .chips {
      inline-size: var(--content-width);
      margin-inline-start: 50%;
      transform: translateX(calc(var(--content-width) / -2));
    }
  }

  /*
   * Size carries the count. The padding and the rule go to `em` here so a big
   * chip keeps a chip's proportions instead of a small box around large text;
   * chips.css keeps its own fixed lengths everywhere else, where every chip is
   * the same size.
   *
   * The number stays in the label. Size alone is a visual-only signal, and this
   * page is the one place a reader might want to compare two tags exactly.
   */
  .chips .chip {
    font-size: calc(var(--text-tiny) * var(--chip-scale, 1));
    padding: 0.15em 0.55em;
    border-width: 0.2em;
    /* Nudged off the row's centre by tagCloudLift, so the chips scatter instead
       of queueing. In `em`, so a large chip drifts further than a small one and
       the offsets stay in proportion to the sizes around them. */
    transform: translateY(var(--chip-lift, 0em));
  }
</style>
