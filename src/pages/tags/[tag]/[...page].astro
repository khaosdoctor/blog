---
// The Portuguese per-tag listing; src/pages/en/tags/[tag]/[...page].astro is
// the English twin. The slug is shared because a translation repeats its
// original's `tags:` line, so switching language is a prefix change.
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostList from '../../../components/PostList.astro'
import Pagination from '../../../components/Pagination.astro'
import { slugify, tagListingRoutes } from '../../../lib/taxonomy'
import { HREFLANG, localePath, LOCALES, t } from '../../../i18n/ui'

export const getStaticPaths = (async ({ paginate }) => tagListingRoutes(paginate)) satisfies GetStaticPaths

const { tag, languages, page } = Astro.props
// Page 1 of the counterpart, whatever page this is: the two languages hold
// different post counts under one tag, so page 3 here need not exist there.
const alternates = languages.map((locale: (typeof LOCALES)[number]) => ({
  lang: HREFLANG[locale],
  href: new URL(localePath(locale, `/tags/${slugify(tag)}/`), Astro.site).href,
}))
const title = page.currentPage > 1 ? `${tag} | Lucas Santos | página ${page.currentPage}` : `${tag} | Lucas Santos`
---

<BaseLayout title={title} description={t('pt', 'tagDescription', tag)} alternates={alternates}>
  <p class="kicker listing-heading">{t('pt', 'tag')}</p>
  <h1 class="listing-heading">
    {tag} <span class="page-count">[{page.total}]</span>
  </h1>
  <PostList posts={page.data} />
  <Pagination page={page} basePath={`/tags/${slugify(tag)}/`} locale="pt" />
</BaseLayout>
