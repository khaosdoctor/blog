---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostList from '../../../components/PostList.astro'
import Pagination from '../../../components/Pagination.astro'
import { LIST_PAGE_SIZE } from '../../../lib/posts'
import { getTags, slugify } from '../../../lib/taxonomy'
import { t } from '../../../i18n/ui'

export const getStaticPaths = (async ({ paginate }) => {
  const tags = await getTags()
  return [...tags.entries()].flatMap(([tag, posts]) =>
    paginate(posts, {
      pageSize: LIST_PAGE_SIZE,
      params: { tag: slugify(tag) },
      props: { tag },
    }),
  )
}) satisfies GetStaticPaths

const { tag, page } = Astro.props
const title = page.currentPage > 1 ? `${tag} | Lucas Santos | página ${page.currentPage}` : `${tag} | Lucas Santos`
---

<BaseLayout title={title} description={t('pt', 'tagDescription', tag)}>
  <p class="kicker">{t('pt', 'tag')}</p>
  <h1>{tag}</h1>
  <PostList posts={page.data} />
  <Pagination page={page} basePath={`/tags/${slugify(tag)}/`} locale="pt" />
</BaseLayout>

<style>
  .kicker {
    margin-block-end: 0;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin-block-start: 0.2rem;
  }
</style>
