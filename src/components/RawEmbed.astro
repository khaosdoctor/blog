---
interface Props {
  html: string
  title: string
  caption?: string
}

const { html, title, caption } = Astro.props

if (/<script\b/i.test(html)) {
  throw new Error(`RawEmbed: refusing <script> tag in embed HTML (title: "${title}")`)
}

if (/\bsrc\s*=\s*["']?http:\/\//i.test(html)) {
  throw new Error(`RawEmbed: refusing plain-http src in embed HTML (title: "${title}")`)
}

const hasFrame = /<(iframe|embed)[\s>]/i.test(html)
const embedHtml = hasFrame ? patchFrameAttrs(html, title) : html

// Each lookahead is per-tag, not per-document, so every frame in a multi-frame
// embed is patched and none is patched twice or has its own attribute replaced.
function patchFrameAttrs(source: string, frameTitle: string): string {
  const escapedTitle = frameTitle.replaceAll('"', '&quot;')
  return source
    .replace(/<(iframe|embed)(?![^>]*\bloading=)([^>]*)>/gi, '<$1$2 loading="lazy">')
    .replace(/<(iframe|embed)(?![^>]*\btitle=)([^>]*)>/gi, `<$1$2 title="${escapedTitle}">`)
    .replace(
      /<(iframe|embed)(?![^>]*\breferrerpolicy=)([^>]*)>/gi,
      '<$1$2 referrerpolicy="strict-origin-when-cross-origin">',
    )
    .replace(
      /<(iframe)(?![^>]*\bsandbox=)([^>]*)>/gi,
      '<$1$2 sandbox="allow-scripts allow-popups allow-presentation">',
    )
}
---

<figure class="raw-embed">
  <div class:list={['container', hasFrame && 'framed']}>
    <div set:html={embedHtml} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .raw-embed {
    margin-block: 2rem 1rem;
    margin-inline: 0;
  }

  .container.framed {
    position: relative;
    padding-block-end: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 4px;
  }

  .container.framed :global(iframe),
  .container.framed :global(embed) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  figcaption {
    font-style: italic;
  }
</style>
