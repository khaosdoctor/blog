---
/**
 * <FootnoteSidenotes /> — the pieces of this feature CSS cannot do alone.
 *
 * Three independent, feature-detected behaviours, none depending on the
 * others working:
 *
 * 1. Hovering or focusing a Sidenote or MarginNote (src/components/Sidenote.astro,
 *    src/components/MarginNote.astro) should highlight the text it is attached
 *    to, but that text is not wrapped in anything: it is whatever plain prose
 *    sits right before the tag in the paragraph. There is no element for a
 *    `:hover` rule to select, and short of giving every note a second,
 *    author-written wrapper around "just the words this refers to" (a bigger
 *    surface than either needs), CSS alone cannot reach it.
 *
 *    The CSS Custom Highlight API can: it paints an arbitrary Range without
 *    touching the DOM, so the text stays exactly as authored. This script's
 *    only job is to build that Range on hover/focus and hand it to
 *    `CSS.highlights`; the paint itself is `::highlight(note-bound)` in
 *    src/styles/sidenotes.css.
 *
 *    One delegated listener pair on the document, not one per note: this
 *    runs on every page whether that page has zero notes or a dozen.
 *    Feature-detected and wrapped, so a browser without the API, or any
 *    unexpected DOM shape, leaves the note working exactly as it does with CSS
 *    off, minus the tint, never a broken page.
 *
 * 2. Each note's `.note-copy-link` (a `<button>`, not a link) copies that
 *    note's own anchor URL to the clipboard without navigating anywhere.
 *    BaseLayout.astro already has a delegated handler for exactly this shape
 *    of interaction, `a[data-copy-link]`, but it exists to let the browser
 *    follow the link after copying, which is precisely the behaviour a note's
 *    reference number must not have (round 1 shipped that as an `<a>` and it
 *    jumped the page). So this is its own small handler, same shape as
 *    BaseLayout's (and src/components/MathCopy.astro's) but `preventDefault`
 *    is moot on a `<button>` with no default action to prevent, and it
 *    reuses the exact `.toast` confirmation and 2-second removal both of
 *    those already use, so the site still has exactly one copy-confirmation
 *    pattern rather than a second one growing here.
 *
 * 3. The mirror of (1): hovering the bound text should grow the note it
 *    belongs to (`.note-grow`, src/styles/sidenotes.css), so the reader can
 *    tell which one it is from either direction. That text is still not
 *    wrapped in anything, which is exactly what made (1) need the Highlight
 *    API instead of a plain CSS selector; here there is not even an element
 *    for `mouseover` to bubble from, since a bare text node fires no events
 *    of its own. So this hit-tests the pointer's screen position instead:
 *    `document.caretPositionFromPoint`/`caretRangeFromPoint` (whichever the
 *    browser has) returns the exact text node under the cursor, and a note's
 *    bound text is always that node's `previousSibling` from the note's own
 *    side (see boundRange above), so checking the other direction, whether
 *    the text node's `nextSibling` is a `.note`, finds the note to grow.
 *    Feature-detected (bails out at the top if neither API exists) and
 *    wrapped, same as (1): a note that never grows is a cosmetic loss, not a
 *    broken page.
 */
import { localeFromPath, t } from '../i18n/ui'

const locale = localeFromPath(Astro.url.pathname)
---

<script is:inline define:vars={{ copiedLabel: t(locale, 'linkCopied') }}>
  document.addEventListener('click', async (event) => {
    const button = event.target.closest('.note-copy-link')
    if (button === null) return

    const anchor = button.dataset.copyAnchor
    if (!anchor) return

    try {
      await navigator.clipboard.writeText(location.href.split('#')[0] + anchor)
    } catch {
      // No clipboard permission, or an insecure origin. Silent: there is
      // nothing else for this button to do.
      return
    }

    document.querySelector('.toast')?.remove()
    const toast = document.createElement('div')
    toast.className = 'toast'
    toast.setAttribute('role', 'status')
    toast.textContent = copiedLabel
    document.body.append(toast)
    setTimeout(() => toast.remove(), 2000)
  })
</script>

<script is:inline>
  ;(function () {
    try {
      if (typeof CSS === 'undefined' || !('highlights' in CSS) || typeof Highlight === 'undefined') return

      var NAME = 'note-bound'

      // The bound text is the plain text node immediately before the note's
      // own <span>, in the same parent: whatever prose the author placed the
      // <Sidenote>/<MarginNote> tag right after.
      function boundRange(note) {
        var node = note.previousSibling
        if (!node || node.nodeType !== Node.TEXT_NODE || !node.textContent.trim()) return null
        var range = document.createRange()
        range.selectNodeContents(node)
        return range
      }

      function show(target) {
        if (!target || typeof target.closest !== 'function') return
        var note = target.closest('.note')
        if (!note) return
        var range = boundRange(note)
        if (!range) return
        CSS.highlights.set(NAME, new Highlight(range))
      }

      function hide(event) {
        var goingTo = event && event.relatedTarget
        if (goingTo && typeof goingTo.closest === 'function' && goingTo.closest('.note')) return
        CSS.highlights.delete(NAME)
      }

      document.addEventListener('mouseover', function (event) {
        show(event.target)
      })
      document.addEventListener('mouseout', hide)
      document.addEventListener('focusin', function (event) {
        show(event.target)
      })
      document.addEventListener('focusout', hide)
    } catch (_error) {
      // A highlight that never shows is a cosmetic loss, not a broken page.
    }
  })()
</script>

<script is:inline>
  ;(function () {
    try {
      // Whichever of the two the browser has: Firefox ships
      // caretPositionFromPoint, Chromium (as of this writing) only
      // caretRangeFromPoint. Neither existing is a plain no-op, not an
      // error, same as the highlight block above.
      var textNodeAt
      if (typeof document.caretPositionFromPoint === 'function') {
        textNodeAt = function (x, y) {
          var pos = document.caretPositionFromPoint(x, y)
          return pos ? pos.offsetNode : null
        }
      } else if (typeof document.caretRangeFromPoint === 'function') {
        textNodeAt = function (x, y) {
          var range = document.caretRangeFromPoint(x, y)
          return range ? range.startContainer : null
        }
      } else {
        return
      }

      var GROWN = 'note-grow'
      var grown = null

      // The inverse of boundRange above: given the text node under the
      // pointer, its own note (if it has one) is whatever immediately
      // follows it in the same parent.
      function noteAfter(node) {
        if (!node || node.nodeType !== Node.TEXT_NODE) return null
        var next = node.nextSibling
        if (!next || next.nodeType !== Node.ELEMENT_NODE || !next.classList) return null
        return next.classList.contains('note') ? next : null
      }

      function setGrown(note) {
        if (note === grown) return
        if (grown) grown.classList.remove(GROWN)
        grown = note
        if (grown) grown.classList.add(GROWN)
      }

      document.addEventListener('mousemove', function (event) {
        setGrown(noteAfter(textNodeAt(event.clientX, event.clientY)))
      })
      // relatedTarget is null when the pointer leaves the window outright,
      // the one case mousemove stops firing without another element to
      // report hitting.
      document.addEventListener('mouseout', function (event) {
        if (!event.relatedTarget) setGrown(null)
      })
    } catch (_error) {
      // A note that never grows is a cosmetic loss, not a broken page.
    }
  })()
</script>
