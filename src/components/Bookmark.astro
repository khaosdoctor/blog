---
interface Props {
  url: string
  title?: string
  description?: string
  publisher?: string
  image?: string
}

const { url, title, description, publisher, image } = Astro.props
const host = publisher ?? new URL(url).host.replace(/^www\./, '')
---

<a class="bookmark" href={url} rel="noopener noreferrer nofollow">
  <span class="thumb">
    {
      image ? (
        <img src={image} alt="" loading="lazy" decoding="async" />
      ) : (
        <svg class="thumb-fallback" viewBox="0 0 16 16" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
          <rect x="2" y="2" width="12" height="10" />
          <rect x="2" y="12" width="4" height="2" />
          <rect x="10" y="12" width="4" height="2" />
          <rect x="2" y="14" width="2" height="2" />
          <rect x="12" y="14" width="2" height="2" />
        </svg>
      )
    }
  </span>
  <span class="body">
    <span class="title">{title ?? url}</span>
    {description && <span class="description">{description}</span>}
    <span class="host">{host}</span>
  </span>
</a>

<style>
  .bookmark {
    display: flex;
    container-type: inline-size;
    margin-block: 1.5rem;
    /* `border-style: double` collapses to a single line under 3px, hence 4px. */
    border: 4px double var(--rule);
    border-inline-start: var(--border-card-edge) solid var(--rule);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }

  .bookmark:hover,
  .bookmark:focus-visible {
    border-color: var(--accent-day, var(--accent));
  }

  .bookmark:hover .title,
  .bookmark:focus-visible .title {
    color: var(--accent-day, var(--accent));
  }

  .thumb {
    display: flex;
    flex: 0 0 6.5rem;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-inline-end: var(--border) solid var(--rule);
    background: var(--rule);
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-fallback {
    width: 40%;
    height: 40%;
    fill: var(--muted);
  }

  .body {
    display: block;
    min-width: 0;
    padding: 0.9rem 1.1rem;
  }

  .title {
    display: block;
    font-weight: 600;
    line-height: 1.3;
  }

  .description {
    display: block;
    margin-block-start: 0.35rem;
    color: var(--muted);
    font-size: var(--text-small);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .host {
    display: block;
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  @media (max-width: 47.99rem) {
    .thumb {
      display: none;
    }
  }
</style>
