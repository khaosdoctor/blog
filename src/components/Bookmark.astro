---
/**
 * The old Ghost "bookmark card": a link rendered with its title, description
 * and site name.
 *
 * This deliberately does NOT fetch anything. astro-embed's
 * LinkPreview refetches OG data for every bookmark at build time, which means
 * hundreds of requests to third-party sites, a build that fails when one of
 * them has no OG tags, and output that changes depending on the network. Ghost
 * already captured this metadata when the card was created, and the migration
 * carries it over, so the build stays offline and deterministic.
 *
 * `image` follows the same rule: nothing here ever fetches one. It only shows
 * up once something upstream (content/bookmarks.json plus a vendor-media.ts
 * pass that does not exist yet) vendors a local copy and threads it through
 * remark-embeds as a prop. Until then, every card falls back to a drawn
 * placeholder rather than an empty gap in the layout.
 */
interface Props {
  url: string
  title?: string
  description?: string
  publisher?: string
  image?: string
}

const { url, title, description, publisher, image } = Astro.props
const host = publisher ?? new URL(url).host.replace(/^www\./, '')
---

<a class="bookmark" href={url} rel="noopener noreferrer nofollow">
  <span class="thumb">
    {
      image ? (
        <img src={image} alt="" loading="lazy" decoding="async" />
      ) : (
        <svg class="thumb-fallback" viewBox="0 0 16 16" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
          <rect x="2" y="2" width="12" height="10" />
          <rect x="2" y="12" width="4" height="2" />
          <rect x="10" y="12" width="4" height="2" />
          <rect x="2" y="14" width="2" height="2" />
          <rect x="12" y="14" width="2" height="2" />
        </svg>
      )
    }
  </span>
  <span class="body">
    <span class="title">{title ?? url}</span>
    {description && <span class="description">{description}</span>}
    <span class="host">{host}</span>
  </span>
</a>

<style>
  .bookmark {
    display: flex;
    container-type: inline-size;
    margin-block: 1.5rem;
    /* House style: double rule on three edges, thick solid bar on the left.
       `border-style: double` collapses to one line under 3px, hence the 4px. */
    border: 4px double var(--rule);
    border-inline-start: var(--border-card-edge) solid var(--rule);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }

  /*
   * Today's colour, the same one every other link on the page answers to
   * (--accent-day, src/lib/day-color.ts), rather than the generic --accent
   * this used to read: that token is the site's fallback blue and never
   * changed with the day, so the card was the one link on the page hovering
   * in a colour nothing else used. The fallback keeps it working anywhere
   * --accent-day is not written, matching how prose/links.css reads it.
   *
   * The border and the title carry it, and nothing fills: prose/links.css
   * hands the card back to this file for exactly that reason, above.
   */
  .bookmark:hover,
  .bookmark:focus-visible {
    border-color: var(--accent-day, var(--accent));
  }

  .bookmark:hover .title,
  .bookmark:focus-visible .title {
    color: var(--accent-day, var(--accent));
  }

  .thumb {
    display: flex;
    flex: 0 0 6.5rem;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-inline-end: var(--border) solid var(--rule);
    background: var(--rule);
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-fallback {
    width: 40%;
    height: 40%;
    fill: var(--muted);
  }

  .body {
    display: block;
    min-width: 0;
    padding: 0.9rem 1.1rem;
  }

  .title {
    display: block;
    font-weight: 600;
    line-height: 1.3;
  }

  .description {
    display: block;
    margin-block-start: 0.35rem;
    color: var(--muted);
    font-size: 0.9rem;
    /* Ghost descriptions can be a whole paragraph; two lines is enough. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .host {
    display: block;
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
  }

  /* Reacts to the card's own width, not the viewport, so it degrades the
     same way regardless of what else shares the reading column. */
  @container (max-width: 420px) {
    .bookmark {
      flex-direction: column;
    }

    .thumb {
      flex-basis: auto;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-inline-end: 0;
      border-block-end: var(--border) solid var(--rule);
    }
  }
</style>
