---
/**
 * <MarginNote>inline text</MarginNote>
 *
 * Same mechanics as <Sidenote> (src/components/Sidenote.astro) but
 * unnumbered: no counter mark appears in the text flow, the note just rests in
 * the margin. Called from migrated MDX content without an import.
 *
 * - On wide viewports the note text floats into the right margin, unmarked,
 *   a thick inline-start border only, always visible.
 * - On narrow viewports there is no margin to show it in, so a small dot
 *   becomes the tap/click target for a popover (checkbox hack, zero JS).
 * - Each instance also gets a build-time sequential id (`marginnote-1`, ...)
 *   for its own permalink: a normal-sized copy-link button in the note's own
 *   top-left corner on hover/focus. Clicking it copies the anchor URL and
 *   does not navigate, handled by FootnoteSidenotes.astro's own click
 *   listener, not BaseLayout's delegated `a[data-copy-link]` handler (that
 *   one deliberately lets the browser follow the link). Lives inside
 *   `.note-text`, see src/styles/sidenotes.css.
 * - Hovering or focusing the note highlights the text it is attached to,
 *   done by src/components/FootnoteSidenotes.astro via the CSS Custom
 *   Highlight API, since that text is not wrapped in anything here.
 * - Slot content MUST be inline only: text, <strong>, <em>, <a>, <code>.
 *   Never headings or block elements.
 */
import { localeFromPath, t } from '../i18n/ui'
import '../styles/sidenotes.css'

// Same reasoning as Sidenote.astro's own counter (module-scoped, resets when
// the pathname changes), kept as its own separate counter rather than a
// shared one: the two id spaces never need to interleave, only stay unique
// within their own prefix.
let lastPath = ''
let count = 0

const locale = localeFromPath(Astro.url.pathname)

if (Astro.url.pathname !== lastPath) {
  lastPath = Astro.url.pathname
  count = 0
}
count += 1
const anchorId = `marginnote-${count}`
const toggleId = `${anchorId}-toggle`
---

<span class="note marginnote" id={anchorId}>
  <input type="checkbox" id={toggleId} class="note-toggle" aria-label={t(locale, 'showMarginNote')} />
  <label for={toggleId} class="note-marker" style={`anchor-name: --${toggleId}`}></label>
  <span class="note-text" style={`position-anchor: --${toggleId}`}
    ><slot /><button
      type="button"
      class="note-copy-link"
      data-copy-anchor={`#${anchorId}`}
      aria-label="link to this note"></button></span
  >
</span>
