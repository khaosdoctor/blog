---
/**
 * <MarginNote>inline text</MarginNote>
 *
 * The same mechanics as <Sidenote> but unnumbered: no counter mark in the text
 * flow, the note just rests in the margin. Injected globally into MDX.
 *
 * - Wide: floats into the right margin, unmarked, always visible. Narrow:
 *   there is no margin to show it in, so a small dot becomes the tap target
 *   for the same checkbox popover.
 * - Its copy button behaves exactly as a Sidenote's, in the top-LEFT corner
 *   rather than the right.
 * - Hovering highlights the text it is attached to, painted on a Range by
 *   FootnoteSidenotes.astro since that text is not wrapped in anything.
 * - Slot content MUST be inline only.
 */
import { localeFromPath, t } from '../i18n/ui'
import '../styles/sidenotes.css'

// Same reasoning as Sidenote.astro's own counter (module-scoped, resets when
// the pathname changes), kept as its own separate counter rather than a
// shared one: the two id spaces never need to interleave, only stay unique
// within their own prefix.
let lastPath = ''
let count = 0

const locale = localeFromPath(Astro.url.pathname)

if (Astro.url.pathname !== lastPath) {
  lastPath = Astro.url.pathname
  count = 0
}
count += 1
const anchorId = `marginnote-${count}`
const toggleId = `${anchorId}-toggle`
---

<span class="note marginnote" id={anchorId}>
  <input type="checkbox" id={toggleId} class="note-toggle" aria-label={t(locale, 'showMarginNote')} />
  <label for={toggleId} class="note-marker" style={`anchor-name: --${toggleId}`}></label>
  <span class="note-text" style={`position-anchor: --${toggleId}`}
    ><slot /><button
      type="button"
      class="note-copy-link"
      data-copy-anchor={`#${anchorId}`}
      aria-label={t(locale, 'linkToNote')}></button></span
  >
</span>
