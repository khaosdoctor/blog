---
import {
  AUTHOR_NAME,
  AUTHOR_TWITTER_HANDLE,
  buildBreadcrumbJsonLd,
  buildPersonJsonLd,
  buildPrimaryJsonLd,
  OG_CARD_HEIGHT,
  OG_CARD_WIDTH,
  sectionOgImage,
  SITE_NAME,
  toJsonLdScript,
  toOgLocale,
  type BreadcrumbItem,
} from '../lib/seo'
import { HREFLANG, SOURCE_LOCALE } from '../i18n/ui'

export interface Alternate {
  lang: string
  href: string
}

interface Props {
  title: string
  description: string
  /** Must be absolute: every relative value here resolves against it. */
  canonical: string
  type: 'website' | 'article'
  publishedAt?: Date
  updatedAt?: Date
  lang: string
  image?: string
  imageAlt?: string
  tags?: string[]
  series?: string
  authors?: string[]
  noindex?: boolean
  alternates?: Alternate[]
  markdown?: string
  section?: { name: string; url: string }
}

const {
  title,
  description,
  canonical,
  type,
  publishedAt,
  updatedAt,
  lang,
  image,
  imageAlt,
  tags,
  series,
  authors,
  noindex = false,
  alternates = [],
  section,
  markdown,
} = Astro.props

// Deliberately never points off-site, even for posts published elsewhere first:
// a foreign canonical hands the ranking to that domain.
const indexUrl = canonical

const card = image ?? sectionOgImage(section?.url)
const absoluteImage = new URL(card, canonical).href

const jsonLd = buildPrimaryJsonLd(type, {
  title,
  description,
  canonical: indexUrl,
  lang,
  image: absoluteImage,
  publishedAt,
  updatedAt,
  tags,
  series,
  authors,
})

const homeUrl = Astro.site ? new URL('/', Astro.site).href : '/'

// The URL comparison is what keeps a section index from repeating itself: a
// BreadcrumbList whose last two items share a URL is rejected as malformed.
const sectionUrl = section === undefined ? null : new URL(section.url, canonical).href
const breadcrumbItems: BreadcrumbItem[] = [
  { name: SITE_NAME, url: homeUrl },
  ...(section !== undefined && sectionUrl !== null && sectionUrl !== canonical
    ? [{ name: section.name, url: sectionUrl }]
    : []),
  { name: title, url: canonical },
]
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems)
const personJsonLd = buildPersonJsonLd(homeUrl)

const xDefault =
  alternates.find((alt) => alt.lang === HREFLANG[SOURCE_LOCALE]) ?? alternates[0]
const robots = noindex ? 'noindex,nofollow' : 'index,follow'
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR_NAME} />
<meta name="robots" content={robots} />
<link rel="canonical" href={indexUrl} />
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

{alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={indexUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={toOgLocale(lang)} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:alt" content={imageAlt ?? title} />
{
  /* Only the generated cards have known dimensions; a wrong hint on a hero
     image renders worse than no hint. */
  !image && (
    <>
      <meta property="og:image:width" content={String(OG_CARD_WIDTH)} />
      <meta property="og:image:height" content={String(OG_CARD_HEIGHT)} />
    </>
  )
}
{
  type === 'article' && (
    <>
      {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
      {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
      <meta property="article:author" content={AUTHOR_NAME} />
      {tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:site" content={AUTHOR_TWITTER_HANDLE} />
<meta name="twitter:creator" content={AUTHOR_TWITTER_HANDLE} />
<meta name="twitter:image" content={absoluteImage} />

<script type="application/ld+json" set:html={toJsonLdScript(jsonLd)} />
<script type="application/ld+json" set:html={toJsonLdScript(breadcrumbJsonLd)} />
<script type="application/ld+json" set:html={toJsonLdScript(personJsonLd)} />
