---
import {
  AUTHOR_NAME,
  AUTHOR_TWITTER_HANDLE,
  buildBreadcrumbJsonLd,
  buildPersonJsonLd,
  buildPrimaryJsonLd,
  DEFAULT_LOCALE,
  OG_CARD_HEIGHT,
  OG_CARD_WIDTH,
  sectionOgImage,
  SITE_NAME,
  toJsonLdScript,
  toOgLocale,
  type BreadcrumbItem,
} from '../lib/seo'

export interface Alternate {
  lang: string
  href: string
}

interface Props {
  title: string
  description: string
  /** This page's own absolute URL. Everything relative resolves against it. */
  canonical: string
  type: 'website' | 'article'
  publishedAt?: Date
  updatedAt?: Date
  lang: string
  /** Absolute or root-relative path; resolved against `canonical` for og:image/twitter:image (both require absolute URLs). */
  image?: string
  /** Describes `image`. Defaults to the page title. */
  imageAlt?: string
  tags?: string[]
  series?: string
  /** Raw `authors` frontmatter, so the schema names who actually wrote it. */
  authors?: string[]
  noindex?: boolean
  alternates?: Alternate[]
  /** Markdown twin of this page, for readers that are not browsers. */
  markdown?: string
  /** The section this page belongs to, so the breadcrumb has a middle step. */
  section?: { name: string; url: string }
}

const {
  title,
  description,
  canonical,
  type,
  publishedAt,
  updatedAt,
  lang,
  image,
  imageAlt,
  tags,
  series,
  authors,
  noindex = false,
  alternates = [],
  section,
  markdown,
} = Astro.props

// Every page carries its own ranking. Three posts were on Medium first and a
// canonical pointing there would hand Google the other domain, so they do not
// get one: the traffic belongs here.
const indexUrl = canonical

// A page with no image of its own shares as a bare link on most networks, so
// it gets the card of its section instead.
const card = image ?? sectionOgImage(section?.url)
const absoluteImage = new URL(card, canonical).href

const jsonLd = buildPrimaryJsonLd(type, {
  title,
  description,
  canonical: indexUrl,
  lang,
  image: absoluteImage,
  publishedAt,
  updatedAt,
  tags,
  series,
  authors,
})

// Derived from Astro.site (astro.config.mjs) instead of a duplicate constant,
// so the domain has exactly one source of truth.
const homeUrl = Astro.site ? new URL('/', Astro.site).href : '/'

// Home -> section -> post. The middle step is what produces the breadcrumb line
// under a result in Google instead of a bare URL, and it only appears on pages
// that are actually in a section. Built on `canonical`, never `indexUrl`: this
// is the trail through THIS site, so a post that credits Medium still shows its
// own path here.
//
// The section index passes its own section, which would repeat the trail's last
// step, and a BreadcrumbList whose last two items are the same URL is rejected
// as malformed.
const sectionUrl = section === undefined ? null : new URL(section.url, canonical).href
const breadcrumbItems: BreadcrumbItem[] = [
  { name: SITE_NAME, url: homeUrl },
  ...(section !== undefined && sectionUrl !== null && sectionUrl !== canonical
    ? [{ name: section.name, url: sectionUrl }]
    : []),
  { name: title, url: canonical },
]
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems)
const personJsonLd = buildPersonJsonLd(homeUrl)

// Compared on the language subtag: callers emit region-qualified hreflang
// values (`pt-BR`), so an exact match against DEFAULT_LOCALE (`pt`) never hit,
// and x-default pointed at the right page only because pt happens to be listed
// first everywhere.
const xDefault =
  alternates.find((alt) => alt.lang.split('-')[0] === DEFAULT_LOCALE) ?? alternates[0]
const robots = noindex ? 'noindex,nofollow' : 'index,follow'
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR_NAME} />
<meta name="robots" content={robots} />
<link rel="canonical" href={indexUrl} />
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

{alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={indexUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={toOgLocale(lang)} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:alt" content={imageAlt ?? title} />
{
  /* Dimensions are only declared for our own cards, which are drawn at this
     size. A hero image can be anything, and a wrong hint renders worse than
     no hint. */
  !image && (
    <>
      <meta property="og:image:width" content={String(OG_CARD_WIDTH)} />
      <meta property="og:image:height" content={String(OG_CARD_HEIGHT)} />
    </>
  )
}
{
  type === 'article' && (
    <>
      {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
      {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
      <meta property="article:author" content={AUTHOR_NAME} />
      {tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:site" content={AUTHOR_TWITTER_HANDLE} />
<meta name="twitter:creator" content={AUTHOR_TWITTER_HANDLE} />
<meta name="twitter:image" content={absoluteImage} />

<script type="application/ld+json" set:html={toJsonLdScript(jsonLd)} />
<script type="application/ld+json" set:html={toJsonLdScript(breadcrumbJsonLd)} />
<script type="application/ld+json" set:html={toJsonLdScript(personJsonLd)} />
