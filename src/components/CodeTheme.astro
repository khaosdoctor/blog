---
// Reader-facing code-block theme picker. Used to render on every code block
// and inject its own opener button next to Expressive Code's copy button;
// moved into SettingsPanel.astro instead (docs/design.md, Settled), one
// picker for the whole site rather than one per block. This component now
// renders only the labelled <select> itself: SettingsPanel.astro supplies the
// popover, the opener button and the reveal-on-ready wrapper around it.
//
// Preventing a flash of the wrong theme still needs the blocking script in
// BaseLayout's <head>, which runs before any stylesheet; this only renders
// the picker and code-theme.ts only wires it up.
//
// Theme names are not translated: they are the themes' own names, the way a
// font name is not translated either.
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<p
  class="ct-settings"
  hidden
  data-label={t(locale, 'codeTheme')}
  data-auto={t(locale, 'codeThemeAuto')}
  data-github-light="GitHub Light"
  data-github-dark="GitHub Dark"
  data-monokai="Monokai"
  data-dracula="Dracula"
  data-catppuccin-latte="Catppuccin Latte"
  data-catppuccin-frappe="Catppuccin Frappé"
  data-catppuccin-macchiato="Catppuccin Macchiato"
  data-catppuccin-mocha="Catppuccin Mocha"
  data-kanagawa-wave="Kanagawa Wave"
  data-kanagawa-dragon="Kanagawa Dragon"
  data-kanagawa-lotus="Kanagawa Lotus"
  data-ayu-light="Ayu Light"
  data-ayu-dark="Ayu Dark"
  data-snazzy-light="Snazzy"
>
  <label for="ct-theme"></label>
  <select id="ct-theme">
    <option value="auto"></option>
    <optgroup label="GitHub">
      <option value="github-light"></option>
      <option value="github-dark"></option>
    </optgroup>
    <optgroup label="Monokai">
      <option value="monokai"></option>
    </optgroup>
    <optgroup label="Dracula">
      <option value="dracula"></option>
    </optgroup>
    <optgroup label="Catppuccin">
      <option value="catppuccin-latte"></option>
      <option value="catppuccin-frappe"></option>
      <option value="catppuccin-macchiato"></option>
      <option value="catppuccin-mocha"></option>
    </optgroup>
    <optgroup label="Kanagawa">
      <option value="kanagawa-wave"></option>
      <option value="kanagawa-dragon"></option>
      <option value="kanagawa-lotus"></option>
    </optgroup>
    <optgroup label="Ayu">
      <option value="ayu-light"></option>
      <option value="ayu-dark"></option>
    </optgroup>
    <optgroup label="Snazzy">
      <option value="snazzy-light"></option>
    </optgroup>
  </select>
</p>

<script>
  import '../scripts/code-theme'
</script>
