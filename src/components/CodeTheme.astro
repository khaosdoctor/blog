---
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<p
  class="ct-settings"
  hidden
  data-label={t(locale, 'codeTheme')}
  data-normal={t(locale, 'codeThemeNormal')}
  data-high-contrast={t(locale, 'codeThemeHighContrast')}
>
  <label for="ct-theme"></label>
  <select id="ct-theme">
    <option value="normal"></option>
    <option value="high-contrast"></option>
  </select>
</p>

<script>
  import '../scripts/code-theme'
</script>
