---
import Magnifier from './icons/Magnifier.astro'
import { localePath, t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const searchHref = localePath(locale, '/search/')
---

<div class="search-trigger">
  <a href={searchHref} class="sx-open" aria-label={t(locale, 'search')} data-base-label={t(locale, 'search')}>
    <span class="sx-label">{t(locale, 'search')}</span>
    <Magnifier class="sx-open-icon" />
    <span class="sx-hint" aria-hidden="true"
      >&lt;<span class="sx-hint-mod"></span>+<span class="sx-hint-key">K</span>&gt;</span
    >
  </a>

  {/* tabindex so the dialog itself can hold the initial focus on touch, where
      focusing the input would open the keyboard over the results. */}
  <dialog id="sx-dialog" class="sx-dialog" tabindex="-1" aria-label={t(locale, 'searchLabel')}>
    <div class="sx-row">
      <span class="sx-prompt" aria-hidden="true">&gt;</span>
      <input
        type="text"
        class="sx-input"
        autocomplete="off"
        spellcheck="false"
        aria-label={t(locale, 'searchLabel')}
        placeholder={t(locale, 'searchPlaceholder')}
        data-searching={t(locale, 'searching')}
        data-no-results={t(locale, 'noResultsFor')}
        data-more-results={t(locale, 'moreResults')}
        data-results-found={t(locale, 'searchResultsFound')}
        data-no-index-message={t(locale, 'searchNoIndex')}
      />
      <span class="sx-cursor" aria-hidden="true"></span>
    </div>
    <p class="sx-status" aria-live="polite" aria-atomic="true"></p>
    <ul class="sx-results"></ul>
    <p class="sx-more"></p>
    {/* Empty until the script fills it: the %s is Cmd or Ctrl, which only the
        browser can decide. */}
    <p class="sx-keys" aria-hidden="true" data-hint={t(locale, 'searchKeysHint')}></p>
  </dialog>
</div>

<script>
  import '../scripts/search-palette'
</script>

<style>
  .search-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .sx-open {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: var(--icon-btn-glyph);
    padding-inline: 0.5rem;
    text-decoration: none;
    cursor: pointer;
  }

  .sx-open::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block: calc((var(--icon-btn-hit) - var(--icon-btn-chip)) / 2);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  .sx-open-icon,
  .sx-hint {
    position: relative;
  }

  .sx-label {
    display: none;
    position: relative;
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--muted);
    margin-inline-end: 0.4rem;
  }

  .sx-hint {
    margin-inline-start: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: 0.03em;
    color: var(--muted);
    white-space: nowrap;
    /* Not display: none, so the anchor holds its final width from first
       paint. */
    visibility: hidden;
  }

  .sx-open:hover,
  .sx-open:focus-visible {
    color: var(--accent);
  }

  .sx-open:hover::before,
  .sx-open:focus-visible::before {
    border-color: var(--accent);
  }

  .sx-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sx-dialog {
    inline-size: min(92vw, 36rem);
    max-block-size: 70dvh;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    padding: 1rem;
  }

  .sx-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .sx-dialog[open] > * + * {
    margin-block-start: 0.6rem;
  }

  /* A real pixelate is out of reach in CSS: backdrop-filter takes only the
     functions `filter` does and none of them resample. */
  .sx-dialog::backdrop {
    backdrop-filter: blur(5px);
    background-image: repeating-linear-gradient(
      0deg,
      color-mix(in oklab, var(--fg) 14%, transparent) 0 3px,
      transparent 3px 6px
    );
  }

  .sx-row {
    position: relative;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1rem;
    border-block-end: var(--border) solid var(--rule);
    padding-block-end: 0.5rem;
  }

  .sx-prompt {
    inline-size: 1.5ch;
    flex-shrink: 0;
    color: var(--accent);
  }

  /* Without the zero minimum the flex item keeps an input's default twenty
     characters of intrinsic width and runs past a narrow row. */
  .sx-input {
    flex: 1;
    min-inline-size: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-family: inherit;
    caret-color: transparent;
  }

  .sx-input:focus {
    outline: none;
  }

  .sx-cursor {
    position: absolute;
    inset-block-start: 0.1em;
    inset-inline-start: 1.5ch;
    inline-size: 1ch;
    block-size: 1.15em;
    background: var(--accent-day, var(--accent));
    opacity: 0;
    pointer-events: none;
  }

  .sx-input:focus ~ .sx-cursor {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sx-input:focus ~ .sx-cursor {
      animation: sx-blink 1s steps(2, jump-none) infinite;
    }
  }

  @keyframes sx-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .sx-status {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-tiny);
  }

  .sx-results {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
  }

  .sx-results :global(li + li) {
    border-block-start: var(--border) solid var(--rule);
  }

  .sx-results :global(a) {
    display: flex;
    align-items: baseline;
    padding-block: 0.5rem;
    color: var(--fg);
    text-decoration: none;
  }

  .sx-results :global(a:hover),
  .sx-results :global(a:focus-visible) {
    color: var(--accent);
  }

  .sx-results :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .sx-results :global(.sx-num) {
    flex-shrink: 0;
    inline-size: 1.4em;
    margin-inline-end: 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  .sx-more:empty {
    display: none;
  }

  .sx-more :global(a) {
    color: var(--accent);
    font-size: var(--text-tiny);
  }

  .sx-keys {
    margin: 0.6rem 0 0;
    padding-block-start: 0.5rem;
    border-block-start: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  /* A touch device has no modifier and no hjkl, so the line is noise there. */
  @media (hover: none) {
    .sx-keys {
      display: none;
    }
  }
</style>
