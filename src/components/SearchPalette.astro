---
// A command-style opener beside LangSwitcher: a magnifier plus the reader's
// own shortcut key, opening a native <dialog> (real top-layer placement and a
// real focus trap for free, no popover/hidden fallback machinery to write)
// that live-searches through Pagefind the same way Search.astro's own script
// does. That existing form-based page is left untouched (see this file's own
// script for why) and keeps working with JS off.
//
// Progressive enhancement, not a JS-only control any more: the element below
// is a real `<a href="/search/">` (or `/en/search/`, via `localePath`, same
// helper NavLinks.astro already uses), so a reader with JS off, or before
// search-palette.ts runs, clicks it and reaches the working, JS-free search
// page, the same shape Search.astro's own form/script pair already uses
// (real GET form first, Pagefind upgrades it in place). Once the script
// runs, it calls `event.preventDefault()` on click and opens the dialog
// instead, the anchor becomes the palette opener, and `aria-haspopup`/
// `aria-controls` (only true once that upgrade has happened) are added by
// the script rather than declared here.
//
// Nothing about the anchor's own appearance depends on JS: the icon and the
// box are visible from first paint, no `hidden` on this control any more
// (unlike ThemeToggle/SettingsPanel, which do nothing at all without JS and
// so start hidden). The one part that IS JS-only is the shortcut hint
// (<Cmd+K> promises a keyboard shortcut that only exists once the script's
// global keydown listener is live): that stays reserved in space
// (`visibility: hidden`, not `display: none`) so the box never resizes, and
// the script switches it to visible once it is actually true, rather than
// hiding the whole control the way the old, JS-only version did.
import Magnifier from './icons/Magnifier.astro'
import { localePath, t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const searchHref = localePath(locale, '/search/')
---

{/*
  A real link, always visible: `searchHref` above is where a reader with no
  JS, or before the script has run, actually goes. `aria-haspopup`/
  `aria-controls` are not declared here (the script adds them once it has
  actually taken over the click), so this element never claims a popup
  behaviour it cannot yet deliver. `aria-label` is the one label that has to
  be honest in both states at once: `t(locale, 'search')` ("Buscar"/"Search")
  describes the destination, not the mechanism, so it reads correctly
  whether the click navigates or opens a dialog.

  Shares its hit target (--icon-btn-hit, 44px tall) and its visible-chip
  technique (a ::before at --icon-btn-chip, 32px tall) with ThemeToggle/
  SettingsPanel, but it is not square: the shortcut hint's reserved space
  (see .sx-hint below) already widens it before any script runs.
*/}
<div class="search-trigger">
  <a href={searchHref} class="sx-open" aria-label={t(locale, 'search')}>
    <Magnifier class="sx-open-icon" />
    {/* Reserved space, invisible content: `visibility: hidden` below keeps
       this in the layout (so the box is already its final width at first
       paint, JS or not) while hiding the promise of a keyboard shortcut
       that only exists once search-palette.ts's global keydown listener is
       live. The script sets it visible and fills in the platform-specific
       Cmd/Ctrl once that is true; the bracket vocabulary matches every
       other button on this site (Search.astro, ChromeButton.vue), and
       Ctrl/Cmd + the letter is read off the settings panel's own choice
       rather than hardcoded to K. */}
    <span class="sx-hint" aria-hidden="true"
      >&lt;<span class="sx-hint-mod"></span>+<span class="sx-hint-key">K</span>&gt;</span
    >
  </a>

  <dialog id="sx-dialog" class="sx-dialog" aria-label={t(locale, 'searchLabel')}>
    <div class="sx-row">
      <span class="sx-prompt" aria-hidden="true">&gt;</span>
      <input
        type="text"
        class="sx-input"
        autocomplete="off"
        spellcheck="false"
        autofocus
        aria-label={t(locale, 'searchLabel')}
        placeholder={t(locale, 'searchPlaceholder')}
        data-searching={t(locale, 'searching')}
        data-no-results={t(locale, 'noResultsFor')}
        data-more-results={t(locale, 'moreResults')}
        data-results-found={t(locale, 'searchResultsFound')}
        data-no-index-message={t(locale, 'searchNoIndex')}
      />
      {/* The block cursor: real caret hidden (`caret-color: transparent` on
         the input, see the style block below), this one positioned over the
         input's own text by the script instead, coloured from the day's own
         hash (src/lib/day-color.ts) rather than the theme accent. */}
      <span class="sx-cursor" aria-hidden="true"></span>
    </div>
    {/* Announces once a search settles, not on every keystroke: debouncedSearch
       already coalesces rapid typing (see the script), so this only ever
       receives one update per settled query rather than one per key. */}
    <p class="sx-status" aria-live="polite" aria-atomic="true"></p>
    <ul class="sx-results"></ul>
    <p class="sx-more"></p>
  </dialog>
</div>

<script>
  import '../scripts/search-palette'
</script>

<style>
  /*
   * Always visible, unlike ThemeToggle/SettingsPanel's own wrappers: those
   * do nothing at all without JS, so they start `hidden`; this one is a real
   * link with a real destination the moment it renders, so there is nothing
   * to wait for and nothing here depends on `[hidden]` any more.
   */
  .search-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /*
   * The hit target is still --icon-btn-hit (44px), the same token
   * ThemeToggle's `.tt-open` and SettingsPanel's `.sp-open` use, but this
   * link is no longer square: the icon and the hint's reserved space both
   * sit inside it, so it grows sideways to fit them while `min-block-size`
   * keeps it 44px tall. `--icon-btn-glyph` still sizes the magnifier; the
   * hint (`.sx-hint` below) sets its own smaller size. `text-decoration:
   * none` is new next to the old button-based version: an `<a>` carries a
   * default underline a `<button>` never had to override.
   */
  .sx-open {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: var(--icon-btn-glyph);
    padding-inline: 0.5rem;
    text-decoration: none;
    cursor: pointer;
  }

  /*
   * The visible chip: 32px tall (--icon-btn-chip), same as every other
   * control's drawn box, but spanning the button's full width
   * (`inset-inline: 0`) rather than a fixed square, since this button's
   * content (icon + hint) is wider than it is tall. The block insets centre
   * it in the 44px hit target: half of the 12px difference on each side.
   * Border reads --accent-day, not --rule: see ThemeToggle's own .tt-open
   * ::before for the full reasoning and the measured numbers.
   */
  .sx-open::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block: calc((var(--icon-btn-hit) - var(--icon-btn-chip)) / 2);
    border: var(--border) solid var(--accent-day);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  /* Same reason as ThemeToggle's .tt-icon and SettingsPanel's .sp-icon: the
     ::before chip is absolutely positioned and opaque, so it paints over an
     unpositioned glyph and leaves an empty outlined square. Now that the
     hint lives inside this button too, it needs the same treatment, or the
     chip paints over it as well. */
  .sx-open-icon,
  .sx-hint {
    position: relative;
  }

  .sx-hint {
    margin-inline-start: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: 0.03em;
    color: var(--muted);
    white-space: nowrap;
    /*
     * Reserved space, hidden content: `visibility: hidden` (not `display:
     * none`/the `hidden` attribute) keeps this in the layout so the anchor
     * is already its final width at first paint. The script sets this to
     * `visible` once it has actually taken over the click, see the
     * component comment for why a keyboard-shortcut promise is dishonest
     * before that.
     */
    visibility: hidden;
  }

  .sx-open:hover,
  .sx-open:focus-visible {
    color: var(--accent);
  }

  .sx-open:hover::before,
  .sx-open:focus-visible::before {
    border-color: var(--accent);
  }

  /* Drawn on the real (larger) hit box, not the chip, same reason as
     ThemeToggle's own .tt-open:focus-visible rule. */
  .sx-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * The "solid square box" the owner asked for: hard corners (`--radius` is 0
   * site-wide), a double rule in the ink colour, same treatment as
   * ThemeToggle's and SettingsPanel's own menus. `showModal()` (the script)
   * is what actually puts this in the top layer; nothing here needs a z-index.
   */
  .sx-dialog {
    inline-size: min(92vw, 36rem);
    max-block-size: 70vh;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    padding: 1rem;
  }

  /* No author `display` outside the `[open]` state: the UA stylesheet already
     hides a closed <dialog>, and this codebase's other menus carry the same
     scar (see ThemeToggle.astro's own note on `.tt-menu`). Children are spaced
     with margin rather than the flex row property, same reason as `.sx-open`
     above. */
  .sx-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .sx-dialog[open] > * + * {
    margin-block-start: 0.6rem;
  }

  /*
   * The pixelated backdrop. A true per-pixel mosaic of the live page behind
   * this dialog is not something CSS can do: `backdrop-filter` only accepts
   * the same functions `filter` does (blur, contrast, saturate, ...), none of
   * which resample anything, and no SVG filter primitive downsamples either.
   * Every working "CSS pixelate" starts from an actual snapshot of the page
   * rasterised onto a small canvas and scaled back up with `image-rendering:
   * pixelated`, which needs either a new dependency (package.json is
   * off-limits here) or a hand-rolled DOM-to-canvas renderer, both well past
   * what a decorative backdrop justifies.
   *
   * `blur()` is the closest built-in effect, and the hard-edged stripes
   * painted over it (rather than a soft gradient) are what keep the result
   * reading as chunky rather than as a plain dim: the ask was explicitly to
   * avoid a smooth dim, and blur alone is still smooth. Both are resolved once
   * by the browser's own compositor when the dialog opens; nothing here
   * re-runs on a keystroke, since typing only ever touches the results list.
   */
  .sx-dialog::backdrop {
    backdrop-filter: blur(5px);
    background-image: repeating-linear-gradient(
      0deg,
      color-mix(in oklab, var(--fg) 14%, transparent) 0 3px,
      transparent 3px 6px
    );
  }

  .sx-row {
    position: relative;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1rem;
    border-block-end: var(--border) solid var(--rule);
    padding-block-end: 0.5rem;
  }

  .sx-prompt {
    inline-size: 1.5ch;
    flex-shrink: 0;
    color: var(--accent);
  }

  .sx-input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-family: inherit;
    caret-color: transparent;
  }

  .sx-input:focus {
    outline: none;
  }

  .sx-cursor {
    position: absolute;
    inset-block-start: 0.1em;
    inset-inline-start: 1.5ch;
    inline-size: 1ch;
    block-size: 1.15em;
    opacity: 0;
    pointer-events: none;
  }

  /* Reduced motion: solid and visible while typing, no blink at all. The rule
     inside the media query below layers the blink on top only for readers who
     have not asked for less motion, same split theme.css uses for
     scroll-behavior. */
  .sx-input:focus ~ .sx-cursor {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sx-input:focus ~ .sx-cursor {
      animation: sx-blink 1s steps(2, jump-none) infinite;
    }
  }

  @keyframes sx-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .sx-status {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-tiny);
  }

  .sx-results {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
  }

  .sx-results li + li {
    border-block-start: var(--border) solid var(--rule);
  }

  .sx-results a {
    display: flex;
    align-items: baseline;
    padding-block: 0.5rem;
    color: var(--fg);
    text-decoration: none;
  }

  .sx-results a:hover,
  .sx-results a:focus-visible {
    color: var(--accent);
  }

  .sx-results a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .sx-num {
    flex-shrink: 0;
    inline-size: 1.4em;
    margin-inline-end: 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  .sx-more:empty {
    display: none;
  }

  .sx-more a {
    color: var(--accent);
    font-size: var(--text-tiny);
  }
</style>
