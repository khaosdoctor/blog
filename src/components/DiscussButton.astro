---
import { type Locale, t } from '../i18n/ui'
import Message from './icons/Message.astro'

interface Props {
  locale: Locale
  title: string
  class?: string
}

const { locale, title, class: className } = Astro.props

const markdownUrl = new URL(`${Astro.url.pathname}index.md`, Astro.site).href
const prompt = t(locale, 'discussPrompt', title, markdownUrl)
const query = `?q=${encodeURIComponent(prompt)}`

// Gemini ignores a prompt in the URL, so its prompt travels by clipboard.
const agents = [
  { name: 'ChatGPT', href: `https://chatgpt.com/${query}` },
  { name: 'Claude', href: `https://claude.ai/new${query}` },
  { name: 'Gemini', href: 'https://gemini.google.com/app', copy: prompt },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search${query}` },
]
---

<details class:list={['action-wrap', 'discuss', className]} data-pagefind-ignore>
  <summary class="action-btn" aria-label={t(locale, 'discussWith')}>
    <Message />
    <span class="action-label">{t(locale, 'discussWith').toLowerCase()}</span>
  </summary>
  <div class="action-menu">
    {
      agents.map(({ name, href, copy }) => (
        <a class="action-item" href={href} data-copy-prompt={copy} target="_blank" rel="noopener noreferrer">
          {name}
          {copy && (
            <small data-copy-hint hidden>
              {t(locale, 'copiesPrompt')}
            </small>
          )}
        </a>
      ))
    }
  </div>
</details>

<style>
  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  function closeDiscussMenus(except?: Node) {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.discuss[open]')) {
      if (except && menu.contains(except)) continue
      menu.open = false
    }
  }

  for (const hint of document.querySelectorAll<HTMLElement>('[data-copy-hint]')) hint.hidden = false

  document.addEventListener('click', (event) => {
    const target = event.target as Element
    const prompt = target.closest<HTMLElement>('[data-copy-prompt]')?.dataset.copyPrompt
    if (prompt) navigator.clipboard?.writeText(prompt).catch(() => {})
    closeDiscussMenus(target.closest('.action-item') ? undefined : target)
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    const open = document.querySelector<HTMLDetailsElement>('.discuss[open]')
    if (!open) return
    open.querySelector('summary')?.focus()
    closeDiscussMenus()
  })
</script>
