---
// Delegated click handler for the copy-as-text button that
// src/plugins/rehype-math-copy.mjs injects into every display equation. One
// listener for the whole page, the same shape as the heading-anchor handler
// in BaseLayout, sharing the site's one copy-confirmation (copy-toast.ts).
//
// The ASCII rendering already lives in data-ascii by build time, written by
// the rehype plugin from the LaTeX KaTeX leaves behind in its own markup:
// nothing here parses LaTeX.
---

<script>
  import { copyWithToast } from '../scripts/copy-toast'

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('button[data-math-copy]')
    if (button === null) return
    void copyWithToast(button.dataset.ascii ?? '')
  })
</script>
