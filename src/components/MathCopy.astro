<script>
  import { copyWithToast } from '../scripts/copy-toast'

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('button[data-math-copy]')
    if (button === null) return
    void copyWithToast(button.dataset.ascii ?? '', 'formula')
  })
</script>
