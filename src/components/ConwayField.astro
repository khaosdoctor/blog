<canvas class="conway-field" aria-hidden="true"></canvas>

<script>
  import '../scripts/conway'
</script>

<style>
  /* z-index must stay negative, so header, main and footer paint above the canvas without needing a z-index of their own. */
  .conway-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    cursor: crosshair;
    touch-action: manipulation;
  }

  :root[data-bg-life='off'] .conway-field {
    display: none;
  }
</style>
