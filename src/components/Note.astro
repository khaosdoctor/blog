---
// Slot content must be inline only: this renders inside a <span> in the running
// text, so a block element would break the paragraph around it.
import { localeFromPath, t } from '../i18n/ui'
import '../styles/sidenotes.css'

const NOTE_KINDS = {
  sidenote: 'showNote',
  marginnote: 'showMarginNote',
} as const

type NoteKind = keyof typeof NOTE_KINDS

interface Props {
  kind: NoteKind
}

const { kind } = Astro.props

const locale = localeFromPath(Astro.url.pathname)

// Frontmatter runs again for every note, so the count has to live on the page
// render; a counter declared here restarts at each one.
const pageNoteCounts = Astro.locals as Partial<Record<NoteKind, number>>
const position = (pageNoteCounts[kind] ?? 0) + 1
pageNoteCounts[kind] = position
const anchorId = `${kind}-${position}`
const toggleId = `${anchorId}-toggle`
---

<span class={`note ${kind}`} id={anchorId}>
  <input type="checkbox" id={toggleId} class="note-toggle" aria-label={t(locale, NOTE_KINDS[kind])} />
  <label for={toggleId} class="note-marker" style={`anchor-name: --${toggleId}`}></label>
  <span class="note-text" style={`position-anchor: --${toggleId}`}
    ><slot /><button
      type="button"
      class="note-copy-link"
      data-copy-anchor={`#${anchorId}`}
      aria-label={t(locale, 'linkToNote')}></button></span
  ><label for={toggleId} class="note-scrim"></label>
</span>
