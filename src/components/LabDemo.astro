---
import { localeFromPath } from '../i18n/ui'
import LabSource from './LabSource.astro'

interface Props {
  name: string
  source: string
}

const { name, source } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
---

<figure class="lab-demo">
  <div class="stage">
    <slot />
  </div>
  <LabSource locale={locale} name={name} source={source} />
</figure>

<style>
  .stage {
    padding: 1.25rem;
  }
</style>
