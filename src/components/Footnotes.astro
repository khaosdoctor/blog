---
// Pairs a marker with its note in the margin, in both directions, which no
// selector can express: the two are neither siblings nor nested. Presentation
// only, the note reads and opens without this script.
---

<script is:inline>
  ;(() => {
    try {
      const HIGHLIGHT = 'footnote-ref-highlighted'
      const ACTIVE = 'footnote-aside-active'
      const REF = '[data-footnote-ref]'
      let highlighted = null
      let active = null

      const swap = (previous, next, name) => {
        if (previous === next) return next
        previous?.classList.remove(name)
        next?.classList.add(name)
        return next
      }

      const markerFor = (aside) => document.getElementById(aside.dataset.footnoteRefId ?? '')?.closest('sup') ?? null

      const asideFor = (ref) => (ref.id ? document.querySelector(`[data-footnote-ref-id="${ref.id}"]`) : null)

      const show = ({ target }) => {
        if (!(target instanceof Element)) return
        const aside = target.closest('.footnote-aside')
        // The marker is inert where the note already reads in the margin, so
        // the hover arrives on the sup around it rather than on the button.
        const ref = target.closest('sup')?.querySelector(REF) ?? null

        highlighted = swap(highlighted, aside ? markerFor(aside) : null, HIGHLIGHT)
        active = swap(active, ref ? asideFor(ref) : aside, ACTIVE)
      }

      document.addEventListener('mouseover', show)
      document.addEventListener('focusin', show)

      // Pull margin notes toward their references. Floated notes with
      // clear:right stack downward when consecutive; a negative margin-top
      // on each float closes the distance without breaking the clear chain.
      const wideQuery = matchMedia('(min-width: 70rem)')
      const allAsides = [...document.querySelectorAll('.footnote-aside')]

      const repositionNotes = () => {
        for (const a of allAsides) a.style.marginTop = ''
        if (!wideQuery.matches || allAsides.length === 0) return

        const GAP = 12
        let prevBottom = -Infinity

        for (const a of allAsides) {
          const refEl = document.getElementById(a.dataset.footnoteRefId ?? '')
          if (!refEl) continue

          const refTop = refEl.getBoundingClientRect().top
          const asideTop = a.getBoundingClientRect().top
          let target = refTop
          if (target < prevBottom + GAP) target = prevBottom + GAP

          const shift = target - asideTop
          if (Math.abs(shift) > 2) a.style.marginTop = `${shift}px`

          prevBottom = a.getBoundingClientRect().top + a.offsetHeight
        }
      }

      if (allAsides.length > 0) {
        const run = () => requestAnimationFrame(repositionNotes)
        if (document.fonts?.ready) document.fonts.ready.then(run)
        else addEventListener('load', run)
        addEventListener('resize', run, { passive: true })
        wideQuery.addEventListener('change', run)
        const prose = document.querySelector('.prose')
        if (prose) new ResizeObserver(run).observe(prose)
      }
    } catch {}
  })()
</script>
