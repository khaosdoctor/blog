---
import { Image } from 'astro:assets'
import { sanitizeCaption } from '../lib/sanitizeCaption'

interface Props {
  src: ImageMetadata | string
  alt: string
  caption?: string
  wide?: boolean
  /** Eager-loads this image instead of the default lazy. At most one per page. */
  priority?: boolean
}

const { src, alt, caption, wide = false, priority = false } = Astro.props

// The migration script emits a static `import` for every local image and
// passes the resulting ImageMetadata here directly, so astro:assets can
// optimise it (real srcset/sizes) and Vite can tell which images are actually
// used. A bare string only ever means a genuinely remote, never-mirrored URL.
const isRemote = typeof src === 'string'
const safeCaption = caption && sanitizeCaption(caption)

// This layout has one fixed reading column (--measure in BaseLayout.astro,
// ~750px), wide or not, so a Figure image never needs to render past that
// width. Clamped to the source's own intrinsic width too, so a screenshot
// narrower than the column doesn't get upsized.
const MAX_DISPLAY_WIDTH = 800
const localWidth = isRemote ? undefined : Math.min(MAX_DISPLAY_WIDTH, (src as ImageMetadata).width)
---

<figure class:list={['figure', { wide }]}>
  {
    isRemote ? (
      <img src={src as string} alt={alt} loading="lazy" decoding="async" class="no-dimensions" />
    ) : (
      <Image src={src as ImageMetadata} alt={alt} width={localWidth} priority={priority} />
    )
  }
  {
    caption && (
      <figcaption>{safeCaption && <span class="caption" set:html={safeCaption} />}</figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin-block: 2rem;
  }

  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  /* ponytail: remote images (Ghost embeds) have no build-time dimensions
     without a network fetch. Reserve a common photo box to bound layout shift. */
  .figure :global(img.no-dimensions) {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .figure figcaption {
    margin-block-start: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  /* ponytail: matches the body's own 1.5rem horizontal padding (BaseLayout),
     so a "wide" figure breaks out flush to the viewport edge on narrow
     screens instead of overflowing it. A --measure-proportional version was
     tried but at the current --measure (68ch) it always resolved to this
     same flat value, so it was dead weight — simplified. */
  .figure.wide {
    --breakout: 1.5rem;
    width: calc(100% + var(--breakout) * 2);
    margin-inline: calc(var(--breakout) * -1);
  }
</style>
