---
import { Image } from 'astro:assets'
import { sanitizeCaption } from '../lib/sanitizeCaption'

interface Props {
  src: ImageMetadata | string
  alt: string
  caption?: string
  credit?: string
  wide?: boolean
  width?: number
  height?: number
}

const { src, alt, caption, credit, wide = false, width, height } = Astro.props

const isRemote = typeof src === 'string' && /^https?:\/\//.test(src)
const safeCaption = caption && sanitizeCaption(caption)

// ponytail: migrated posts pass images as plain relative strings (the migration
// script writes MDX without import statements, per this component group's brief).
// astro:assets can only optimise an imported ImageMetadata, so we resolve the
// string ourselves: glob every image colocated under content/blog/ and match by
// path suffix. Works as long as filenames are unique within their post folder,
// which is how the Ghost export is laid out. Extensions are listed in both
// cases since the filesystem match is case-sensitive but Ghost exports aren't
// consistent about it.
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  '/content/blog/**/*.{png,jpg,jpeg,gif,webp,avif,svg,PNG,JPG,JPEG,GIF,WEBP,AVIF,SVG}',
)

async function resolveLocalImage(relativePath: string): Promise<ImageMetadata> {
  const suffix = relativePath.replace(/^\.\//, '')
  const key = Object.keys(localImages).find((path) => path.endsWith(`/${suffix}`))
  if (!key) throw new Error(`Figure: no local image matches "${relativePath}"`)
  const mod = await localImages[key]()
  return mod.default
}

const localImage = !isRemote && typeof src === 'string' ? await resolveLocalImage(src) : undefined
const image = localImage ?? (typeof src === 'string' ? undefined : src)
---

<figure class:list={['figure', { wide }]}>
  {
    isRemote ? (
      <img
        src={src as string}
        alt={alt}
        loading="lazy"
        decoding="async"
        width={width}
        height={height}
        class:list={[{ 'no-dimensions': !(width && height) }]}
      />
    ) : (
      <Image src={image as ImageMetadata} alt={alt} />
    )
  }
  {
    (caption || credit) && (
      <figcaption>
        {safeCaption && <span class="caption" set:html={safeCaption} />}
        {credit && <span class="credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin-block: 2rem;
  }

  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  /* ponytail: remote images (Ghost embeds) have no build-time dimensions
     without a network fetch. Reserve a common photo box by default to bound
     layout shift; pass width+height when known to get the real ratio. */
  .figure :global(img.no-dimensions) {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .figure figcaption {
    margin-block-start: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .figure figcaption .credit {
    display: block;
    margin-block-start: 0.25rem;
    font-size: 0.8rem;
  }

  /* ponytail: matches the body's own 1.5rem horizontal padding (BaseLayout),
     so a "wide" figure breaks out flush to the viewport edge on narrow
     screens instead of overflowing it. A --measure-proportional version was
     tried but at the current --measure (68ch) it always resolved to this
     same flat value, so it was dead weight — simplified. */
  .figure.wide {
    --breakout: 1.5rem;
    width: calc(100% + var(--breakout) * 2);
    margin-inline: calc(var(--breakout) * -1);
  }
</style>
