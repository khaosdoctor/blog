---
import { t, type Locale } from '../i18n/ui'

// The finish time depends on when the reader looks, not on build time, so it can
// only be computed client-side.
interface Props {
  minutes: number
  locale: Locale
}

const { minutes, locale } = Astro.props
---

<span class="reading-time" data-reading-minutes={minutes} data-finish-template={t(locale, 'finishReadingAt')}
  >{minutes} min</span
>

<style>
  .reading-time {
    position: relative;
    display: inline-block;
  }

  :global(.reading-time:has(.rt-trigger)),
  :global(.reading-time .rt-trigger) {
    cursor: default;
  }

  /* Not `all: unset`: that drops `display` too, and this has to stay inline. */
  .reading-time :global(.rt-trigger) {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
  }

  .reading-time :global(.rt-trigger:hover),
  .reading-time :global(.rt-trigger:focus-visible) {
    background: var(--accent-day, var(--accent));
    color: var(--bg);
    outline: none;
  }

  /* Never `display: none`: an `aria-describedby` points at this, so its text has
     to stay in the accessibility tree while it is invisible. */
  .reading-time :global(.rt-popup) {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: 100%;
    transform: translateX(-50%);
    margin-block-end: 0.4rem;
    padding: 0.3rem 0.55rem;
    border: 3px double light-dark(#000000, #ffffff);
    background: var(--bg);
    color: light-dark(#000000, #ffffff);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration) var(--ease);
  }

  .reading-time[data-open='true'] :global(.rt-popup) {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  import '../scripts/reading-time-hover'
</script>
