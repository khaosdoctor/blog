---
// Pixelarticons `x.svg` (MIT), github.com/halfmage/pixelarticons, path data
// unchanged. Pixelarticons has no separate "twitter" glyph any more, only
// this one: the pack renamed its bird icon to the X logo when the platform
// did, the same real asset either name would point at, so this is not a
// drawn approximation, just the pack's current file for that service under
// its own new name. Used once, by the footer's link to twitter.lsantos.dev
// (BaseLayout.astro), which is Lucas's own short link and keeps the
// "twitter" name regardless of what icon represents it. `currentColor` and
// `1em` sizing so the glyph takes the colour and scale of whatever link
// places it, with no token of its own, the same shape every neighbour in
// this directory (Cog, Github, LinkedIn, Sun, Moon, Monitor)
// already follows.
interface Props {
  class?: string
  [key: string]: unknown
}

const { class: className, ...rest } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  {...rest}
>
  <path
    d="M6 20H4v-2h2v2Zm14-2h2v2h-6v-2h2v-2h2v2ZM8 18H6v-2h2v2Zm8 0h-2v-2h2v2Zm-6-2H8v-2h2v2Zm4 0h-2v-2h2v2Zm4 0h-2v-2h2v2Zm-6-2h-2v-2h2v2Zm4 0h-2v-2h2v2Zm-6-2H8v-2h2v2Zm4 0h-2v-2h2v2Zm-6-2H6V8h2v2Zm4 0h-2V8h2v2Zm4 0h-2V8h2v2ZM8 6H6v2H4V6H2V4h6v2Zm2 2H8V6h2v2Zm8 0h-2V6h2v2Zm2-2h-2V4h2v2Z"
  ></path>
</svg>
