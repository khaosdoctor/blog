---
// Pixelarticons `linkedin.svg` (MIT), github.com/halfmage/pixelarticons, path
// data unchanged. Used once, by the footer's LinkedIn link (BaseLayout.astro).
// `currentColor` and `1em` sizing so the glyph takes the colour and scale of
// whatever link places it, with no token of its own, the same shape every
// neighbour in this directory (Cog, Github, Sun, Moon, Monitor, Sliders)
// already follows.
interface Props {
  class?: string
  [key: string]: unknown
}

const { class: className, ...rest } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  {...rest}
>
  <path
    d="M7 22H1V8h6v14Zm12-12h-8v10h2v-8h4v2h-2v8H9V8h10v2Zm4 12h-6v-8h2v6h2v-8h2v10ZM3 20h2V10H3v10Zm18-8h-2v-2h2v2ZM5 7H3V5h2v2ZM3 5H1V3h2v2Zm4 0H5V3h2v2ZM5 3H3V1h2v2Z"
  ></path>
</svg>
