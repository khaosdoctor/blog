---
// Pixelarticons `youtube.svg` (MIT), github.com/halfmage/pixelarticons, path
// data unchanged. Used once, by the footer's YouTube link (BaseLayout.astro).
// `currentColor` and `1em` sizing so the glyph takes the colour and scale of
// whatever link places it, with no token of its own, the same shape every
// neighbour in this directory (Cog, Github, LinkedIn, Twitter, Sun, Moon,
// Monitor, Sliders) already follows.
interface Props {
  class?: string
  [key: string]: unknown
}

const { class: className, ...rest } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  {...rest}
>
  <path
    d="M20 20H4v-2h16v2ZM4 18H2V6h2v12Zm18 0h-2V6h2v12ZM12 9h-2v6h2v2H8V7h4v2Zm3 6h-3v-2h3v2Zm2-2h-2v-2h2v2Zm-2-2h-3V9h3v2Zm5-5H4V4h16v2Z"
  ></path>
</svg>
