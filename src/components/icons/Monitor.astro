---
// Pixelarticons `monitor.svg` (MIT), github.com/halfmage/pixelarticons, path
// data unchanged. Stands for "follows the system" in the theme menu.
// `currentColor` and `1em` sizing so the glyph takes the colour and scale of
// whatever button or heading places it, with no token of its own.
interface Props {
  class?: string
  [key: string]: unknown
}

const { class: className, ...rest } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  {...rest}
>
  <path d="M4 2h16v2H4zm0 14h16v2H4zM2 4h2v12H2zm18 0h2v12h-2zm-9 14h2v2h-2zm-3 2h8v2H8z"></path>
</svg>
