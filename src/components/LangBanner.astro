---
import type { Locale } from '../i18n/ui'
import { t } from '../i18n/ui'

interface Props {
  lang: Locale
  originalHref: string
}

const { lang, originalHref } = Astro.props

if (!/^(\/|https:)/.test(originalHref)) {
  throw new Error(`LangBanner: originalHref must be an internal path or an https URL, got "${originalHref}"`)
}

const suggestFixUrl = new URL('https://github.com/khaosdoctor/blog/issues/new')
suggestFixUrl.searchParams.set('title', `Translation: ${Astro.url.pathname}`)
suggestFixUrl.searchParams.set('body', 'Suggest a translation fix for this page')
---

<div class="lang-banner" role="note">
  <p>
    {t(lang, 'machineTranslated')}
    {' '}
    <a href={originalHref}>{t(lang, 'readOriginal')}</a>
    {' / '}
    <a href={suggestFixUrl.href}>{t(lang, 'suggestFix')}</a>
  </p>
</div>

<style>
  /* Lifted toward white on dark: the brand tone goes muddy straight against black. */
  .lang-banner {
    margin-block-end: 2rem;
    padding: 0.9rem 1.2rem;
    background: transparent;
    border-style: double;
    border-color: light-dark(var(--post-accent), color-mix(in oklab, var(--post-accent) 75%, white));
    border-width: var(--qc-border-width);
    border-inline-start-style: solid;
    border-inline-start-width: var(--border-card-edge);
    border-radius: var(--qc-radius);
    font-size: 0.85rem;
    color: var(--fg);
  }

  .lang-banner p {
    margin: 0;
    line-height: 1.4;
  }

  .lang-banner a {
    font-weight: 500;
  }
</style>
