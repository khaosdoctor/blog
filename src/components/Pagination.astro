---
import type { Page } from 'astro'
import { t, type Locale } from '../i18n/ui'
import { LIST_PAGE_SIZE } from '../lib/posts'

/**
 * The list's own page nav, at the bottom of every archive, section and tag
 * page long enough to page. Takes Astro's own `page` object straight from
 * `paginate()` (see the page files this renders on: they all use the
 * `[...page].astro` shape, page 1 bare and page N at `.../N/`), so the
 * previous/next targets (`page.url.prev`/`next`) come from Astro's own route
 * generator rather than being rebuilt here. The individual page numbers are
 * not something `paginate()` hands back, only prev/next/first/last, so those
 * are built from `basePath` plus the same `N/` convention every page file
 * already generates its own routes with.
 *
 * Every control (previous, next, each visible page number) is a link styled
 * as one of the header's own icon buttons (ThemeToggle.astro/
 * SettingsPanel.astro): they navigate, so they stay <a> even where they look
 * like buttons, the current page and a disabled previous/next render as a
 * plain <span> instead since neither one goes anywhere.
 */
interface Props {
  page: Page<unknown>
  basePath: string
  locale: Locale
}

const { page, basePath, locale } = Astro.props

function hrefFor(pageNumber: number): string {
  return pageNumber === 1 ? basePath : `${basePath}${pageNumber}/`
}

type Slot = number | 'ellipsis'

/**
 * Which page numbers actually render, out of `count`. The rule is MUI's own
 * `usePagination` (boundaryCount 1, siblingCount 1), not an invented one:
 * page 1 and the last page always render as real numbers, the current page
 * always keeps one sibling on each side, and an ellipsis only ever replaces
 * a run of two or more hidden pages, since one hidden between two visible
 * numbers would read the same length as just printing it. Below 8 pages
 * (`COLLAPSE_FLOOR`, below) those three rules already cover every page
 * between them, so nothing ever collapses.
 *
 * The property this buys, and the reason it was picked over a plainer
 * "first four, ellipsis, last four": every render at 8 pages or past it
 * produces exactly 7 slots (2 boundary numbers, up to 2 ellipses, up to 3
 * sibling numbers, the current page), a constant width regardless of which
 * page is current, so the row of controls never shifts under a reader's
 * pointer as they move through it. And unlike a fixed first-N/last-N split,
 * the current page can never fall inside the hidden middle with nothing to
 * mark where it is: it is always one of the rendered numbers, or is covered
 * by the boundary/sibling numbers already on screen.
 */
function paginationSlots(count: number, current: number): Slot[] {
  const BOUNDARY = 1
  const SIBLING = 1
  // The smallest count the boundary pairs and the current page's own
  // siblings cannot already cover between them without a hidden run of two
  // or more; at or under it, list every page instead of collapsing anything.
  const COLLAPSE_FLOOR = 2 * BOUNDARY + 2 * SIBLING + 3
  if (count < COLLAPSE_FLOOR + 1) {
    return Array.from({ length: count }, (_, index) => index + 1)
  }

  const range = (start: number, end: number): number[] =>
    Array.from({ length: end - start + 1 }, (_, index) => start + index)

  const startPages = range(1, BOUNDARY)
  const endPages = range(count - BOUNDARY + 1, count)

  const siblingsStart = Math.max(
    Math.min(current - SIBLING, count - BOUNDARY - SIBLING * 2 - 1),
    BOUNDARY + 2
  )
  const siblingsEnd = Math.min(
    Math.max(current + SIBLING, BOUNDARY + SIBLING * 2 + 2),
    endPages[0] - 2
  )

  const slots: Slot[] = [...startPages]

  if (siblingsStart > BOUNDARY + 2) {
    slots.push('ellipsis')
  } else if (BOUNDARY + 1 < count - BOUNDARY) {
    slots.push(BOUNDARY + 1)
  }

  slots.push(...range(siblingsStart, siblingsEnd))

  if (siblingsEnd < count - BOUNDARY - 1) {
    slots.push('ellipsis')
  } else if (count - BOUNDARY > BOUNDARY) {
    slots.push(count - BOUNDARY)
  }

  slots.push(...endPages)

  return slots
}

const slots = paginationSlots(page.lastPage, page.currentPage)

// The size choices offered beside the pagination. LIST_PAGE_SIZE (10) is the
// only one actually built: the other three work by having page-size.ts fetch
// and merge further pages built at that same size, which is why it is read
// off the nav's own data-built-page-size attribute below rather than
// duplicated as a second literal in that script.
const PAGE_SIZES = [10, 20, 50, 100]
---

{
  page.lastPage > 1 && (
    <nav
      class="pagination"
      aria-label={t(locale, 'pagination')}
      data-base-path={basePath}
      data-current-page={page.currentPage}
      data-last-page={page.lastPage}
      data-built-page-size={LIST_PAGE_SIZE}
    >
      {/* DOM order matches the grid's own left-to-right reading order
         (empty first column, this cluster centred in the second, the size
         control end-aligned in the third below), so Tab visits things in
         the same order a sighted reader's eye would, rather than jumping to
         the right-hand control before the centred page numbers. */}
      <div class="pg-controls">
        {page.url.prev ? (
          <a class="pg-btn" href={page.url.prev} rel="prev" aria-label={t(locale, 'paginationPrev')}>
            <span class="pg-glyph" aria-hidden="true">
              {'<<'}
            </span>
          </a>
        ) : (
          <span class="pg-btn" aria-disabled="true" aria-label={t(locale, 'paginationPrev')}>
            <span class="pg-glyph" aria-hidden="true">
              {'<<'}
            </span>
          </span>
        )}
        <ol class="numbers">
          {slots.map((slot) =>
            slot === 'ellipsis' ? (
              <li aria-hidden="true">
                <span class="pg-ellipsis">…</span>
              </li>
            ) : (
              <li>
                {slot === page.currentPage ? (
                  <span class="pg-btn pg-current" aria-current="page">
                    <span class="pg-glyph">{slot}</span>
                  </span>
                ) : (
                  <a class="pg-btn" href={hrefFor(slot)} aria-label={t(locale, 'paginationGoTo', slot)}>
                    <span class="pg-glyph">{slot}</span>
                  </a>
                )}
              </li>
            )
          )}
        </ol>
        {page.url.next ? (
          <a class="pg-btn" href={page.url.next} rel="next" aria-label={t(locale, 'paginationNext')}>
            <span class="pg-glyph" aria-hidden="true">
              {'>>'}
            </span>
          </a>
        ) : (
          <span class="pg-btn" aria-disabled="true" aria-label={t(locale, 'paginationNext')}>
            <span class="pg-glyph" aria-hidden="true">
              {'>>'}
            </span>
          </span>
        )}
      </div>
      {/* Its own grid cell, end-aligned past the cluster above (see
         `.pagination`'s own comment on the three-column grid this row is
         now): the cluster stays optically centred in the row regardless of
         how wide this control's own label gets.

         Same family as ThemeToggle.astro/SettingsPanel.astro's own icon
         buttons, not a native <select>: a native listbox draws its open
         list with the OS's own chrome, which cannot take the double ANSI
         rule, the pixel face or the aria-current marking every other menu
         on this site wears. Hidden until page-size.ts confirms it can run,
         the same reason those two start hidden: there is no server-side way
         to change how many posts a static build already put on this page,
         so a reader with JS off gets the built LIST_PAGE_SIZE and no
         control offering a choice that could not do anything for them,
         rather than a dead or misleading one. */}
      <div class="pg-size" hidden>
        <button
          type="button"
          class="pg-size-open"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="pg-size-menu"
          data-template={t(locale, 'pageSizeCurrent')}
        >
          <span class="pg-size-open-label">{t(locale, 'pageSizeCurrent', LIST_PAGE_SIZE)}</span>
        </button>
        <div id="pg-size-menu" class="pg-size-menu" aria-label={t(locale, 'pageSizeLabel')} hidden>
          {PAGE_SIZES.map((size) => (
            <button type="button" class="pg-size-option" data-value={size} aria-current={size === LIST_PAGE_SIZE ? 'true' : 'false'}>
              {size}
            </button>
          ))}
        </div>
      </div>
    </nav>
  )
}

<script>
  import '../scripts/page-size'
</script>

<style>
  /*
   * A three-column grid, empty first cell, the prev/numbers/next cluster
   * centred in the second, `.pg-size` end-aligned in the third: the middle
   * cell's own width is only ever its content (`auto`), so its centre is
   * the row's true centre regardless of what the third cell measures,
   * rather than a plain flex row where a wide trailing control pushes the
   * centred group off-centre by half its own width. `minmax(0, 1fr)` on the
   * outer two, not a bare `1fr`, is what keeps that true even if `.pg-size`
   * ever grows wider than the empty column would otherwise be: a bare `1fr`
   * track cannot shrink past its own content's width, so a wide third
   * column would out-grow the empty first one and drag the middle cell
   * along with it; `minmax(0, …)` lets the flexible share alone decide each
   * outer column's width instead.
   */
  .pagination {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    /*
     * The quotes' own dashed rule rather than a solid hairline: the same
     * `repeating-linear-gradient` recipe quotes.css draws its author line
     * with (10px on, 6px off, 2px weight), so the two read as one mark used
     * twice instead of two different rules. Drawn as a background rather than
     * a border so it can be centred and cut to a share of the row's width,
     * which a border cannot do.
     */
    border-block-start: 0;
    background-image: repeating-linear-gradient(to right, var(--rule) 0 10px, transparent 10px 16px);
    background-repeat: no-repeat;
    background-position: top center;
    background-size: 50% 2px;
    font-family: var(--font-display);
    font-size: 0.85rem;
  }

  /*
   * Same 70rem/80vw treatment as PostList.astro's own `.posts` (see that
   * file's comment for the full mechanism): this row widens exactly as much
   * as the list above it, so the two read as one deliberate width rather
   * than the list widening on its own.
   */
  @media (min-width: 70rem) {
    .pagination {
      inline-size: var(--chrome-width);
      /* Same inset as the list above and the header's own row. */
      padding-inline: var(--chrome-inset);
      margin-inline-start: 50%;
      transform: translateX(calc(var(--chrome-width) / -2));
    }
  }

  /*
   * Narrow enough that the grid's three columns crowd rather than help: a
   * plain centred column instead, the cluster first and the size control
   * under it (`order`, not source order, decides that: see the markup's own
   * comment on why the cluster is written first in the document either
   * way), rather than the control stranding itself alone on the row's own
   * first line above the numbers the way a naive `flex-wrap` on the grid's
   * row would have left it.
   */
  @media (max-width: 32rem) {
    .pagination {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .pg-controls {
      order: 1;
    }

    .pg-size {
      order: 2;
      margin-block-start: 0.75rem;
    }
  }

  .pg-controls {
    grid-column: 2;
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .pg-size {
    grid-column: 3;
    justify-self: end;
    position: relative;
    margin-inline-start: 1rem;
  }

  /*
   * Author CSS beats the UA sheet's `[hidden] { display: none }` regardless
   * of specificity, so `display` only ever applies on the `:not([hidden])`
   * state: a reader with JS off, who never gets past this wrapper's own
   * `hidden`, would otherwise see a dead control anyway. Same rule
   * ThemeToggle.astro's own `.theme-toggle:not([hidden])` carries.
   */
  .pg-size:not([hidden]) {
    display: inline-flex;
  }

  /*
   * The trigger, same footprint as every other icon button on the site
   * (ThemeToggle.astro's `.tt-open`, SettingsPanel.astro's `.sp-open`): the
   * chip and border move to `::before` at `--icon-btn-chip` so the visible
   * square can be smaller than the real `--icon-btn-hit` box a pointer has
   * to reach, and the border reads `--accent-day` for the reason those two
   * files already measured (clears the 3:1 a non-text border needs against
   * every one of the four day colours). Unlike those two this button keeps
   * its own visible text (the current size), so it is not sized square:
   * `min-inline-size` only floors it at the same hit target, and padding
   * gives the number room past that floor.
   */
  .pg-size-open {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.85rem;
    padding-inline: 0.6rem;
    cursor: pointer;
  }

  .pg-size-open::before {
    content: '';
    position: absolute;
    inset: 0;
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  .pg-size-open span {
    position: relative;
  }

  .pg-size-open:hover,
  .pg-size-open:focus-visible,
  .pg-size-open[aria-expanded='true'] {
    color: var(--accent);
  }

  .pg-size-open:hover::before,
  .pg-size-open:focus-visible::before,
  .pg-size-open[aria-expanded='true']::before {
    border-color: var(--accent);
  }

  .pg-size-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * Positioned by page-size.ts, which sets top/left in pixels once it knows
   * where the trigger is: same `place()` mechanism, same reason, as
   * ThemeToggle.astro's own `.tt-menu` (see that file's own comment on why
   * `display` never belongs here). `--font-display`, not `--font-mono`: this
   * row already reads Departure Mono (`.pagination` above), and this menu
   * is that row's own popup rather than the settings panel's, so it keeps
   * that row's face instead of the settings menu's.
   */
  .pg-size-menu {
    position: fixed;
    z-index: 60;
    margin: 0;
    min-inline-size: 6rem;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    padding: 0.3rem 0;
    font-family: var(--font-display);
  }

  .pg-size-menu:popover-open,
  .pg-size-menu:not([popover]):not([hidden]) {
    display: flex;
    flex-direction: column;
  }

  .pg-size-option {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    border: 0;
    border-block-end: var(--border) solid var(--rule);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 0.85rem;
    text-align: start;
    padding: 0.4rem 1rem;
    cursor: pointer;
  }

  .pg-size-option:last-child {
    border-block-end: 0;
  }

  .pg-size-option:hover,
  .pg-size-option:focus-visible {
    background: var(--rule);
  }

  .pg-size-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* The current choice, same convention as ThemeToggle.astro's own
     `.tt-option[aria-current='true']`. */
  .pg-size-option[aria-current='true'] {
    color: var(--accent);
    font-weight: bold;
  }

  .numbers {
    display: flex;
    flex-wrap: wrap;
    margin: 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  .numbers li + li {
    margin-inline-start: 0.15rem;
  }

  /*
   * Every control here, previous, next, each page number, shares the
   * header's own icon-button footprint (ThemeToggle.astro/
   * SettingsPanel.astro, both read in full before writing this):
   * --icon-btn-hit is the real 44px hit target, --icon-btn-chip the smaller
   * bordered square actually drawn (on ::before, so the visible chip can be
   * smaller than the box a pointer has to reach), --accent-day the border
   * every icon button already reads. These stay <a> (or, disabled/current, a
   * plain <span>) rather than becoming <button>: they navigate, which is
   * what a link is for, and there is nothing here to submit the way
   * ThemeToggle's own menu options do.
   */
  .pg-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .pg-btn::before {
    content: '';
    position: absolute;
    inline-size: var(--icon-btn-chip);
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  /*
   * position: relative for the same reason ThemeToggle's own .tt-icon needs
   * it: the ::before chip above is absolutely positioned and opaque, and an
   * absolutely positioned box paints over a non-positioned sibling whatever
   * the source order says. Giving the label a position moves it into the
   * same later paint step the chip is already in, so tree order (the label
   * comes after ::before) decides, and the label draws on top.
   */
  .pg-glyph {
    position: relative;
    font-size: var(--icon-btn-glyph);
    font-variant-numeric: tabular-nums;
  }

  .pg-btn:hover,
  .pg-btn:focus-visible {
    color: var(--accent);
  }

  .pg-btn:hover::before,
  .pg-btn:focus-visible::before {
    border-color: var(--accent);
  }

  .pg-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pg-btn[aria-disabled='true'] {
    color: var(--muted);
    opacity: 0.5;
    cursor: default;
  }

  /*
   * The current page: this list's own destaque colour, the day colour, same
   * rule PostList.astro's own section label reads, kept from the plain-text
   * version this replaces.
   */
  /*
   * The current page fills solid in the day's own colour, with the page ground
   * as the ink on top. It reads `--post-accent-fill` (prose/links.css) rather
   * than the raw accent: that token is the same day colour already mixed the
   * few percent it needs to clear 4.5:1 against `--bg` on either ground, so
   * the number stays readable on a green or yellow day where the raw colour
   * would not. Painted on ::before, the same element the chip's own border is
   * on, so the fill and the frame are one box.
   */
  .pg-current {
    color: var(--bg);
  }

  .pg-current::before {
    background: var(--post-accent-fill);
  }

  .pg-current .pg-glyph {
    font-weight: bold;
  }

  /*
   * min-inline-size matches .pg-btn's own hit target, not because the
   * ellipsis is a control (it is aria-hidden and un-clickable, plain text),
   * but so it takes up the same width as every real slot: the whole point of
   * the 7-slot rule above is a row that holds a constant width as the
   * current page changes, and an undersized ellipsis would undo that.
   */
  .pg-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    color: var(--muted);
  }
</style>
