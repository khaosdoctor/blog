---
import type { Page } from 'astro'
import { t, type Locale } from '../i18n/ui'

interface Props {
  page: Page<unknown>
  basePath: string
  locale: Locale
}

const { page, basePath, locale } = Astro.props

function hrefFor(pageNumber: number): string {
  return pageNumber === 1 ? basePath : `${basePath}${pageNumber}/`
}

type Slot = number | 'ellipsis'

// Yields exactly 7 slots at 8+ pages, so the row holds a constant width as
// the page changes.
function paginationSlots(count: number, current: number): Slot[] {
  const BOUNDARY = 1
  const SIBLING = 1
  // Below this the boundaries and siblings already cover every page.
  const COLLAPSE_FLOOR = 2 * BOUNDARY + 2 * SIBLING + 3
  if (count < COLLAPSE_FLOOR + 1) {
    return Array.from({ length: count }, (_, index) => index + 1)
  }

  const range = (start: number, end: number): number[] =>
    Array.from({ length: end - start + 1 }, (_, index) => start + index)

  const startPages = range(1, BOUNDARY)
  const endPages = range(count - BOUNDARY + 1, count)

  const siblingsStart = Math.max(
    Math.min(current - SIBLING, count - BOUNDARY - SIBLING * 2 - 1),
    BOUNDARY + 2
  )
  const siblingsEnd = Math.min(
    Math.max(current + SIBLING, BOUNDARY + SIBLING * 2 + 2),
    endPages[0] - 2
  )

  const slots: Slot[] = [...startPages]

  if (siblingsStart > BOUNDARY + 2) {
    slots.push('ellipsis')
  } else if (BOUNDARY + 1 < count - BOUNDARY) {
    slots.push(BOUNDARY + 1)
  }

  slots.push(...range(siblingsStart, siblingsEnd))

  if (siblingsEnd < count - BOUNDARY - 1) {
    slots.push('ellipsis')
  } else if (count - BOUNDARY > BOUNDARY) {
    slots.push(count - BOUNDARY)
  }

  slots.push(...endPages)

  return slots
}

const slots = paginationSlots(page.lastPage, page.currentPage)
---

{
  page.lastPage > 1 && (
    <nav class="pagination" aria-label={t(locale, 'pagination')}>
      <hr class="pg-rule" />
      {page.url.prev ? (
        <a class="pg-btn" href={page.url.prev} rel="prev" aria-label={t(locale, 'paginationPrev')}>
          <span class="pg-glyph" aria-hidden="true">
            {'<<'}
          </span>
        </a>
      ) : (
        <span class="pg-btn" aria-hidden="true">
          <span class="pg-glyph">
            {'<<'}
          </span>
        </span>
      )}
      <ol class="numbers">
        {slots.map((slot) =>
          slot === 'ellipsis' ? (
            <li aria-hidden="true">
              <span class="pg-ellipsis">…</span>
            </li>
          ) : (
            <li>
              {slot === page.currentPage ? (
                <span class="pg-btn pg-current" aria-current="page">
                  <span class="pg-glyph">{slot}</span>
                </span>
              ) : (
                <a class="pg-btn" href={hrefFor(slot)} aria-label={t(locale, 'paginationGoTo', slot)}>
                  <span class="pg-glyph">{slot}</span>
                </a>
              )}
            </li>
          )
        )}
      </ol>
      {page.url.next ? (
        <a class="pg-btn" href={page.url.next} rel="next" aria-label={t(locale, 'paginationNext')}>
          <span class="pg-glyph" aria-hidden="true">
            {'>>'}
          </span>
        </a>
      ) : (
        <span class="pg-btn" aria-hidden="true">
          <span class="pg-glyph">
            {'>>'}
          </span>
        </span>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-block-start: 5px;
    border-block-start: 0;
    font-family: var(--font-display);
    font-size: 0.85rem;
  }

  /* `inline-size` cannot shorten a flex item, so the box spans the row and only
     the paint is cut. The mask needs that same size or it fades the wrong edges. */
  .pg-rule {
    flex-basis: 100%;
    margin-block: 0 1.2rem;
    background-size: var(--rule-length) var(--rule-weight);
    background-position: center;
    background-repeat: no-repeat;
    mask: linear-gradient(to right, transparent, black 35%, black 65%, transparent) center / var(--rule-length) 100%
      no-repeat;
  }

  @media (min-width: 70rem) {
    .pagination {
      inline-size: var(--content-width);
      padding-inline: var(--shell-inset);
      margin-inline-start: 50%;
      transform: translateX(calc(var(--content-width) / -2));
    }
  }

  .numbers {
    display: flex;
    flex-wrap: wrap;
    margin: 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  .numbers li + li {
    margin-inline-start: 0.15rem;
  }

  .pg-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .pg-btn::before {
    content: '';
    position: absolute;
    inline-size: var(--icon-btn-chip);
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  /* Without a position the opaque ::before chip paints over this label. */
  .pg-glyph {
    position: relative;
    font-size: var(--icon-btn-glyph);
    font-variant-numeric: tabular-nums;
  }

  .pg-btn:hover,
  .pg-btn:focus-visible {
    color: var(--accent);
  }

  .pg-btn:hover::before,
  .pg-btn:focus-visible::before {
    border-color: var(--accent);
  }

  .pg-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pg-btn[aria-disabled='true'] {
    color: var(--muted);
    opacity: 0.5;
    cursor: default;
  }

  /* Not the raw accent: this token is mixed to stay readable on either ground. */
  .pg-current {
    color: var(--bg);
  }

  .pg-current::before {
    background: var(--post-accent-fill);
  }

  .pg-current .pg-glyph {
    font-weight: bold;
  }

  /* Sized like .pg-btn though it is not a control: every slot has to match. */
  .pg-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    color: var(--muted);
  }
</style>
