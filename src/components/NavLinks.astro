---
import { getCategories } from '../lib/taxonomy'
import { LOCALES, localePath, SOURCE_LOCALE, t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

type LinkKey = 'navPosts' | 'navSeries' | 'navTags' | 'navAbout'

const LINKS: { key: LinkKey; path: string }[] = [
  { key: 'navPosts', path: '/' },
  { key: 'navSeries', path: '/series/' },
  { key: 'navTags', path: '/tags/' },
  { key: 'navAbout', path: 'https://lsantos.dev' },
]

function href(locale: Locale, path: string): string {
  return path.startsWith('https://') ? path : localePath(locale, path)
}

const OTHER_LOCALES = LOCALES.filter((entry) => entry !== SOURCE_LOCALE)
const localePrefix = OTHER_LOCALES.find(
  (entry) => Astro.url.pathname === `/${entry}` || Astro.url.pathname.startsWith(`/${entry}/`),
)
const path = localePrefix === undefined ? Astro.url.pathname : Astro.url.pathname.slice(localePrefix.length + 1) || '/'

// A post page and a category listing share the URL shape `/<segment>/`; only
// the category set can tell them apart at render time.
const categorySlugs = new Set((await getCategories()).keys())

function isCurrent(key: LinkKey, path: string, categorySlugs: Set<string>): boolean {
  switch (key) {
    case 'navPosts': {
      if (path === '/' || /^\/\d+\/$/.test(path)) return true
      // The category test has to be there, or this also catches /tags/<name>/
      // and every individual post.
      const section = /^\/([^/]+)\/(?:\d+\/)?$/.exec(path)
      return section !== null && categorySlugs.has(section[1])
    }
    case 'navTags':
      return path === '/tags/' || /^\/tags\/[^/]+\/(?:\d+\/)?$/.test(path)
    case 'navSeries':
      // No pagination arm: series listings never paginate.
      return path === '/series/' || /^\/series\/[^/]+\/$/.test(path)
    case 'navAbout':
      // Leaves the site, so it is never the page being read.
      return false
    default:
      return key satisfies never
  }
}
---

<nav class="nav-links" aria-label={t(locale, 'primaryNav')}>
  {
    LINKS.map((link) => (
      <a
        href={href(locale, link.path)}
        aria-current={isCurrent(link.key, path, categorySlugs) ? 'page' : undefined}
      >
        {t(locale, link.key)}
      </a>
    ))
  }
</nav>

<style>
  .nav-links {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: calc(0.75rem + 2pt);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav-links > a {
    margin-inline-end: 0.5rem;
  }

  .nav-links > a:last-child {
    margin-inline-end: 0;
  }

  .nav-links a {
    /* background-clip keeps the hover fill on the visible line, off the
       invisible tap padding. */
    display: inline-block;
    padding-inline: 1px;
    padding-block: 0.7rem;
    margin-block: -0.7rem;
    background-clip: content-box;
    color: inherit;
    background-color: transparent;
    text-decoration-line: underline;
    text-underline-offset: 3px;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a[aria-current='page'] {
    /* background-color, never the shorthand: the shorthand resets
       background-clip and the fill would flood the invisible tap padding. */
    background-color: var(--accent-day);
    color: var(--bg);
    text-decoration-line: none;
  }
</style>
