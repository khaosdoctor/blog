---
import { type Locale, t } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<button
  type="button"
  class="font-toggle"
  aria-label={t(locale, 'fontToggle')}
  aria-pressed="false"
>
  <span class="ft-glyph" aria-hidden="true">Aa</span>
</button>

<script>
  const BODY_FACE_KEY = 'body-face'
  const buttons = document.querySelectorAll<HTMLButtonElement>('.font-toggle')

  if (buttons.length > 0) {
    const isSans = (): boolean => document.documentElement.getAttribute('data-body-face') === 'sans'

    const syncAll = (): void => {
      const pressed = String(isSans())
      for (const b of buttons) b.setAttribute('aria-pressed', pressed)
    }

    syncAll()

    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const next = isSans() ? null : 'sans'
        if (next === null) {
          document.documentElement.removeAttribute('data-body-face')
          localStorage.removeItem(BODY_FACE_KEY)
        } else {
          document.documentElement.setAttribute('data-body-face', next)
          localStorage.setItem(BODY_FACE_KEY, next)
        }
        syncAll()
      })
    }
  }
</script>

<style>
  .font-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 0;
    cursor: pointer;
  }

  .font-toggle::before {
    content: '';
    position: absolute;
    inline-size: var(--icon-btn-chip);
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  .ft-glyph {
    position: relative;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .font-toggle:hover,
  .font-toggle:focus-visible,
  .font-toggle[aria-pressed='true'] {
    color: var(--accent);
  }

  .font-toggle:hover::before,
  .font-toggle:focus-visible::before,
  .font-toggle[aria-pressed='true']::before {
    border-color: var(--accent);
  }

  .font-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
