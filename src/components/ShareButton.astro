---
import { type Locale, t } from '../i18n/ui'

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className } = Astro.props
---

<span
  class:list={['share-wrap', className]}
  data-share-label={t(locale, 'share')}
  data-share-copied={t(locale, 'linkCopied')}
>
  <button type="button" class="share-btn" aria-label={t(locale, 'share')} aria-expanded="false">
    <svg class="share-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 8V14H12V8"/>
      <path d="M8 10V2"/>
      <path d="M5 5L8 2L11 5"/>
    </svg>
    <span class="share-label">{t(locale, 'share').toLowerCase()}</span>
  </button>
  <div class="share-menu">
    <a class="share-item" data-share="x" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      <span>X</span>
    </a>
    <a class="share-item" data-share="bluesky" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 568 501" fill="currentColor"><path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.86 122.992-172.272-30.859-185.702-70.281-2.462-7.227-3.614-10.608-3.631-7.733-.017-2.875-1.169.506-3.631 7.733-13.43 39.422-65.842 193.273-185.702 70.281-63.111-64.76-33.89-129.52 80.986-149.071-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.659 0 75.291 0 57.946 0-28.906 76.135-1.612 123.121 33.664z"/></svg>
      <span>Bluesky</span>
    </a>
    <a class="share-item" data-share="mastodon" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054 19.648 19.648 0 0 0 4.636.536c.377 0 .754 0 1.132-.015 1.53-.05 3.14-.154 4.633-.42 .038-.007.076-.015.111-.024 2.475-.464 4.833-1.917 5.079-5.537.01-.145.034-1.507.034-1.652 0-.506.196-3.592-.011-5.49z"/><path d="M19.429 8.44v5.609h-2.218V8.629c0-1.148-.482-1.73-1.448-1.73-1.067 0-1.601.691-1.601 2.058v2.98h-2.204v-2.98c0-1.367-.534-2.058-1.6-2.058-.967 0-1.449.582-1.449 1.73v5.42H6.691V8.44c0-1.148.293-2.06.878-2.737.604-.676 1.395-1.022 2.378-1.022 1.137 0 1.998.437 2.562 1.31l.552.926.552-.926c.564-.873 1.425-1.31 2.562-1.31.983 0 1.774.346 2.378 1.022.585.676.878 1.589.878 2.737z" fill="var(--bg)"/></svg>
      <span>Mastodon</span>
    </a>
    <a class="share-item" data-share="linkedin" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      <span>LinkedIn</span>
    </a>
    <a class="share-item" data-share="reddit" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
      <span>Reddit</span>
    </a>
    <a class="share-item" data-share="hackernews" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 24V0h24v24H0zM6.951 5.896l4.112 7.708v5.064h1.583v-4.972l4.148-7.799h-1.749l-2.457 4.875c-.372.745-.688 1.434-.688 1.434s-.297-.708-.651-1.434L8.831 5.896h-1.88z"/></svg>
      <span>Hacker News</span>
    </a>
    <a class="share-item" data-share="threads" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.187.408-2.26 1.33-3.017.834-.684 1.988-1.077 3.344-1.138 1.173-.053 2.267.08 3.26.392-.09-.548-.27-1.022-.537-1.417-.49-.724-1.277-1.1-2.339-1.12h-.037c-.834 0-1.86.296-2.41 1.063l-1.721-1.17C8.78 5.738 10.268 5.2 11.84 5.2h.051c1.627.027 2.866.625 3.685 1.778.654.921 1.036 2.103 1.142 3.52.587.245 1.112.554 1.569.932 1.2.99 1.96 2.394 2.199 4.06.316 2.203-.348 4.408-1.87 6.2C16.7 23.59 14.296 24.024 12.186 24zm-1.075-7.994c-.874.04-1.541.283-1.986.723-.37.365-.554.823-.52 1.293.06 1.018.95 1.672 2.327 1.598 1.078-.058 1.907-.48 2.464-1.254.395-.548.658-1.262.79-2.14-.72-.206-1.513-.313-2.368-.275l-.707.055z"/></svg>
      <span>Threads</span>
    </a>
    <a class="share-item" data-share="email" target="_blank" rel="noopener noreferrer">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="14" height="10" rx="1"/>
        <path d="M1 4l7 5 7-5"/>
      </svg>
      <span>Email</span>
    </a>
    <hr class="share-divider" />
    <button type="button" class="share-item" data-share="copy">
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="5" width="9" height="9" rx="1"/>
        <path d="M11 5V3a1 1 0 00-1-1H3a1 1 0 00-1 1v7a1 1 0 001 1h2"/>
      </svg>
      <span data-copy-label>{t(locale, 'copyLink')}</span>
    </button>
  </div>
</span>

<style>
  .share-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .share-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.15rem 0.55rem;
    border: var(--btn-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: max(0.75rem, 12px);
    cursor: pointer;
  }

  .share-icon {
    position: relative;
  }

  .share-label {
    position: relative;
  }

  @media (max-width: 47.99rem) {
    .share-label {
      display: none;
    }

    .share-btn {
      padding: 0;
      border: 0;
      min-inline-size: var(--icon-btn-hit);
      min-block-size: var(--icon-btn-hit);
    }

    .share-btn::before {
      content: '';
      position: absolute;
      inline-size: var(--icon-btn-chip);
      block-size: var(--icon-btn-chip);
      border: var(--btn-border);
      border-radius: var(--radius);
      background: var(--bg);
      pointer-events: none;
    }
  }

  .share-btn:hover,
  .share-btn:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 47.99rem) {
    .share-btn:hover::before,
    .share-btn:focus-visible::before {
      border-color: var(--accent);
    }
  }

  .share-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .share-menu {
    display: none;
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    margin-block-start: 0.3rem;
    padding: 0.35rem 0;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    min-inline-size: 11rem;
    z-index: 10;
    font-family: var(--font-mono);
    font-size: max(0.75rem, 12px);
  }

  .share-wrap[data-open] .share-menu {
    display: block;
  }

  .share-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.7rem;
    color: var(--fg);
    text-decoration: none;
    border: none;
    background: transparent;
    font: inherit;
    cursor: pointer;
    inline-size: 100%;
    white-space: nowrap;
  }

  .share-item:hover,
  .share-item:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }

  .share-item svg {
    flex-shrink: 0;
  }

  .share-divider {
    border: none;
    border-block-start: 1px solid var(--rule);
    margin: 0.25rem 0.7rem;
  }

  .share-wrap.share-bottom .share-menu {
    inset-block-start: auto;
    inset-block-end: 100%;
    margin-block-start: 0;
    margin-block-end: 0.3rem;
  }
</style>

<script>
  function closeAllMenus() {
    for (const wrap of document.querySelectorAll<HTMLElement>('.share-wrap')) {
      wrap.removeAttribute('data-open')
      wrap.querySelector('.share-btn')?.setAttribute('aria-expanded', 'false')
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.share-btn')

    if (!btn) {
      closeAllMenus()
      return
    }

    const wrap = btn.closest<HTMLElement>('.share-wrap')!
    const menu = wrap.querySelector<HTMLElement>('.share-menu')!
    const title = document.querySelector('h1')?.textContent?.trim() ?? document.title
    const url = location.href

    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      navigator.share({ title, url }).catch(() => {})
      return
    }

    const wasOpen = wrap.hasAttribute('data-open')
    closeAllMenus()

    if (!wasOpen) {
      const text = encodeURIComponent(title)
      const encodedUrl = encodeURIComponent(url)

      const xLink = menu.querySelector<HTMLAnchorElement>('[data-share="x"]')
      if (xLink) xLink.href = `https://x.com/intent/post?text=${text}&url=${encodedUrl}`

      const bsLink = menu.querySelector<HTMLAnchorElement>('[data-share="bluesky"]')
      if (bsLink) bsLink.href = `https://bsky.app/intent/compose?text=${text}+${encodedUrl}`

      const liLink = menu.querySelector<HTMLAnchorElement>('[data-share="linkedin"]')
      if (liLink) liLink.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`

      const mastoLink = menu.querySelector<HTMLAnchorElement>('[data-share="mastodon"]')
      if (mastoLink) mastoLink.href = `https://mastodonshare.com/?text=${text}&url=${encodedUrl}`

      const redditLink = menu.querySelector<HTMLAnchorElement>('[data-share="reddit"]')
      if (redditLink) redditLink.href = `https://www.reddit.com/submit?url=${encodedUrl}&title=${text}`

      const hnLink = menu.querySelector<HTMLAnchorElement>('[data-share="hackernews"]')
      if (hnLink) hnLink.href = `https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${text}`

      const threadsLink = menu.querySelector<HTMLAnchorElement>('[data-share="threads"]')
      if (threadsLink) threadsLink.href = `https://www.threads.net/intent/post?text=${text}+${encodedUrl}`

      const emailLink = menu.querySelector<HTMLAnchorElement>('[data-share="email"]')
      if (emailLink) emailLink.href = `mailto:?subject=${text}&body=${encodedUrl}`

      wrap.setAttribute('data-open', '')
      btn.setAttribute('aria-expanded', 'true')
    }
  })

  document.addEventListener('click', (e) => {
    const copyBtn = (e.target as Element).closest('[data-share="copy"]')
    if (!copyBtn) return
    e.preventDefault()

    const wrap = copyBtn.closest<HTMLElement>('.share-wrap')!
    const copiedText = wrap.getAttribute('data-share-copied') ?? 'copied'
    const label = copyBtn.querySelector('[data-copy-label]')
    const original = label?.textContent ?? ''

    navigator.clipboard.writeText(location.href).then(() => {
      if (label) {
        label.textContent = copiedText
        setTimeout(() => { label.textContent = original }, 1500)
      }
    })

    closeAllMenus()
  })
</script>
