---
import { formatCoverByline } from '../lib/cover'

interface Props {
  slug: string
  title: string
  category: string
  pubDate: Date
  lang: 'pt' | 'en'
  authorName: string
}

const { slug, title, category, pubDate, lang, authorName } = Astro.props
const byline = formatCoverByline(pubDate, lang, authorName)
---

<div class="cover-hero" data-cover-hero data-slug={slug} data-title={title} data-category={category} data-byline={byline} hidden>
  <div class="cover-hero-canvas" aria-hidden="true"></div>
  <div class="cover-hero-meta"></div>
</div>

{/* Runs during parse so the box is reserved before first paint. */}
<script is:inline>
  if ('noModule' in HTMLScriptElement.prototype) {
    const hero = document.querySelector('[data-cover-hero]')
    if (hero) {
      hero.removeAttribute('hidden')
      const article = hero.closest('article')
      if (article) article.setAttribute('data-cover-active', '')
    }
  }
</script>

<script>
  import '../scripts/cover-hero'
</script>

<style>
  .cover-hero {
    /* The box shows the middle `--cover-span` units of the drawing's 1200, so each side loses half the difference. */
    --cover-span: 1200;
    --cover-crop: calc((1200 - var(--cover-span)) / 2);

    position: relative;
    aspect-ratio: var(--cover-span) / 630;
    width: 100%;
    margin-block-end: 2.5rem;
    overflow: hidden;
    /* `n * (100cqw / var(--cover-span))` is SVG unit n at every viewport, so the overlay below is written in the card's own coordinates. */
    container-type: inline-size;
  }

  /* Phone: the card bleeds over both page gutters, cropping its side frame lines off-screen (the inner rect's outer edge is unit 69.5).
     Cancelling the known gutter, rather than sizing from 100vw, keeps a scrollbar out of the sum. */
  @media (max-width: 47.99rem) {
    .cover-hero {
      --cover-span: 990;

      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
    }

    /* The row below reads at its 11px floor, taller than the slot the drawing left it, so it clears the title downwards. */
    .cover-hero-meta {
      margin-block-start: 0.75rem;
    }
  }

  .cover-hero-canvas :global(svg) {
    display: block;
    width: calc(1200 / var(--cover-span) * 100%);
    height: 100%;
    margin-inline-start: calc(var(--cover-crop) / var(--cover-span) * -100%);
  }

  .cover-hero-meta {
    position: absolute;
    inset-inline-start: calc((var(--cover-meta-x, 160) - var(--cover-crop)) * (100cqw / var(--cover-span)));
    inset-block-start: calc(var(--cover-meta-y, 470) * (100cqw / var(--cover-span)));
    transform: translateY(-50%);
    font-size: max(11px, calc(var(--cover-meta-size, 20) * (100cqw / var(--cover-span))));
  }

  .cover-hero .cover-hero-meta :global(.meta) {
    margin: 0;
    color: var(--cover-meta-ink);
    font-family: var(--font-display);
    font-size: 1em;
  }

  .cover-hero .cover-hero-meta :global(.chip) {
    --chip-ink: var(--cover-chip-ink);

    padding: 0.25em 0.7em;
    border-width: 0.3em;
    font-family: var(--font-display);
    font-size: max(10px, calc(var(--cover-chip-size, 17) * (100cqw / var(--cover-span))));
  }

  /* `time + [aria-hidden]` is the dot after the date, not the chip's own. */
  :global(article[data-cover-active] h1),
  :global(article[data-cover-active] .meta time),
  :global(article[data-cover-active] .meta time + [aria-hidden]),
  :global(article[data-cover-active] .authors) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Direct child: must stop matching once the row moves into the overlay slot. */
  :global(article[data-cover-active] > .meta) {
    position: absolute;
    visibility: hidden;
  }
</style>
