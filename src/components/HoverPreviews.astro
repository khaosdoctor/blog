---
import { t, type Locale } from '../i18n/ui'
import '../styles/hover-previews.css'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<p
  class="hp-settings"
  hidden
  data-loading={t(locale, 'previewLoading')}
  data-close={t(locale, 'previewClose')}
  data-pin={t(locale, 'previewPin')}
  data-unpin={t(locale, 'previewUnpin')}
  data-drag={t(locale, 'previewDrag')}
  data-minimize={t(locale, 'previewMinimize')}
  data-restore={t(locale, 'previewRestore')}
  data-unwritten={t(locale, 'previewUnwritten')}
></p>

<script>
  import '../scripts/hover-previews'
</script>
