---
// Drop this once anywhere in the page (BaseLayout is the natural spot). It
// takes no props beyond the locale: at runtime it scans <article a href> and
// attaches hover / long-press preview cards. With JS disabled every link stays
// a plain, fully working <a href>, this only ever adds behaviour on top.
import { t, type Locale } from '../i18n/ui'
import '../styles/hover-previews.css'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

{/* Cards are built in the browser, so their labels cannot come from t()
    directly. They ride along on this element instead, which the script reads
    once. The persist checkbox that used to live in here moved to
    SettingsPanel.astro (docs/design.md, Settled); this element now only ever
    carries data, so it stays permanently hidden rather than being toggled. */}
<p
  class="hp-settings"
  hidden
  data-loading={t(locale, 'previewLoading')}
  data-close={t(locale, 'previewClose')}
  data-pin={t(locale, 'previewPin')}
  data-unpin={t(locale, 'previewUnpin')}
  data-drag={t(locale, 'previewDrag')}
  data-minimize={t(locale, 'previewMinimize')}
  data-restore={t(locale, 'previewRestore')}
  data-unwritten={t(locale, 'previewUnwritten')}
></p>

<script>
  import '../scripts/hover-previews'
</script>
