---
import type { Post } from '../lib/posts'
import { formatDate } from '../lib/posts'

interface Props {
  posts: Post[]
  showCategory?: boolean
}

const { posts, showCategory = true } = Astro.props
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <a href={`/${post.id}/`}>{post.data.title}</a>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, post.data.lang)}
          </time>
          {showCategory && (
            <>
              <span aria-hidden="true">·</span>
              <a href={`/${post.data.category}/`} class="category">
                {post.data.category}
              </a>
            </>
          )}
        </p>
        <p class="excerpt">{post.data.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    padding: 0;
    list-style: none;
  }

  .posts li + li {
    margin-block-start: 2.5rem;
  }

  .posts > li > a {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.2rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
  }

  .category {
    color: var(--muted);
  }

  .excerpt {
    margin-block-start: 0.3rem;
  }
</style>
