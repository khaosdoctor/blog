---
import type { Post } from '../lib/posts'
import { estimateReadingTime, formatDate, isScheduled, urlOf } from '../lib/posts'
import { localePath } from '../i18n/ui'
import ReadingTime from './ReadingTime.astro'
import { LISTING_LEADER } from '../lib/listing'

interface Props {
  posts: Post[]
  showCategory?: boolean
}

const { posts, showCategory = true } = Astro.props

// This list renders inside both page trees, so the link has to carry the post's
// own language or an English reader leaves for the Portuguese section index.
function categoryUrl(post: Post): string {
  return localePath(post.data.lang, `/${post.data.category}/`)
}


// A noindex post is still listed, so nothing on the row says it is unlisted
// everywhere else. The marker is for the author while writing and never ships.
const showPrivate = import.meta.env.DEV
---

<ol class="listing">
  {
    posts.map((post) => (
      <li class="listing-row">
        <span class="listing-date">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, post.data.lang)}</time>
        </span>
        <a href={urlOf(post)} class="listing-title">
          {showPrivate && post.data.noindex && <span class="listing-private">[private]</span>}
          {showPrivate && isScheduled(post) && (
            <span class="listing-scheduled">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                <path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
              [scheduled]
            </span>
          )}
          {post.data.title}
        </a>
        <span class="listing-leader" aria-hidden="true">
          {LISTING_LEADER}
        </span>
        {showCategory && (
          <a href={categoryUrl(post)} class="listing-label">
            {post.data.category}
          </a>
        )}
        <span class="listing-figure">
          <ReadingTime minutes={estimateReadingTime(post.body ?? '')} locale={post.data.lang} />
        </span>
      </li>
    ))
  }
</ol>
