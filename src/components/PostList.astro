---
import type { Post } from '../lib/posts'
import { estimateReadingTime, formatDate, urlOf } from '../lib/posts'
import { localePath } from '../i18n/ui'
import ReadingTime from './ReadingTime.astro'

/**
 * The decided candidate from the theme lab (content/blog/theme-lab/components/
 * ChromeList.vue, "tabela densa, 4 colunas"): date, title, section and reading
 * time in one row, a dotted leader running from the end of the title to the
 * trailing columns. Dense enough that a reader scanning the archive sees many
 * posts per screen rather than few, which per the bench's own note is the
 * whole reason this candidate, and not one of the six others on the same
 * bench, survives a hundred posts: the eye runs down the title column, and
 * the leader only carries it sideways to the date or the section when the
 * reader goes looking for one of those.
 *
 * An earlier pass of this file drew an 88px cover thumbnail on every row
 * (the "cartões"/grade candidate on the same bench) after reading the
 * decision settings as asking for both a table and a cover. They do not
 * combine: the table candidate draws no image at all, in the bench or here.
 * Every thumbnail, the astro:assets Image import, the cover/no-cover branch
 * and their CSS are removed; nothing about images belongs to this candidate.
 *
 * The excerpt (post.data.description) that used to sit under every title is
 * also gone: the bench's own dense table never carried one, that is part of
 * what "dense" means for it, and the description still exists, HoverPreviews
 * reads it straight from each post's own built page.
 */
interface Props {
  posts: Post[]
  showCategory?: boolean
}

const { posts, showCategory = true } = Astro.props

// The section index of the post's own language. This list renders inside both
// page trees, and a bare /<category>/ sent an English reader from an English
// listing to a Portuguese one.
function categoryUrl(post: Post): string {
  return localePath(post.data.lang, `/${post.data.category}/`)
}

// The bench's own leader was "─" (a box-drawing dash), a solid run that read
// as a hard rule once titles could wrap: see .leader's own comment below for
// why this is now a short, fixed-width, dimmed run of dots instead. 24 of
// them at this font-size overflows any width .leader is ever given, clipped
// by its own overflow:hidden the same way the old run was.
const LEADER = '·'.repeat(200)
---

<ol class="posts">
  {
    posts.map((post) => (
      <li>
        <span class="date">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, post.data.lang)}</time>
        </span>
        <a href={urlOf(post)} class="title">
          {post.data.title}
        </a>
        <span class="leader" aria-hidden="true">
          {LEADER}
        </span>
        {showCategory && (
          <a href={categoryUrl(post)} class="category">
            {post.data.category}
          </a>
        )}
        {/* post.body is the raw markdown/MDX Astro already loaded for this
            entry; see estimateReadingTime's own comment for why this reads
            that instead of calling render() again per post. "min", not a t()
            call: the post's own page (src/pages/[...slug].astro) already
            hardcodes the same abbreviation rather than the unused
            `readingTime` ui key, and this matches that existing choice
            rather than fixing it under a different task. */}
        <span class="read">
          <ReadingTime minutes={estimateReadingTime(post.body ?? '')} locale={post.data.lang} />
        </span>
      </li>
    ))
  }
</ol>

<style>
  /*
   * Tracking -1/100em, the row height (13, as rows.value / 20 in rem) and the
   * muted mono baseline every column but the title and the section keeps:
   * set here, on the real elements this file renders. DateCopy used to be
   * one of them, a child component with its own class this file could only
   * reach through plain inheritance; it is gone now, and <time> is a plain
   * child of `.date` instead, so that inheritance is all this ever needed.
   */
  .posts {
    padding: 0;
    list-style: none;
    letter-spacing: -0.01em;
  }

  /*
   * Past the same 70rem breakpoint BrandHeader's `.chrome` and the footer
   * already widen at (theme.css/BaseLayout.astro), this list does too: below
   * this it measured `var(--measure)` (78ch), `main`'s own default width and
   * exactly the column a post's own prose reads at, which made a table of
   * many posts read as a strip of running text rather than the header's own
   * wider row above it. `main` itself keeps `--measure` (a real post's
   * reading column still wants that), so the list breaks out of it instead
   * of `main` changing: `main` is this box's containing block, and margin
   * percentages resolve against a containing block's width regardless of
   * what that width actually is, so `margin-inline-start: 50%` always puts
   * this box's start edge at `main`'s own horizontal centre. `main` and
   * `body` are both centred and equally padded, so that centre is the
   * viewport's centre too; translateX(-40vw), half this box's own 80vw
   * width, pulls the box back so its centre ends up there instead of its
   * edge. The same full-bleed trick every CSS framework already uses for
   * 100vw/50vw, generalised to 80vw/40vw.
   */
  @media (min-width: 70rem) {
    .posts {
      inline-size: var(--chrome-width);
      /* The same inset the header's own row carries, so the rows begin and end
         exactly where the header's drawn edges do rather than a few pixels
         wider on both sides. */
      padding-inline: var(--chrome-inset);
      margin-inline-start: 50%;
      transform: translateX(calc(var(--chrome-width) / -2));
    }
  }

  .posts li {
    display: flex;
    /*
     * Centred, not baseline: the row mixes a small date/section/read-time
     * with a visibly larger title, and baseline alignment sizes the flex
     * line from the tallest item's own ascent/descent, which pushes every
     * smaller item off-centre inside the row's own (equal top and bottom)
     * padding-block. Centring keeps every item in the middle of the line
     * regardless of its own font-size, which is what reads as one row
     * centred in its own box rather than closer to the rule above.
     *
     * This still holds once the title wraps to two or three lines: the row's
     * own height grows to match, and centring puts the date/category/read
     * cluster in the middle of that taller box rather than pinned to its
     * top. flex-start was tried first and rejected: it aligns every item to
     * the title's own first line, which looks right for a one-line title but
     * re-introduces exactly the "smaller item reads as misplaced" problem
     * the comment above already solved, only against the title's cap-height
     * instead of its baseline. Centring is the one rule that already
     * generalises to both a one-line and a wrapped title without a second
     * special case.
     */
    align-items: center;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding-block: 0.65rem;
    /*
     * The quotes' own dashed recipe (quotes.css, 10px on and 6px off), the
     * same mark the pagination rule above the row of controls now draws, so
     * every horizontal rule on a listing page reads as one thing used three
     * times rather than three unrelated lines.
     *
     * Two differences from those two, both deliberate: it keeps the 1px weight
     * a row separator wants rather than the 2px a section break carries, and
     * it runs the row's full width instead of a centred half, because this
     * separates two rows rather than closing a block. And it draws in
     * `--muted` rather than `--rule`, whose dark tone carries a hint of purple
     * that read as coloured against the dim white of the row's own text.
     */
    border-block-end: 0;
    position: relative;
  }

  /*
   * The separator, on its own pseudo-element rather than as a background on
   * the row itself. It has to be its own box because it is masked, and a mask
   * applies to everything an element renders: on the `li` it would fade the
   * row's own text along with the rule.
   *
   * Three quarters of the row, fading out toward the right rather than
   * stopping at a hard edge. Two layers doing two jobs: the repeating gradient
   * draws the dashes (the same 10px on, 6px off the quotes and the pagination
   * use), and the mask ramps its alpha away over the last stretch. One
   * gradient cannot do both, since the dashes need a repeating pattern and the
   * fade needs a continuous one.
   */
  .posts li::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    inline-size: 75%;
    block-size: 1px;
    background-image: repeating-linear-gradient(
      to right,
      color-mix(in oklab, var(--muted) 45%, transparent) 0 10px,
      transparent 10px 16px
    );
    mask-image: linear-gradient(to right, #000 0 55%, transparent 100%);
  }

  /* No rule above the first row. The list already begins where the header's
     own row ends, so a line here reads as a second header edge rather than as
     the start of a table. Every row still carries its own bottom rule, so the
     rows stay separated from each other. */

  /* The last row drops its own bottom rule: Pagination.astro draws its own
     border-block-start immediately below, and the two stacked read as a
     doubled line with an empty band between them. */
  /* The separator is a pseudo-element now, so the last row removes it rather
     than zeroing a border width. */
  .posts li:last-child::after {
    content: none;
  }

  .date {
    flex: none;
    /* Departure Mono, not the inherited system mono stack: the reader asked
       for the same face the page numbers now use to reach the dates and
       reading times in this list too. */
    font-family: var(--font-display);
  }

  /*
   * A post title, so it takes the display face like every other title. It is
   * a bare <a> rather than a heading, which is why the global heading rule in
   * BaseLayout does not reach it and the face has to be named here.
   *
   * color is set explicitly rather than left to the global `a { color: accent }`
   * rule (BaseLayout.astro's `is:global` block): the decided candidate reads
   * the title in ink, at 16.26:1 light / 18.61:1 dark against the real page
   * grounds (both clear the bench's own measured 14.26:1 against its darker
   * bench-only ground), keeping the accent for the section label alone.
   *
   * Weight 400, not 600: Departure Mono ships one weight and a browser asked
   * for 600 synthesises it by smearing the glyphs sideways.
   */
  /*
   * flex-grow: 1, not 0: the title is now the row's one growing item, so its
   * assigned width is the row's own width minus whatever its flex: none
   * siblings (date, category, read) and the leader's own fixed width
   * actually reserve, a fixed number this box's content cannot inflate.
   * Titles that don't fit that width on one line wrap onto as many as they
   * need instead of the ellipsis this used to clip to: reading every title in
   * full is the one thing a list whose whole job is letting someone scan
   * titles cannot compromise on. min-inline-size: 0 is still what lets a flex
   * item shrink (and here, wrap) below its own content's natural one-line
   * width in the first place; flex-basis: auto would fight that by handing
   * shrink/wrap pressure to whichever item the algorithm favours instead of
   * a size decided by layout the way this one now is.
   */
  .title {
    /* Shrinks but does not grow, so a title takes exactly the room its own
       text needs and the leader claims what is left. If both grew they would
       split the leftover space between them and the leader would never reach
       the columns it is meant to guide the eye toward. */
    flex: 0 1 auto;
    min-inline-size: 0;
    margin-inline-start: 0.9rem;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  /*
   * The one hover convention this site already has for a plain-text link
   * (BaseLayout's `footer a:hover`): fill with the day colour, invert the
   * text to the page ground. Reused here rather than invented again.
   */
  .title:hover,
  .title:focus-visible {
    background: var(--accent-day, var(--accent));
    color: var(--bg);
  }

  /*
   * The bench's own leader was a solid box-drawing run (flex: 1 1 auto,
   * stretching to whatever the row had left after a single-line, ellipsis-
   * clipped title), which read as a hard rule once dimmed, and made no sense
   * once the title above could wrap to two or three lines: there is no one
   * line left for a full-width leader to run from and clip against, and a
   * rule drawn mid-way down a wrapped title, at the row's own vertical
   * centre, would connect to neither. Rather than invent a per-line leader
   * (unreachable in CSS without measuring rendered text), this is now a
   * short, fixed-width run of dots: flex: none, not flex: 1, so the title
   * (now the row's one growing item) is what claims the freed space instead.
   * A small width is enough for it to still read as connective punctuation
   * between the title and the date/category/read cluster, in both the
   * one-line and the wrapped case.
   *
   * Dimmed past `--muted` itself (5.17:1 light / 8.30:1 dark against `--bg`,
   * theme.css) via opacity, the same mechanism Pagination.astro's own
   * disabled prev/next already use for "present but not the point". A
   * decorative rule like this one carries no required information (the row
   * still reads in full through its date, title, category and read-time text
   * alone), so WCAG 1.4.11's exemption for purely decorative graphics applies
   * and there is no 3:1 floor to hold it to the way a meaningful border or
   * icon would be.
   */
  /*
   * The leader fills the room between the title and the trailing columns
   * rather than being a fixed stub. That is the whole job of a leader: it
   * carries the eye from a title across to the date and section on the far
   * side of a wide row. Cut to a fixed 1.75rem it guided nothing and read as
   * punctuation after the title.
   *
   * `flex: 1` with `min-inline-size: 0` so it takes what is left and can also
   * be squeezed to nothing on a narrow row, where the title needs every pixel
   * and there is no distance worth guiding across anyway.
   */
  .leader {
    /*
     * Basis 0, not `auto`. The dot run is 200 characters long, and with an
     * `auto` basis that whole string counts as this item's own ideal width, so
     * the row overflowed and flexbox shrank every shrinkable item to
     * compensate, the title included: titles were wrapping after three or four
     * words with empty room to their right. A zero basis means this item asks
     * for nothing and takes only what the title leaves, which is what a leader
     * is: the dots are decoration cut to fit, never a width the row owes them.
     */
    flex: 1 1 0;
    min-inline-size: 0;
    margin-inline: 0.6rem;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0.5;
  }

  /*
   * The section label: this list's own "destaque" colour is the day colour,
   * not the post's own per-slug hash and not a fixed accent, since a list of
   * many posts belongs to no single post's cover. Text, not a border or a
   * rule, so its contrast is the 4.5:1 text floor, not the 3:1 non-text one:
   * red 4.67:1 dark / 4.72:1 light and blue 4.90:1 dark / 4.56:1 light clear
   * it, green 8.03:1 dark / 3.29:1 light and yellow 11.25:1 dark / 3.23:1
   * light do not on the light page (measured in theme.css against --bg,
   * WCAG 2.1). That shortfall already exists everywhere else --accent-day is
   * text (the header wordmark, prose links) and is not this list's to fix.
   */
  .category {
    flex: none;
    color: var(--accent-day, var(--accent));
    text-decoration: none;
  }

  .category:hover,
  .category:focus-visible {
    background: var(--accent-day, var(--accent));
    color: var(--bg);
  }

  .read {
    flex: none;
    margin-inline-start: 0.7rem;
    font-variant-numeric: tabular-nums;
    /* Departure Mono, matching .date above: same reader ask, same reason. */
    font-family: var(--font-display);
  }

  @media (max-width: 34rem) {
    .posts li {
      flex-wrap: wrap;
    }

    .title {
      order: -1;
      flex-basis: 100%;
      margin-inline-start: 0;
      margin-block-end: 0.3rem;
    }

    .leader {
      display: none;
    }
  }
</style>
