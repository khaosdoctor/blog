---
import type { Post } from '../lib/posts'
import { formatDate, urlOf } from '../lib/posts'
import { localePath } from '../i18n/ui'

interface Props {
  posts: Post[]
  showCategory?: boolean
}

const { posts, showCategory = true } = Astro.props

// The section index of the post's own language. This list renders inside both
// page trees, and a bare /<category>/ sent an English reader from an English
// listing to a Portuguese one.
function categoryUrl(post: Post): string {
  return localePath(post.data.lang, `/${post.data.category}/`)
}
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <a href={urlOf(post)}>{post.data.title}</a>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, post.data.lang)}
          </time>
          {showCategory && (
            <>
              <span aria-hidden="true">·</span>
              <a href={categoryUrl(post)} class="category">
                {post.data.category}
              </a>
            </>
          )}
        </p>
        <p class="excerpt">{post.data.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    padding: 0;
    list-style: none;
  }

  .posts li + li {
    margin-block-start: 2.5rem;
  }

  /*
   * A post title, so it takes the display face like every other title. It is a
   * bare <a> rather than a heading, which is why the global heading rule in
   * BaseLayout does not reach it and the face has to be named here.
   *
   * Weight 400, not 600: Departure Mono ships one weight and a browser asked for
   * 600 synthesises it by smearing the glyphs sideways.
   */
  .posts > li > a {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.2rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .category {
    color: var(--muted);
  }

  /*
   * The decided subtitle face. 16px flat, not a rem step: PxPlus is a 9x16
   * bitmap traced to outlines and only lands crisp on whole multiples of 16.
   */
  .excerpt {
    margin-block-start: 0.3rem;
    font-family: var(--font-subtitle);
    font-size: 16px;
    line-height: 1.5;
  }
</style>
