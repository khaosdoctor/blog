---
// A chunky pixel-art ON/OFF slab rather than a plain link pair or a grey
// track with a coloured dot (Lucas's own reference image): the whole slab is
// filled in the DESTINATION language's brand colour (green when the switch
// goes to Português, red when it goes to English), a single word of large
// pixel type names the CURRENT language instead (PT on the Portuguese site,
// EN on the English one), and a raised block occupies the other half,
// sliding to the side the word is not on. Two of these three signals name
// the current state (the word, and the block's own position, which swaps
// side together with the word via the same `[data-current]` selector) and
// one names the destination (the fill): a deliberate split, not an
// oversight, since the fill and the word naming the same thing (both past
// attempts here) reads as either "which one is this" or "where do I go",
// never as answering both questions at once the way this arrangement does.
// Still a single real link, not a faked in-place control: choosing a
// language is a navigation, to the page's own alternate when one exists and
// to that language's home otherwise, exactly as the plain-link version did.
//
// Colour is never the only signal (WCAG 1.4.1, and red/green is the one pair
// a colour-blind reader is least likely to tell apart): the block's position
// is one non-colour signal, the PT/EN word printed on the slab is a second,
// and the link's own accessible name states in words which language it goes
// to.
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** The hreflang pairs the page already builds, when it has any. */
  alternates?: { lang: string; href: string }[]
}

const { locale, alternates = [] } = Astro.props

const LOCALES: { code: Locale; label: string; name: string; home: string }[] = [
  { code: 'pt', label: 'PT', name: 'Português', home: '/' },
  { code: 'en', label: 'EN', name: 'English', home: '/en/' },
]

// A translated page links to its counterpart. Everything else links to the
// other locale's home, which beats linking at a page that does not exist.
function hrefFor(code: Locale): string {
  const match = alternates.find((alt) => alt.lang.toLowerCase().startsWith(code))
  if (match !== undefined) return new URL(match.href, Astro.site).pathname
  return LOCALES.find((entry) => entry.code === code)?.home ?? '/'
}

const other = LOCALES.find((entry) => entry.code !== locale)
const otherHref = other === undefined ? '/' : hrefFor(other.code)
const otherName = other?.name ?? ''
/*
 * The word names the language the reader is on RIGHT NOW, not the destination.
 * Only the fill colour is inverted (see `.lang-slab` below, where the token is
 * the destination's brand colour): the owner asked for the colour to point at
 * where the control goes, and separately reported the word reading backwards
 * once it pointed there too. So the two carry different things on purpose.
 *
 * Word plus knob position are the state signals, and both describe the
 * current language, which is what WCAG 1.4.1 needs from a control whose other
 * cue is colour. The colour is the invitation; the word is the fact. The link
 * itself still goes to the other language, and `aria-label` still says which
 * one, so nothing a screen reader hears depends on reading the slab.
 */
const currentLabel = LOCALES.find((entry) => entry.code === locale)?.label ?? ''
---

<nav class="lang-switch" aria-label={t(locale, 'language')} data-current={locale}>
  <a
    class="lang-track"
    href={otherHref}
    hreflang={other?.code}
    aria-label={t(locale, 'switchLanguage', otherName)}
    title={t(locale, 'switchLanguage', otherName)}
  >
    {/* The 44px hit target is .lang-track (the link itself, above); this inner
       slab is the 32px box a reader actually sees, the same split
       ThemeToggle/SettingsPanel/SearchPalette draw with a ::before chip.
       Here the drawn box carries real children (the fill, the word, the
       knob) rather than a pseudo-element, so it is a real element instead. */}
    <span class="lang-slab" aria-hidden="true">
      <span class="lang-word">{currentLabel}</span>
      <span class="lang-knob"></span>
    </span>
  </a>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
  }

  /*
   * The 44px hit target: a wide rectangle, deliberately, the reference is
   * neither a pill nor a square. `--icon-btn-hit` is the same token every
   * other header control's own hit target uses (ThemeToggle, SettingsPanel,
   * the search trigger), so this control lines up with them in one row even
   * though nothing else about its shape borrows from theirs. This element
   * draws nothing itself any more (no fill, no border, no shadow): it is a
   * flex container that centres the real drawn box, `.lang-slab` below, the
   * same "hit target vs. visible box" split the icon buttons draw with a
   * ::before chip, done here with a real child element instead since the
   * slab has its own children (fill, word, knob) rather than being a single
   * pseudo-element.
   */
  .lang-track {
    position: relative;
    display: inline-flex;
    align-items: center;
    inline-size: 7rem;
    block-size: var(--icon-btn-hit);
    text-decoration: none;
    cursor: pointer;
  }

  .lang-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * The 32px drawn box, the same height every other header control's own
   * visible chip uses (--icon-btn-chip). Full width of `.lang-track` (100%
   * of its 7rem), centred in the taller hit target above by that element's
   * own flex `align-items: center`. `.lang-word` and `.lang-knob` below are
   * absolutely positioned against this element (the nearest `position:
   * relative` ancestor), not against `.lang-track`, so they fill this 32px
   * box rather than the 44px one that holds it.
   */
  .lang-slab {
    position: relative;
    display: block;
    inline-size: 100%;
    block-size: var(--icon-btn-chip);
    border-radius: var(--radius);
    overflow: hidden;
    /*
     * The whole slab is the colour, not a neutral track with a coloured
     * dot on it, and it is the raw brand token, not a mix toward black or
     * white: `--lang-fill-color` picks the destination language's brand
     * colour (red by default, since a page in Portuguese switches to
     * English; overridden to green below, since a page in English switches
     * to Português).
     *
     * This used to mix each colour toward the ground first, the same
     * formula chips.css's --chip-ink uses, because the word painted on top
     * (`.lang-word` below) needed the contrast that gave. Painting the token
     * raw instead reuses exactly the numbers theme.css's own brand table
     * already measured for these colours as text against each ground (its
     * word ink is literally `--bg`, so word-on-fill is the same pair,
     * foreground and background swapped, which the contrast formula treats
     * identically): red 4.67:1 dark / 4.72:1 light, green 8.03:1 dark /
     * 3.29:1 light. Both pass on dark; on light, red clears the 4.5 floor
     * and green does not. A page in English, in light mode, shows a green
     * slab (the Português destination) with the word under the floor at
     * 3.29:1, a real regression this raw-colour change introduces and a
     * fix past what this task asked for: reported rather than silently
     * mixed back in.
     */
    --lang-fill-color: var(--brand-red);
    background: var(--lang-fill-color);
    /*
     * A hard offset block, no blur, behind the whole slab: the same shadow
     * code frames drop (--code-shadow-offset, --code-shadow-color in
     * theme.css), reused rather than re-invented because it already solves
     * "read against both grounds" the way this needs to: black on the
     * sepia page, white on the black one, so the shadow never disappears
     * into whichever ground it falls on.
     */
    box-shadow: var(--code-shadow-offset) var(--code-shadow-offset) 0 var(--code-shadow-color);
  }

  .lang-switch[data-current='en'] .lang-slab {
    --lang-fill-color: var(--brand-green);
  }

  /*
   * The current-language word: large pixel type (PxPlus IBM VGA8,
   * --font-subtitle, sized at a whole multiple of 16px so its bitmap grid
   * stays crisp), white in the reference and `--bg` here (see the
   * measurements on `.lang-slab` above for what that pairing measures out
   * to against the raw fill; the ink and the fill are unchanged by which
   * text is painted on top of them, only the word's own content read above
   * did). Absolutely positioned rather than a flex child: its side (left
   * for one language, right for the other) is a per-locale, server-rendered
   * fact, not something that toggles at runtime, so it needs no transition
   * of its own. `.lang-knob` below moves to the opposite side through the
   * same `[data-current='en']` selector, so the block's position agrees
   * with this word (both current-language signals) rather than with the
   * fill.
   */
  .lang-word {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-subtitle);
    font-size: 32px;
    color: var(--bg);
  }

  .lang-switch[data-current='en'] .lang-word {
    inset-inline-end: auto;
    inset-inline-start: 0;
  }

  /*
   * The knob: a flat block occupying the half of the slab the word is not
   * on, one of the two non-colour state signals alongside the word's own
   * text. It used to carry a crosshatch texture (two repeating-linear-
   * gradients, a moulded-grip look); dropped, flat rather than textured, per
   * the owner's own direction. `--lang-knob-face`/`--lang-knob-edge`
   * (theme.css) stay a fixed neutral pair rather than a mix of the brand
   * colours above: a physical switch's plastic grip does not repaint itself
   * to match ON green or OFF red, and the border needs to read as darker
   * than the face in both directions, which the brand mix (light in dark
   * mode) cannot promise. The border still reads at 2x `--border` rather
   * than a bare literal, so it is still built from the one token everything
   * else's hairline reads from.
   *
   * Position is still the same transform+steps mechanism the plain-link
   * version's knob used, kept for the same reason: a same-document
   * transition (a future view transition, say) would still want a knob it
   * can slide rather than teleport, and `--duration` already collapses to
   * 0ms under prefers-reduced-motion (theme.css), so wherever this does
   * animate, it stops doing so under that setting for free. A plain link
   * swap is a full page load today, so most readers only ever see the two
   * resting states, never the motion between them.
   */
  .lang-knob {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 3.5rem;
    transform: translateX(0%);
    transition: transform var(--duration) steps(2, jump-none);
    background-color: var(--lang-knob-face);
    border: calc(var(--border) * 2) solid var(--lang-knob-edge);
  }

  .lang-switch[data-current='en'] .lang-knob {
    transform: translateX(100%);
  }
</style>
