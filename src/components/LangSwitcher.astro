---
// A chunky pixel-art ON/OFF slab rather than a plain link pair or a grey
// track with a coloured dot (Lucas's own reference image): the whole slab is
// filled in the current state's brand colour (green for Português, red for
// English), a single word of large pixel type names that state, and a
// raised, textured knob occupies the other half, sliding to the side that
// state's word is not on. Still a single real link, not a faked in-place
// control: choosing a language is a navigation, to the page's own alternate
// when one exists and to that language's home otherwise, exactly as the
// plain-link version did.
//
// Colour is never the only signal (WCAG 1.4.1, and red/green is the one pair
// a colour-blind reader is least likely to tell apart): the knob's position
// is one non-colour signal, the PT/EN word printed on the slab is a second,
// and the link's own accessible name states in words which language is
// current and which one clicking it goes to.
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** The hreflang pairs the page already builds, when it has any. */
  alternates?: { lang: string; href: string }[]
}

const { locale, alternates = [] } = Astro.props

const LOCALES: { code: Locale; label: string; name: string; home: string }[] = [
  { code: 'pt', label: 'PT', name: 'Português', home: '/' },
  { code: 'en', label: 'EN', name: 'English', home: '/en/' },
]

// A translated page links to its counterpart. Everything else links to the
// other locale's home, which beats linking at a page that does not exist.
function hrefFor(code: Locale): string {
  const match = alternates.find((alt) => alt.lang.toLowerCase().startsWith(code))
  if (match !== undefined) return new URL(match.href, Astro.site).pathname
  return LOCALES.find((entry) => entry.code === code)?.home ?? '/'
}

const current = LOCALES.find((entry) => entry.code === locale)
const other = LOCALES.find((entry) => entry.code !== locale)
const otherHref = other === undefined ? '/' : hrefFor(other.code)
const otherName = other?.name ?? ''
const currentLabel = current?.label ?? locale.toUpperCase()
---

<nav class="lang-switch" aria-label={t(locale, 'language')} data-current={locale}>
  <a
    class="lang-track"
    href={otherHref}
    hreflang={other?.code}
    aria-label={t(locale, 'switchLanguage', otherName)}
    title={t(locale, 'switchLanguage', otherName)}
  >
    <span class="lang-word" aria-hidden="true">{currentLabel}</span>
    <span class="lang-knob" aria-hidden="true"></span>
  </a>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
  }

  /*
   * A wide rectangle, deliberately: the reference is neither a pill nor a
   * square. Height still reads from `--icon-btn-hit`, the same token every
   * other header control's own hit target uses (ThemeToggle, SettingsPanel,
   * the search trigger), so this control lines up with them in one row even
   * though nothing else about its shape borrows from theirs. Width is fixed
   * rather than measured off the word, so the slab does not resize itself
   * between the two languages: 7rem splits evenly into the two 3.5rem
   * halves below.
   */
  .lang-track {
    position: relative;
    display: inline-block;
    inline-size: 7rem;
    block-size: var(--icon-btn-hit);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
    /*
     * The whole slab is the colour, not a neutral track with a coloured
     * dot on it: `--lang-fill-color` picks the brand token for the current
     * state (green by default, overridden to red below), then mixes it
     * toward black on the sepia page or toward white on the black one, the
     * same oklab mix chips.css already proved safe for these two exact
     * colours (dark green 13.16:1, light green 11.63:1, dark red 10.35:1,
     * light red 13.45:1, all read there as --chip-ink against `--bg`, which
     * is exactly what `.lang-word` below paints on top of it).
     */
    --lang-fill-color: var(--brand-green);
    background: light-dark(
      color-mix(in oklab, var(--lang-fill-color) 50%, black),
      color-mix(in oklab, var(--lang-fill-color) 52%, white)
    );
    /*
     * A hard offset block, no blur, behind the whole slab: the same shadow
     * code frames drop (--code-shadow-offset, --code-shadow-color in
     * theme.css), reused rather than re-invented because it already solves
     * "read against both grounds" the way this needs to: black on the
     * sepia page, white on the black one, so the shadow never disappears
     * into whichever ground it falls on.
     */
    box-shadow: var(--code-shadow-offset) var(--code-shadow-offset) 0 var(--code-shadow-color);
  }

  .lang-switch[data-current='en'] .lang-track {
    --lang-fill-color: var(--brand-red);
  }

  .lang-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * The state word: large pixel type (PxPlus IBM VGA8, --font-subtitle,
   * sized at a whole multiple of 16px so its bitmap grid stays crisp),
   * white in the reference and `--bg` here, the same inversion chips.css's
   * own hover fill uses (the fill above is that chip's --chip-ink formula,
   * so painting `--bg` on top of it is the identical, already-measured
   * pairing read the other way round). Absolutely positioned rather than a
   * flex child: its side (left for one language, right for the other) is a
   * per-locale, server-rendered fact, not something that toggles at
   * runtime, so it needs no transition of its own.
   */
  .lang-word {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-subtitle);
    font-size: 32px;
    color: var(--bg);
  }

  .lang-switch[data-current='en'] .lang-word {
    inset-inline-end: auto;
    inset-inline-start: 0;
  }

  /*
   * The knob: a raised, textured block occupying the half of the slab the
   * word is not on. `--lang-knob-face`/`--lang-knob-edge` (theme.css) are a
   * fixed neutral pair rather than a mix of the brand colours above: a
   * physical switch's plastic grip does not repaint itself to match ON
   * green or OFF red, and the border needs to read as darker than the face
   * in both directions, which the brand mix (light in dark mode) cannot
   * promise. The two repeating-linear-gradients cross into the grid texture
   * a moulded grip is drawn with in pixel art; the border reads at 2x
   * `--border` rather than a bare literal, so it is still built from the
   * one token everything else's hairline reads from.
   *
   * Position is still the same transform+steps mechanism the plain-link
   * version's knob used, kept for the same reason: a same-document
   * transition (a future view transition, say) would still want a knob it
   * can slide rather than teleport, and `--duration` already collapses to
   * 0ms under prefers-reduced-motion (theme.css), so wherever this does
   * animate, it stops doing so under that setting for free. A plain link
   * swap is a full page load today, so most readers only ever see the two
   * resting states, never the motion between them.
   */
  .lang-knob {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 3.5rem;
    transform: translateX(0%);
    transition: transform var(--duration) steps(2, jump-none);
    background-color: var(--lang-knob-face);
    background-image:
      repeating-linear-gradient(90deg, var(--lang-knob-edge) 0 2px, transparent 2px 8px),
      repeating-linear-gradient(0deg, var(--lang-knob-edge) 0 2px, transparent 2px 8px);
    border: calc(var(--border) * 2) solid var(--lang-knob-edge);
  }

  .lang-switch[data-current='en'] .lang-knob {
    transform: translateX(100%);
  }
</style>
