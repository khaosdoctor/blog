---
// A pixel on/off switch rather than two plain links: Português is the green
// side, English the red side, drawn hard-edged and stepped like an old game
// menu's toggle (Lucas's own words). Still a single real link, not a faked
// in-place control: choosing a language is a navigation, to the page's own
// alternate when one exists and to that language's home otherwise, exactly
// as the plain-link version did.
//
// Colour is never the only signal (WCAG 1.4.1, and red/green is the one pair
// a colour-blind reader is least likely to tell apart): the knob's position
// on the track is one non-colour signal, the PT/EN text printed on the track
// itself is a second, and the link's own accessible name states in words
// which language is current and which one clicking it goes to.
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** The hreflang pairs the page already builds, when it has any. */
  alternates?: { lang: string; href: string }[]
}

const { locale, alternates = [] } = Astro.props

const LOCALES: { code: Locale; label: string; name: string; home: string }[] = [
  { code: 'pt', label: 'PT', name: 'Português', home: '/' },
  { code: 'en', label: 'EN', name: 'English', home: '/en/' },
]

// A translated page links to its counterpart. Everything else links to the
// other locale's home, which beats linking at a page that does not exist.
function hrefFor(code: Locale): string {
  const match = alternates.find((alt) => alt.lang.toLowerCase().startsWith(code))
  if (match !== undefined) return new URL(match.href, Astro.site).pathname
  return LOCALES.find((entry) => entry.code === code)?.home ?? '/'
}

const other = LOCALES.find((entry) => entry.code !== locale)
const otherHref = other === undefined ? '/' : hrefFor(other.code)
const otherName = other?.name ?? ''
---

<nav class="lang-switch" aria-label={t(locale, 'language')} data-current={locale}>
  <a
    class="lang-track"
    href={otherHref}
    hreflang={other?.code}
    aria-label={t(locale, 'switchLanguage', otherName)}
    title={t(locale, 'switchLanguage', otherName)}
  >
    <span class="lang-cell" data-code="pt" aria-hidden="true">PT</span>
    <span class="lang-cell" data-code="en" aria-hidden="true">EN</span>
    <span class="lang-knob" aria-hidden="true"></span>
  </a>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
  }

  /*
   * Sized to match the header's icon buttons (--icon-btn-hit, theme.css):
   * same row height, and 3.75rem wide clears the 44px WCAG floor on both
   * axes on its own, so the whole track is one generous hit target rather
   * than two cramped ones.
   */
  .lang-track {
    position: relative;
    display: inline-flex;
    inline-size: 3.75rem;
    block-size: var(--icon-btn-hit);
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
  }

  .lang-track:hover,
  .lang-track:focus-visible {
    border-color: var(--accent);
  }

  .lang-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lang-cell {
    position: relative;
    z-index: 1;
    flex: 1 1 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  /*
   * The knob: a hard-edged block half the track's width, in the current
   * language's own brand colour, sliding to the side that colour belongs to.
   * `--lang-knob-fill` mixes that colour toward whichever end of the page is
   * readable, the same oklab mix chips.css already proved safe for these two
   * exact colours (dark green 13.16:1, light green 11.63:1, dark red
   * 10.35:1, light red 13.45:1, all read there as --chip-ink), so the fill
   * doubles as the current cell's own text-on-colour contrast once inverted
   * below.
   *
   * The slide is a step, not an ease (an old switch snaps, it does not
   * glide), and it only ever fires on a same-document navigation (a future
   * view transition, say): a plain link swap is a full page load, so most
   * readers only ever see the two resting states, never the motion between
   * them. `--duration` already collapses to 0ms under
   * prefers-reduced-motion (theme.css), so wherever this does animate, it
   * stops doing so under that setting for free.
   */
  .lang-knob {
    --lang-knob-color: var(--brand-green);
    --lang-knob-fill: light-dark(
      color-mix(in oklab, var(--lang-knob-color) 50%, black),
      color-mix(in oklab, var(--lang-knob-color) 52%, white)
    );
    position: absolute;
    z-index: 0;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 50%;
    background: var(--lang-knob-fill);
    transition: transform var(--duration) steps(2, jump-none);
  }

  .lang-switch[data-current='en'] .lang-knob {
    --lang-knob-color: var(--brand-red);
    transform: translateX(100%);
  }

  /* The current side's label is drawn on top of the knob, so its own text
     needs the knob-fill's contrast pair: --bg, the page ground, same
     inversion chips.css's hover state already reads. Bold on top of that is
     the non-colour cue: position and weight both say "this one", not only
     hue. */
  .lang-switch[data-current='pt'] .lang-cell[data-code='pt'],
  .lang-switch[data-current='en'] .lang-cell[data-code='en'] {
    color: var(--bg);
    font-weight: bold;
  }
</style>
