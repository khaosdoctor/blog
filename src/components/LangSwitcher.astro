---
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  alternates?: { lang: string; href: string }[]
}

const { locale, alternates = [] } = Astro.props

const LOCALES: { code: Locale; label: string; name: string; home: string }[] = [
  { code: 'pt', label: 'PT', name: 'Português', home: '/' },
  { code: 'en', label: 'EN', name: 'English', home: '/en/' },
]

function hrefFor(code: Locale): string {
  const match = alternates.find((alt) => alt.lang.toLowerCase().startsWith(code))
  if (match !== undefined) return new URL(match.href, Astro.site).pathname
  return LOCALES.find((entry) => entry.code === code)?.home ?? '/'
}

const other = LOCALES.find((entry) => entry.code !== locale)
const otherHref = other === undefined ? '/' : hrefFor(other.code)
const otherName = other?.name ?? ''
---

<nav class="lang-switch" aria-label={t(locale, 'language')} data-current={locale}>
  <a
    class="lang-track"
    href={otherHref}
    hreflang={other?.code}
    data-goes-to={other?.code}
    aria-label={`${LOCALES.map((entry) => entry.label).join(' ')}: ${t(locale, 'switchLanguage', otherName)}`}
    title={t(locale, 'switchLanguage', otherName)}
  >
    <span class="lang-rect" aria-hidden="true">
      {/* The literal space keeps the flattened text reading "PT EN", matching the accessible name above. */}
      {LOCALES.map((entry, index) => (
        <Fragment>
          {index > 0 && ' '}
          <span class={entry.code === locale ? 'lang-square' : 'lang-other'}>{entry.label}</span>
        </Fragment>
      ))}
    </span>
  </a>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
  }

  /* Width is derived from `.lang-rect` so the hit box never reaches wider than the frame a reader sees. */
  .lang-track {
    position: relative;
    display: inline-flex;
    align-items: center;
    inline-size: calc(var(--icon-btn-chip) * 2);
    block-size: var(--icon-btn-hit);
    text-decoration: none;
    cursor: pointer;
  }

  .lang-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* `--icon-btn-chip` tall and twice that wide, so `.lang-square` fills exactly half; transparent so the hollow half shows page ground. */
  .lang-rect {
    position: relative;
    display: block;
    inline-size: 100%;
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: transparent;
  }

  /* Ink is a fixed literal since the brand tokens already carry their own per-ground tone. */
  .lang-square {
    position: absolute;
    /* z-index paints over the dim half regardless of source order, which is set for the flattened text, not for painting. */
    z-index: 1;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateX(0%);
    transition: transform var(--duration) steps(2, jump-none);
    background: var(--brand-green);
    color: #000000;
    font-family: var(--font-subtitle);
    font-size: var(--icon-btn-glyph);
  }

  .lang-switch[data-current='en'] .lang-square {
    transform: translateX(100%);
    background: var(--brand-red);
    color: #ffffff;
  }

  .lang-other {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateX(0%);
    transition: transform var(--duration) steps(2, jump-none);
    color: var(--muted);
    font-family: var(--font-subtitle);
    font-size: var(--icon-btn-glyph);
  }

  .lang-switch[data-current='en'] .lang-other {
    transform: translateX(-100%);
  }
</style>

<script>
  document.querySelector<HTMLAnchorElement>(".lang-switch .lang-track")?.addEventListener("click", (event) => {
    const code = (event.currentTarget as HTMLElement).dataset.goesTo
    if (code === undefined) return
    try {
      localStorage.setItem("lang", code)
    } catch {
    }
  })
</script>

<script>
  import '../scripts/lang-preference'
</script>
