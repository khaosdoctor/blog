---
// A hollow rectangle with a solid square inside it (Lucas's own spec,
// replacing the earlier full-slab and knob-slider attempts): the rectangle
// is a double-ruled outline in the day colour (`--accent-day`, the same
// token the header accent and the icon buttons' own outline read), no fill
// of its own. Twice the square's width, so the square occupies exactly one
// half and the other half stays hollow, page ground showing through.
//
// The square carries the CURRENT language, not the destination, on every
// axis: solid green with `PT` on the Portuguese site (left half), solid red
// with `EN` on the English one (right half). Word, fill and position all
// name the same thing now, which is what the reader is asked to confirm
// before leaving; the destination is implied by which half is hollow (the
// side the square would move to) and stated in words by the link's own
// accessible name, not painted anywhere on the square itself.
//
// Still a single real link, not a faked in-place control: choosing a
// language is a navigation, to the page's own alternate when one exists and
// to that language's home otherwise. "The square moves" on click is real
// only in the sense that the next page renders it on the other side; there
// is no in-place slide today, since a plain link swaps the whole document.
// The transform+steps transition on `.lang-square` below is a no-cost
// placeholder for the one case that could show it: a future same-document
// view transition carrying this element across the navigation, the same
// reasoning the old knob's own transition carried before it was replaced.
//
// Colour is never the only signal (WCAG 1.4.1, and red/green is the one
// pair a colour-blind reader is least likely to tell apart): the word is
// one non-colour signal, which half is solid vs. hollow is a second, and
// the link's own accessible name states in words which language it goes to.
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** The hreflang pairs the page already builds, when it has any. */
  alternates?: { lang: string; href: string }[]
}

const { locale, alternates = [] } = Astro.props

const LOCALES: { code: Locale; label: string; name: string; home: string }[] = [
  { code: 'pt', label: 'PT', name: 'Português', home: '/' },
  { code: 'en', label: 'EN', name: 'English', home: '/en/' },
]

// A translated page links to its counterpart. Everything else links to the
// other locale's home, which beats linking at a page that does not exist.
function hrefFor(code: Locale): string {
  const match = alternates.find((alt) => alt.lang.toLowerCase().startsWith(code))
  if (match !== undefined) return new URL(match.href, Astro.site).pathname
  return LOCALES.find((entry) => entry.code === code)?.home ?? '/'
}

const other = LOCALES.find((entry) => entry.code !== locale)
const otherHref = other === undefined ? '/' : hrefFor(other.code)
const otherName = other?.name ?? ''
// The square names the language the reader is on right now, not the
// destination: see the component comment above for why the fill and the
// position agree with this instead of pointing onward.
const currentLabel = LOCALES.find((entry) => entry.code === locale)?.label ?? ''
---

<nav class="lang-switch" aria-label={t(locale, 'language')} data-current={locale}>
  <a
    class="lang-track"
    href={otherHref}
    hreflang={other?.code}
    aria-label={t(locale, 'switchLanguage', otherName)}
    title={t(locale, 'switchLanguage', otherName)}
  >
    {/* The 44px hit target is .lang-track (the link itself, above); .lang-rect
       is the 32px hollow frame a reader actually sees, the same drawn-vs-hit
       split every other header control uses. .lang-square is the one solid
       half, carrying the current language's colour and its word together. */}
    <span class="lang-rect" aria-hidden="true">
      <span class="lang-square">{currentLabel}</span>
    </span>
  </a>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
  }

  /*
   * The 44px hit target: `--icon-btn-hit`, the same token every other header
   * control's own hit target uses (ThemeToggle, SettingsPanel, the search
   * trigger), so this control lines up with them in one row. Width matches
   * `.lang-rect` below (twice `--icon-btn-chip`) rather than a separate
   * fixed measurement, so the hit target never reaches wider than the frame
   * a reader actually sees. Draws nothing itself: a flex container that
   * centres the real drawn box.
   */
  .lang-track {
    position: relative;
    display: inline-flex;
    align-items: center;
    inline-size: calc(var(--icon-btn-chip) * 2);
    block-size: var(--icon-btn-hit);
    text-decoration: none;
    cursor: pointer;
  }

  .lang-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * The hollow frame: 32px tall (--icon-btn-chip, the same drawn height
   * every other control's own visible chip uses) and twice that wide, so a
   * single square (below) fills exactly half of it. No background of its
   * own, on purpose: "hollow" means the page ground shows through the half
   * the square is not on. The double border reads `--accent-day`, the day-
   * hash accent BrandHeader.astro sets on every page load (the pre-JS
   * fallback in theme.css is a static yellow), the same token the icon
   * buttons' own outline now reads too. 3px double is chips.css's own
   * weight for a double rule at this scale, reused rather than picked fresh.
   */
  .lang-rect {
    position: relative;
    display: block;
    inline-size: 100%;
    block-size: var(--icon-btn-chip);
    border: 3px double var(--accent-day);
    border-radius: var(--radius);
    overflow: hidden;
    background: transparent;
  }

  /*
   * The one solid half: exactly one square (50% of the rectangle's own
   * width, which is itself twice the square size, so this resolves to the
   * same 32px on a side as the frame's own height). Left by default
   * (Portuguese, the site's own default locale); the `[data-current='en']`
   * rule below moves it to the right instead via `transform`, not by
   * changing which inset property is set, so the property stays animatable
   * (see the component comment for why this transition exists at all).
   *
   * Fill and ink are both fixed literals, not `light-dark()`: the brand
   * green/red tokens already carry their own per-ground tone (theme.css),
   * so the ink only has to clear both of those resolved shades, not the
   * page ground the old slab design painted its word against.
   *
   * Measured (WCAG 2.1, relative luminance, 4.5:1 the running-text floor):
   * black on green, this square's PT state, 8.04:1 dark (`--brand-green`
   * #45b384), 5.56:1 light (#39936c), comfortable on both, which is why
   * black rather than `--em-bold-fg`'s warmer near-black was chosen (that
   * tone only reaches 5.22:1 dark and 3.61:1 light, failing on light).
   * White on red, the EN state, per the owner's own spec: 4.51:1 dark
   * (`--brand-red` #e6242f), a hair over the floor with almost no margin,
   * reported here rather than silently swapped for a safer ink since white
   * was specified explicitly; 5.43:1 light (#d50612), comfortable.
   */
  .lang-square {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateX(0%);
    transition: transform var(--duration) steps(2, jump-none);
    background: var(--brand-green);
    color: #000000;
    font-family: var(--font-subtitle);
    /* --icon-btn-glyph, not a bespoke size: the same 16px-in-32px ratio the
       icon buttons themselves draw their glyph at, and two letters at 16px
       comfortably clear this 32px-wide half (PxPlus IBM VGA8's own advance
       width is roughly half its em), where the old design's 32px word needed
       a wider slot than this square has to give. */
    font-size: var(--icon-btn-glyph);
  }

  .lang-switch[data-current='en'] .lang-square {
    transform: translateX(100%);
    background: var(--brand-red);
    color: #ffffff;
  }
</style>
