---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { HREFLANG, localePath, type Locale } from '../../i18n/ui'
import { coverTone } from '../../lib/cover'
import { mdxComponents } from '../../lib/mdx-components'
import { slugOf, type Post } from '../../lib/posts'
import type { getSeriesNavigation } from '../../lib/taxonomy'
import LangBanner from '../LangBanner.astro'
import PostArticle from '../PostArticle.astro'
import PostToc from '../PostToc.astro'

interface Props {
  locale: Locale
  post: Post
  series: ReturnType<typeof getSeriesNavigation>
  sourcePath: string | null
  alternates: { lang: Locale; path: string }[]
}

const { locale, post, series, sourcePath, alternates: siblings } = Astro.props

const { Content, headings, remarkPluginFrontmatter } = await render(post)
const readingTime = remarkPluginFrontmatter.readingTime as number | undefined

const alternates = siblings.map(({ lang, path }) => ({
  lang: HREFLANG[lang],
  href: new URL(path, Astro.site).href,
}))

const postAccent = coverTone(slugOf(post)).token
const sectionPath = localePath(locale, `/${post.data.category}/`)
---

<BaseLayout
  title={`${post.data.seoTitle ?? post.data.title} - Lucas Santos`}
  description={post.data.seoDescription ?? post.data.description}
  lang={locale}
  type="article"
  publishedAt={post.data.pubDate}
  updatedAt={post.data.updatedDate}
  tags={post.data.tags}
  series={post.data.series}
  authors={post.data.authors}
  image={post.data.heroImage?.src}
  alternates={alternates}
  section={{ name: post.data.category, url: sectionPath }}
  markdown={new URL(`${Astro.url.pathname}index.md`, Astro.site).href}
  noindex={post.data.noindex}
  progress
  postAccent={postAccent}
>
  <PostToc headings={headings} locale={locale} />
  <PostArticle post={post} series={series} readingTime={readingTime} locale={locale}>
    <Fragment slot="banner">
      {post.data.machineOwnedTranslation && sourcePath !== null && (
        <LangBanner lang={locale} originalHref={sourcePath} />
      )}
    </Fragment>
    <Content components={mdxComponents} />
  </PostArticle>
</BaseLayout>
