---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { alternatesFor, t, type Locale } from '../../i18n/ui'
import Search from '../Search.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<BaseLayout
  title={`LS: ${t(locale, 'searchTitle')}`}
  description={t(locale, 'searchDescription')}
  lang={locale}
  alternates={alternatesFor('/search/', Astro.site)}
>
  <h1 class="listing-heading">{t(locale, 'searchTitle')}</h1>
  <div class="listing-heading">
    <Search locale={locale} />
  </div>
</BaseLayout>
