---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { tagLabel } from '../../i18n/tags'
import { alternatesFor, HREFLANG, t, type Locale } from '../../i18n/ui'
import { getTags } from '../../lib/taxonomy'
import TagCloud from '../TagCloud.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const tags = [...(await getTags(locale)).entries()]
  // By the label, not the tag: the cloud reads alphabetically in the language
  // it is being read in.
  .sort(([a], [b]) => tagLabel(a, locale).localeCompare(tagLabel(b, locale), HREFLANG[locale]))
  .map(([name, posts]) => ({ name, count: posts.length }))
---

<BaseLayout
  title={`LS: ${t(locale, 'tags')}`}
  description={t(locale, 'tagsIntro')}
  lang={locale}
  alternates={alternatesFor('/tags/', Astro.site)}
>
  <TagCloud locale={locale} tags={tags} />
</BaseLayout>
