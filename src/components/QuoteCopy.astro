---
/**
 * Appends a copy-as-citation button to every rendered quote card and wires its
 * click. Neither markup shape a quote can take ever contains one, so this adds
 * it at runtime rather than asking an author to write it.
 *
 * The same shape as the notes' own copy control: a real <button>, an SVG mask
 * icon so it takes currentColor, hidden until hover or focus, reusing the
 * site's one `.toast` confirmation rather than growing a second pattern.
 *
 * The payload is built at click time from whatever text is on the page:
 * `"body" » Author` for the callout shape, just `"body"` for the plain
 * blockquote. The » is the same glyph the author line already shows, so a
 * pasted citation matches the house style. Paragraphs join with one space and
 * whitespace collapses, so a two-paragraph quote copies as one unit.
 *
 * The author's leading » and the watermark are both CSS `content`, never text,
 * so neither needs stripping; they are only defended against in case that
 * changes.
 */
import { localeFromPath, t } from '../i18n/ui'

const locale = localeFromPath(Astro.url.pathname)
---

<script is:inline define:vars={{ copyLabel: t(locale, 'copyQuote') }}>
  ;(function () {
    var SELECTOR = '.prose .callout[data-callout="quote"], .prose blockquote:not(.callout):not(.twitter-tweet)'
    document.querySelectorAll(SELECTOR).forEach(function (card) {
      if (card.querySelector(':scope > .qc-copy')) return
      var button = document.createElement('button')
      button.type = 'button'
      button.className = 'qc-copy'
      button.setAttribute('aria-label', copyLabel)
      card.append(button)
    })
  })()
</script>

<script is:inline define:vars={{ copiedLabel: t(locale, 'linkCopied') }}>
  document.addEventListener('click', async (event) => {
    const button = event.target.closest('.qc-copy')
    if (button === null) return

    const card = button.closest('.callout[data-callout="quote"], blockquote:not(.callout):not(.twitter-tweet)')
    if (!card) return

    // A container's own text, from its direct <p> children when it has any
    // (both markup shapes normally do), falling back to the container's
    // whole text otherwise, so a quote with no paragraph wrapper still
    // copies something rather than an empty string.
    function textOf(container) {
      const paragraphs = container.querySelectorAll(':scope > p')
      const nodes = paragraphs.length ? paragraphs : [container]
      return Array.from(nodes)
        .map((node) => node.textContent)
        .join(' ')
        .replace(/\s+/g, ' ')
        .trim()
    }

    const authorEl = card.querySelector(':scope > .callout-title .callout-title-text')
    const bodyContainer = authorEl ? card.querySelector(':scope > .callout-content') : card
    const body = bodyContainer ? textOf(bodyContainer) : ''
    const author = authorEl ? authorEl.textContent.replace(/^\s*»\s*/, '').trim() : ''
    const citation = author ? `"${body}" » ${author}` : `"${body}"`

    try {
      await navigator.clipboard.writeText(citation)
    } catch {
      // No clipboard permission, or an insecure origin. Silent, same as
      // every other copy control on this site.
      return
    }

    document.querySelector('.toast')?.remove()
    const toast = document.createElement('div')
    toast.className = 'toast'
    toast.setAttribute('role', 'status')
    toast.textContent = copiedLabel
    document.body.append(toast)
    setTimeout(() => toast.remove(), 2000)
  })
</script>
