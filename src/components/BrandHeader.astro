---
/**
 * The decided header, off the bench at
 * content/blog/theme-lab/components/ChromeHeader.vue: shape "barra de caixa
 * ┌─┐", mark "fio" (wireframe Elite) at 36px (under that candidate's own
 * 72px legibility floor, chosen knowingly, so nothing here clamps it), in all
 * four brand roles at once, logo plus wordmark, Departure Mono, letter-
 * spacing 6/100em, caps on. Ported into a plain Astro component plus
 * src/scripts/header-brand.ts rather than shipping the bench's Vue island:
 * this renders on every page (docs/design.md's Vue-on-every-page argument
 * that kept Conway off Vue applies here too), and every value below is
 * fixed rather than reader-adjustable, so there is nothing left for a
 * picker to drive.
 *
 * Two changes from the bench, both requested afterward rather than measured
 * on it:
 *
 * - The wordmark's accent used to be a fixed yellow (#f5b200). It is now the
 *   day-hash colour (src/lib/day-color.ts, excluding purple), applied as
 *   `--accent-day` by header-brand.ts on every page load. `--accent-day` in
 *   theme.css is only the pre-JS fallback (a static yellow, the bench's own
 *   choice), so a reader with JS off still gets a sane header rather than an
 *   unset custom property.
 * - The scramble (decifra) used to replay on every hold, and the wordmark
 *   also had a "falha" glitch mode as an alternative animation rather than a
 *   companion to it. Now the scramble runs once per browser session (see the
 *   script for why session rather than page load or forever) and never
 *   replays; in its place, an occasional glitch burst (1-3 pulses, a random
 *   4-20s apart) hits both the wordmark and the mark, replacing the mark's
 *   own fixed 2.2-4s glitch cadence from the bench.
 *
 * The mark's hover swap to its five true colours (LogoMark.vue's own
 * behaviour) is kept as pure CSS, disabled the same way: no rule at all
 * under prefers-reduced-motion.
 */
import LangSwitcher from './LangSwitcher.astro'
import NavLinks from './NavLinks.astro'
import SearchPalette from './SearchPalette.astro'
import SettingsPanel from './SettingsPanel.astro'
import ThemeToggle from './ThemeToggle.astro'
import { markCells, MARK_RECTS, ROLE_TOKEN } from '../lib/logo-mark'
import type { Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  home: string
  alternates?: { lang: string; href: string }[]
}

const { locale, home, alternates = [] } = Astro.props

const WORD = 'lsantos.dev'
const CELLS = markCells()
---

<header class="chrome">
  <span class="edge" aria-hidden="true">┌─</span>
  <a href={home} class="brand" aria-label={WORD}>
    <span class="mark" aria-hidden="true">
      <span class="mark-chars">
        {
          CELLS.map((cell) => (
            <span class="mark-cell" data-row={cell.row} data-col={cell.col} data-glyph={cell.glyph} style={`color:${cell.color}`}>
              {cell.glyph}
            </span>
          ))
        }
      </span>
      <svg class="mark-solid" viewBox="0 0 64 64" aria-hidden="true">
        {MARK_RECTS.map((rect) => <rect x={rect.x} y={rect.y} width={rect.w} height={rect.h} fill={ROLE_TOKEN[rect.role]} />)}
      </svg>
    </span>
    <span class="word" data-word={WORD} aria-hidden="true">
      {WORD.split('').map((ch) => <span class="letter" data-ch={ch}>{ch}</span>)}
      <span class="cursor" aria-hidden="true" />
    </span>
  </a>
  <span class="fill" aria-hidden="true">──────────────────────────────────────</span>
  <nav class="controls">
    <SearchPalette locale={locale} />
    <NavLinks locale={locale} />
    <LangSwitcher locale={locale} alternates={alternates} />
    <ThemeToggle locale={locale} />
    <SettingsPanel locale={locale} />
  </nav>
  <span class="edge" aria-hidden="true">─┐</span>
</header>

<script>
  import '../scripts/header-brand'
</script>

<style>
  /*
   * "barra de caixa": the box-drawing edges plus a stretch of dashes that
   * absorb whatever room the controls do not need, the same flex row the
   * bench's `.bar` used. `.fill` (flex: 1, overflow hidden) is what pushes
   * `.controls` to the right edge, replacing the old `margin-inline-end:
   * auto` on the home link, since that link is no longer the only thing on
   * this row that can carry the push.
   *
   * `max-inline-size: 80vw` (below, past 70rem) is what makes the row read
   * as 80% of the row's own available width rather than the reading column
   * (`--measure`, 78ch): the header is chrome across the top, not prose, so
   * measuring it against the viewport reads truer than against a column
   * meant for running text. Applied only past 70rem (the same breakpoint
   * footnotes.css already uses for "there is room to spare"), so nothing
   * changes below it: brand, the switch, and three icon buttons need real
   * room of their own, and narrowing the row further on a phone, where
   * `flex-wrap` already has to wrap `.controls` onto its own line, would
   * only make that wrap happen sooner. `margin-inline: auto` centres the
   * row once it is narrower than its container; a no-op at full width.
   */
  .chrome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-inline: auto;
    /* "Breathing room 4" from the bench's density knob (range 4-30, in
       tenths of a rem block / sixths of a rem inline). */
    padding: 0.4rem 0.667rem;
    font-family: var(--font-mono);
  }

  @media (min-width: 70rem) {
    .chrome {
      max-inline-size: 80vw;
    }
  }

  .chrome > * {
    margin-inline-end: 0.6rem;
  }

  .chrome > *:last-child {
    margin-inline-end: 0;
  }

  .edge {
    color: var(--muted);
    font-family: var(--font-display);
    letter-spacing: 0.06em;
  }

  /*
   * The dashes read from the same fixed 38-character string regardless of
   * viewport (`overflow: hidden` crops whatever the flex box does not need,
   * `flex: 1` is what actually claims the row's own leftover space, see the
   * component comment above); wider letter-spacing here does not change how
   * much of the row `.fill` claims, only how loosely the dash glyphs read
   * within it, which is the owner's own separate ask ("larger space between
   * the characters", not a different count). 0.4em rather than `.edge`'s
   * 0.06em: enough to read as an openly spaced dashed line rather than the
   * near-solid rule the box-drawing "─" glyph draws edge-to-edge at.
   */
  .fill {
    color: var(--muted);
    font-family: var(--font-display);
    letter-spacing: 0.4em;
    flex: 1;
    overflow: hidden;
  }

  .controls {
    display: inline-flex;
    align-items: center;
  }

  /*
   * `.controls > *` used to read as a plain child combinator, but every
   * direct child here (SearchPalette, NavLinks, LangSwitcher, ThemeToggle,
   * SettingsPanel) is a SEPARATE component's own root element, not something
   * written in this file's own template. Astro scopes a selector by pairing
   * it with this component's own `data-astro-cid`, on BOTH sides of a
   * combinator, so the compiled rule was
   * `.controls[data-astro-cid-X] > [data-astro-cid-X]`: it could only ever
   * match a child that also carried BrandHeader's own cid, and none of these
   * five do (each carries its own file's cid instead). The rule was
   * therefore a silent no-op the whole time, verified by reading the actual
   * compiled CSS and the actual rendered attributes side by side: every one
   * of the five controls sat flush against its neighbour with zero margin,
   * which is exactly what Lucas reported (search touching POSTS, SOBRE
   * touching PT). `:global()` on the wildcard is Astro's own escape hatch
   * for "a child from another component": it keeps `.controls` itself
   * scoped (a real element written in this file) while leaving the `*` an
   * actual wildcard again, so the existing 0.5rem is what now finally
   * reaches every pair, `.chrome > *` never had this problem, since edge/
   * brand/fill/controls are all written directly in this file's own markup.
   */
  .controls > :global(*) {
    margin-inline-end: 0.5rem;
  }

  .controls > :global(*:last-child) {
    margin-inline-end: 0;
  }

  /*
   * One hard-offset shadow behind the whole brand lockup (mark and wordmark
   * together), not two separate ones: `filter: drop-shadow()` traces the
   * alpha of every non-transparent pixel underneath it, and the mark and the
   * word are visually separate shapes with real clear space between them, so
   * one filter here already throws a shadow behind each independently, the
   * same as applying it twice would. Reused rather than duplicated on
   * `.mark` itself: `.mark` keeps its own `overflow: hidden` (clips the
   * character grid to its box), and a filter on that same element would
   * clip its own shadow off at that boundary before it ever painted.
   * `.brand` has no such clipping, so the shadow the owner asked for
   * actually shows.
   *
   * `--code-shadow-offset`/`--code-shadow-color` (theme.css): the same hard,
   * no-blur offset code frames and the language switch's own frame already
   * use, reused rather than a fresh value, and already `light-dark()` so it
   * reads dark-on-sepia and light-on-black without a second declaration.
   *
   * This does not change the wordmark's own measured contrast against the
   * page (a shadow is not a WCAG-recognised way to clear a text ratio); see
   * the report for the actual numbers and what to do about the two day
   * colours that read weak on the sepia ground.
   */
  .brand {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    filter: drop-shadow(var(--code-shadow-offset) var(--code-shadow-offset) 0 var(--code-shadow-color));
  }

  .brand > .mark {
    margin-inline-end: 0.4rem;
  }

  .brand:focus-visible {
    outline: 2px solid var(--accent-day);
    outline-offset: 3px;
  }

  /* --- the mark: an 8x8 character grid, wireframe Elite, all four brand roles at once --- */
  .mark {
    position: relative;
    display: inline-flex;
    inline-size: 36px;
    block-size: 36px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .mark-chars,
  .mark-solid {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .mark-chars {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    line-height: 1;
    font-family: var(--font-mono);
    font-weight: 900;
  }

  /*
   * At 36px (4.5px per cell, logo-mark.ts's own MARK_MIN_PX notes the 72px
   * floor this is knowingly under), the box-drawing glyphs (┌┐└┘─│) read as a
   * faint smudge at the font's own regular stroke width, and font-weight
   * alone is not a reliable fix: a system monospace stack's bold variant is
   * not guaranteed to touch box-drawing glyphs at all (bumped to 900 above
   * regardless, since it costs nothing where it does help). `-webkit-text-
   * stroke` is the part doing the real work: it adds stroke width around
   * each glyph's own path independent of whatever weight variants the font
   * ships, which is what actually thickens a hairline character at this
   * size. `currentColor` picks up each cell's own inline `color` (its brand
   * role, set server-side in the template), so the stroke matches the fill
   * rather than a second flat colour. Widely supported (Chrome, Safari,
   * Firefox 49+).
   */
  .mark-cell {
    display: flex;
    flex: 0 0 12.5%;
    inline-size: 12.5%;
    block-size: 12.5%;
    align-items: center;
    justify-content: center;
    font-size: 4.5px;
    -webkit-text-stroke: 0.5px currentColor;
  }

  .mark-solid {
    display: none;
    overflow: visible;
  }

  /* A hard swap to the mark's true five-rectangle colours on hover, no
     cross-fade: the site's pixel-era vocabulary trades frames, it does not
     dissolve between them. Off under reduced motion, so a reduced-motion
     reader gets the same wireframe on hover as at rest. */
  @media (prefers-reduced-motion: no-preference) {
    .brand:hover .mark-chars,
    .brand:focus-visible .mark-chars {
      display: none;
    }

    .brand:hover .mark-solid,
    .brand:focus-visible .mark-solid {
      display: block;
    }
  }

  /* --- the wordmark: the header's own accent, day-hash coloured --- */
  .word {
    position: relative;
    display: inline-flex;
    min-inline-size: 11ch;
    color: var(--accent-day);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 900;
    /*
     * Departure Mono ships one weight (fonts.css: DepartureMono-Regular.woff2,
     * no bold file), so `font-weight: 900` above is a request the browser may
     * or may not honour by synthesising, the exact reason `.mark-cell`'s own
     * legibility fix (dark-ground complaint, further down) does not rely on
     * weight alone either. `-webkit-text-stroke` is what actually thickens
     * the letterforms regardless: same technique, same 0.5px, reused rather
     * than re-derived. `currentColor` follows `.word`'s own `color`, so the
     * stroke matches the fill at rest and the hover/focus inversion below.
     */
    -webkit-text-stroke: 0.5px currentColor;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    /*
     * The hover fill's own padding, kept present (and transparent) at rest:
     * the same "reserve the space before you need it" trick prose/links.css
     * uses, so filling the background on hover changes no box size and
     * nothing around the wordmark moves.
     */
    padding-inline: 1px;
    padding-block: 2px;
  }

  .letter {
    display: inline-block;
  }

  /*
   * Hover/focus fills the wordmark with the day accent and inverts the text,
   * the same treatment src/styles/prose/links.css gives a link. The mark's
   * own hover swap above fires at the same time, from the same `:hover` on
   * `.brand`, since both read as "this is the one clickable thing."
   */
  .brand:hover .word,
  .brand:focus-visible .word {
    background: var(--accent-day);
    color: var(--bg);
  }

  /*
   * The block cursor: opacity is set inline, per frame, by header-brand.ts;
   * no CSS transition here on purpose, a stepped opacity change is the low-
   * frame-rate read the decided cursor asks for, and a transition would
   * smooth it into a fade.
   */
  .cursor {
    display: inline-block;
    inline-size: 0.55em;
    block-size: 1.1em;
    margin-inline-start: 1px;
    background: currentColor;
    vertical-align: text-bottom;
  }

  /* Falha glitch: two ghost copies of the wordmark, red and cyan, shifted
     and screen-blended over the real one, only while header-brand.ts marks
     a pulse active. Off under reduced motion; the script itself never
     schedules a pulse in that case, this is the belt to that brace. */
  @media (prefers-reduced-motion: no-preference) {
    .word[data-glitch='true']::before,
    .word[data-glitch='true']::after {
      content: attr(data-word);
      position: absolute;
      inset: 0;
      text-transform: uppercase;
      mix-blend-mode: screen;
      pointer-events: none;
    }

    .word[data-glitch='true']::before {
      color: #ff2b4d;
      transform: translateX(var(--glitch-a, 0));
    }

    .word[data-glitch='true']::after {
      color: #21c8ff;
      transform: translateX(var(--glitch-b, 0));
      clip-path: var(--glitch-band, inset(0 0 100% 0));
    }
  }
</style>
