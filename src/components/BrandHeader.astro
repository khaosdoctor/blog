---
import { type Locale, t } from '../i18n/ui'
import { MARK_RECTS, markCells, ROLE_TOKEN } from '../lib/logo-mark'
import LangSwitcher from './LangSwitcher.astro'
import NavLinks from './NavLinks.astro'
import SearchPalette from './SearchPalette.astro'
import SettingsPanel from './SettingsPanel.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  locale: Locale
  home: string
  alternates?: { lang: string; href: string }[]
}

const { locale, home, alternates = [] } = Astro.props

const WORD = 'lsantos.dev'
const CELLS = markCells()

const RULE = '──────────────────────────────────────'
---

<header class="shell">
  <button
    class="menu-toggle"
    type="button"
    hidden
    aria-expanded="false"
    aria-controls="shell-menu"
    aria-label={t(locale, 'openMenu')}
    data-label-open={t(locale, 'openMenu')}
    data-label-close={t(locale, 'closeMenu')}
  >
    <span class="menu-toggle-open" aria-hidden="true">≡</span>
    <span class="menu-toggle-close" aria-hidden="true">X {t(locale, 'closeMenuShort')}</span>
  </button>
  <span class="edge" aria-hidden="true">┌─</span>
  <a href={home} class="brand" aria-label={WORD}>
    <span class="mark" aria-hidden="true">
      <span class="mark-chars">
        {
          CELLS.map((cell) => (
            <span class="mark-cell" data-row={cell.row} data-col={cell.col} data-glyph={cell.glyph} style={`color:${cell.color}`}>
              {cell.glyph}
            </span>
          ))
        }
      </span>
      <svg class="mark-solid" viewBox="0 0 64 64" aria-hidden="true">
        {MARK_RECTS.map((rect) => <rect x={rect.x} y={rect.y} width={rect.w} height={rect.h} fill={ROLE_TOKEN[rect.role]} />)}
      </svg>
    </span>
    <span class="word" data-word={WORD} aria-hidden="true">
      {WORD.split('').map((ch) => <span class="letter" data-ch={ch}>{ch}</span>)}
      <span class="cursor" aria-hidden="true" />
    </span>
  </a>
  <span class="fill" aria-hidden="true">{RULE.split('').map((ch) => <span class="dash">{ch}</span>)}</span>
  <div class="shell-menu" id="shell-menu">
    <NavLinks locale={locale} />
    <span class="fill" aria-hidden="true">{RULE.split('').map((ch) => <span class="dash">{ch}</span>)}</span>
    <nav class="controls">
      <SearchPalette locale={locale} />
      <LangSwitcher locale={locale} alternates={alternates} />
      <ThemeToggle locale={locale} />
      <SettingsPanel locale={locale} />
    </nav>
  </div>
  <span class="edge" aria-hidden="true">─┐</span>
</header>

<script>
  import '../scripts/header-brand'
  import '../scripts/mobile-menu'
</script>

<style>
  .shell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-inline: auto;
    padding: 0.4rem var(--shell-inset);
    column-gap: 0.6rem;
    font-family: var(--font-mono);
  }

  @media (min-width: 70rem) {
    .shell {
      max-inline-size: var(--shell-width);
    }
  }

  .menu-toggle {
    display: none;
  }

  .shell-menu {
    display: contents;
  }

  @media (max-width: 47.99rem) {
    .menu-toggle:not([hidden]) {
      position: relative;
      display: grid;
      place-items: center;
      min-inline-size: var(--icon-btn-hit);
      min-block-size: var(--icon-btn-hit);
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--muted);
      font-size: 1.3rem;
      line-height: 1;
      cursor: pointer;
    }

    .menu-toggle:not([hidden])::before {
      content: '';
      position: absolute;
      inline-size: var(--icon-btn-chip);
      block-size: var(--icon-btn-chip);
      border: var(--btn-border);
      border-radius: var(--radius);
      background: var(--bg);
      pointer-events: none;
    }

    .menu-toggle > span {
      position: relative;
    }

    .menu-toggle-close {
      display: none;
      font-family: var(--font-display);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      white-space: nowrap;
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle-open {
      display: none;
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle-close {
      display: inline;
    }

    .menu-toggle:hover,
    .menu-toggle:focus-visible {
      color: var(--accent);
    }

    /* Ink, not the day's accent, which reads as a live control on a red day. */
    .menu-toggle[aria-expanded='true'] {
      color: var(--fg);
    }

    .menu-toggle:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .shell[data-menu-ready] .edge,
    .shell[data-menu-ready] .fill,
    .shell[data-menu-ready]:not([data-menu-open]) .shell-menu {
      display: none;
    }

    /* Reading progress with no run to write along: a wash over what has been
       read, the cover's own tone at the head, painted under the brand. */
    .shell[data-menu-ready]::after {
      --read-tone: light-dark(
        color-mix(in oklab, var(--post-accent, var(--accent-day)) 18%, var(--bg)),
        color-mix(in oklab, var(--post-accent, var(--accent-day)) 34%, var(--bg))
      );
      --read-head: var(--read-progress, 0%);
      --read-tip: 0.75rem;
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline: calc(-1 * var(--gutter));
      z-index: 0;
      background: linear-gradient(
        to right,
        var(--read-tone) 0 calc(var(--read-head) - var(--read-tip)),
        var(--post-accent, var(--accent-day)) calc(var(--read-head) - var(--read-tip)) var(--read-head),
        transparent var(--read-head)
      );
      pointer-events: none;
    }

    /* Four offsets, no blur: an opaque 1px ring in the ground colour, so the
       wordmark and the mark hold their edges over the fill in any tone. */
    .shell[data-menu-ready] .brand {
      filter: drop-shadow(1px 0 0 var(--bg)) drop-shadow(-1px 0 0 var(--bg)) drop-shadow(0 1px 0 var(--bg))
        drop-shadow(0 -1px 0 var(--bg)) drop-shadow(var(--brand-shadow-offset) var(--brand-shadow-offset) 0 var(--brand-shadow-color));
    }

    .shell[data-menu-ready] {
      justify-content: center;
    }

    /* Negative by the hit box's overhang, so the DRAWN chip lines up with the
       gutter every heading and link starts at. */
    .shell[data-menu-ready] .menu-toggle {
      position: absolute;
      inset-inline-start: calc((var(--icon-btn-chip) - var(--icon-btn-hit)) / 2);
      z-index: 2;
    }

    .shell[data-menu-open] .menu-toggle {
      position: fixed;
      inset-block-start: 1.2rem;
      inset-inline-start: 1.2rem;
      justify-items: start;
      padding-inline: 0.6rem;
    }

    .shell[data-menu-open] .menu-toggle::before {
      inset-inline: 0;
      inline-size: auto;
    }

    /* Fixed inside the sticky header's stacking context: paints above the page and below the hamburger. */
    .shell[data-menu-open] .shell-menu {
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      inline-size: min(16rem, 80vw);
      padding: calc(var(--icon-btn-hit) * 2 + 2rem) 1.2rem 1.2rem;
      border-inline-end: 3px double var(--fg);
      background: var(--bg);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .shell[data-menu-open] :global(.nav-links) {
      flex-direction: column;
      align-items: start;
      font-size: 1.1rem;
    }

    .shell[data-menu-open] :global(.nav-links a + a) {
      margin-block-start: 1rem;
    }

    .shell[data-menu-open] .controls {
      margin-block-start: auto;
      padding-block-start: 1.5rem;
      /* Static, or the absolutely-placed search line below would measure its offsets from this row instead of the drawer. */
      position: static;
    }

    .shell[data-menu-open] .controls :global(.theme-toggle) {
      margin-inline-start: auto;
    }

    .shell[data-menu-open] .controls :global(.tt-open),
    .shell[data-menu-open] .controls :global(.sp-open) {
      font-size: 1.3rem;
    }

    .shell[data-menu-open] .controls :global(.lang-switch) {
      font-size: 1.1rem;
    }

    .shell[data-menu-open] .controls :global(.search-trigger) {
      position: absolute;
      inset-block-start: calc(var(--icon-btn-hit) + 1.2rem);
      inset-inline: 1.2rem;
      display: flex;
    }

    .shell[data-menu-open] .controls :global(.sx-open) {
      inline-size: 100%;
      display: flex;
      justify-content: flex-start;
    }

    .shell[data-menu-open] .controls :global(.sx-hint) {
      display: none;
    }

    .shell[data-menu-open] .controls :global(.sx-dialog[open]) {
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: 3;
      inline-size: auto;
      max-block-size: 60dvh;
      margin: 0;
      padding: 0.45rem;
    }

    /* Status, results and the more link are empty until a search runs, and
       their spacing alone would hold the box open. */
    .shell[data-menu-open] .controls :global(.sx-dialog[open] > :empty) {
      margin-block-start: 0;
    }

    .shell[data-menu-open] .controls :global(.sx-row) {
      font-size: 0.8rem;
      padding-block-end: 0.3rem;
      border-color: var(--fg);
    }

    /* The example queries are longer than the drawer can show without cutting
       them at the frame, so the row is the prompt and the caret here. */
    .shell[data-menu-open] .controls :global(.sx-input::placeholder) {
      color: transparent;
    }

    .shell[data-menu-open] .controls :global(.sx-label) {
      display: inline;
    }
  }

  .edge {
    color: var(--muted);
    font-family: var(--font-display);
    letter-spacing: 0.06em;
  }

  .fill {
    color: var(--muted);
    font-family: var(--font-display);
    letter-spacing: 0.4em;
    margin-inline-end: -0.4em;
    flex: 1;
    overflow: hidden;
  }

  /* Paint properties only, so a lit dash can't move the row or need a transition. */
  .dash.lit {
    color: var(--post-accent, var(--accent-day));
    -webkit-text-stroke: 0.4px currentColor;
  }

  .controls {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    column-gap: 0.5rem;
  }

  .controls > :global(*) {
    margin-inline-end: 0;
  }

  .controls :global(.search-trigger) {
    margin-inline-start: 0;
  }

  /* Negative: the container's 0.5rem column spacing also separates the nav links, so pulling the switch back tightens just the controls. */
  .controls :global(.lang-switch) {
    margin-inline-start: -0.25rem;
  }

  /* Starts the second group: subtracts the one side of invisible hit box the opener carries and the switch does not, so the step is chip-to-chip. */
  .controls :global(.theme-toggle) {
    margin-inline-start: calc(0.25rem - ((var(--icon-btn-hit) - var(--icon-btn-chip)) / 2));
  }

  /* Both neighbours carry the invisible hit box here, not just one, so this subtracts both sides rather than the single side the rule above does. */
  .controls :global(.settings-panel) {
    margin-inline-start: calc(-0.25rem - (var(--icon-btn-hit) - var(--icon-btn-chip)));
  }

  /* Stacking context is for the cursor. The shadow filter lives here, not on `.mark`, which would clip it. */
  .brand {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    filter: drop-shadow(var(--brand-shadow-offset) var(--brand-shadow-offset) 0 var(--brand-shadow-color));
  }

  .brand > .mark {
    margin-inline-end: 0.4rem;
  }

  .brand:focus-visible {
    outline: 2px solid var(--accent-day);
    outline-offset: 3px;
  }

  .mark {
    position: relative;
    display: inline-flex;
    inline-size: 36px;
    block-size: 36px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .mark-chars,
  .mark-solid {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .mark-chars {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    line-height: 1;
    font-family: var(--font-mono);
    font-weight: 900;
  }

  .mark-cell {
    display: flex;
    flex: 0 0 12.5%;
    inline-size: 12.5%;
    block-size: 12.5%;
    align-items: center;
    justify-content: center;
    font-size: 4.5px;
    -webkit-text-stroke: 0.25px currentColor;
  }

  .mark-solid {
    display: none;
    overflow: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brand:hover .mark-chars,
    .brand:focus-visible .mark-chars {
      display: none;
    }

    .brand:hover .mark-solid,
    .brand:focus-visible .mark-solid {
      display: block;
    }
  }

  .word {
    position: relative;
    display: inline-flex;
    /* `stretch` would give the cursor the full line height instead of the baseline. */
    align-items: baseline;
    min-inline-size: 11ch;
    color: var(--accent-day);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 900;
    /* Departure Mono ships one weight; `font-weight: 900` is only a synthesis request, the stroke is what actually thickens. */
    -webkit-text-stroke: 0.5px currentColor;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-inline: 1px;
    padding-block: 2px;
  }

  .letter {
    display: inline-block;
  }

  .brand:hover .word,
  .brand:focus-visible .word {
    background: var(--accent-day);
    color: var(--bg);
  }

  /* No transition on opacity, or the stepped blink smooths into a fade; transform only, so the head can't move the wordmark or dashes. */
  .cursor {
    display: inline-block;
    inline-size: 0.55em;
    block-size: 1.1em;
    margin-inline-start: 1px;
    background: currentColor;
    /* 0.2em approximates the descender depth, keeping the empty block's baseline edge straddled correctly. */
    align-self: baseline;
    transform: translate(var(--cursor-x, 0px), 0.2em);
  }

  /* `!important` beats the inline per-frame `opacity` header-brand.ts writes. */
  .cursor[data-writing='true'] {
    opacity: 1 !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    .word[data-glitch='true']::before,
    .word[data-glitch='true']::after {
      content: attr(data-word);
      position: absolute;
      inset: 0;
      text-transform: uppercase;
      mix-blend-mode: screen;
      pointer-events: none;
    }

    .word[data-glitch='true']::before {
      color: #ff2b4d;
      transform: translateX(var(--glitch-a, 0));
    }

    .word[data-glitch='true']::after {
      color: #21c8ff;
      transform: translateX(var(--glitch-b, 0));
      clip-path: var(--glitch-band, inset(0 0 100% 0));
    }
  }
</style>
