---
import { sanitizeCaption } from '../lib/sanitizeCaption'

interface Props {
  src: string
  poster?: string
  caption?: string
}

const { src, poster, caption } = Astro.props
const safeCaption = caption && sanitizeCaption(caption)
---

{
  safeCaption ? (
    <figure class="video-figure">
      <video controls preload="metadata" playsinline poster={poster} src={src} />
      <figcaption set:html={safeCaption} />
    </figure>
  ) : (
    <video class="video-standalone" controls preload="metadata" playsinline poster={poster} src={src} />
  )
}

<style>
  video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    background: var(--rule);
  }

  .video-figure,
  .video-standalone {
    margin-block: 2rem;
  }

  figcaption {
    margin-block-start: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }
</style>
