---
interface Props {
  id: string
}

const { id } = Astro.props
---

<figure class="deck">
  <iframe
    src={`https://speakerdeck.com/player/${id}`}
    title="Slides"
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    sandbox="allow-scripts allow-popups allow-presentation"
    allowfullscreen
  ></iframe>
</figure>

<style>
  .deck iframe {
    aspect-ratio: 16 / 10;
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
</style>
