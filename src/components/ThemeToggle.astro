---
import { t, type Locale } from '../i18n/ui'
import Sun from './icons/Sun.astro'
import Moon from './icons/Moon.astro'
import Monitor from './icons/Monitor.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div
  class="theme-toggle"
  hidden
  data-label={t(locale, 'themeToggle')}
  data-light={t(locale, 'themeLight')}
  data-dark={t(locale, 'themeDark')}
  data-system={t(locale, 'themeSystem')}
>
  <button type="button" class="tt-open" aria-haspopup="true" aria-expanded="false" aria-controls="tt-menu">
    <Sun class="tt-icon" data-value="light" hidden />
    <Moon class="tt-icon" data-value="dark" hidden />
    <Monitor class="tt-icon" data-value="system" hidden />
  </button>
  <div id="tt-menu" class="tt-menu" hidden>
    <button type="button" class="tt-option" data-value="light">
      <Sun class="tt-option-icon" />
      <span class="tt-option-label"></span>
    </button>
    <button type="button" class="tt-option" data-value="dark">
      <Moon class="tt-option-icon" />
      <span class="tt-option-label"></span>
    </button>
    <button type="button" class="tt-option" data-value="system">
      <Monitor class="tt-option-icon" />
      <span class="tt-option-label"></span>
    </button>
  </div>
</div>

<script>
  import '../scripts/theme-toggle'
</script>

<style>
  .theme-toggle {
    position: relative;
  }

  .theme-toggle:not([hidden]) {
    display: inline-flex;
  }

  .theme-toggle[hidden] {
    display: inline-flex;
    visibility: hidden;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
  }

  /* Border and background live on ::before so the drawn chip can shrink
     independently of the hit box. */
  .tt-open {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: var(--icon-btn-glyph);
    padding: 0;
    cursor: pointer;
  }

  /* `pointer-events: none`, or this decoration swallows clicks meant for the
     button. */
  .tt-open::before {
    content: '';
    position: absolute;
    inline-size: var(--icon-btn-chip);
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  /* `position: relative` keeps the glyph's painting group above the ::before
     chip. No z-index: source order alone decides, and one here would fight the menu. */
  .tt-icon:not([hidden]) {
    display: block;
    position: relative;
  }

  .tt-icon[hidden] {
    display: none;
  }

  .tt-open:hover,
  .tt-open:focus-visible,
  .tt-open[aria-expanded='true'] {
    color: var(--accent);
  }

  .tt-open:hover::before,
  .tt-open:focus-visible::before,
  .tt-open[aria-expanded='true']::before {
    border-color: var(--accent);
  }

  .tt-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* theme-toggle.ts sets top/left here in pixels. */
  .tt-menu {
    position: fixed;
    z-index: 60;
    margin: 0;
    min-inline-size: 8rem;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    padding: 0.3rem 0;
  }

  .tt-menu:popover-open,
  .tt-menu:not([popover]):not([hidden]) {
    display: flex;
    flex-direction: column;
  }

  .tt-option {
    display: flex;
    align-items: center;
    min-block-size: var(--icon-btn-hit);
    border: 0;
    border-block-end: var(--border) solid var(--rule);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: start;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
  }

  .tt-option-icon {
    flex-shrink: 0;
    margin-inline-end: 0.5rem;
  }

  .tt-option:last-child {
    border-block-end: 0;
  }

  .tt-option:hover,
  .tt-option:focus-visible {
    background: var(--rule);
  }

  .tt-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .tt-option[aria-current='true'] {
    color: var(--accent);
  }
</style>
