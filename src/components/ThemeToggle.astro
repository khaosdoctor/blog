---
// Explicit light/dark/system control, next to LangSwitcher in the header. Same
// shape as CodeTheme.astro: a button and a menu do nothing without a script to
// wire them up, so both stay hidden until theme-toggle.ts confirms it can run.
// Option labels travel through data attributes for the same reason CodeTheme's
// do: that script has no access to t().
//
// Applying a stored choice before first paint is the blocking script in
// BaseLayout's <head>; this component only renders the control itself.
//
// A native <select> was considered for the menu, the same element
// CodeTheme.astro's picker uses, since it would delete the open/place/
// outside-click/Escape machinery below for free. Rejected: the owner asked
// for an icon beside each choice, and an <option> cannot hold one.
import { t, type Locale } from '../i18n/ui'
import Sun from './icons/Sun.astro'
import Moon from './icons/Moon.astro'
import Monitor from './icons/Monitor.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div
  class="theme-toggle"
  hidden
  data-label={t(locale, 'themeToggle')}
  data-light={t(locale, 'themeLight')}
  data-dark={t(locale, 'themeDark')}
  data-system={t(locale, 'themeSystem')}
>
  <button type="button" class="tt-open" aria-haspopup="true" aria-expanded="false" aria-controls="tt-menu">
    {/* One icon per scheme, all hidden until theme-toggle.ts un-hides the
       current one: the button shows what is on, without opening anything. */}
    <Sun class="tt-icon" data-value="light" hidden />
    <Moon class="tt-icon" data-value="dark" hidden />
    <Monitor class="tt-icon" data-value="system" hidden />
  </button>
  <div id="tt-menu" class="tt-menu" hidden>
    <button type="button" class="tt-option" data-value="light">
      <Sun class="tt-option-icon" />
      <span class="tt-option-label"></span>
    </button>
    <button type="button" class="tt-option" data-value="dark">
      <Moon class="tt-option-icon" />
      <span class="tt-option-label"></span>
    </button>
    <button type="button" class="tt-option" data-value="system">
      <Monitor class="tt-option-icon" />
      <span class="tt-option-label"></span>
    </button>
  </div>
</div>

<script>
  import '../scripts/theme-toggle'
</script>

<style>
  .theme-toggle {
    position: relative;
  }

  /*
   * Author CSS beats the UA sheet's `[hidden] { display: none }` regardless of
   * specificity, so `display` only ever applies here, on the `:not([hidden])`
   * state: a reader with JS off, who never gets past the wrapper's own
   * `hidden`, would otherwise see a dead control anyway.
   */
  .theme-toggle:not([hidden]) {
    display: inline-flex;
  }

  /*
   * Icon-only, so the touch target comes from the button's own box rather
   * than from a bigger glyph: min-inline/block-size holds --icon-btn-hit (the
   * WCAG 44px floor, theme.css) regardless of how small the drawn chip below
   * gets. The button itself carries no border or background any more; both
   * moved to ::before, sized at --icon-btn-chip, so the *visible* square can
   * shrink independently of the box a pointer actually has to reach.
   */
  .tt-open {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: var(--icon-btn-glyph);
    padding: 0;
    cursor: pointer;
  }

  /*
   * The chip a reader actually sees, sized at `--icon-btn-chip` rather than the
   * full hit box. `pointer-events: none` so a click anywhere in the real button
   * still reaches it rather than being swallowed by this decoration.
   *
   * The border reads `--accent-day`, not `--rule`, so every icon button shares
   * the row's one accent. `--rule` was chosen for the 3:1 a non-text border
   * needs; the day colours clear 3:1 too on both grounds (the weakest being
   * yellow at 3.23 light), so nothing drops under the floor.
   */
  .tt-open::before {
    content: '';
    position: absolute;
    inline-size: var(--icon-btn-chip);
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  /*
   * Sized from .tt-open's own font-size above; only the current one is
   * unhidden, which the script does by moving the `hidden` attribute.
   *
   * The second rule is the one that does the hiding, and it has to exist: the
   * UA stylesheet declares `@namespace url(http://www.w3.org/1999/xhtml)`, so
   * its `[hidden] { display: none }` never matches an `<svg>`, which is in the
   * SVG namespace. Without this the attribute is inert and all three glyphs
   * draw at once.
   */
  /*
   * position: relative only so the glyph paints above the ::before chip below.
   * That chip is absolutely positioned and fills itself with --bg, and an
   * absolutely positioned pseudo-element paints over a non-positioned sibling
   * whatever the source order says, so the opaque square covered the icon and
   * the button rendered as an empty outlined box. Giving the glyph a position
   * puts it in the same painting group and later in it. No z-index: the two
   * are siblings in one stacking context, so tree order decides once both are
   * positioned, and a z-index here would only invite a fight with the menu.
   */
  .tt-icon:not([hidden]) {
    display: block;
    position: relative;
  }

  .tt-icon[hidden] {
    display: none;
  }

  .tt-open:hover,
  .tt-open:focus-visible,
  .tt-open[aria-expanded='true'] {
    color: var(--accent);
  }

  .tt-open:hover::before,
  .tt-open:focus-visible::before,
  .tt-open[aria-expanded='true']::before {
    border-color: var(--accent);
  }

  /* Drawn on the real (larger) hit box, not the chip, so focus shows the
     whole area a keyboard or switch-access user can actually activate. */
  .tt-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * Positioned by theme-toggle.ts, which sets top/left in pixels once it knows
   * where the opener button is. Deliberately no `display` here: the browser
   * already hides a closed popover (`[popover]:not(:popover-open)`) and the
   * no-popover fallback (`[hidden]`), and an author `display` would beat both,
   * which is the bug CodeTheme's picker hit first (see code-blocks.css).
   */
  .tt-menu {
    position: fixed;
    z-index: 60;
    margin: 0;
    min-inline-size: 8rem;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    padding: 0.3rem 0;
  }

  .tt-menu:popover-open,
  .tt-menu:not([popover]):not([hidden]) {
    display: flex;
    flex-direction: column;
  }

  .tt-option {
    display: flex;
    align-items: center;
    min-block-size: var(--icon-btn-hit);
    border: 0;
    border-block-end: var(--border) solid var(--rule);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: start;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
  }

  /* An icon alone in a menu leaves the reader guessing, so the label stays;
     the icon only speeds up the visual match and inherits the option's own
     0.75rem. Spaced from the label with margin, not a row property, to avoid
     a three-letter CSS keyword the author has banned from this codebase. */
  .tt-option-icon {
    flex-shrink: 0;
    margin-inline-end: 0.5rem;
  }

  .tt-option:last-child {
    border-block-end: 0;
  }

  .tt-option:hover,
  .tt-option:focus-visible {
    background: var(--rule);
  }

  .tt-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /*
   * The current choice, the same way LangSwitcher marks the current language:
   * `aria-current="true"` on the matching option. A real `role="radio"` group
   * would announce it too, but the ARIA radiogroup pattern also asks for a
   * roving tabindex and arrow-key navigation between options, which is more
   * machinery than three buttons in a menu need; Tab and Enter already reach
   * every option here.
   */
  .tt-option[aria-current='true'] {
    color: var(--accent);
  }
</style>
