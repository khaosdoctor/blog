---
interface Props {
  cite?: string
}

const { cite } = Astro.props
---

<blockquote class="epigraph">
  <slot />
  {cite && <cite>{cite}</cite>}
</blockquote>

<style>
  .epigraph {
    margin-inline: 0;
    margin-block: 2rem;
    padding-inline-start: 1.2rem;
    border-inline-start: 2px solid var(--rule);
    color: var(--muted);
    font-style: italic;
  }

  /* :global since this reaches into <p> tags MDX renders inside the slot,
     not markup this component owns. Forcing slotted content into our own
     <p> was invalid HTML for multi-paragraph or block-level epigraphs. */
  .epigraph :global(p) {
    margin: 0;
  }

  .epigraph :global(p + p) {
    margin-block-start: 0.75rem;
  }

  .epigraph cite {
    display: block;
    margin-block-start: 0.4rem;
    font-size: 0.85rem;
    font-style: normal;
  }
</style>
