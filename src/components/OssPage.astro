---
// The whole open-source credits page, shared by src/pages/oss.astro and its
// /en/ twin: the two differed only by locale, so the markup and the intro
// style live once here.
import BaseLayout from '../layouts/BaseLayout.astro'
import CreditList from './CreditList.astro'
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<BaseLayout
  title={`${t(locale, 'ossTitle')} | Lucas Santos`}
  description={t(locale, 'ossDescription')}
  lang={locale}
  alternates={[
    { lang: 'pt-BR', href: new URL('/oss/', Astro.site).href },
    { lang: 'en', href: new URL('/en/oss/', Astro.site).href },
  ]}
>
  <h1 class="listing-heading">{t(locale, 'ossTitle')}</h1>
  <p class="intro listing-heading">{t(locale, 'ossIntro')}</p>
  <div class="listing-heading">
    <CreditList locale={locale} />
  </div>
</BaseLayout>

<style>
  .intro {
    margin-block-end: 2.5rem;
    color: var(--muted);
  }
</style>
