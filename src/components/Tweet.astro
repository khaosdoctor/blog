---
interface Props {
  url: string
}

const { url } = Astro.props
---

<blockquote class="twitter-tweet" data-dnt="true">
  <slot />
  <a href={url}>{url}</a>
</blockquote>

<script is:inline>
  if (!document.querySelector('script[src^="https://platform.twitter.com/widgets.js"]')) {
    const script = document.createElement('script')
    script.async = true
    script.charset = 'utf-8'
    script.src = 'https://platform.twitter.com/widgets.js'
    document.head.appendChild(script)
  }
</script>

<style>
  /* Only ever seen as a fallback: widgets.js replaces this element with its
     own iframe when it loads. */
  .twitter-tweet {
    margin-block: 2rem;
    margin-inline: 0;
    padding: 1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    font-size: 0.95rem;
  }

  .twitter-tweet :global(p:first-child) {
    margin-block-start: 0;
  }

  .twitter-tweet > a {
    display: block;
    margin-block-start: 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
    word-break: break-all;
  }
</style>
