---
/**
 * A real embedded tweet, built as progressive enhancement rather than a fetch.
 *
 * The markup is exactly what Twitter's widget script looks for: a
 * `blockquote.twitter-tweet` whose last anchor points at the status URL. On
 * load, widgets.js replaces it with the live embed. Until then, and forever,
 * if the script is blocked, the tweet is deleted, or X breaks embeds for
 * logged-out readers again, the reader sees the tweet text Ghost cached when
 * the card was created, which is what <slot /> holds.
 *
 * No build-time fetch. astro-embed's Tweet component calls Twitter's
 * oEmbed for every tweet at build, which makes the build non-deterministic,
 * network-dependent, and prone to failing on someone else's outage. The text is
 * already in the repo, so it renders from there.
 *
 * data-dnt stops X using the impression for personalisation. It does not stop
 * the request: these pages do talk to X.
 */
interface Props {
  url: string
}

const { url } = Astro.props
---

<blockquote class="twitter-tweet" data-dnt="true">
  <slot />
  <a href={url}>{url}</a>
</blockquote>

<script is:inline>
  // One copy of the widget script per page, however many tweets are on it.
  if (!document.querySelector('script[src^="https://platform.twitter.com/widgets.js"]')) {
    const script = document.createElement('script')
    script.async = true
    script.charset = 'utf-8'
    script.src = 'https://platform.twitter.com/widgets.js'
    document.head.appendChild(script)
  }
</script>

<style>
  /* Styles the fallback only: once widgets.js runs it replaces this element
     completely with an iframe of its own. */
  .twitter-tweet {
    margin-block: 2rem;
    margin-inline: 0;
    padding: 1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    font-size: 0.95rem;
  }

  .twitter-tweet :global(p:first-child) {
    margin-block-start: 0;
  }

  .twitter-tweet > a {
    display: block;
    margin-block-start: 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
    word-break: break-all;
  }
</style>
