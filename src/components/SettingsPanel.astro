---
// The reader preferences panel: one sliders button beside ThemeToggle,
// opening a menu that holds the four things docs/design.md settles into one
// place rather than four scattered controls. Same shape as ThemeToggle.astro
// on purpose (docs/design.md asked for this component to grow right where
// ThemeToggle already sits): a button and a menu do nothing without a script
// to wire them up, so both stay hidden until settings-panel.ts confirms it
// can run.
//
// What lives here, in order: the motion override (mirrors ThemeToggle's own
// light/dark/system three-way, one key over), the text-size stepper and the
// reading-font picker (both scoped to --text-base/--font-body, theme.css:
// neither touches the header, the mark or code, which keep their own decided
// faces), the Conway background on/off switch, a disclosure for its
// reader-adjustable knobs, the code theme picker (moved here from every code
// block, see CodeTheme.astro), and the pinned-preview persistence checkbox
// (moved here from HoverPreviews.astro, closing the open decision
// docs/design.md recorded for it).
//
// Static labels are rendered directly through t(), the same way
// HoverPreviews.astro's own checkbox label always has been: this is an Astro
// component with full access to t() at render time, unlike the plain script
// modules that wire the controls up afterwards. Dataset attributes are kept
// only for the one label that genuinely changes at runtime (the pause
// button's own text swapping to "resume").
import Cog from './icons/Cog.astro'
import CodeTheme from './CodeTheme.astro'
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div class="settings-panel" hidden data-label={t(locale, 'settingsPanel')}>
  <button type="button" class="sp-open" aria-haspopup="true" aria-expanded="false" aria-controls="sp-menu">
    <Cog class="sp-icon" />
  </button>

  <div id="sp-menu" class="sp-menu" hidden>
    <p class="sp-heading">{t(locale, 'settingsPanel')}</p>

    <fieldset class="sp-motion">
      <legend>{t(locale, 'motionLabel')}</legend>
      <button type="button" class="sp-motion-option" data-value="reduce">{t(locale, 'motionReduce')}</button>
      <button type="button" class="sp-motion-option" data-value="allow">{t(locale, 'motionAllow')}</button>
      <button type="button" class="sp-motion-option" data-value="system">{t(locale, 'motionSystem')}</button>
    </fieldset>

    <fieldset class="sp-font-size">
      <legend>
        <label for="sp-font-size">{t(locale, 'fontSizeLabel')}</label>
      </legend>
      <div class="sp-font-size-row">
        {/* A stepper, the owner's own ask ("instead of a slider, add a - and
           a + button with a textbox in the middle"), across 50-160% (the
           range narrowed from the 10-500 this control opened with). A flat
           step of 10 gives twelve stops, each a perceptible jump, and puts
           both ends on the grid (see settings-panel.ts's own comment on
           FONT_SIZE_STEP).

           `type="number"` rather than a plain text box: min/max/step here are
           what give the box its own Up/Down arrow stepping for free, on the
           same grid the two buttons move it along, and what make a screen
           reader announce it as a spinbutton with a range rather than as an
           open-ended text field. A text input would mean owning both of
           those by hand for nothing gained. What `type="number"` does *not*
           do is enforce min/max on a typed value (it only reports the field
           invalid), so settings-panel.ts still clamps and snaps whatever is
           typed, on `change` rather than on every keystroke: "5" on the way
           to "50" would otherwise apply as 50 and fight the reader's typing.

           The two buttons take .sp-step, the same border/radius/uppercase
           chrome as .sp-motion-option and the Conway actions row, so this is
           the panel's existing button rather than a new one.

           The percent sign is a static aria-hidden marker, not part of the
           box: keeping it out of the input is what lets the input hold a
           bare number the browser can step and validate. The reader-facing
           unit is still on screen, and the accessible name of the whole
           thing comes from the legend's own label plus the live region
           below. */}
        <button type="button" class="sp-step" id="sp-font-size-down" aria-label={t(locale, 'fontSizeDecrease')}>&minus;</button>
        <input type="number" id="sp-font-size" min="50" max="160" step="10" inputmode="numeric" />
        <span class="sp-font-size-unit" aria-hidden="true">%</span>
        <button type="button" class="sp-step" id="sp-font-size-up" aria-label={t(locale, 'fontSizeIncrease')}>+</button>
        {/* Back to 100%, which this panel stores as *nothing stored* (see
           settings-panel.ts's applyFontSize and the FONT_SIZE_DEFAULT branch
           of the write path): resetting removes the key and the inline
           --font-scale rather than writing a literal 100. Its visible label
           is the number itself, untranslated the same way the code theme
           names are, with the sentence in aria-label. */}
        <button type="button" class="sp-step" id="sp-font-size-reset" aria-label={t(locale, 'fontSizeReset')}>
          {t(locale, 'fontSizeResetShort')}
        </button>
      </div>
      {/* The announcement channel for the three buttons: pressing one does not
         move focus, so without a live region nothing tells a screen reader
         the size changed. Visually hidden (the .sr-only in BaseLayout's own
         global block) rather than removed, because the box beside it already
         shows the same number on screen and a second copy in an 18rem menu
         is noise. */}
      <span
        id="sp-font-size-value"
        class="sr-only"
        aria-live="polite"
        data-template={t(locale, 'fontSizeCurrent')}></span>
    </fieldset>

    {/* The accent override. "Auto" is the site's own behaviour, today's colour
       from the day hash (lib/day-color.ts), and is the default; the five
       swatches pin it to one brand colour instead.

       Swatches are buttons rather than radios for the same reason the motion
       and reading-font rows are: this panel has one button-group shape and
       one aria-current convention, and a radio group here would be a second.
       Each carries a real name in aria-label, so the choice is never colour
       alone (WCAG 1.4.1), and the selected one is marked by the same
       aria-current the rest of the panel uses rather than by its swatch
       looking different.

       Purple is offered even though the automatic rotation never draws it:
       that exclusion is about chance, not about the colour. */}
    <fieldset class="sp-accent">
      <legend>{t(locale, 'accentLabel')}</legend>
      <div class="sp-accent-row">
        <button type="button" class="sp-accent-auto" data-value="auto">{t(locale, 'accentAuto')}</button>
        <button type="button" class="sp-accent-option" data-value="red" style="--swatch: var(--brand-red)" aria-label={t(locale, 'accentRed')}></button>
        <button type="button" class="sp-accent-option" data-value="green" style="--swatch: var(--brand-green)" aria-label={t(locale, 'accentGreen')}></button>
        <button type="button" class="sp-accent-option" data-value="yellow" style="--swatch: var(--brand-yellow)" aria-label={t(locale, 'accentYellow')}></button>
        <button type="button" class="sp-accent-option" data-value="blue" style="--swatch: var(--brand-blue)" aria-label={t(locale, 'accentBlue')}></button>
        <button type="button" class="sp-accent-option" data-value="purple" style="--swatch: var(--brand-purple)" aria-label={t(locale, 'accentPurple')}></button>
      </div>
    </fieldset>

    <fieldset class="sp-font-family">
      <legend>{t(locale, 'fontFamilyLabel')}</legend>
      <button type="button" class="sp-font-family-option" data-value="serif">{t(locale, 'fontFamilySerif')}</button>
      <button type="button" class="sp-font-family-option" data-value="sans">{t(locale, 'fontFamilySans')}</button>
    </fieldset>

    <label class="sp-row">
      <input type="checkbox" id="sp-bg-life" />
      {t(locale, 'backgroundLife')}
    </label>

    <details class="sp-conway-details">
      <summary>{t(locale, 'conwayKnobs')}</summary>
      <div class="sp-conway-knobs">
        {/* Every knob prints its own value beside its label. A bare range
           input shows where the handle is and never what that position
           means, so "generations per second" was a slider a reader could
           set without ever learning what they had set it to.

           Each readout is aria-hidden and carries no unit in its markup: the
           range input itself already announces its own value to a screen
           reader, so a second copy would only read the number twice, and the
           unit each one appends (%, /s, s) is a symbol rather than a word,
           which is why it lives in settings-panel.ts's formatter instead of
           in a translated string. */}
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwaySeedDensity')}</span>
            <span class="sp-knob-value" id="sp-density-value" aria-hidden="true"></span>
          </span>
          <input type="range" id="sp-density" min="1" max="20" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayGenerationsPerSecond')}</span>
            <span class="sp-knob-value" id="sp-gps-value" aria-hidden="true"></span>
          </span>
          {/* 1 to 25 whole generations a second, matching setGps's own clamp
             in conway.ts. It used to be 0.5 to 8 in half steps; a fractional
             generation rate is a number nobody sets on purpose, and the top
             of the old range was slower than the field can actually run. */}
          <input type="range" id="sp-gps" min="1" max="25" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayAutoFeed')}</span>
            <span class="sp-knob-value" id="sp-autofeed-value" aria-hidden="true"></span>
          </span>
          <input type="range" id="sp-autofeed" min="0" max="20" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayOpacity')}</span>
            <span class="sp-knob-value" id="sp-opacity-value" aria-hidden="true"></span>
          </span>
          {/* min/max match conway.ts's own MIN_OPACITY/MAX_OPACITY (0 to 0.5),
             hardcoded here the same way density/gps/autofeed's own ranges
             are above: those constants are not exported, same reason. Step
             0.01 so the slider can actually rest on the 0.04 default. */}
          <input type="range" id="sp-opacity" min="0" max="0.5" step="0.01" />
        </label>
        <div class="sp-conway-actions">
          <button type="button" id="sp-pause" data-pause={t(locale, 'conwayPause')} data-resume={t(locale, 'conwayResume')}>
            {t(locale, 'conwayPause')}
          </button>
          <button type="button" id="sp-reseed">{t(locale, 'conwayReseed')}</button>
        </div>
      </div>
    </details>

    <fieldset class="sp-search-shortcut">
      <legend>{t(locale, 'searchShortcutLabel')}</legend>
      <select id="sp-search-key">
        {Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i)).map((letter) => (
          <option value={letter}>{letter}</option>
        ))}
      </select>
    </fieldset>

    <hr class="sp-rule" />

    <CodeTheme locale={locale} />

    <label class="sp-row">
      <input type="checkbox" id="hp-persist" />
      {t(locale, 'keepPreviews')}
    </label>

    <hr class="sp-rule" />

    {/* One control returning every preference above to its default. No
       confirmation step, which is the house answer rather than a shortcut:
       nothing else on this site confirms before a destructive action (the
       reseed button two fieldsets up wipes the whole field on the first
       click, and closing a pinned preview discards it), and none of what
       this clears is the reader's own content, only choices any of which is
       one click from being made again. A dialog here would be the only one
       on the site, and it would be guarding the cheapest thing to undo.

       Every one of these settings lives above this rule, which is why the
       light/dark theme choice is not in scope: it belongs to ThemeToggle,
       one button over, and the owner asked for it to stay out of this panel.
       See settings-panel.ts's own note where this is wired up. */}
    <button type="button" class="sp-reset-all" id="sp-reset-all" title={t(locale, 'resetAllHint')}>
      {t(locale, 'resetAll')}
    </button>
  </div>
</div>

<script>
  import '../scripts/settings-panel'
</script>

<style>
  .settings-panel {
    position: relative;
  }

  /* Same reasoning as ThemeToggle's own rule: the UA `[hidden] { display:
     none }` sheet is namespaced to XHTML and never matches an <svg>, so a
     hidden icon inside this button would still draw unless CSS says so
     itself. Nothing in this panel currently hides an SVG conditionally (the
     sliders icon is the only one and it is never swapped), but the rule
     stays here as the same guard ThemeToggle carries, since the next icon
     added to this row is the likeliest place for that trap to reappear. */
  .settings-panel:not([hidden]) {
    display: inline-flex;
  }

  .sp-icon[hidden] {
    display: none;
  }

  /* Same reason as ThemeToggle's .tt-icon: the ::before chip is absolutely
     positioned and opaque, so it paints over an unpositioned glyph and leaves
     an empty outlined square. */
  .sp-icon {
    position: relative;
  }

  /*
   * Identical footprint to ThemeToggle's .tt-open, both reading the same
   * three tokens (theme.css): --icon-btn-hit is the real hit target, the
   * border and background move to ::before at --icon-btn-chip so the
   * visible square can be smaller than the box a pointer has to reach, and
   * --icon-btn-glyph sizes the icon itself.
   */
  .sp-open {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: var(--icon-btn-glyph);
    padding: 0;
    cursor: pointer;
  }

  /*
   * Border reads --accent-day, not --rule: see ThemeToggle's own .tt-open
   * ::before for the full reasoning (the day colour clears the 3:1 a
   * non-text border needs on every one of its four possible values) and the
   * measured numbers.
   */
  .sp-open::before {
    content: '';
    position: absolute;
    inline-size: var(--icon-btn-chip);
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  .sp-open:hover,
  .sp-open:focus-visible,
  .sp-open[aria-expanded='true'] {
    color: var(--accent);
  }

  .sp-open:hover::before,
  .sp-open:focus-visible::before,
  .sp-open[aria-expanded='true']::before {
    border-color: var(--accent);
  }

  .sp-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Same no-`display`-here rule ThemeToggle's own menu carries: the browser
     already hides a closed popover and the no-popover `hidden` fallback, and
     an author `display` here would beat both. */
  .sp-menu {
    position: fixed;
    z-index: 60;
    margin: 0;
    inline-size: 18rem;
    max-block-size: 80vh;
    overflow-y: auto;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  .sp-menu:popover-open,
  .sp-menu:not([popover]):not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sp-heading {
    margin: 0;
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sp-motion {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-motion legend {
    inline-size: 100%;
    margin-block-end: 0.3rem;
    padding: 0;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .sp-motion-option {
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
  }

  .sp-motion-option[aria-current='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sp-motion-option:hover,
  .sp-motion-option:focus-visible {
    border-color: var(--accent);
  }

  .sp-motion-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Same fieldset/legend shape as .sp-motion's own, one row of two buttons and
     a value readout instead of a button group. */
  .sp-font-size {
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-font-size legend {
    margin-block-end: 0.3rem;
    padding: 0;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .sp-font-size-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .sp-font-size-row > * + * {
    margin-inline-start: 0.3rem;
  }

  /* The minus/plus/reset buttons. Same border, radius, family and casing as
     .sp-motion-option and .sp-conway-actions button, which is the panel's one
     button treatment; only the padding is tighter, since two of the three
     carry a single glyph rather than a word. */
  .sp-step {
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.5rem;
    cursor: pointer;
  }

  .sp-step:hover:not(:disabled),
  .sp-step:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sp-step:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* At 50% and at 160% the matching button is disabled rather than left
     looking live and doing nothing. Dimmed *and* given not-allowed, since
     colour alone is the signal a reader with low vision is least likely to
     catch; the `disabled` attribute itself is what tells a screen reader. */
  .sp-step:disabled {
    color: var(--muted);
    border-color: var(--rule);
    opacity: 0.5;
    cursor: not-allowed;
  }

  /*
   * Sized to the widest value it can hold (three digits), so the row does not
   * shift between 50 and 160.
   *
   * The native spinner is dropped on purpose: the minus and plus buttons
   * beside it already are that control, at a hit target a pointer can
   * actually reach, and the browser's own arrows are two tiny halves stacked
   * inside the field. Up/Down on the keyboard still steps it, since that
   * behaviour belongs to `type="number"` itself rather than to the rendered
   * spinner.
   */
  .sp-font-size-row input[type='number'] {
    inline-size: 4.5ch;
    flex: 0 0 auto;
    text-align: center;
    background: var(--bg);
    color: var(--fg);
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    padding: 0.3rem 0.2rem;
    appearance: textfield;
  }

  .sp-font-size-row input[type='number']:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sp-font-size-row input[type='number']::-webkit-outer-spin-button,
  .sp-font-size-row input[type='number']::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .sp-font-size-unit {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  /* Same button-group shape as .sp-motion/.sp-motion-option, its own classes
     since settings-panel.ts scopes its motion query to .sp-motion-option and
     these two buttons must not answer to that query too. */
  .sp-font-family {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-font-family legend {
    inline-size: 100%;
    margin-block-end: 0.3rem;
    padding: 0;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .sp-font-family-option {
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.6rem;
    margin-inline-end: 0.4rem;
    margin-block-end: 0.4rem;
    cursor: pointer;
  }

  .sp-font-family-option[aria-current='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sp-font-family-option:hover,
  .sp-font-family-option:focus-visible {
    border-color: var(--accent);
  }

  .sp-font-family-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sp-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
  }

  /*
   * The field's properties only exist while the field does. With the
   * background off, every knob in here adjusts something that is not being
   * drawn, and the pause and reseed buttons act on a stopped canvas.
   *
   * Done in CSS off the checkbox's own state rather than in the script: the
   * two are adjacent siblings, so `:has()` on the row reads the checkbox
   * without either element needing a class toggled from JS, and the panel
   * cannot get into a state where the box says one thing and the disclosure
   * shows another. `display: none` rather than the `hidden` attribute so
   * nothing has to remember to remove it.
   */
  .sp-row:has(#sp-bg-life:not(:checked)) + .sp-conway-details {
    display: none;
  }

  .sp-conway-details summary {
    color: var(--fg);
    cursor: pointer;
  }

  .sp-conway-knobs {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block-start: 0.6rem;
  }

  .sp-knob {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--muted);
  }

  .sp-knob input[type='range'] {
    inline-size: 100%;
  }

  .sp-accent-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  /*
   * A swatch is a square of the colour it sets, with the panel's own border
   * around it so it reads as a control rather than as a decoration. No label
   * on screen: six named colours would fill the menu, and the name is in
   * aria-label where a screen reader finds it.
   */
  .sp-accent-option {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin-inline-end: 0.35rem;
    padding: 0;
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: var(--swatch);
    cursor: pointer;
  }

  .sp-accent-auto {
    margin-inline-end: 0.35rem;
    padding: 0.15rem 0.5rem;
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: var(--text-tiny);
    text-transform: uppercase;
    cursor: pointer;
  }

  /*
   * The selected one, marked the way every other group in this panel marks
   * its own: aria-current drives it, and the mark is a ring drawn outside the
   * swatch rather than a change to the swatch itself, since the swatch's whole
   * job is to show one exact colour.
   */
  .sp-accent-option[aria-current='true'],
  .sp-accent-auto[aria-current='true'] {
    border-color: var(--fg);
    outline: var(--border) solid var(--fg);
    outline-offset: 2px;
  }

  .sp-accent-option:focus-visible,
