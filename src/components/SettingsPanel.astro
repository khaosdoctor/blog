---
import { type Locale, t } from '../i18n/ui'
import { fontSizeMaximumPercent, fontSizeMinimumPercent, fontSizeStepPercent } from '../lib/tweaks'
import CodeTheme from './CodeTheme.astro'
import Cog from './icons/Cog.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div class="settings-panel" hidden data-label={t(locale, 'settingsPanel')}>
  <button type="button" class="sp-open" aria-haspopup="true" aria-expanded="false" aria-controls="sp-menu">
    <Cog class="sp-icon" />
  </button>

  <span class="sp-nudge" data-nudge hidden aria-hidden="true">{t(locale, 'settingsNudge')}</span>

  <div id="sp-menu" class="sp-menu" hidden>
    <p class="sp-heading">{t(locale, 'settingsPanel')}</p>

    <fieldset class="sp-motion">
      <legend>{t(locale, 'motionLabel')}</legend>
      <button type="button" class="sp-motion-option" data-value="reduce">{t(locale, 'motionReduce')}</button>
      <button type="button" class="sp-motion-option" data-value="allow">{t(locale, 'motionAllow')}</button>
      <button type="button" class="sp-motion-option" data-value="system">{t(locale, 'motionSystem')}</button>
    </fieldset>

    <fieldset class="sp-font-size">
      <legend>
        <label for="sp-font-size">{t(locale, 'fontSizeLabel')}</label>
      </legend>
      <div class="sp-font-size-row">
        <button type="button" class="sp-step" id="sp-font-size-down" aria-label={t(locale, 'fontSizeDecrease')}>&minus;</button>
        <input
          type="number"
          id="sp-font-size"
          min={fontSizeMinimumPercent}
          max={fontSizeMaximumPercent}
          step={fontSizeStepPercent}
          inputmode="numeric"
        />
        <span class="sp-font-size-unit" aria-hidden="true">%</span>
        <button type="button" class="sp-step" id="sp-font-size-up" aria-label={t(locale, 'fontSizeIncrease')}>+</button>
        <button type="button" class="sp-step" id="sp-font-size-reset" aria-label={t(locale, 'fontSizeReset')}>
          {t(locale, 'fontSizeResetShort')}
        </button>
      </div>
      {/* A stepper button moves no focus, so nothing else announces the change. */}
      <span
        id="sp-font-size-value"
        class="sr-only"
        aria-live="polite"
        data-template={t(locale, 'fontSizeCurrent')}></span>
    </fieldset>

    <fieldset class="sp-accent">
      <legend>{t(locale, 'accentLabel')}</legend>
      <div class="sp-accent-row">
        <button type="button" class="sp-accent-auto" data-value="auto">{t(locale, 'accentAuto')}</button>
        <button type="button" class="sp-accent-option" data-value="red" style="--swatch: var(--brand-red)" aria-label={t(locale, 'accentRed')}></button>
        <button type="button" class="sp-accent-option" data-value="green" style="--swatch: var(--brand-green)" aria-label={t(locale, 'accentGreen')}></button>
        <button type="button" class="sp-accent-option" data-value="yellow" style="--swatch: var(--brand-yellow)" aria-label={t(locale, 'accentYellow')}></button>
        <button type="button" class="sp-accent-option" data-value="blue" style="--swatch: var(--brand-blue)" aria-label={t(locale, 'accentBlue')}></button>
        <button type="button" class="sp-accent-option" data-value="purple" style="--swatch: var(--brand-purple)" aria-label={t(locale, 'accentPurple')}></button>
        <button type="button" class="sp-accent-option" data-value="white" style="--swatch: var(--fg)" aria-label={t(locale, 'accentWhite')}></button>
      </div>
    </fieldset>

    <fieldset class="sp-font-family">
      <legend>{t(locale, 'fontFamilyLabel')}</legend>
      <button type="button" class="sp-font-family-option" data-value="serif">{t(locale, 'fontFamilySerif')}</button>
      <button type="button" class="sp-font-family-option" data-value="sans">{t(locale, 'fontFamilySans')}</button>
    </fieldset>

    <label class="sp-row">
      <input type="checkbox" id="sp-bg-life" />
      {t(locale, 'backgroundLife')}
    </label>

    <details class="sp-conway-details">
      <summary>{t(locale, 'conwayKnobs')}</summary>
      <div class="sp-conway-knobs">
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwaySeedDensity')}</span>
            <span class="sp-knob-value" id="sp-density-value" aria-hidden="true"></span>
          </span>
          <input type="range" id="sp-density" min="1" max="20" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayGenerationsPerSecond')}</span>
            <span class="sp-knob-value" id="sp-gps-value" aria-hidden="true"></span>
          </span>
          <input type="range" id="sp-gps" min="1" max="25" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayAutoFeed')}</span>
            <span class="sp-knob-value" id="sp-autofeed-value" aria-hidden="true"></span>
          </span>
          <input type="range" id="sp-autofeed" min="0" max="20" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayOpacity')}</span>
            <span class="sp-knob-value" id="sp-opacity-value" aria-hidden="true"></span>
          </span>
          <input type="range" id="sp-opacity" min="0" max="0.5" step="0.01" />
        </label>
        <div class="sp-conway-actions">
          <button type="button" id="sp-pause" data-pause={t(locale, 'conwayPause')} data-resume={t(locale, 'conwayResume')}>
            {t(locale, 'conwayPause')}
          </button>
          <button type="button" id="sp-reseed">{t(locale, 'conwayReseed')}</button>
        </div>
      </div>
    </details>

    <fieldset class="sp-search-shortcut">
      <legend>{t(locale, 'searchShortcutLabel')}</legend>
      <select id="sp-search-key" data-reserved={t(locale, 'searchShortcutReserved')}>
        {Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i)).map((letter) => (
          <option value={letter}>{letter}</option>
        ))}
      </select>
    </fieldset>

    <hr class="sp-rule" />

    <CodeTheme locale={locale} />

    <label class="sp-row">
      <input type="checkbox" id="hp-persist" />
      {t(locale, 'keepPreviews')}
    </label>

    <hr class="sp-rule" />

    <button type="button" class="sp-reset-all" id="sp-reset-all" title={t(locale, 'resetAllHint')}>
      {t(locale, 'resetAll')}
    </button>
  </div>
</div>

<script>
  import '../scripts/settings-panel'
</script>

<style>
  .settings-panel {
    position: relative;
  }

  .settings-panel:not([hidden]) {
    display: inline-flex;
  }

  /* Still occupying its space while hidden, or the late un-hide re-wraps the
     phone header. */
  .settings-panel[hidden] {
    display: inline-flex;
    visibility: hidden;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
  }

  /* The ::before chip is opaque, so it paints over an unpositioned glyph. */
  .sp-icon {
    position: relative;
  }

  .sp-open {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: var(--icon-btn-glyph);
    padding: 0;
    cursor: pointer;
  }

  .sp-open::before {
    content: '';
    position: absolute;
    inline-size: var(--icon-btn-chip);
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  .sp-open:hover,
  .sp-open:focus-visible,
  .sp-open[aria-expanded='true'] {
    color: var(--accent);
  }

  .sp-open:hover::before,
  .sp-open:focus-visible::before,
  .sp-open[aria-expanded='true']::before {
    border-color: var(--accent);
  }

  .sp-menu {
    position: fixed;
    z-index: 60;
    margin: 0;
    inline-size: 18rem;
    max-block-size: 80dvh;
    overflow-y: auto;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  .sp-menu:popover-open,
  .sp-menu:not([popover]):not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sp-heading {
    margin: 0;
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sp-motion {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-font-size,
  .sp-accent,
  .sp-search-shortcut {
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-motion legend,
  .sp-font-size legend,
  .sp-font-family legend,
  .sp-accent legend,
  .sp-search-shortcut legend {
    margin-block-end: 0.3rem;
    padding: 0;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .sp-motion legend,
  .sp-font-family legend,
  .sp-accent legend {
    inline-size: 100%;
  }

  .sp-motion-option,
  .sp-step,
  .sp-font-family-option,
  .sp-conway-actions button,
  .sp-reset-all {
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .sp-motion-option {
    padding: 0.35rem 0.6rem;
  }

  .sp-motion-option[aria-current='true'],
  .sp-font-family-option[aria-current='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sp-motion-option:hover,
  .sp-motion-option:focus-visible,
  .sp-font-family-option:hover,
  .sp-font-family-option:focus-visible,
  .sp-conway-actions button:hover,
  .sp-conway-actions button:focus-visible {
    border-color: var(--accent);
  }

  .sp-step:hover:not(:disabled),
  .sp-step:focus-visible,
  .sp-reset-all:hover,
  .sp-reset-all:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sp-open:focus-visible,
  .sp-motion-option:focus-visible,
  .sp-step:focus-visible,
  .sp-font-size-row input[type='number']:focus-visible,
  .sp-font-family-option:focus-visible,
  .sp-reset-all:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sp-font-size-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .sp-font-size-row > * + * {
    margin-inline-start: 0.3rem;
  }

  .sp-step {
    padding: 0.35rem 0.5rem;
  }

  .sp-step:disabled {
    color: var(--muted);
    border-color: var(--rule);
    opacity: 0.5;
    cursor: not-allowed;
  }

  .sp-font-size-row input[type='number'] {
    inline-size: 4.5ch;
    flex: 0 0 auto;
    text-align: center;
    background: var(--bg);
    color: var(--fg);
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    padding: 0.3rem 0.2rem;
    appearance: textfield;
  }

  .sp-font-size-row input[type='number']::-webkit-outer-spin-button,
  .sp-font-size-row input[type='number']::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .sp-font-size-unit {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  .sp-font-family {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-font-family-option {
    padding: 0.35rem 0.6rem;
    margin-inline-end: 0.4rem;
    margin-block-end: 0.4rem;
  }

  .sp-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
  }

  .sp-row:has(#sp-bg-life:not(:checked)) + .sp-conway-details {
    display: none;
  }

  /* Preview cards only open on a hovering pointer: the row can do nothing here. */
  @media (hover: none), (pointer: coarse) {
    .sp-row:has(#hp-persist) {
      display: none;
    }
  }

  .sp-conway-details summary {
    color: var(--fg);
    cursor: pointer;
  }

  .sp-conway-knobs {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block-start: 0.6rem;
  }

  .sp-knob {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--muted);
  }

  .sp-knob input[type='range'] {
    inline-size: 100%;
  }

  @media (pointer: coarse) {
    .sp-knob input[type='range'] {
      height: 2.75rem;
      appearance: none;
      background: transparent;
    }

    .sp-knob input[type='range']::-webkit-slider-thumb {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: var(--radius);
      border: var(--border) solid var(--muted);
      background: var(--fg);
      appearance: none;
      margin-top: calc((2.75rem - 0.5rem) / -2);
    }

    .sp-knob input[type='range']::-moz-range-thumb {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: var(--radius);
      border: var(--border) solid var(--muted);
      background: var(--fg);
    }

    .sp-knob input[type='range']::-webkit-slider-runnable-track {
      height: 0.5rem;
      border-radius: var(--radius);
      background: var(--muted);
    }

    .sp-knob input[type='range']::-moz-range-track {
      height: 0.5rem;
      border-radius: var(--radius);
      background: var(--muted);
    }
  }

  /* `pointer-events: none`, or it intercepts the click meant for the button
     under it. */
  .sp-nudge {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    z-index: 4;
    inline-size: max-content;
    max-inline-size: 11rem;
    margin-block-start: 0.35rem;
    padding: 0.35rem 0.5rem;
    border: var(--border) solid var(--accent-day, var(--accent));
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--text-tiny);
    line-height: 1.3;
    pointer-events: none;
  }

  .sp-nudge::before {
    content: '';
    position: absolute;
    inset-block-end: 100%;
    inset-inline-end: 0.75rem;
    border: 0.35rem solid transparent;
    border-block-end-color: var(--accent-day, var(--accent));
  }

  @media (prefers-reduced-motion: no-preference) {
    .sp-nudge {
      animation: sp-nudge-in var(--duration) var(--ease) both;
    }
  }

  @keyframes sp-nudge-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  .sp-accent-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  /* The margins have to clear the selected ring, an outline 2px outside the
     border, or two swatches overlap the moment one is chosen. */
  .sp-accent-option {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin-inline-end: 0.5rem;
    margin-block-end: 0.5rem;
    padding: 0;
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: var(--swatch);
    cursor: pointer;
  }

  .sp-accent-auto {
    margin-inline-end: 0.5rem;
    margin-block-end: 0.5rem;
    padding: 0.15rem 0.5rem;
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: var(--text-tiny);
    text-transform: uppercase;
    cursor: pointer;
  }

  .sp-accent-option[aria-current='true'],
  .sp-accent-auto[aria-current='true'] {
    border-color: var(--fg);
    outline: var(--border) solid var(--fg);
    outline-offset: 2px;
  }

  .sp-accent-option:focus-visible,
  .sp-accent-auto:focus-visible {
    outline: 2px solid var(--accent-day, var(--accent));
    outline-offset: 2px;
  }

  .sp-knob-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .sp-knob-value {
    margin-inline-start: 0.5rem;
    color: var(--fg);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .sp-conway-actions {
    display: flex;
    gap: 0.5rem;
  }

  .sp-conway-actions button {
    flex: 1 1 auto;
    padding: 0.35rem 0.5rem;
  }

  .sp-rule {
    border: 0;
    border-block-start: var(--border) solid var(--rule);
    margin: 0;
  }

  .sp-reset-all {
    inline-size: 100%;
    padding: 0.4rem 0.5rem;
  }

  .settings-panel :global(.ct-settings) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    color: var(--fg);
  }

  .sp-search-shortcut select,
  .settings-panel :global(.ct-settings select) {
    font-family: var(--font-mono);
    font-size: 1rem;
    background: var(--bg);
    color: var(--fg);
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    padding: 0.3rem;
  }

  .sp-search-shortcut option,
  .settings-panel :global(.ct-settings option),
  .settings-panel :global(.ct-settings optgroup) {
    font-size: 1rem;
  }
</style>
