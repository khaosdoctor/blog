---
// The reader preferences panel: one cog beside ThemeToggle, opening a menu
// that gathers what would otherwise be controls scattered across the page.
// Same shape as ThemeToggle.astro on purpose: a button and a menu do nothing
// without a script, so both stay hidden until settings-panel.ts confirms it
// can run.
//
// In order: the motion override (mirrors ThemeToggle's light/dark/system
// three-way), the text-size stepper and the reading-font picker (both scoped
// to --text-base/--font-body, so neither touches the header, the mark or
// code, which keep their own decided faces), the accent override, the Conway
// background switch and its knobs, the code theme picker (moved in from
// CodeTheme.astro) and the pinned-preview checkbox (moved in from
// HoverPreviews.astro).
//
// Static labels go through t() directly: this is an Astro component with
// access to it at render time, unlike the plain script modules that wire the
// controls up. Dataset attributes carry only the strings that change at
// runtime, or that a script needs and cannot call t() for.
import Cog from './icons/Cog.astro'
import CodeTheme from './CodeTheme.astro'
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div class="settings-panel" hidden data-label={t(locale, 'settingsPanel')}>
  <button type="button" class="sp-open" aria-haspopup="true" aria-expanded="false" aria-controls="sp-menu">
    <Cog class="sp-icon" />
  </button>

  {/* Shown once, on a reader's first visit, then never again (settings-panel.ts
     stores a flag). aria-hidden and out of the tab order: the button beside it
     already announces itself, and a screen reader reaching a second copy of
     "preferences" would be reading the same control twice. */}
  <span class="sp-nudge" data-nudge hidden aria-hidden="true">{t(locale, 'settingsNudge')}</span>

  <div id="sp-menu" class="sp-menu" hidden>
    <p class="sp-heading">{t(locale, 'settingsPanel')}</p>

    <fieldset class="sp-motion">
      <legend>{t(locale, 'motionLabel')}</legend>
      <button type="button" class="sp-motion-option" data-value="reduce">{t(locale, 'motionReduce')}</button>
      <button type="button" class="sp-motion-option" data-value="allow">{t(locale, 'motionAllow')}</button>
      <button type="button" class="sp-motion-option" data-value="system">{t(locale, 'motionSystem')}</button>
    </fieldset>

    <fieldset class="sp-font-size">
      <legend>
        <label for="sp-font-size">{t(locale, 'fontSizeLabel')}</label>
      </legend>
      <div class="sp-font-size-row">
        {/* A stepper across 50-160%, in steps of 10: twelve stops, each a
           perceptible jump, with both ends on the grid.

           `type="number"` rather than a text box gives Up/Down stepping on
           that same grid for free and makes a screen reader announce a
           spinbutton with a range rather than an open-ended field. What it
           does *not* do is enforce min/max on a typed value, only report the
           field invalid, so settings-panel.ts clamps and snaps on `change`
           rather than per keystroke: "5" on the way to "50" would otherwise
           apply as 50 and fight the reader's typing.

           The percent sign is a static aria-hidden marker so the input can
           hold a bare number the browser can step and validate; the
           accessible name comes from the legend plus the live region below. */}
        <button type="button" class="sp-step" id="sp-font-size-down" aria-label={t(locale, 'fontSizeDecrease')}>&minus;</button>
        <input type="number" id="sp-font-size" min="50" max="160" step="10" inputmode="numeric" />
        <span class="sp-font-size-unit" aria-hidden="true">%</span>
        <button type="button" class="sp-step" id="sp-font-size-up" aria-label={t(locale, 'fontSizeIncrease')}>+</button>
        {/* Back to 100%, which this panel stores as *nothing stored*: reset
           removes the key and the inline --font-scale rather than writing a
           literal 100. Visible label is the number, untranslated like the
           code theme names, with the sentence in aria-label. */}
        <button type="button" class="sp-step" id="sp-font-size-reset" aria-label={t(locale, 'fontSizeReset')}>
          {t(locale, 'fontSizeResetShort')}
        </button>
      </div>
      {/* Pressing a stepper button moves no focus, so without a live region
         nothing tells a screen reader the size changed. Visually hidden
         because the box beside it already shows the same number. */}
      <span
        id="sp-font-size-value"
        class="sr-only"
        aria-live="polite"
        data-template={t(locale, 'fontSizeCurrent')}></span>
    </fieldset>

    {/* The accent override. "Auto" is the default, today's colour from the day
       hash (lib/day-color.ts); the swatches pin it to one brand colour.

       Buttons rather than radios because this panel has one button-group
       shape and one aria-current convention. Each carries a real name in
       aria-label, so the choice is never colour alone (WCAG 1.4.1).

       Purple is offered even though the automatic rotation never draws it:
       that exclusion is about chance, not about the colour. */}
    <fieldset class="sp-accent">
      <legend>{t(locale, 'accentLabel')}</legend>
      <div class="sp-accent-row">
        <button type="button" class="sp-accent-auto" data-value="auto">{t(locale, 'accentAuto')}</button>
        <button type="button" class="sp-accent-option" data-value="red" style="--swatch: var(--brand-red)" aria-label={t(locale, 'accentRed')}></button>
        <button type="button" class="sp-accent-option" data-value="green" style="--swatch: var(--brand-green)" aria-label={t(locale, 'accentGreen')}></button>
        <button type="button" class="sp-accent-option" data-value="yellow" style="--swatch: var(--brand-yellow)" aria-label={t(locale, 'accentYellow')}></button>
        <button type="button" class="sp-accent-option" data-value="blue" style="--swatch: var(--brand-blue)" aria-label={t(locale, 'accentBlue')}></button>
        <button type="button" class="sp-accent-option" data-value="purple" style="--swatch: var(--brand-purple)" aria-label={t(locale, 'accentPurple')}></button>
        <button type="button" class="sp-accent-option" data-value="white" style="--swatch: var(--fg)" aria-label={t(locale, 'accentWhite')}></button>
      </div>
    </fieldset>

    <fieldset class="sp-font-family">
      <legend>{t(locale, 'fontFamilyLabel')}</legend>
      <button type="button" class="sp-font-family-option" data-value="serif">{t(locale, 'fontFamilySerif')}</button>
      <button type="button" class="sp-font-family-option" data-value="sans">{t(locale, 'fontFamilySans')}</button>
    </fieldset>

    <label class="sp-row">
      <input type="checkbox" id="sp-bg-life" />
      {t(locale, 'backgroundLife')}
    </label>

    <details class="sp-conway-details">
      <summary>{t(locale, 'conwayKnobs')}</summary>
      <div class="sp-conway-knobs">
        {/* Every knob prints its own value: a bare range input shows where the
           handle is and never what that position means.

           Each readout is aria-hidden and carries no unit in its markup: the
           range input announces its own value already, and the unit each
           appends (%, /s, s) is a symbol rather than a word, which is why it
           lives in settings-panel.ts's formatter and not in a translation. */}
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwaySeedDensity')}</span>
            <span class="sp-knob-value" id="sp-density-value" aria-hidden="true"></span>
          </span>
          <input type="range" id="sp-density" min="1" max="20" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayGenerationsPerSecond')}</span>
            <span class="sp-knob-value" id="sp-gps-value" aria-hidden="true"></span>
          </span>
          {/* Matches conway.ts's MIN_GPS/MAX_GPS. It was 0.5 to 8 in half
             steps; a fractional generation rate is a number nobody sets on
             purpose, and the old ceiling was slower than the field can run. */}
          <input type="range" id="sp-gps" min="1" max="25" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayAutoFeed')}</span>
            <span class="sp-knob-value" id="sp-autofeed-value" aria-hidden="true"></span>
          </span>
          <input type="range" id="sp-autofeed" min="0" max="20" step="1" />
        </label>
        <label class="sp-knob">
          <span class="sp-knob-head">
            <span>{t(locale, 'conwayOpacity')}</span>
            <span class="sp-knob-value" id="sp-opacity-value" aria-hidden="true"></span>
          </span>
          {/* Matches conway.ts's MIN_OPACITY/MAX_OPACITY, repeated here like
             the other three ranges because those constants are not exported.
             Step 0.01 so the slider can rest on the 0.04 default. */}
          <input type="range" id="sp-opacity" min="0" max="0.5" step="0.01" />
        </label>
        <div class="sp-conway-actions">
          <button type="button" id="sp-pause" data-pause={t(locale, 'conwayPause')} data-resume={t(locale, 'conwayResume')}>
            {t(locale, 'conwayPause')}
          </button>
          <button type="button" id="sp-reseed">{t(locale, 'conwayReseed')}</button>
        </div>
      </div>
    </details>

    <fieldset class="sp-search-shortcut">
      <legend>{t(locale, 'searchShortcutLabel')}</legend>
      {/* Every letter is offered; settings-panel.ts disables the seven the
         browser owns and puts this sentence on each as its title. Passed in
         because that file is a plain script with no access to t(). */}
      <select id="sp-search-key" data-reserved={t(locale, 'searchShortcutReserved')}>
        {Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i)).map((letter) => (
          <option value={letter}>{letter}</option>
        ))}
      </select>
    </fieldset>

    <hr class="sp-rule" />

    <CodeTheme locale={locale} />

    <label class="sp-row">
      <input type="checkbox" id="hp-persist" />
      {t(locale, 'keepPreviews')}
    </label>

    <hr class="sp-rule" />

    {/* Returns every preference above to its default. No confirmation step:
       nothing else on this site confirms before a destructive action, and
       none of what this clears is the reader's own content, only choices any
       of which is one click from being made again.

       The light/dark choice is out of scope by the same rule: it belongs to
       ThemeToggle, one button over, and stays there. */}
    <button type="button" class="sp-reset-all" id="sp-reset-all" title={t(locale, 'resetAllHint')}>
      {t(locale, 'resetAll')}
    </button>
  </div>
</div>

<script>
  import '../scripts/settings-panel'
</script>

<style>
  .settings-panel {
    position: relative;
  }

  /* The UA `[hidden] { display: none }` sheet is namespaced to XHTML and never
     matches an <svg>, so a hidden icon inside this button would still draw
     unless CSS says so. Nothing here hides an SVG conditionally today, but
     this row is the likeliest place for that trap to reappear. ThemeToggle
     carries the same guard. */
  .settings-panel:not([hidden]) {
    display: inline-flex;
  }

  /* Same reserved-while-hidden treatment as ThemeToggle, same reason: the
     late un-hide re-wrapped the phone header and shifted the page. */
  .settings-panel[hidden] {
    display: inline-flex;
    visibility: hidden;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
  }

  .sp-icon[hidden] {
    display: none;
  }

  /* Same reason as ThemeToggle's .tt-icon: the ::before chip is absolutely
     positioned and opaque, so it paints over an unpositioned glyph and leaves
     an empty outlined square. */
  .sp-icon {
    position: relative;
  }

  /*
   * Identical footprint to ThemeToggle's .tt-open: --icon-btn-hit is the real
   * hit target, the border and background move to ::before at --icon-btn-chip
   * so the visible square can be smaller than the box a pointer has to reach,
   * and --icon-btn-glyph sizes the icon.
   */
  .sp-open {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--icon-btn-hit);
    min-block-size: var(--icon-btn-hit);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: var(--icon-btn-glyph);
    padding: 0;
    cursor: pointer;
  }

  /*
   * Border reads --accent-day, not --rule: see ThemeToggle's .tt-open::before
   * for the measured contrast numbers behind that.
   */
  .sp-open::before {
    content: '';
    position: absolute;
    inline-size: var(--icon-btn-chip);
    block-size: var(--icon-btn-chip);
    border: var(--btn-border);
    border-radius: var(--radius);
    background: var(--bg);
    pointer-events: none;
  }

  .sp-open:hover,
  .sp-open:focus-visible,
  .sp-open[aria-expanded='true'] {
    color: var(--accent);
  }

  .sp-open:hover::before,
  .sp-open:focus-visible::before,
  .sp-open[aria-expanded='true']::before {
    border-color: var(--accent);
  }

  .sp-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* No `display` here: the browser already hides a closed popover and the
     no-popover `hidden` fallback, and an author `display` would beat both. */
  .sp-menu {
    position: fixed;
    z-index: 60;
    margin: 0;
    inline-size: 18rem;
    max-block-size: 80dvh;
    overflow-y: auto;
    border: 3px double var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  .sp-menu:popover-open,
  .sp-menu:not([popover]):not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sp-heading {
    margin: 0;
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sp-motion {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-motion legend {
    inline-size: 100%;
    margin-block-end: 0.3rem;
    padding: 0;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .sp-motion-option {
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
  }

  .sp-motion-option[aria-current='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sp-motion-option:hover,
  .sp-motion-option:focus-visible {
    border-color: var(--accent);
  }

  .sp-motion-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sp-font-size {
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-font-size legend {
    margin-block-end: 0.3rem;
    padding: 0;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .sp-font-size-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .sp-font-size-row > * + * {
    margin-inline-start: 0.3rem;
  }

  /* The panel's one button treatment, shared with .sp-motion-option and
     .sp-conway-actions button; only the padding is tighter, since two of the
     three carry a single glyph rather than a word. */
  .sp-step {
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.5rem;
    cursor: pointer;
  }

  .sp-step:hover:not(:disabled),
  .sp-step:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sp-step:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* At either end the matching button is disabled rather than left looking
     live and doing nothing. Dimmed *and* not-allowed, since colour alone is
     the signal a reader with low vision is least likely to catch; the
     `disabled` attribute is what tells a screen reader. */
  .sp-step:disabled {
    color: var(--muted);
    border-color: var(--rule);
    opacity: 0.5;
    cursor: not-allowed;
  }

  /*
   * Sized to three digits, so the row does not shift between 50 and 160.
   *
   * The native spinner is dropped: the minus and plus buttons already are
   * that control at a hit target a pointer can reach, and the browser's
   * arrows are two tiny halves stacked inside the field. Up/Down still steps
   * it, since that belongs to `type="number"` rather than to the spinner.
   */
  .sp-font-size-row input[type='number'] {
    inline-size: 4.5ch;
    flex: 0 0 auto;
    text-align: center;
    background: var(--bg);
    color: var(--fg);
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    padding: 0.3rem 0.2rem;
    appearance: textfield;
  }

  .sp-font-size-row input[type='number']:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sp-font-size-row input[type='number']::-webkit-outer-spin-button,
  .sp-font-size-row input[type='number']::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .sp-font-size-unit {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  /* Same shape as .sp-motion-option, its own classes because settings-panel.ts
     scopes its motion query to .sp-motion-option and these must not answer to
     it too. */
  .sp-font-family {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-font-family legend {
    inline-size: 100%;
    margin-block-end: 0.3rem;
    padding: 0;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .sp-font-family-option {
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.6rem;
    margin-inline-end: 0.4rem;
    margin-block-end: 0.4rem;
    cursor: pointer;
  }

  .sp-font-family-option[aria-current='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sp-font-family-option:hover,
  .sp-font-family-option:focus-visible {
    border-color: var(--accent);
  }

  .sp-font-family-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sp-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
  }

  /*
   * The field's properties only exist while the field does: with the
   * background off, every knob adjusts something that is not being drawn.
   *
   * Done off the checkbox's own state rather than from the script, so the
   * panel cannot get into a state where the box says one thing and the
   * disclosure shows another. `display: none` rather than the `hidden`
   * attribute, so nothing has to remember to remove it.
   */
  .sp-row:has(#sp-bg-life:not(:checked)) + .sp-conway-details {
    display: none;
  }

  .sp-conway-details summary {
    color: var(--fg);
    cursor: pointer;
  }

  .sp-conway-knobs {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block-start: 0.6rem;
  }

  .sp-knob {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--muted);
  }

  .sp-knob input[type='range'] {
    inline-size: 100%;
  }

  /*
   * Borderless and unpadded like every other group here. Without this it kept
   * the browser's default fieldset look, a notched box none of its
   * neighbours have, with the swatches pressed against it.
   */
  .sp-accent {
    margin: 0;
    border: 0;
    padding: 0;
  }

  .sp-accent legend {
    inline-size: 100%;
    margin-block-end: 0.3rem;
    padding: 0;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  /*
   * The first-visit nudge: a small label under the cog, pointing at it with a
   * caret. Absolutely positioned and `pointer-events: none`, so it cannot move
   * the header row or intercept a click meant for the button under it. It
   * disappears the first time the panel opens, so it never becomes something
   * a reader has to dismiss.
   */
  .sp-nudge {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    z-index: 4;
    inline-size: max-content;
    max-inline-size: 11rem;
    margin-block-start: 0.35rem;
    padding: 0.35rem 0.5rem;
    border: var(--border) solid var(--accent-day, var(--accent));
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--text-tiny);
    line-height: 1.3;
    pointer-events: none;
  }

  .sp-nudge::before {
    content: '';
    position: absolute;
    inset-block-end: 100%;
    inset-inline-end: 0.75rem;
    border: 0.35rem solid transparent;
    border-block-end-color: var(--accent-day, var(--accent));
  }

  @media (prefers-reduced-motion: no-preference) {
    .sp-nudge {
      animation: sp-nudge-in var(--duration) var(--ease) both;
    }
  }

  @keyframes sp-nudge-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  .sp-accent-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  /*
   * A square of the colour it sets, with the panel's border around it so it
   * reads as a control. No label on screen: six named colours would fill the
   * menu, and the name is in aria-label.
   *
   * The spacing has to clear the selected ring, an outline 2px outside the
   * border, or two swatches overlap the moment one is chosen. The block
   * margin is what keeps a wrapped second row clear of the one above.
   */
  .sp-accent-option {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin-inline-end: 0.5rem;
    margin-block-end: 0.5rem;
    padding: 0;
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: var(--swatch);
    cursor: pointer;
  }

  .sp-accent-auto {
    margin-inline-end: 0.5rem;
    margin-block-end: 0.5rem;
    padding: 0.15rem 0.5rem;
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: var(--text-tiny);
    text-transform: uppercase;
    cursor: pointer;
  }

  /*
   * A ring outside the swatch rather than a change to the swatch itself,
   * whose whole job is to show one exact colour. aria-current drives it, the
   * same as every other group in this panel.
   */
