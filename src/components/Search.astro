---
// Real <form> first: a plain GET to /search/?q=... works with JS off, with
// Pagefind not installed yet, and in dev where /pagefind/pagefind.js 404s.
// The script below only enhances that baseline in place, it never replaces it.
// The input starts empty; the client script below fills it from
// window.location.search on load, the only place a real query string exists
// on a static build.
import { t, type Locale } from '../i18n/ui'

interface Props {
  action?: string
  locale?: Locale
}

const { action = '/search/', locale = 'pt' } = Astro.props
---

<form action={action} method="get" role="search" aria-label={t(locale, 'searchLabel')} data-search-form>
  {/* The visible label is gone; the name moves to aria-label so the field is
      still announced. */}
  <div class="row">
    <input
      id="search-q"
      type="search"
      name="q"
      aria-label={t(locale, 'searchLabel')}
      placeholder={t(locale, 'searchPlaceholder')}
      autocomplete="off"
      data-no-index-message={t(locale, 'searchNoIndex')}
      data-searching={t(locale, 'searching')}
      data-no-results={t(locale, 'noResultsFor')}
      data-more-results={t(locale, 'moreResults')}
    />
    <button type="submit">{t(locale, 'search')}</button>
  </div>
</form>
<div id="search-results" class="search-results" aria-live="polite" aria-atomic="false"></div>
<noscript>
  <p class="search-noscript">{t(locale, 'searchNoJs')}</p>
</noscript>

<script>
  // Pagefind ships its own ranked index + snippet extraction; this only glues
  // its JS API to our own markup so results keep the site's styling instead
  // of Pagefind's default UI CSS.
  import { loadPagefind, searchLabel as label, type PagefindModule } from '../scripts/pagefind'
  // Capped because an unqualified term (e.g. "de") can match a large share of
  // the site, and Pagefind returns every match with no limit of its own.
  import { searchPageResultLimit as MAX_RESULTS } from '../lib/tweaks'

  // Bumped on every search; a stale async response checks it before writing
  // to the DOM so a slow earlier query can't overwrite a faster later one.
  let searchGeneration = 0

  function showMessage(target: HTMLElement, message: string): void {
    target.replaceChildren(document.createTextNode(message))
  }

  function updateUrl(query: string): void {
    const url = new URL(window.location.href)
    url.searchParams.delete('q')
    if (query) url.searchParams.set('q', query)
    window.history.replaceState({}, '', url)
  }

  async function renderResults(
    pagefind: PagefindModule,
    target: HTMLElement,
    input: HTMLInputElement,
    query: string,
  ): Promise<void> {
    const generation = ++searchGeneration

    if (!query) {
      target.replaceChildren()
      return
    }

    showMessage(target, label(input, 'searching'))
    const { results } = await pagefind.search(query)
    if (generation !== searchGeneration) return // a newer search has already started

    if (results.length === 0) {
      showMessage(target, label(input, 'noResults', query))
      return
    }

    const list = document.createElement('ul')
    list.className = 'search-results-list'
    for (const result of results.slice(0, MAX_RESULTS)) {
      const data = await result.data()
      if (generation !== searchGeneration) return
      // data.url only comes from this site's own Pagefind index today, but
      // guard against a future indexing misconfig emitting an external URL.
      if (!data.url.startsWith('/')) continue
      const item = document.createElement('li')
      const link = document.createElement('a')
      link.href = data.url
      link.textContent = data.meta.title ?? data.url
      const excerpt = document.createElement('p')
      // Pagefind's excerpt is its own generated HTML (wraps matches in <mark>),
      // not user input, so innerHTML here is the documented, intended usage.
      excerpt.innerHTML = data.excerpt
      item.append(link, excerpt)
      list.append(item)
    }

    if (generation !== searchGeneration) return
    target.replaceChildren(list)
    if (results.length > MAX_RESULTS) {
      const more = document.createElement('p')
      more.className = 'search-results-more'
      more.textContent = label(input, 'moreResults', String(results.length - MAX_RESULTS))
      target.append(more)
    }
  }

  async function main(): Promise<void> {
    const form = document.querySelector<HTMLFormElement>('[data-search-form]')
    if (!form) return

    const input = form.querySelector<HTMLInputElement>('input[name="q"]')
    const resultsEl = document.getElementById('search-results')
    if (!input || !resultsEl) return

    // Astro prerenders this page once at build time, so any `value` baked
    // into the input's HTML is stale for a static build. The live query
    // only exists in the browser's address bar, so that's the source of
    // truth for "read the initial query on load".
    const queryFromUrl = new URLSearchParams(window.location.search).get('q')
    if (queryFromUrl !== null) input.value = queryFromUrl
    if (input.value.trim()) showMessage(resultsEl, label(input, 'searching'))

    const pagefind = await loadPagefind()
    if (!pagefind) {
      // Localised server-side and read back here, so this script stays free of
      // translation strings.
      if (input.value.trim()) showMessage(resultsEl, input.dataset.noIndexMessage ?? '')
      return
    }

    // Called bare, init() picks between the per-language indexes from the
    // page's own lang, which is right on the happy path. Its miss path is
    // `findIndex`, so an unknown or variant tag falls back to whichever index
    // has the most pages (pt): a reader on an English page would silently get
    // Portuguese results and nothing would report it. Passing the tag turns
    // that quiet fallback into a thrown error, handled below.
    if (pagefind.init) {
      try {
        await pagefind.init(document.documentElement.lang)
      } catch {
        if (input.value.trim()) showMessage(resultsEl, input.dataset.noIndexMessage ?? '')
        return
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault()
      const query = input.value.trim()
      updateUrl(query)
      void renderResults(pagefind, resultsEl, input, query)
    })

    const initial = input.value.trim()
    if (initial) void renderResults(pagefind, resultsEl, input, initial)
  }

  void main()
</script>

<style>
  form {
    margin-block-end: 1.5rem;
  }

  .row {
    display: flex;
    gap: 0.6rem;
  }

  input[type='search'] {
    flex: 1;
    min-inline-size: 0;
    padding: 0.5rem 0.7rem;
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
  }

  input[type='search']:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /*
   * The site's chosen button treatment (ChromeButton.vue, decided): brackets
   * as pseudo-elements, never text, so the label stays the only thing a
   * screen reader announces. Outline variant, the one the search form's
   * single action calls for; see theme.css for the touch-target and contrast
   * numbers behind these tokens.
   */
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--btn-touch-min);
    padding: var(--btn-pad-block) var(--btn-pad-inline);
    border: var(--border) solid var(--btn-fg);
    border-radius: var(--radius);
    background: transparent;
    color: var(--btn-fg);
    font-family: var(--btn-face);
    font-size: 1rem;
    letter-spacing: var(--btn-tracking);
    cursor: pointer;
  }

  button::before {
    content: '[';
    margin-inline-end: 0.4em;
  }

  button::after {
    content: ']';
    margin-inline-start: 0.4em;
  }

  button:hover {
    background: color-mix(in oklab, var(--btn-fg) 12%, transparent);
  }

  button:focus-visible {
    outline: 2px solid var(--btn-fg);
    outline-offset: 1px;
  }

  .search-results :global(.search-results-list) {
    padding: 0;
    list-style: none;
  }

  .search-results :global(.search-results-list li + li) {
    margin-block-start: 2rem;
  }

  .search-results :global(a) {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .search-results :global(p) {
    margin-block: 0.3rem 0;
    color: var(--muted);
  }

  .search-results :global(.search-results-more) {
    font-size: 0.9rem;
  }

  .search-noscript {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
