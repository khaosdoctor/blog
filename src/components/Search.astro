---
import { type Locale, localePath, t } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const action = localePath(locale, '/search/')
---

<form action={action} method="get" role="search" aria-label={t(locale, 'searchLabel')} data-search-form>
  <div class="row">
    <input
      id="search-q"
      type="search"
      name="q"
      aria-label={t(locale, 'searchLabel')}
      placeholder={t(locale, 'searchPlaceholder')}
      autocomplete="off"
      data-no-index-message={t(locale, 'searchNoIndex')}
      data-searching={t(locale, 'searching')}
      data-no-results={t(locale, 'noResultsFor')}
      data-more-results={t(locale, 'moreResults')}
    />
    <button type="submit">{t(locale, 'search')}</button>
  </div>
</form>
<div id="search-results" class="search-results" aria-live="polite" aria-atomic="false"></div>
<noscript>
  <p class="search-noscript">{t(locale, 'searchNoJs')}</p>
</noscript>

<script>
  import { loadPagefind, searchLabel as label, type PagefindModule } from '../scripts/pagefind'
  // Pagefind itself returns every match, however many that is.
  import { searchPageResultLimit as MAX_RESULTS } from '../lib/tweaks'

  // Every await below has to re-check this before touching the DOM, or a slow
  // earlier query overwrites the results of a faster later one.
  let searchGeneration = 0

  function showMessage(target: HTMLElement, message: string): void {
    target.replaceChildren(document.createTextNode(message))
  }

  function updateUrl(query: string): void {
    const url = new URL(window.location.href)
    url.searchParams.delete('q')
    if (query) url.searchParams.set('q', query)
    window.history.replaceState({}, '', url)
  }

  async function renderResults(
    pagefind: PagefindModule,
    target: HTMLElement,
    input: HTMLInputElement,
    query: string,
  ): Promise<void> {
    const generation = ++searchGeneration

    if (!query) {
      target.replaceChildren()
      return
    }

    showMessage(target, label(input, 'searching'))
    const { results } = await pagefind.search(query)
    if (generation !== searchGeneration) return

    if (results.length === 0) {
      showMessage(target, label(input, 'noResults', query))
      return
    }

    const list = document.createElement('ul')
    list.className = 'search-results-list'
    for (const result of results.slice(0, MAX_RESULTS)) {
      const data = await result.data()
      if (generation !== searchGeneration) return
      // Refuse anything that is not a same-site path, so a misconfigured index
      // cannot put a foreign URL behind a result link.
      if (!data.url.startsWith('/')) continue
      const item = document.createElement('li')
      const link = document.createElement('a')
      link.href = data.url
      link.textContent = data.meta.title ?? data.url
      const excerpt = document.createElement('p')
      // innerHTML is safe only because the excerpt is Pagefind's own generated
      // markup (<mark> around matches) from build-time content, never input.
      excerpt.innerHTML = data.excerpt
      item.append(link, excerpt)
      list.append(item)
    }

    if (generation !== searchGeneration) return
    target.replaceChildren(list)
    if (results.length > MAX_RESULTS) {
      const more = document.createElement('p')
      more.className = 'search-results-more'
      more.textContent = label(input, 'moreResults', String(results.length - MAX_RESULTS))
      target.append(more)
    }
  }

  async function main(): Promise<void> {
    const form = document.querySelector<HTMLFormElement>('[data-search-form]')
    if (!form) return

    const input = form.querySelector<HTMLInputElement>('input[name="q"]')
    const resultsEl = document.getElementById('search-results')
    if (!input || !resultsEl) return

    // Prerendered page: the address bar is the only live source of the query.
    const queryFromUrl = new URLSearchParams(window.location.search).get('q')
    if (queryFromUrl !== null) input.value = queryFromUrl
    if (input.value.trim()) showMessage(resultsEl, label(input, 'searching'))

    const pagefind = await loadPagefind()
    if (!pagefind) {
      if (input.value.trim()) showMessage(resultsEl, input.dataset.noIndexMessage ?? '')
      return
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault()
      const query = input.value.trim()
      updateUrl(query)
      void renderResults(pagefind, resultsEl, input, query)
    })

    const initial = input.value.trim()
    if (initial) void renderResults(pagefind, resultsEl, input, initial)
  }

  void main()
</script>

<style>
  form {
    margin-block-end: 1.5rem;
  }

  .row {
    display: flex;
    gap: 0.6rem;
  }

  input[type='search'] {
    flex: 1;
    min-inline-size: 0;
    padding: 0.5rem 0.7rem;
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
  }

  input[type='search']:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--btn-touch-min);
    padding: var(--btn-pad-block) var(--btn-pad-inline);
    border: var(--border) solid var(--btn-fg);
    border-radius: var(--radius);
    background: transparent;
    color: var(--btn-fg);
    font-family: var(--btn-face);
    font-size: 1rem;
    letter-spacing: var(--btn-tracking);
    cursor: pointer;
  }

  button::before {
    content: '[';
    margin-inline-end: 0.4em;
  }

  button::after {
    content: ']';
    margin-inline-start: 0.4em;
  }

  button:hover {
    background: color-mix(in oklab, var(--btn-fg) 12%, transparent);
  }

  button:focus-visible {
    outline: 2px solid var(--btn-fg);
    outline-offset: 1px;
  }

  .search-results :global(.search-results-list) {
    padding: 0;
    list-style: none;
  }

  .search-results :global(.search-results-list li + li) {
    margin-block-start: 2rem;
  }

  .search-results :global(a) {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .search-results :global(p) {
    margin-block: 0.3rem 0;
    color: var(--muted);
  }

  .search-results :global(.search-results-more) {
    font-size: var(--text-small);
  }

  .search-noscript {
    color: var(--muted);
    font-size: var(--text-small);
  }
</style>
