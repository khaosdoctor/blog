---
// Shared by /oss/ and /en/oss/, the same way Search.astro is shared by the two
// search pages: one render, driven by a locale prop, reading the one credit
// list in src/lib/credits.ts.
import { credits, type CreditKind } from '../lib/credits'
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

// Fixed order, not the array's own order: fonts first since one of them is
// the reason this page exists.
const KIND_ORDER: CreditKind[] = ['font', 'icon', 'dependency', 'markdown', 'search']
const KIND_HEADING: Record<CreditKind, Parameters<typeof t>[1]> = {
  font: 'ossFontsHeading',
  icon: 'ossIconsHeading',
  dependency: 'ossDependenciesHeading',
  markdown: 'ossMarkdownHeading',
  search: 'ossSearchHeading',
}
const groups = KIND_ORDER.map((kind) => ({
  kind,
  heading: t(locale, KIND_HEADING[kind]),
  entries: credits.filter((credit) => credit.kind === kind),
})).filter((group) => group.entries.length > 0)
---

{
  groups.map((group) => (
    <section class="credit-group">
      <h2>{group.heading}</h2>
      <ul>
        {group.entries.map((credit) => (
          <li>
            <a href={credit.url} rel="noopener">
              {credit.name}
            </a>
            <span class="meta">
              {credit.licenseUrl ? (
                <a href={credit.licenseUrl} rel="noopener license">
                  {credit.license}
                </a>
              ) : (
                credit.license
              )}
              {credit.author && (
                <>
                  {' · '}
                  {t(locale, 'writtenBy')} {credit.author}
                </>
              )}
            </span>
            <p>{credit.note}</p>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .credit-group + .credit-group {
    margin-block-start: 3rem;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  li {
    padding-block: 0.9rem;
    border-block-end: var(--border) solid var(--rule);
  }

  li:first-child {
    padding-block-start: 0;
  }

  li:last-child {
    border-block-end: none;
  }

  li > a {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
  }

  .meta {
    display: block;
    margin-block-start: 0.2rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  li > p {
    margin-block: 0.4rem 0;
    color: var(--muted);
    font-size: var(--text-small);
  }
</style>
