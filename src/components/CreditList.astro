---
// Shared by /oss/ and /en/oss/, the same way Search.astro is shared by the two
// search pages: one render, driven by a locale prop, reading the one credit
// data in src/lib/credits.ts.
import { dependencies, fonts, icons, type AttributedCredit, type Credit } from '../lib/credits'
import { t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section class="credit-group">
  <h2>{t(locale, 'ossFontsHeading')}</h2>
  <ul>
    {fonts.map((credit: AttributedCredit) => (
      <li>
        <a href={credit.url} rel="noopener">
          {credit.name}
        </a>
        <span class="meta">
          {credit.licenseUrl ? (
            <a href={credit.licenseUrl} rel="noopener license">
              {credit.license}
            </a>
          ) : (
            credit.license
          )}
          {credit.author && (
            <>
              {' · '}
              {t(locale, 'writtenBy')} {credit.author}
            </>
          )}
        </span>
      </li>
    ))}
  </ul>
</section>

<section class="credit-group">
  <h2>{t(locale, 'ossIconsHeading')}</h2>
  <ul>
    {icons.map((credit: AttributedCredit) => (
      <li>
        <a href={credit.url} rel="noopener">
          {credit.name}
        </a>
        <span class="meta">
          {credit.licenseUrl ? (
            <a href={credit.licenseUrl} rel="noopener license">
              {credit.license}
            </a>
          ) : (
            credit.license
          )}
          {credit.author && (
            <>
              {' · '}
              {t(locale, 'writtenBy')} {credit.author}
            </>
          )}
        </span>
      </li>
    ))}
  </ul>
</section>

<section class="credit-group">
  <h2>{t(locale, 'ossDependenciesHeading')}</h2>
  <ul>
    {dependencies.map((credit: Credit) => (
      <li>
        {credit.url ? (
          <a href={credit.url} rel="noopener">
            {credit.name}
          </a>
        ) : (
          credit.name
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .credit-group + .credit-group {
    margin-block-start: 3rem;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  li {
    padding-block: 0.9rem;
    border-block-end: var(--border) solid var(--rule);
  }

  li:first-child {
    padding-block-start: 0;
  }

  li:last-child {
    border-block-end: none;
  }

  li > a {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
  }

  .meta {
    display: block;
    margin-block-start: 0.2rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }
</style>
