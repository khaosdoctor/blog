---
import { type Locale, t } from '../i18n/ui'

export interface TocItem {
  slug: string
  text: string
  children: TocItem[]
}

interface Props {
  items: TocItem[]
  locale: Locale
}

const { items, locale } = Astro.props
---

<ul>
  {
    items.map((item) => (
      <li data-slug={item.slug}>
        <div class="row">
          {item.children.length > 0 && (
            <button
              class="fold"
              type="button"
              aria-expanded="true"
              aria-label={t(locale, 'foldSection')}
            >
              <span aria-hidden="true">▾</span>
            </button>
          )}
          <a href={`#${item.slug}`}>{item.text}</a>
        </div>
        {item.children.length > 0 && (
          <div class="sub">
            <div>
              <Astro.self items={item.children} locale={locale} />
            </div>
          </div>
        )}
      </li>
    ))
  }
</ul>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sub > div > ul {
    padding-inline-start: 1.1ch;
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
  }

  a {
    display: block;
    flex: 1;
    padding: 0.1rem 0.3rem;
    color: inherit;
    font-size: 0.72rem;
    line-height: 1.5;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  a:hover,
  a:focus-visible,
  a[aria-current='location'] {
    background: var(--toc-ink);
    color: var(--toc-paper);
  }

  /* Literal colours: `--toc-ink`/`--toc-paper` cannot reach outside `.toc`.
     `anywhere`, not `break-word`, caps one long word to the script's `max-inline-size`. */
  :global(.toc-full) {
    position: fixed;
    z-index: 30;
    display: none;
    margin: 0;
    padding: 0.1rem 0.3rem;
    background: light-dark(#000000, #ffffff);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    pointer-events: none;
  }

  :global(.toc-full[data-open='true']) {
    display: block;
  }

  .fold {
    /* Cancelled by the margin below: a bigger target, same row metrics. */
    padding: 1.1rem;
    margin: -1.1rem;
    border: 0;
    background: none;
    color: var(--toc-ink);
    font: inherit;
    font-size: 0.6rem;
    line-height: 1.5;
    cursor: pointer;
    transition: transform var(--duration) var(--ease);
  }

  [data-folded] > .row > .fold {
    transform: rotate(-90deg);
  }

  .sub {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--duration) var(--ease);
  }

  .sub > div {
    min-height: 0;
    overflow: hidden;
  }

  [data-folded] > .sub {
    grid-template-rows: 0fr;
  }
</style>
