---
import type { Post } from '../lib/posts'
import { estimateReadingTime, formatDate } from '../lib/posts'
import { t, type Locale } from '../i18n/ui'
import PostList from './PostList.astro'
import ReadingTime from './ReadingTime.astro'
import { LISTING_LEADER } from '../lib/listing'

interface Props {
  entries: { slug: string; title: string; posts: Post[] }[]
  locale: Locale
}

const { entries, locale } = Astro.props


const rows = entries
  .map((entry) => ({
    ...entry,
    updated: entry.posts.reduce(
      (latest, post) => (post.data.pubDate > latest ? post.data.pubDate : latest),
      entry.posts[0].data.pubDate,
    ),
    minutes: entry.posts.reduce((total, post) => total + estimateReadingTime(post.body ?? ''), 0),
    parts: [...entry.posts].sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0)),
  }))
  .sort((a, b) => b.updated.getTime() - a.updated.getTime())
---

<ol class="listing listing-accordion">
  {
    rows.map((row) => (
      <li>
        <details>
          <summary class="listing-row">
            <span class="listing-marker" aria-hidden="true" />
            <span class="listing-date">
              <time datetime={row.updated.toISOString()}>{formatDate(row.updated, locale)}</time>
            </span>
            <span class="listing-title">{row.title}</span>
            <span class="listing-leader" aria-hidden="true">
              {LISTING_LEADER}
            </span>
            <span class="listing-label-plain">
              {row.posts.length} {t(locale, 'articles')}
            </span>
            <span class="listing-figure">
              <ReadingTime minutes={row.minutes} locale={locale} />
            </span>
          </summary>
          <div class="listing-panel">
            {/* seriesOrder, not date: parts are listed in reading order. */}
            <PostList posts={row.parts} showCategory={false} />
          </div>
        </details>
      </li>
    ))
  }
</ol>

