---
interface Props {
  title?: string
  text?: string
  cta?: string
}

const {
  title = 'Aprenda TypeScript de verdade',
  text = 'Curso completo de TypeScript para quem já programa e quer parar de adivinhar os tipos: teoria, prática e projetos reais.',
  cta = 'Conhecer a Formação TS',
} = Astro.props
---

<aside class="course-cta">
  <p class="eyebrow">Formação TS</p>
  <p class="title">{title}</p>
  <p class="body">{text}</p>
  <a class="button" href="https://formacaots.com.br" target="_blank" rel="noopener noreferrer">
    {cta}
  </a>
</aside>

<style>
  /* ponytail: plain placeholder card, deliberately undecorated — the owner
     restyles this once the real theme lands. */
  .course-cta {
    margin-block: 2.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
  }

  .eyebrow {
    margin: 0 0 0.3rem;
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .course-cta .title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .course-cta .body {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .button {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .button:hover {
    background: var(--accent);
    color: var(--bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .button {
      transition:
        background-color 0.15s ease,
        color 0.15s ease;
    }
  }
</style>
