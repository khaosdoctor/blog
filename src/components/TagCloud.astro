---
// The tag cloud both tag indexes render (src/pages/tags/index.astro and its
// /en/ twin). One component so the sizing and scatter rules exist once; each
// page still builds its own tag list from its own language's posts.
import { chipColor, slugify, tagCloudLift, tagCloudScale } from '../lib/taxonomy'
import { localePath, t, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  tags: { name: string; count: number }[]
}

const { locale, tags } = Astro.props

// The range the cloud is scaled across, from the counts actually present.
const counts = tags.map(({ count }) => count)
const fewest = Math.min(...counts)
const most = Math.max(...counts)
---

<h1 class="cloud-heading">
  {t(locale, 'tags')} <span class="page-count">[{tags.length}]</span>
</h1>
<ul class="chips">
  {
    tags.map(({ name, count }) => (
      <li>
        <a
          href={localePath(locale, `/tags/${slugify(name)}/`)}
          class="chip"
          style={`--chip-color: ${chipColor(name)}; --chip-scale: ${tagCloudScale(count, fewest, most)}; --chip-lift: ${tagCloudLift(name)}em`}
        >
          {name} ({count})
        </a>
      </li>
    ))
  }
</ul>

<style>
  .chips {
    margin-block-start: 1.5rem;
    /* Pulls the run in from both edges so the cloud reads a little more
       centred without any chip changing shape. */
    padding-inline: 5px;
    /* Centred rows read as a band of mixed sizes; on a baseline the cloud read
       as ruled text, and a left-aligned short last row looked unfinished. */
    align-items: center;
    justify-content: center;
  }

  /* The cloud and its title break out of the reading column: 85 chips at up
     to three times the base size need the room. Same arithmetic as .listing
     (listing.css): 50% puts the start edge at main's centre, the translate
     pulls back by half this box's own width. */
  @media (min-width: 70rem) {
    .cloud-heading,
    .chips {
      inline-size: var(--content-width);
      margin-inline-start: 50%;
      transform: translateX(calc(var(--content-width) / -2));
    }
  }

  /* Size carries the count. Padding and rule in `em` so a big chip keeps a
     chip's proportions; the number stays in the label because size alone is a
     visual-only signal and this page is where tags get compared exactly. */
  .chips .chip {
    font-size: calc(var(--text-tiny) * var(--chip-scale, 1));
    padding: 0.15em 0.55em;
    border-width: 0.2em;
    /* tagCloudLift scatters chips off the row's centre; in `em` so a large
       chip drifts further and the offsets stay in proportion. */
    transform: translateY(var(--chip-lift, 0em));
  }
</style>
