---
import type { MarkdownHeading } from 'astro'
import TocBranch, { type TocItem } from './TocBranch.astro'
import { t, type Locale } from '../i18n/ui'

/**
 * The outline of the post, pinned to the left margin at the height of the
 * reader's eye, tracking where they are as they scroll.
 *
 * Built from the headings Astro already collected while rendering the post, so
 * it costs no second parse and can never disagree with the ids the anchors use.
 * h1 is excluded on purpose: it is the post title, which is the page, not a
 * section of it. Below h4 nothing goes in, since an outline that lists every
 * sub-sub-point is a second copy of the article.
 *
 * A post with fewer than two headings renders nothing at all. One entry is not
 * an outline, and an empty frame in the margin is worse than no frame.
 */
interface Props {
  headings: MarkdownHeading[]
  locale: Locale
}

const { headings, locale } = Astro.props

// The footnotes heading is generated by the markdown pipeline at the end of
// every post that has one, and it is not a section the author wrote: listing it
// puts "Footnotes" in the outline of half the archive.
const flat = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 4 && heading.slug !== 'footnote-label',
)

/**
 * Headings are a flat list with a depth number; the outline is a tree. The stack
 * holds the open ancestors, so a heading attaches to the last one shallower than
 * itself and a jump from h2 straight to h4 nests rather than throwing.
 */
function treeOf(items: MarkdownHeading[]): TocItem[] {
  const root: TocItem[] = []
  const open: Array<{ depth: number; node: TocItem }> = []

  for (const heading of items) {
    const node: TocItem = { slug: heading.slug, text: heading.text, children: [] }
    while (open.length > 0 && open[open.length - 1].depth >= heading.depth) open.pop()
    const parent = open[open.length - 1]
    const siblings = parent === undefined ? root : parent.node.children
    siblings.push(node)
    open.push({ depth: heading.depth, node })
  }

  return root
}

const tree = treeOf(flat)
---

{
  flat.length > 1 && (
    <>
      {/* Small screens have no margin to pin anything to, so the outline
          collapses into this control and opens as a panel over the corner. */}
      <button
        class="handle"
        type="button"
        aria-expanded="false"
        aria-controls="post-toc"
        aria-label={t(locale, 'openContents')}
      >
        <span aria-hidden="true">≡</span>
      </button>
      <nav id="post-toc" class="toc" aria-labelledby="toc-title" data-open="false">
        <p class="title" id="toc-title">{t(locale, 'contents')}</p>
        <div class="list">
          <TocBranch items={tree} locale={locale} />
        </div>
      </nav>
    </>
  )
}

<style>
  /*
   * Full white on the dark page and full black on the sepia one, which is the
   * one place on this site that ignores the muted greys: the outline is chrome
   * beside the text, and chrome that fades into the background is a frame the
   * reader has to hunt for. `--toc-paper` is what the inverted line paints its
   * type in, so it has to be the page ground rather than a fixed white.
   */
  .toc,
  .handle {
    --toc-ink: light-dark(#000000, #ffffff);
    --toc-paper: var(--bg);
  }

  .toc {
    position: fixed;
    /* Vertically centred on the window, which is roughly where the eye already
       is when reading, and the one position that needs no scroll maths. */
    /* Held in the upper third rather than centred: centred, it drifts below the
       line the eye actually reads from, and on a short window it collided with
       the bottom of the screen before the top. */
    /*
     * 38%, not 33%: this is `translateY(-50%)`'d, so the box's own top edge is
     * this anchor minus half its rendered height, and a long outline can reach
     * the `max-block-size` cap below. At the old 33% anchor and the old 70vh
     * cap, the worst case (a post with enough headings to reach the cap) put
     * the top edge at 33vh - 35vh = -2vh: two viewport-height percent above the
     * top of the window, under the header. Lucas's own report ("too close to
     * the header") is that case on a real post. 38% anchor plus the 64vh cap
     * below moves the same worst-case arithmetic to 38vh - 32vh = +6vh: a real,
     * positive clearance instead of a negative one, verified by the arithmetic
     * rather than by eye since there is no browser to check it in. Short
     * outlines, the common case, only move a few percent lower than before,
     * still reading as "upper third" rather than centred.
     */
    inset-block-start: 38%;
    transform: translateY(-50%);
    /*
     * `--toc-left` is written by the script from the article's real left edge.
     * This must never be computed from `--measure`: that token is in `ch`, and
     * `ch` resolves against the font of the element reading it, so `78ch` here is
     * 936px in this panel's monospace and 1014px on the article in the sans body
     * face. Placing the panel with the wrong one of those two numbers put it 39px
     * too far right and printed the frame over the first characters of the text.
     */
    inset-inline-start: var(--toc-left, var(--gutter));
    z-index: 2;
    inline-size: 15rem;
    /* 64vh, down from 70vh: see the anchor comment above for the worst-case
       maths this pairs with. */
    max-block-size: 64vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem 0.7rem;
    /* ANSI double frame: the box-drawing look without box-drawing characters,
       which would need a monospace grid and would not survive a font change. */
    border: 3px double var(--toc-ink);
    background: transparent;
    color: var(--toc-ink);
    font-family: var(--font-mono);
    scrollbar-width: thin;
  }

  /*
   * Full ink at 0.75rem. It was 0.66rem at 75% opacity, which on a single-weight
   * display face is the only way a label can go thin: there is no lighter weight
   * to fall back to, so the alpha was doing all of it and the words read as a
   * ghost of the frame around them.
   */
  .title {
    margin: 0 0 0.35rem;
    padding-inline-start: 0.3rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .handle {
    position: fixed;
    inset-block-end: var(--gutter);
    inset-inline-start: var(--gutter);
    z-index: 2;
    padding: 0.35rem 0.6rem;
    border: 3px double var(--toc-ink);
    background: var(--bg);
    color: var(--toc-ink);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  /*
   * Panel or handle is decided by measurement, not by a width guess, and the
   * script writes the answer to `data-toc-mode` on <html>. It has to be measured:
   * the reading column is `--measure` in `ch`, and `ch` is the width of the body
   * font's zero, so the same 68ch is 708px in Literata at 18px and 881px in
   * Atkinson at 20px. Any breakpoint hard-coded here would be correct for one
   * face and would let the panel sit on top of the text in the other.
   *
   * These two queries are the starting guess, for the moment before the script
   * runs and for a reader with no JavaScript at all. 78rem is the narrowest
   * window that fits the panel beside the widest sensible column.
   */
  @media (min-width: 78rem) {
    .handle {
      display: none;
    }
  }

  :root[data-toc-mode='handle'] .handle {
    display: block;
  }

  /*
   * Handle mode, written twice on purpose: once for the width guess above and
   * once for the measured answer. A media query cannot be combined with an
   * attribute selector into one rule, and the alternative was a layer of custom
   * properties standing in for two states, which is harder to read at 3am than
   * the same six declarations appearing twice.
   */
  @media (max-width: 77.99rem) {
    .toc {
      inset-block: auto calc(var(--gutter) + 3rem);
      inset-inline-start: var(--gutter);
      transform: none;
      max-block-size: 60vh;
      background: var(--bg);
      /* Opening eases in rather than appearing: `display` is animatable in
         browsers that support `allow-discrete`, and in the rest the panel just
         shows up, which is the pre-animation behaviour. */
      display: none;
      opacity: 0;
      transition:
        opacity var(--duration) var(--ease),
        display var(--duration) var(--ease) allow-discrete;
    }

    .toc[data-open='true'] {
      display: block;
      opacity: 1;
      @starting-style {
        opacity: 0;
      }
    }
  }

  :root[data-toc-mode='handle'] .toc {
    inset-block: auto calc(var(--gutter) + 3rem);
    inset-inline-start: var(--gutter);
    transform: none;
    max-block-size: 60vh;
    background: var(--bg);
    display: none;
    opacity: 0;
    transition:
      opacity var(--duration) var(--ease),
      display var(--duration) var(--ease) allow-discrete;
  }

  :root[data-toc-mode='handle'] .toc[data-open='true'] {
    display: block;
    opacity: 1;
    @starting-style {
      opacity: 0;
    }
  }

  /* Measured room for the panel, whatever the media query guessed. Written
     twice on purpose, same as the rest of this mode split (see the comment
     further down): 38%/64vh here has to match the base `.toc` rule above or
     the measured answer would undo the header-clearance fix the instant the
     script runs. */
  :root[data-toc-mode='panel'] .toc {
    inset-block-start: 38%;
    inset-block-end: auto;
    inset-inline-start: var(--toc-left, var(--gutter));
    transform: translateY(-50%);
    max-block-size: 64vh;
    display: block;
    opacity: 1;
    background: transparent;
  }

  :root[data-toc-mode='panel'] .handle {
    display: none;
  }
</style>

<script>
  // Which section the reader is in, as a highlighted line in the outline.
  //
  // Deliberately not an IntersectionObserver: the question is not "is this
  // heading visible" but "which heading did I most recently pass", and a long
  // section with its heading scrolled far off the top intersects nothing while
  // still being where the reader is. The last heading above the fold answers it
  // directly, and rAF-throttling a scroll read costs the same as the observer.
  const toc = document.querySelector<HTMLElement>('.toc')
  const handle = document.querySelector<HTMLButtonElement>('.handle')

  if (toc !== null) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
    const sections = links
      .map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry.heading !== null)

    const eased = matchMedia('(prefers-reduced-motion: no-preference)').matches

    /*
     * Panel beside the text, or handle in the corner: decided by measuring the
     * strip to the left of the article, never by a width breakpoint. The reading
     * column is sized in `ch`, which is the width of the body font's zero, so the
     * same `--measure` is a different number of pixels in each of the two body
     * faces the reader can choose. A hard-coded breakpoint is correct for one of
     * them and lets the panel cover the text in the other.
     *
     * 15rem is the panel, plus a gutter on the outside and a gap before the text.
     */
    const article = document.querySelector('article')
    const PANEL_REM = 15
    // The gap between the panel and the first character of the text. Wide enough
    // that the frame reads as a separate object in the margin rather than as
    // something attached to the paragraph beside it.
    const GAP_REM = 2.5

    const fitMode = (): void => {
      if (article === null) return
      const room = article.getBoundingClientRect().left
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16
      const panel = PANEL_REM * rem
      const gutter = 1.5 * rem
      const fits = room >= panel + gutter + GAP_REM * rem
      document.documentElement.dataset.tocMode = fits ? 'panel' : 'handle'
      if (!fits) return
      // Snug against the text rather than against the window edge, measured from
      // the article itself, which is the only number that is right in both faces.
      toc.style.setProperty('--toc-left', `${Math.max(gutter, room - panel - GAP_REM * rem)}px`)
    }

    fitMode()

    /*
     * The column is watched, not the clock. Switching the body face reflows the
     * article in two passes about 100ms apart, the new size first and the new
     * font's metrics second, so anything that counts frames can read the
     * intermediate width: two frames after the switch the column measured 858px
     * on its way from 780px to 1014px, and the panel was placed from that middle
     * number and stayed there. A ResizeObserver fires on each settled pass
     * instead, so the last thing it sees is the final layout.
     */
    if (article !== null) new ResizeObserver(fitMode).observe(article)

    // The window can change without the column changing: past the measure the
    // article stops growing while the room beside it keeps shrinking.
    addEventListener('resize', fitMode, { passive: true })
    // A heading level with the window top is already behind the reader, so the
    // line reads a little below it. Same figure as the heading scroll margin.
    const LOOKAHEAD = 120

    let current: HTMLAnchorElement | null = null
    let queued = false

    /** Keeps the highlighted line inside the box without scrolling the page. */
    const reveal = (link: HTMLAnchorElement): void => {
      const box = toc.getBoundingClientRect()
      const row = link.getBoundingClientRect()
      const above = box.top + 8 - row.top
      const below = row.bottom - (box.bottom - 8)
      if (above <= 0 && below <= 0) return
      const delta = above > 0 ? -above : below
      toc.scrollTo({ top: toc.scrollTop + delta, behavior: eased ? 'smooth' : 'auto' })
    }

    /** Opens every branch above a line, so the reader is never highlighted
     * inside a folded section they cannot see. */
    const unfoldTo = (link: HTMLAnchorElement): void => {
      let item = link.closest('li')
      while (item !== null) {
        item.removeAttribute('data-folded')
        item.querySelector('.row > .fold')?.setAttribute('aria-expanded', 'true')
        item = item.parentElement?.closest('li') ?? null
      }
    }

    const update = (): void => {
      queued = false
      let found = sections[0]?.link ?? null
      for (const { link, heading } of sections) {
        if (heading.getBoundingClientRect().top > LOOKAHEAD) break
        found = link
      }

      /*
       * The last sections of a post are shorter than the window, so the scroll
       * runs out before their headings ever reach the reading line and the
       * outline stays stuck on whichever one did. At the end of the page the
       * reader is in the last section by definition, whatever the geometry says.
       * This only applies when the document is actually taller than the window;
       * on a page shorter than the viewport the bottom is always near from the start.
       */
      const bottom = document.documentElement.scrollHeight - innerHeight - scrollY
      if (bottom <= 2 && document.documentElement.scrollHeight > innerHeight) found = sections.at(-1)?.link ?? found

      if (found === current) return
      current?.removeAttribute('aria-current')
      current = found
      if (current === null) return
      current.setAttribute('aria-current', 'location')
      unfoldTo(current)
      reveal(current)
    }

    const schedule = (): void => {
      if (queued) return
      queued = true
      requestAnimationFrame(update)
    }

    addEventListener('scroll', schedule, { passive: true })
    addEventListener('resize', schedule, { passive: true })
    update()

    // Folding is the reader's, so it is a real button and a real click, never a
    // hover: a branch that collapses when the pointer leaves is unusable.
    toc.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      const fold = target.closest<HTMLButtonElement>('.fold')
      if (fold === null) return
      const item = fold.closest('li')
      if (item === null) return
      const folded = item.toggleAttribute('data-folded')
      fold.setAttribute('aria-expanded', folded ? 'false' : 'true')
    })

    /*
     * The whole heading, for the rows the ellipsis cut short.
     *
     * A row is 15rem wide and a heading is not, so TocBranch truncates, and two
     * sections that both start "O que aconteceu com a" become the same line to
     * anyone reading with their eyes: the full text is still in the accessible
     * name, so a screen reader was never affected. Hovering or focusing a cut
     * row prints the whole thing, over the article if it has to.
     *
     * On <body>, placed from the row's own getBoundingClientRect(), which is the
     * same shape hover-previews.ts uses for its cards. Nothing inside the panel
     * can do this: `.toc` is a scroll container and clips its children on both
     * axes, and `position: fixed` does not escape from in there either while the
     * panel carries `transform: translateY(-50%)`, since a transform makes its
     * element the containing block for fixed descendants. CSS anchor positioning
     * would have placed it without any of this measuring, but it is still
     * "limited availability" on MDN (not Baseline: Firefox has not shipped it),
     * it would need a measured fallback anyway for the browsers without it, and
     * it would still not escape the clip on its own without the top layer. The
     * top layer via `popover` would escape it, but this element takes no
     * pointer, no focus and no light dismiss, so the only thing it would buy
     * over one z-index is a support question.
     *
     * One element for the whole outline: only one row is ever revealed.
     */
    const full = document.createElement('div')
    full.className = 'toc-full'
    /*
     * The heading is already the link's accessible name, which a screen reader
     * has just read, so this copy is hidden from the accessibility tree or it
     * gets read twice. `display: none` between reveals (TocBranch's own
     * `.toc-full` rule) is safe here in a way it is not in reading-time-hover.ts:
     * that popup is the target of an `aria-describedby`, so its text has to stay
     * reachable while it is invisible, and nothing points at this one.
     */
    full.setAttribute('aria-hidden', 'true')
    document.body.append(full)

    // Clearance from the window edge, same figure the hover-preview cards use.
    const EDGE = 8

    let shown: HTMLAnchorElement | null = null
    let rowBox: DOMRect | null = null
    let fullBox: DOMRect | null = null

    const place = (link: HTMLAnchorElement): void => {
      const rect = link.getBoundingClientRect()
      /*
       * Pinned to the row's own top left corner, with the same padding and type
       * as the row, so the reveal prints its first character exactly over the
       * first character underneath and reads as the row carrying on past the
       * frame.
       *
       * With the start edge pinned there, the only thing that can push the
       * reveal off the window is its own length, so the length is capped at
       * whatever room is left. A heading longer than that wraps onto a second
       * line instead of running off screen, which is the case that matters in
       * handle mode: there the panel is a drawer at the bottom of a phone-width
       * window, where "past the frame" is only a couple of centimetres.
       */
      full.style.maxInlineSize = `${Math.max(120, innerWidth - rect.left - EDGE)}px`
      full.style.left = `${rect.left}px`
      full.style.top = `${rect.top}px`
      // Read once the line has its final width, since the wrapping decides the
      // height, and lifted off the bottom of the window if it would fall past it:
      // in handle mode the last row of an open drawer is already near it.
      const top = Math.min(rect.top, Math.max(EDGE, innerHeight - full.offsetHeight - EDGE))
      full.style.top = `${top}px`
      rowBox = rect
      fullBox = full.getBoundingClientRect()
    }

    const inside = (x: number, y: number, box: DOMRect | null): boolean =>
      box !== null && x >= box.left && x <= box.right && y >= box.top && y <= box.bottom

    /** True when there was something to dismiss, so Escape can tell. */
    const hideFull = (): boolean => {
      if (shown === null) return false
      shown = null
      rowBox = null
      fullBox = null
      full.removeAttribute('data-open')
      removeEventListener('pointermove', trackPointer)
      return true
    }

    /*
     * WCAG 1.4.13's second requirement, hoverable: the pointer has to be able to
     * move onto the revealed text without it disappearing, and this text does
     * overlap the article. The reveal itself takes no pointer events (a click
     * has to keep reaching the row's link underneath it, and the row has to keep
     * its own `:hover` while the pointer is over the half that covers it), so a
     * plain mouseleave on the row would drop the reveal the moment the pointer
     * moved onto the part hanging over the prose. The pointer is followed
     * instead, and the reveal stays while it is over either rectangle. Both are
     * measured at reveal and again whenever the panel scrolls under them, and
     * the listener only exists while something is revealed.
     */
    function trackPointer(event: PointerEvent): void {
      if (inside(event.clientX, event.clientY, rowBox)) return
      if (inside(event.clientX, event.clientY, fullBox)) return
      hideFull()
    }

    const showFull = (link: HTMLAnchorElement, pointer: boolean): void => {
      // Only a row the ellipsis actually cut. A heading that already fits is
      // fully readable where it is, and a box appearing over it is noise. One
      // pixel of rounding is not truncation.
      if (link.scrollWidth - link.clientWidth < 2) return
      full.textContent = link.textContent
      full.setAttribute('data-open', 'true')
      shown = link
      // After the attribute, never before: the height cannot be read off a
      // `display: none` element, and the wrapping decides the height.
      place(link)
      // Only a reveal the pointer opened follows the pointer. One opened from
      // the keyboard stays until the focus leaves it or Escape takes it, and a
      // mouse being nudged somewhere else on the page is neither.
      if (pointer) addEventListener('pointermove', trackPointer, { passive: true })
    }

    for (const link of links) {
      link.addEventListener('pointerenter', (event) => {
        // Touch has no hover: the tap follows the link, and the reveal would
        // only flash over the text on the way out.
        if (event.pointerType === 'touch') return
        showFull(link, true)
      })
      // The same reveal from the keyboard. These rows are links, so they are
      // already tab stops, and a reader tabbing through the outline cannot see
      // the cut text any better than a reader pointing at it.
      link.addEventListener('focus', () => showFull(link, false))
      link.addEventListener('blur', () => hideFull())
    }

    // Following a row, or opening and closing a branch, moves or replaces the
    // thing the reveal is pinned to.
    toc.addEventListener('click', () => hideFull())
    /*
     * The panel scrolls out from under the reveal on its own: `reveal()` above
     * scrolls the current row into the box as the reader moves down the page,
     * and focusing a row inside a scroll container scrolls it into view too. The
     * reveal is re-placed rather than dismissed, since that second case fires
     * immediately after the focus that opened it.
     */
    toc.addEventListener(
      'scroll',
      () => {
        if (shown !== null) place(shown)
      },
      { passive: true },
    )
    // A resize re-measures and re-places the panel itself (fitMode above), so
    // the row the reveal is pinned to is about to be somewhere else.
    addEventListener('resize', () => hideFull(), { passive: true })

    /*
     * WCAG 1.4.13's first requirement, dismissable: Escape takes the reveal down
     * without moving the pointer or the focus, which stay where they are, ready
     * to open it again. Nothing here is on a timeout, so the third requirement
     * (persistent) is the absence of one.
     *
     * Registered before the drawer's own Escape handler below and stopping the
     * event only when there was actually something to dismiss, so in handle mode
     * the first press takes the reveal and the outline stays open for a second
     * press to close.
     */
    addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      if (hideFull()) event.stopImmediatePropagation()
    })

    if (handle !== null) {
      const setOpen = (open: boolean): void => {
        toc.dataset.open = String(open)
        handle.setAttribute('aria-expanded', String(open))
      }

      handle.addEventListener('click', () => setOpen(toc.dataset.open !== 'true'))

      // On a phone the panel covers the text it is an index of, so following a
      // link has to put the text back.
      toc.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a') === null) return
        if (document.documentElement.dataset.tocMode === 'panel') return
        setOpen(false)
      })

      addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return
        if (toc.dataset.open !== 'true') return
        setOpen(false)
        handle.focus()
      })
    }
  }
</script>
