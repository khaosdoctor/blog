---
import { localeFromPath, t } from '../i18n/ui'

/** Keeps the caption and the original URL when a remote host stops serving an image. */
interface Props {
  src: string
  alt?: string
  caption?: string
}

// The dead URL is kept in data-original on the frame. It used to be an HTML
// comment, and Astro does not evaluate expressions inside comments, so every page
// shipped the literal text `{src}` instead.
const { src, alt, caption } = Astro.props
// MDX calls this without props, so the URL is what tells us the language.
const locale = localeFromPath(Astro.url.pathname)
const host = (() => {
  try {
    return new URL(src).hostname.replace(/^www\./, '')
  } catch {
    return t(locale, 'imageGoneUnknownHost')
  }
})()
---

<figure class="missing">
  <div class="frame" role="img" aria-label={alt || t(locale, 'imageGoneAlt', host)} data-original={src}>
    <p class="sad" aria-hidden="true">=(</p>
    <p class="label">{t(locale, 'imageGone')}</p>
    <p class="host">{host}</p>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* The block margin comes from core.css's own `figure` rule. */
  .frame {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 8rem;
    padding: 1.5rem;
    border: var(--border) dashed var(--rule);
    border-inline-start: var(--border-card-edge) solid var(--rule);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }

  /* A typed-out sad face rather than an emoji: an emoji is a font-dependent
     colour image, and this whole site is going pixel and monochrome. Painted behind
     the labels as a watermark, hidden from screen readers because it is
     decoration and the frame already carries a real label. */
  .sad {
    position: absolute;
    z-index: -1;
    margin: 0;
    color: var(--rule);
    font-family: var(--font-mono);
    font-size: 5rem;
    line-height: 1;
    letter-spacing: -0.05em;
    user-select: none;
    /* Typed sideways, read upright: rotating it puts the eyes above the mouth
       instead of leaving the reader to tilt their head. */
    transform: rotate(90deg);
  }

  .label {
    margin: 0;
    font-size: var(--text-small);
  }

  .host {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    opacity: 0.8;
  }
</style>
