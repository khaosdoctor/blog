---
import { localeFromPath, t } from '../i18n/ui'

/** Keeps the caption and the original URL when a remote host stops serving an image. */
interface Props {
  src: string
  alt?: string
  caption?: string
}

// The dead URL is kept in data-original on the frame. It used to be an HTML
// comment, and Astro does not evaluate expressions inside comments, so every page
// shipped the literal text `{src}` instead.
const { src, alt, caption } = Astro.props
// MDX calls this without props, so the URL is what tells us the language.
const locale = localeFromPath(Astro.url.pathname)
const host = (() => {
  try {
    return new URL(src).hostname.replace(/^www\./, '')
  } catch {
    return t(locale, 'imageGoneUnknownHost')
  }
})()
---

<figure class="missing">
  <div class="frame" role="img" aria-label={alt || t(locale, 'imageGoneAlt', host)} data-original={src}>
    <p class="label">{t(locale, 'imageGone')}</p>
    <p class="host">{host}</p>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .missing {
    margin-block: 2rem;
    margin-inline: 0;
  }

  .frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 8rem;
    padding: 1.5rem;
    border: 1px dashed var(--rule);
    border-radius: 4px;
    color: var(--muted);
    text-align: center;
  }

  .label {
    margin: 0;
    font-size: 0.9rem;
  }

  .host {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    opacity: 0.8;
  }
</style>
