---
import { localeFromPath, t } from '../i18n/ui'

interface Props {
  src: string
  alt?: string
  caption?: string
}

// The dead URL has to ride in data-original rather than an HTML comment: Astro
// does not evaluate expressions inside comments and would ship `{src}` verbatim.
const { src, alt, caption } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
const host = (() => {
  try {
    return new URL(src).hostname.replace(/^www\./, '')
  } catch {
    return t(locale, 'imageGoneUnknownHost')
  }
})()
---

<figure class="missing">
  <div class="frame" role="img" aria-label={alt || t(locale, 'imageGoneAlt', host)} data-original={src}>
    <p class="sad" aria-hidden="true">=(</p>
    <p class="label">{t(locale, 'imageGone')}</p>
    <p class="host">{host}</p>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .frame {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 8rem;
    padding: 1.5rem;
    border: var(--border) dashed var(--rule);
    border-inline-start: var(--border-card-edge) solid var(--rule);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }

  .sad {
    position: absolute;
    z-index: -1;
    margin: 0;
    color: var(--rule);
    opacity: 0.3;
    font-family: var(--font-mono);
    font-size: 5rem;
    line-height: 1;
    letter-spacing: -0.05em;
    user-select: none;
    /* The face is typed sideways, so the rotation is what puts the eyes above
       the mouth. */
    transform: rotate(90deg);
  }

  .label {
    margin: 0;
    font-size: var(--text-small);
  }

  .host {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    opacity: 0.8;
  }
</style>
