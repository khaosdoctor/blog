---
/**
 * How far down the post you are, drawn on the header's own dashed rule.
 *
 * This component renders no markup of its own any more. The track it drives is
 * the two runs of dashes BrandHeader.astro already draws between the bracket
 * corners (`.fill > .dash`, one span per character), read as ONE meter running
 * left to right across the row: the left run's dashes first, then the right
 * run's, so progress starts at the `┌─` corner and finishes at the `─┐` one.
 * A dash the reader has passed takes the post's cover colour (`--post-accent`,
 * BrandHeader's own `.dash.lit` rule); the rest stay the muted dashes they
 * always were. That replaces the fixed bar this used to pin to the top of the
 * window, and its `--progress-*` tokens went with it.
 *
 * The wordmark's block cursor is the head of that run rather than a fixture
 * beside the brand: at the top of a post it is exactly where it always was, and
 * as the reader scrolls it travels along the dashes, which are its trail. It is
 * writing them. See `measureHead`/`moveHead` in the script below for the
 * geometry, and `.cursor` in BrandHeader.astro for the two declarations that
 * make it possible from the stylesheet's side.
 *
 * The reveal is not a straight readout of the scroll position, per the owner's
 * own ask. Two things stay between them:
 *
 * - Lag. The lit count eases toward where the reader actually is instead of
 *   snapping to it, so on a fast scroll the dashes visibly catch up rather
 *   than arriving with the page.
 * - Jitter. Each dash carries a small random offset in WHEN it lights within
 *   its own slot, so the run types itself out unevenly, the way a person
 *   types, instead of at a metronome's cadence.
 *
 * Both are motion, so under reduced motion both are off: the lit count tracks
 * the scroll exactly and every dash lights at its own even position. The bar
 * still reports the reader's position, which is the part that is information
 * rather than decoration.
 *
 * It stays out of the accessibility tree (the dash spans are inside
 * BrandHeader's own `aria-hidden` runs): a screen reader announcing a
 * percentage on every scroll tick is noise, and the reader already knows where
 * they are in the document.
 */
---

<script>
  /*
   * The track, in visual order: the left run's dashes, then the right run's.
   * DOM order is left-to-right order here, so no sorting is needed.
   *
   * Only the dashes that are actually VISIBLE count. `.fill` crops its fixed
   * 38-character run with `overflow: hidden`, and how many of those 38 survive
   * depends on the viewport, so treating all 76 as the meter would stall the
   * fill against a cropped stretch nobody can see and then jump. Measured on
   * load, on resize and once the display face has loaded (a font swap changes
   * every advance, and with it how many dashes fit), never on a scroll tick.
   */
  const fills = Array.from(document.querySelectorAll<HTMLElement>('.chrome .fill'))
  /*
   * The write head, which is the wordmark's own block cursor, borrowed rather
   * than duplicated: the owner asked for "that same block", and a second block
   * drawn somewhere else would have to hide the first to avoid two cursors on
   * one row.
   *
   * It is NOT moved in the DOM. Reparenting it next to the dash it is writing
   * would put it inside `.fill`, which is the one place on this row it cannot
   * survive: `.fill` crops itself with `overflow: hidden` exactly where the
   * meter ends, so the head would be clipped away at the very moment it
   * finished a run; `.fill`'s 0.4em letter-spacing would add a slot of air
   * after it and shove every remaining dash along, so the track would change
   * shape as the head crossed it; its `0.55em`/`1.1em`/`0.2em` metrics would
   * re-resolve against `.fill`'s font-size instead of `.word`'s 0.85rem, so
   * the block would change size the instant it left home; and it would step
   * outside `.brand`'s drop shadow, which is the only reason the wordmark
   * reads at all on the light ground. A transform from where it already lives
   * keeps every one of those: same box, same blink, same shadow, and the crop
   * never applies to it because it is never inside the cropped element.
   */
  const cursor = document.querySelector<HTMLElement>('.chrome .cursor')

  if (fills.length > 0) {
    // How much of a dash's own slot its appearance can be pushed back by. Under
    // 1 so the order can never invert: dash i lights somewhere inside [i, i+1),
    // which is still strictly after dash i-1.
    const JITTER = 0.85
    // How much of the remaining distance the fill closes per frame. The lag the
    // owner asked for, and the reason it reads as catching up rather than
    // tracking.
    const EASE = 0.18
    // Ceiling on that, in dashes per frame: without it a jump to the bottom of
    // a long post closes most of the distance in the first frame or two, which
    // reads as the whole run appearing at once rather than being typed. At 60Hz
    // this is roughly 54 dashes a second, so even a full-length jump types
    // itself out in well under two seconds.
    const MAX_STEP = 0.9

    let track: HTMLElement[] = []
    let jitter: number[] = []
    /*
     * Where the head is, in px to the right of its home position, once exactly
     * `i` dashes are lit. `stops[0]` is 0, which is home: nothing written past
     * the brand yet, and the header at the top of a post therefore draws the
     * cursor in the position it has always drawn it. `stops[i]` past that is
     * the TRAILING edge of dash `i - 1`, which is also the leading edge of dash
     * `i`, since two consecutive characters of one run share that edge (letter-
     * spacing goes into each character's own advance). So the head always
     * occupies the slot of the dash it is about to write, one step ahead of its
     * own trail, which is what a cursor does.
     */
    let stops: number[] = []
    /*
     * The distance from the cursor's home edge to the start of the first run,
     * measured once and then reused, because it is the one number here that
     * does not change: it is the cursor's own width (em, off a rem font-size),
     * `.word`'s 1px padding and `.chrome`'s 0.6rem column spacing, none of
     * which move when the display face loads or when the wordmark's letters do.
     *
     * Measured rather than written out because it is three values from two
     * other files, but measured ONLY on the first pass, which is the only pass
     * guaranteed to catch the wordmark whole: this script runs at module time
     * and header-brand.ts starts its scramble on DOMContentLoaded, after it, so
     * the first measurement sees eleven real letters. Every later one (the font
     * swap, a resize) can arrive mid-scramble, where the letters are blanked
     * one by one and `.word` collapses onto its own `min-inline-size`; reading
     * the cursor's live position there would put home some 30px to the left and
     * the head would disagree with its trail by a whole dash for the rest of
     * the session. Anchoring to `.fill` instead keeps the font swap's real
     * effect, which is that every dash edge moves, without importing the
     * wordmark's transient width into it.
     */
    let lead: number | null = null
    // How many leading dashes are lit. The thresholds below only ever increase
    // with the index, so the lit set is always a prefix and this one number is
    // enough to know exactly which spans need touching on any given frame.
    let lit = 0
    let shown = 0
    let target = 0
    let animating = false
    let queued = false

    /*
     * Reduced motion: the same convention conway.ts and header-brand.ts
     * already read, an explicit `data-motion` override (written by the
     * settings panel) wins in both directions, and the OS query decides when
     * it is absent.
     */
    function motionOverride(): 'reduce' | 'allow' | null {
      const attr = document.documentElement.getAttribute('data-motion')
      return attr === 'reduce' || attr === 'allow' ? attr : null
    }

    function reducedMotion(): boolean {
      const override = motionOverride()
      if (override === 'reduce') return true
      if (override === 'allow') return false
      return matchMedia('(prefers-reduced-motion: reduce)').matches
    }

    /** Where in the run dash `index` lights up, in dashes. */
    function threshold(index: number): number {
      return reducedMotion() ? index : index + jitter[index]
    }

    /**
     * Where the head is drawn for the current `shown`, in px from home.
     *
     * It rides the eased count, not `scrollY`: the trail is painted from the
     * same number one line above, so the two cannot drift out of step no matter
     * how hard the reader flings the page. Writes one custom property and reads
     * nothing, so it is safe on every frame; all the geometry it needs was
     * measured in `measureHead` below.
     *
     * Between two stops it interpolates, so the head slides rather than
     * stepping character to character. The one exception is the seam between
     * the two runs, where the nav is: interpolating there would walk a solid
     * block straight across POSTS/SERIES/TAGS/ABOUT, which reads as a bug, and
     * hiding it for the crossing reads as the cursor blinking out at a random
     * point in the post. So it holds at the end of the left run for that one
     * slot and then appears at the head of the right one. It is never drawn
     * over a link and it is never not drawn. The trail does exactly the same
     * thing at exactly the same moment (the left run finishes, the right run
     * starts), and the rule is already drawn as though it passed BEHIND the
     * links rather than stopping at them, so the head skipping the same
     * distance reads as the rule continuing, which is what it is.
     */
    function moveHead(): void {
      if (cursor === null || stops.length === 0) return
      const last = stops.length - 1
      /*
       * The head is placed from `lit`, the count of dashes actually written,
       * not from `shown`. The two are the same number in the reduced-motion
       * path and can be most of a dash apart otherwise: `threshold()` pushes
       * each dash's own lighting back by up to JITTER of its slot, so `shown`
       * can be well past a dash the trail has not drawn yet. Placing from
       * `shown` therefore ran the block ahead of its own trail, further ahead
       * the more jitter that dash happened to draw, which is the drift the
       * owner reported.
       *
       * `lit` is the pen's real position: it is exactly the number of dashes
       * that exist, so the head standing at `stops[lit]` is standing on the
       * one it is about to write.
       */
      /*
       * One stop per dash, no interpolation between them. Sliding smoothly
       * between two stops is what let the block drift away from its own trail:
       * it was always somewhere between the dash just written and the one
       * coming, while the trail only ever moves a whole character at a time.
       * Stepping means the two are the same thing by construction, and it is
       * what typing looks like: a cursor jumps a character, it does not glide
       * across one.
       */
      const index = Math.min(Math.max(lit, 0), last)
      cursor.style.setProperty('--cursor-x', `${stops[index].toFixed(2)}px`)
    }

    /** Adds or removes only the spans the fill has actually crossed. */
    function paint(): void {
      while (lit < track.length && threshold(lit) < shown) track[lit++].classList.add('lit')
      while (lit > 0 && threshold(lit - 1) >= shown) track[--lit].classList.remove('lit')
      moveHead()
    }

    /*
     * The head's stops, from the dash edges the crop left visible.
     *
     * `lefts` and not the trailing edges this used to read. Two reasons, one
     * of them a bug: a dash carries `letter-spacing: 0.4em`, and that space is
     * part of its own advance, so its right edge is most of half an em past
     * the glyph. Stacking that on the final dash put the head inside the
     * search button. Standing the head on the LEFT edge of the dash it is
     * about to write also says what the block means: the pen is on the
     * character it is writing, not past it.
     *
     * The last stop is the last dash's own left edge as well, so a fully read
     * post parks the block on the final dash rather than in the chrome beyond
     * it. Nothing is lost: that dash is lit either way.
     */
    function measureHead(lefts: number[]): void {
      if (cursor === null) return
      const start = fills[0].getBoundingClientRect().left
      if (lead === null) lead = start - cursor.getBoundingClientRect().left
      const home = start - lead
      const last = lefts.length - 1
      stops = [0]
      for (let index = 0; index <= last; index += 1) stops.push(lefts[Math.min(index, last)] - home)
    }

    /*
     * Which dashes the crop leaves visible, a fresh jitter offset for each, and
     * where the head has to be for each. Reads geometry, so it runs on load and
     * resize only, never per scroll.
     */
    function measure(): void {
      for (const dash of track) dash.classList.remove('lit')
      lit = 0
      track = []
      const lefts: number[] = []
      for (const [run, fill] of fills.entries()) {
        const edge = fill.getBoundingClientRect().right
        for (const dash of fill.querySelectorAll<HTMLElement>('.dash')) {
          const box = dash.getBoundingClientRect()
          // Half a pixel of slack: a fractional layout width should not lose
          // the last dash that does in fact draw.
          if (box.right <= edge + 0.5) {
            track.push(dash)
            lefts.push(box.left)
            continue
          }
          dash.classList.remove('lit')
        }
      }
      jitter = track.map(() => Math.random() * JITTER)
      measureHead(lefts)
      paint()
    }

    /*
     * Blinking or solid. A terminal cursor blinks while it waits for you and
     * holds steady while characters are going down, and that is the distinction
     * worth keeping here: a block that blinks while it slides along the rule
     * reads as flicker, not as a cursor. So it is solid for exactly as long as
     * the eased count is still moving, and back to blinking the moment it parks,
     * whether that is at the brand or halfway down the post.
     *
     * The blink itself belongs to header-brand.ts, which writes an inline
     * opacity per frame and knows nothing about any of this. One attribute and
     * one `!important` rule in BrandHeader.astro is the whole of the contract
     * between them; neither script has to import the other or share a clock.
     */
    function setWriting(writing: boolean): void {
      if (cursor === null) return
      if (writing) cursor.setAttribute('data-writing', 'true')
      else cursor.removeAttribute('data-writing')
    }

    function step(): void {
      const distance = target - shown
      if (Math.abs(distance) <= 0.01) {
        shown = target
        animating = false
        paint()
        setWriting(false)
        return
      }
      const move = Math.min(Math.abs(distance) * EASE, MAX_STEP)
      shown += Math.sign(distance) * move
      paint()
      requestAnimationFrame(step)
    }

    function advance(): void {
      if (reducedMotion()) {
        // No lag and no jitter: the fill is wherever the reader is, and so is
        // the head. Nothing is travelling, so there is no writing state to mark
        // either; the same convention the lag and the jitter already follow,
        // and header-brand.ts has frozen the cursor solid regardless.
        shown = target
        setWriting(false)
        paint()
        return
      }
      if (animating) return
      animating = true
      setWriting(true)
      requestAnimationFrame(step)
    }

    // Scroll position as a fraction of the scrollable height. rAF-throttled,
    // the same as the fixed bar this replaces: a scroll listener that reads
    // layout on every event is the classic way to make a long post feel heavy.
    const update = (): void => {
      queued = false
      const max = document.documentElement.scrollHeight - innerHeight
      // A post shorter than the window has nothing to scroll, so it is either
      // fully read already or the question is meaningless. Either way: full.
      const ratio = max <= 0 ? 1 : Math.min(Math.max(scrollY / max, 0), 1)
      target = ratio * track.length
      advance()
    }

    const schedule = (): void => {
      if (queued) return
      queued = true
      requestAnimationFrame(update)
    }

    const remeasure = (): void => {
      measure()
      schedule()
    }

    addEventListener('scroll', schedule, { passive: true })
    addEventListener('resize', remeasure, { passive: true })
    // The dashes are laid out in the display face, which loads after first
    // paint: until it has, the run measures at the fallback's advance and the
    // crop falls in a different place.
    document.fonts?.ready.then(remeasure)
    measure()
    update()

    // A reader turning reduced motion on mid-scroll should finish at the exact
    // position rather than complete an eased run; both paths below do that
    // through the same `advance`.
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', advance)

    // The settings panel writes `data-motion` straight onto <html>; a
    // MutationObserver is the plain platform way to notice that without this
    // script importing the settings panel's own module.
    new MutationObserver(advance).observe(document.documentElement, { attributes: true, attributeFilter: ['data-motion'] })
  }
</script>
