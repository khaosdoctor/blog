<script>
  import { prefersReducedMotion as reducedMotion } from '../scripts/motion'

  const fills = Array.from(document.querySelectorAll<HTMLElement>('.shell .fill'))
  // Never reparent this into `.fill`: clipping, letter-spacing, font metrics,
  // and `.brand`'s drop shadow would all break.
  const cursor = document.querySelector<HTMLElement>('.shell .cursor')

  if (fills.length > 0) {
    // Must stay under 1, or the order inverts: dash i lights inside [i, i+1),
    // still strictly after dash i-1.
    const JITTER = 0.85
    const EASE = 0.18
    // Ceiling in dashes per frame, so a jump to the bottom of a long post still
    // types itself out.
    const MAX_STEP = 0.9

    let track: HTMLElement[] = []
    let jitter: number[] = []
    // Head position in px right of home, indexed by how many dashes are lit.
    // Index i is the left edge of dash i, the one about to be written.
    let stops: number[] = []
    // Measured on the FIRST pass only: a later run can arrive mid-scramble in
    // header-brand, when the letters are blank and `.word` collapses to its min.
    let lead: number | null = null
    // Thresholds increase with the index, so the lit set is always a prefix.
    let lit = 0
    let shown = 0
    let target = 0
    let animating = false
    let queued = false

    function threshold(index: number): number {
      return reducedMotion() ? index : index + jitter[index]
    }

    // Rides `lit`, not `shown`: `threshold()` pushes each dash back by up to
    // JITTER of its slot, so `shown` can be past a dash the trail has not drawn.
    function moveHead(): void {
      if (cursor === null || stops.length === 0) return
      const last = stops.length - 1
      const index = Math.min(Math.max(lit, 0), last)
      cursor.style.setProperty('--cursor-x', `${stops[index].toFixed(2)}px`)
    }

    function paint(): void {
      while (lit < track.length && threshold(lit) < shown) track[lit++].classList.add('lit')
      while (lit > 0 && threshold(lit - 1) >= shown) track[--lit].classList.remove('lit')
      moveHead()
    }

    // Left edges, never right: a dash carries 0.4em of letter-spacing inside
    // its own advance, so its right edge is half an em past the glyph.
    function measureHead(lefts: number[]): void {
      if (cursor === null) return
      const start = fills[0].getBoundingClientRect().left
      const box = cursor.getBoundingClientRect()
      if (lead === null) lead = start - box.left
      const home = start - lead
      const last = lefts.length - 1
      // A stop positions the block's LEFT edge, so subtracting its width keeps
      // the whole block inside the run on the final dashes.
      const limit = fills[fills.length - 1].getBoundingClientRect().right - box.width - home
      stops = [0]
      for (let index = 0; index <= last; index += 1) {
        stops.push(Math.min(lefts[Math.min(index, last)] - home, limit))
      }
    }

    // Only the dashes `.fill`'s crop leaves visible are part of the meter.
    // Reads geometry, so it runs on load and resize only, never on a scroll.
    function measure(): void {
      for (const dash of track) dash.classList.remove('lit')
      lit = 0
      track = []
      const lefts: number[] = []
      for (const [run, fill] of fills.entries()) {
        const edge = fill.getBoundingClientRect().right
        for (const dash of fill.querySelectorAll<HTMLElement>('.dash')) {
          const box = dash.getBoundingClientRect()
          // Half a pixel of slack for fractional layout widths.
          if (box.right <= edge + 0.5) {
            track.push(dash)
            lefts.push(box.left)
            continue
          }
          dash.classList.remove('lit')
        }
      }
      jitter = track.map(() => Math.random() * JITTER)
      measureHead(lefts)
      paint()
    }

    function setWriting(writing: boolean): void {
      if (cursor === null) return
      if (writing) cursor.setAttribute('data-writing', 'true')
      else cursor.removeAttribute('data-writing')
    }

    function step(): void {
      const distance = target - shown
      if (Math.abs(distance) <= 0.01) {
        shown = target
        animating = false
        paint()
        setWriting(false)
        return
      }
      const move = Math.min(Math.abs(distance) * EASE, MAX_STEP)
      shown += Math.sign(distance) * move
      paint()
      requestAnimationFrame(step)
    }

    function advance(): void {
      if (reducedMotion()) {
        shown = target
        setWriting(false)
        paint()
        return
      }
      if (animating) return
      animating = true
      setWriting(true)
      requestAnimationFrame(step)
    }

    const update = (): void => {
      queued = false
      const max = document.documentElement.scrollHeight - innerHeight
      // A post shorter than the window has nothing to scroll: count it full.
      const ratio = max <= 0 ? 1 : Math.min(Math.max(scrollY / max, 0), 1)
      target = ratio * track.length
      advance()
    }

    const schedule = (): void => {
      if (queued) return
      queued = true
      requestAnimationFrame(update)
    }

    const remeasure = (): void => {
      measure()
      schedule()
    }

    addEventListener('scroll', schedule, { passive: true })
    addEventListener('resize', remeasure, { passive: true })
    // Before the display face loads the run measures at the fallback's advance.
    document.fonts?.ready.then(remeasure)
    measure()
    update()

    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', advance)

    new MutationObserver(advance).observe(document.documentElement, { attributes: true, attributeFilter: ['data-motion'] })
  }
</script>
