---
import { localeFromPath, t } from '../i18n/ui'

/**
 * A self-contained HTML page embedded in a post.
 *
 * For a demo that is a whole page with its own scripts and styles, which is what
 * most of the old ones are. Put the page in `public/labs/<name>/index.html` and
 * write `<HtmlLab name="the-name" title="what it does" />` in the post.
 *
 * An iframe rather than inlining the markup, deliberately: a pasted-in demo's CSS
 * would inherit and then fight the post's own styles, and its script would share
 * the page's globals. Same origin, so `frame-src 'self'` covers it, and the
 * `sandbox` attribute still keeps it from navigating the parent or opening popups.
 */
interface Props {
  /** Folder under public/labs/. */
  name: string
  /** What the demo is, for the iframe's accessible name. Required, not decorative. */
  title: string
  /** CSS height. A demo that needs to grow should say so. */
  height?: string
}

const { name, title, height = '24rem' } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
---

<figure class="lab" style={`--lab-height: ${height}`}>
  <iframe
    src={`/labs/${name}/`}
    title={title}
    loading="lazy"
    sandbox="allow-scripts allow-same-origin allow-forms"></iframe>
  <figcaption>
    {title} <a href={`/labs/${name}/`} rel="noopener">{t(locale, 'openInNewTab')}</a>
  </figcaption>
</figure>

<style>
  .lab {
    margin-block: 2rem;
    margin-inline: 0;
  }

  .lab iframe {
    display: block;
    inline-size: 100%;
    block-size: var(--lab-height);
    border: var(--border) solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
  }
</style>
