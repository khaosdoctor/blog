---
import { localeFromPath, t } from '../i18n/ui'

interface Props {
  html: string
  name: string
  title: string
  height?: string
}

const { html, name, title, height = '18rem' } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
---

<figure class="lab-demo" style={`--lab-height: ${height}`}>
  <iframe srcdoc={html} title={title} loading="lazy" sandbox="allow-scripts"></iframe>
  <details>
    <summary>{t(locale, 'showSource')} <code>{name}</code></summary>
    <slot name="source" />
  </details>
</figure>

<style>
  iframe {
    display: block;
    inline-size: 100%;
    block-size: var(--lab-height);
    border: 0;
    background: var(--bg);
  }
</style>
