{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "vendor": "node scripts/vendor-media.ts",
    "prebuild": "node scripts/vendor-media.ts",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "check": "astro check && npm run check:worker && node scripts/check-i18n.ts && node scripts/check-component-css.ts && node scripts/check-credits.ts",
    "check:worker": "tsc -p worker",
    "astro": "astro",
    "cover": "node scripts/cover.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vue": "^7.0.2",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "astro": "^7.2.2",
    "astro-embed": "^0.13.1",
    "astro-expressive-code": "^0.44.1",
    "astro-mermaid": "^2.1.0",
    "github-slugger": "^2.0.0",
    "mermaid": "^11.16.1",
    "pagefind": "^1.5.2",
    "rehype-callouts": "^2.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "textmode.js": "^0.17.1",
    "vue": "^3.5.41"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "acorn": "^8.15.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3"
  }
}
