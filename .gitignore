# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Obsidian vault config is tracked so the writing setup is reproducible, except
# the parts that rewrite themselves constantly.
content/.obsidian/workspace.json
content/.obsidian/workspace-mobile.json
content/.obsidian/vault-stats.json
content/.obsidian/plugins/*/data.json.bak
content/.obsidian/plugins/recent-files-obsidian/data.json

# migration working artifacts (inventory, review lists, the Ghost export)
.migration/
# The Ghost importer itself. Kept on disk while the content settles, untracked
# because it is a one-shot: the posts are the source of truth now and there is
# no second migration coming.
scripts/migrate/
scripts/analyze-export.ts
# open questions and decisions for Lucas, not part of the site
QUESTIONS.md

# incident writeup for Lucas: internal, and the repo goes public later
SECURITY-INCIDENT.md
# scratch build output from review agents
dist-review/
